lo00009",15],[24,"blo00011",10],[24,"blo00012",15],[25,"blo00014",10],[25,"blo00015",15],[26,"evo00021",8],[26,"evo00023",32],[26,"evo01015",1],[27,"blo00007",4],[27,"blo00010",4],[27,"blo00013",4],[28,"blo00007",4],[28,"blo00010",4],[28,"blo00013",4],[29,"blo00007",4],[29,"blo00010",4],[29,"blo00013",4],[30,"blo00007",4],[30,"blo00010",4],[30,"blo00013",4],[31,"evo00021",8],[31,"evo00023",32],[31,"evo01015",1],[32,"blo00007",4],[32,"blo00010",4],[32,"blo00013",4],[33,"blo00007",4],[33,"blo00010",4],[33,"blo00013",4],[34,"blo00007",4],[34,"blo00010",4],[34,"blo00013",4],[35,"blo00007",4],[35,"blo00010",4],[35,"blo00013",4],[36,"evo00021",8],[36,"evo00023",32],[36,"evo01015",1],[37,"blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00021",8],[41,"evo00023",32],[41,"evo01015",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00021",8],[46,"evo00023",32],[46,"evo01015",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"葉取星舟よ。ふん、不躾な視線ね……これが今のふうまの頭領とは","en":"Hatori Seishu, how rude of you to look at me like that... is this really the leader of the current Fuuma?"},"clip":"Audio/Voice/uni07015_1/uni07015_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふ、対魔忍に魔族に米連……良く節操もなく集めたものね","en":"Ha ha, you've got a pretty mixed bag here - Taimanin, demons, and even some from the US... no sense of decency, I suppose?"},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"昨今の対魔忍の質はヒドイ物ね、ぬるま湯につかっているせいかしら？　顔からして腑抜けてるわ","en":"The quality of Taimanin these days is appalling... I suppose it's because they're too comfortable, like they're soaking in a warm bath. They look so spineless."},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふうま家のくせに隊長だなんて……アサギも平和ぼけしたのかしら？","en":"The Fuuma family, and they call themselves captains... I wonder if Asagi has gone soft too?"},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"見た目だけで判断してくる奴は楽で良いわね。目の前の物しか見えない雑魚だから","en":"It's easy to deal with people who judge me based on appearances alone... they're just weaklings who can't see beyond what's right in front of them."},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お前ちょっと肩を揉みなさい。ふぅ～……まあ、そこそこってところね","en":"Come here and massage my shoulders for a bit. Ah, that's nice... I suppose you're passable."},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"アサギが最強の対魔忍……ふっ、あの小娘がねえ……","en":"Asagi, the strongest Taimanin... ha! That little girl?"},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"全盛期の姿と力を保っているけれど、お前などとは比べものにならない年長だという事は覚えておきなさい","en":"I've maintained my peak strength and appearance, but you should remember that I'm a senior, and you can't compare to me."},"clip":"Audio/Voice/uni07015_1/uni07015_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07015_1/uni07015_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07015_1/uni07015_1_atk_2.ogg"},{"type":"atk","label":"Attack","varian