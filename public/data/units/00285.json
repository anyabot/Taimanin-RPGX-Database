":{"ja":"味方全体のDEFを大アップ、敵１体に特大威力で攻撃、ATKを中ダウンする"}},{"level":4,"sp":350,"detail":{"ja":"味方全体のDEFを大アップ、敵１体に特大威力で攻撃、ATKを中ダウンする"}},{"level":5,"sp":350,"detail":{"ja":"味方全体のDEFを大アップ、敵１体に特大威力で攻撃、ATKを中ダウンする"}}],"effects":[{"text":"1 enemy: 620% Devilish damage"},{"text":"1 enemy: ATK -25% for 4 turns","icon":"atk_down"},{"text":"All allies: DEF +60% for 4 turns","icon":"def_up"}]}},"leader":{"name":{"ja":"真祖の血脈"},"detail":{"ja":"クエストクリア時のランク経験値獲得量が中アップ"},"effects":[{"text":"Quest clear: player EXP +15%"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00285",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00285",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00285",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00285",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00285",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00285",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00285",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"やっほ～、久しぶりだねぇ、おにいさん♪　ふぇりと一緒に遊べるんだから、光栄に思ってよね","en":"Yo~ long time no see, big brother♪ Since I get to play with Feri, you should be honored."},"clip":"Audio/Voice/uni00285_1/uni00285_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おにいさん、どこ行くのぉ？　学校？　そんなトコ行くより、ふぇりと遊ぼうよ～♪　そのほうが、絶対楽しいよぉ……ふふっ","en":"Big brother, where are you going? School? Instead of that, let's play with Feri~♪ That's definitely more fun… hehe"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あ～あ、学校サボっちゃったねぇ……ふぇりと遊ぶほう、優先しちゃったねぇ？　ふぇりのほうが、大事だもんねぇ♪","en":"Ah, you skipped school… you chose to play with Feri first, huh? Feri's more important, right♪"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"むー、今日は学校行くんだ……つまんない、つーまーんーなーいー！　ふぇりも行くっ、ついていくっ！","en":"Ugh, gotta go to school today… boring, sooo boring! Feri's coming too, I'm coming!"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"へ～、ここが学校かぁ……あはっ、弱そうなやつばっか♪　ねぇ、ちょっとくらい数減らしちゃっても、いいよねぇ？","en":"Heh, this is school… ahaha, only weaklings♪ Hey, could you maybe thin the numbers a bit?"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ふぅん……せんせい？　とかいうのは、そこら辺のザコより愉しめそう……二、三人、遊び相手にしちゃおっかなぁ～♪","en":"Hmm… teacher? Whatever, they seem more fun than those lowly fodders… maybe I'll play with two or three of them~♪"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"弱いやつは嫌いかなぁ……あ、でもおにいさんは別ね。弱いけど、おもしろいから……もう少し強くなったら、壊してあげるね♪","en":"I don't like weaklings… Ah, but you're different, big brother. You're weak, but you're fun… once you get a little stronger, I'll crush you~"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"壊されたくないなら……ペットにしてあげてもいいよ♪　おにいさんみたいな子、飼ってみたかったんだぁ～","en":"If you don't want me to break you… I could make you my pet~♪ I've always wanted a kid like you, big brother~"},"clip":"Audio/Voice/uni00285_1/uni00285_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00285_1/uni00285_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00285_1/uni00285_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00285_1/uni00285_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00285_1/uni00285_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00285_1/uni00285_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/un