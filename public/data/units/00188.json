50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ごきげんよう。私の名はカテジナ。呪われた魔女とも呼ばれています。……あの、私の事が怖くないのですか？","en":"Good day. My name is Catejina. I'm also called the cursed witch… Um, aren't you scared of me?"},"clip":"Audio/Voice/uni00188_1/uni00188_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はい、いかがなさいましたか？　私の顔になにか付いてますでしょうか？","en":"Yes, what can I do for you? Is there something on my face?"},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あまり私に近付かないでください。……呪われてしまっても、知りませんよ？","en":"Please don't get too close to me… Even if I'm cursed, I won't tell you."},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私は近付く者にやがて死をもたらす魔女。呪われた女。……あ、すみません。ついいつものクセで。気にしないでください","en":"I am the witch who eventually brings death to those who approach. A cursed woman… Ah, sorry. It's just my usual habit. Please ignore it."},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"い、いけません。あまり撫でられたりするのは、な、慣れていなくって。あぁ……","en":"N-no, that's not allowed. I'm not used to being petted… Ah…"},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ええ、いつでもお側にいます。……あなたが私に飽きるまでは","en":"Yes, I'll be by your side whenever… until you grow tired of me."},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私の二つ名は、『呪われた女』。どうか必要以上に近付かないでください","en":"My epithet is \"Cursed Woman.\" Please don't get any closer than necessary."},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お戯れを。あまりふざけていると、……本当に毒が回って死んでしまいますよ？","en":"Just playing around. If you keep goofing off… the poison will really spread and you'll die, you know?"},"clip":"Audio/Voice/uni00188_1/uni00188_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00188_1/uni00188_1_wav_1.ogg"}],"tru