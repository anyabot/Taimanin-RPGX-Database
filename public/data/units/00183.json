00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"……あン。アタシ？　レーベだよ。レーベ・サフリー。頭下げンなら、手伝ってやってもいいじょー？","en":"…Hmm. Me? It's Loewe. Loewe Saffrey. If you bow your head, I might help you, you know?"},"clip":"Audio/Voice/uni00183_1/uni00183_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"なあなあ。ジッとしてんの飽きたよ。そろそろ戦いに行こうぜぇー？","en":"Hey hey. I'm bored just standing around. Let's go fight soon, yeah?"},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"バッカじゃねーの。そんなくっだらないことより、アタシと楽しもうじぇ♪","en":"You're not stupid, are you? Forget that nonsense, have fun with me!"},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"キャハハハハッ！　ウケるッ！　あんたマジでそんなコト言ってんのぉ？","en":"Kahahahaha! So funny! Are you seriously saying that?"},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"何？　アタシの顔になんか付いてるぅ？　ウッザ。どーでもいいしぃ。ほっといてくんねぇ？","en":"What? Got something on my face? Ugh. Whatever. Just leave me alone, okay?"},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ちょまっ。あんたドコ触ってんじょ！？　フザけんな。ヤラれてーのかよぉ！","en":"Hey, what are you touching?! Don't mess around. You trying to get me?"},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"キャハハハッ。あんた気に入ったじぇ！　ヨシ、しばらく付き合ってやる♪","en":"Kahaha. I like you! Alright, I'll hang out with you for a while."},"clip":"Audio/Voice/uni00183_1/uni00183_1_hom_6.ogg"},{"type":