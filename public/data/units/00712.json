00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"うさちゃんみたいにぴょんぴょん跳ねて、お仕事いっぱい頑張っちゃうから、期待しててねっ、えへへっ♪","en":"I'll hop around like a bunny and work my tail off, so keep your expectations high, hehe♪"},"clip":"Audio/Voice/uni00712_1/uni00712_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ボクなら出来る。絶対できるから……大丈夫っ。よーしっ！　お仕事、絶対成功させるから期待して待っててねっ！","en":"I can do it. I'll definitely succeed… don't worry. Alright! I'll make sure the job succeeds, so just wait and expect it!"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ボクだってちゃんと任務を遂行できるってところ、ちゃんと見せてあげるから。泥船……違った、大船に乗った気でいていいからねっ！","en":"I'll show you that I can properly carry out the mission. Not a leaky boat… no, think of it as a big ship, okay!"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"はふぅ。お仕事、すっごくヘビーだったからちょっと疲れちゃった。けど、ふうまの顔を見たら疲れ、どっかにいっちゃったよっ！","en":"Phew. The job was super heavy so I'm a bit tired. But seeing Fuuma's face made my fatigue disappear!"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この格好、かわいいんだけど……。その、あんまりジロジロ見られちゃうと、恥ずかしいかな？","en":"This outfit's cute, but… um, if you stare at me too much, I might get embarrassed, you know?"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ぴょんぴょんうさちゃんだよぉ！　見て、すっごいかわいいでしょ？","en":"I'm a hopping bunny! Look, isn't it super cute?"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ふうまがご主人様だったらきっと可愛がってくれそう。えへへ、にやけちゃう♪","en":"If Fuuma were my master, I'm sure he'd dote on me. Hehe, I can't help grinning♪"},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ボク、このうさちゃんスーツ姿で何をさせられるんだろう？　ちょっと緊張してきたかも","en":"I wonder what I'll be made to do in this bunny suit… I'm getting a bit nervous."},"clip":"Audio/Voice/uni00712_1/uni00712_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ねぇ……知ってる？　うさちゃんってね……すり切れちゃうくらいするんだよ……？　何をって……そんなの……ボクの口から言わせるつもり？","en":"Hey… did you know? Bunnies… they do it so much they wear out…? Do what… you want me to say that…"},"clip":"Audio/Voice_r18/uni00712_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"おねがい……ボクの傍から絶対離れないで欲しいの……ボク……この衣装のせいで……寂しい気持ちに勝てなくなっちゃったみたいなんだ……","en":"Please… don't ever leave my side… I… because of this outfit… I can't fight the loneliness…"},"clip":"Audio/Voice_r18/uni00712_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"ふうま……何して欲しい……？　ボクね……いますっごくえっちな気分になっちゃってるから……どんなことでもしてあげられるよ……えへへ……♪","en":"Fuuma… what do you want me to do? I'm feeling super… naughty… so I can do anything…"},"clip":"Audio/Voice_r18/uni00712_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00712_1/uni00712_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0560_r18"]],"stills":[["chr_0560a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":"2023-07-31","end":"2023-08-16"},{"kind":"gacha","type":"Pickup","title":{"ja":"【復刻】ピックアップガチャ","en":"Rerun: Pick-up Gacha"},"start":"2025-08-18","end":"2025-08-31","pull":["Pick-up select"]},{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】バニー限定ガチャ","en":"Rerun: Bunny Limited Gacha"},"start":null,"end":"2026-08-12","pull":["Pick-up select"]}],"standardPool":true,"origin":"Bunny","art":{"graphicId":"uni_00712","graphicNum":2,"r18GraphicId":"uni_00712_r18","r18GraphicNum":2,"spineId":"Chr_0560"}}