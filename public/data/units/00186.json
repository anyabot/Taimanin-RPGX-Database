9,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"待たせたな。このあたい、セラステス様の参上だ！　この新しくガメてきた銃。どうだ強そうだろぉ？　ガンガン暴れ回ってやるぜッ！！","en":"Sorry to keep you waiting. Here I am, Cerastes-sama, making an entrance! Check out this brand-new gun I just snagged. Looks strong, huh? I'm gonna go on a rampage!!"},"clip":"Audio/Voice/uni00186_1/uni00186_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"見ろよコレ、新しく手に入れた武器！！　その名も“サメガン”だ！　どうだ、カッコイイだろぉー！","en":"Look at this, the new weapon I got!! It's called the \"Shark Gun\"! How cool is that—right?"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"この“サメガン”は、剣にも銃にもなる。喰らえぇ！！　必殺、サメ・ビィィィームッ！！","en":"This \"Shark Gun\" can be a sword or a gun. Take this!! Special attack, Shark Beam!!"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あぁン？　なにビビってんだよ。あたいとこの銃がありゃ、怖いもんナシだろぉが","en":"Huh? What are you scared of? With this gun of mine, there's nothing to fear, right?"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"いいぜこの衝撃、ビリビリ来るッ！　この電磁砲の威力マジハンパねぇよ！！　サイッコォーッ！！","en":"This shock's great, it zaps! The power of this railgun is seriously off the charts!! So awesome!!"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"スコープなんてチャチなモンいらねぇよ。あたいの狙いなら、百発百中ってヤツさ！","en":"I don't need some cheap scope. With my aim, it's a hundred-percent hit!"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いいだろ。この新しい武器。オマエにもこの良さがわかるかなぁ？　わかんねぇだろうなぁー","en":"Nice, huh? This new weapon. I wonder if you can feel how good it is? You probably can't, huh—"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"こら、勝手に触るな！　このサメガンは、その辺の量産品とは違ぇーんだからよぉ？","en":"Hey, don't touch it without permission! This Shark Gun isn't like those mass-produced ones, you know?"},"clip":"Audio/Voice/uni00186_1/uni00186_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00186_1/uni00186_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audi