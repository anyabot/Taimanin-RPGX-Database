敵１体に特大威力で攻撃、与えたダメージの一部で自身のHPを大回復する"}},{"level":4,"sp":335,"detail":{"ja":"敵１体に特大威力で攻撃、与えたダメージの一部で自身のHPを大回復する"}},{"level":5,"sp":330,"detail":{"ja":"敵１体に特大威力で攻撃、与えたダメージの一部で自身のHPを大回復する"}}],"effects":[{"text":"1 enemy: 600% Superhuman damage","tag":"instant"},{"text":"1 enemy: heal self for 40% of damage dealt","tag":"modifier"}]}},"leader":{"name":{"ja":"鮮血の対魔忍"},"detail":{"ja":"超人属性ユニットのDEFを大アップ"},"effects":[{"text":"Superhuman allies: DEF +20%","icon":"def_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私はツバキ。姓は、捨てたわ。理由は聞かないで。ただツバキと、そう呼んで頂戴","en":"I am Tsubaki. I threw away my surname—don't ask why. Just call me Tsubaki."},"clip":"Audio/Voice/uni00201_1/uni00201_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"言っておくけれど、私がここにいるのは秘密よ？　もし、ばらしたりなんかしたら……わかってるわね？","en":"Let me make it clear: my being here is a secret, okay? If you go blabbing about it… you know what'll happen, right?"},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"聞けばなんでも答えてくれるなんて、思い上がりよ？　世の中には、わからないことの方が多いの","en":"Thinking I'll answer anything you ask is arrogant, you know? There are far more things you can't know in this world."},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私があなたと一緒にいるのは、興味があるから。本当に、それだけ","en":"I'm with you because I'm interested. That's really all there is to it."},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"……何かしら？　考え事をしていて、聞き取れなかったわ。もう一回言ってくれる？","en":"…What? I was lost in thought and missed that. Say it again?"},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"甘い考えは嫌いよ。生き残るためには、情に縛られず、無慈悲でないといけないわ","en":"I hate naive ideas. To survive, you can't be bound by sentiment; you have to be merciless."},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"さっきは、よくあんなに出したわね。年頃の男子は、みんなそうなの？　それとも、あなたが特別なのかしら？　ふふっ……","en":"You really gave it your all earlier. Is that how all teenage boys are? Or are you special? Heh…"},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あなたの血、とても面白いわ。また気が向いたら、気持ちいいことをしてあげるわよ？","en":"Your blood is fascinating. When I feel like it, I'll do something that'll feel good for you, okay?"},"clip":"Audio/Voice/uni00201_1/uni00201_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00201_1/uni00201_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0127_1_r18"],["chr_0127_2_r18"]],"stills":[["chr_0127_1a_r18"],["chr_0127_2a_r18"]],"obtain":[{"kind":"event","type":"Map event","title":{"ja":"Map event #6","en":"Map event #6"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"origin":"Event","art":{"graphicId":"uni_00201","graphicNum":2,"r18GraphicId":"uni_00201_r18","r18GraphicNum":2,"spineId":"Chr_0127"}}