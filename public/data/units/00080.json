47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"米連所属、レティシア・ベルメールだ。命令によりこれより行動を共にさせて貰う。異論は無いな？","en":"This is Laetitia Bellmer of the US forces. By order, we'll be operating together from now on. No objections?"},"clip":"Audio/Voice/uni00080_1/uni00080_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おい、早く何をするのか指示をよこせ。私も暇なわけではない","en":"Hey, hurry up and give me the orders. I'm not exactly idle."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"機械みたいだと？　ふん、兵士としては誉め言葉でしかないな","en":"Like a machine, huh? Hmph, that's just a compliment for a soldier."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"軍でもセクハラは問題になっていた。まさか、こんなところで自分が体験するとは思わなかったがな","en":"Even the military had issues with sexual harassment. Never thought I'd experience it here."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ううん……あ、いや、特に指示もない状態にあまり慣れていないんだ","en":"Uh… no, actually I'm not used to having no orders."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私と話しをしたいと言われても特に話すこともない……お前は変わっているな","en":"If you want to talk to me, there's not much to say… you're odd."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"すべては軍の命令だ。魔族を殲滅する。それに反さぬのであれば、私は戦う","en":"Everything's a military order: eradicate the demons. As long as it doesn't contradict that, I'll fight."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私は兵士だ、命令があればそれに従うまで。例えそれがどんな命令であろうとな","en":"I'm a soldier; I'll follow any command, no matter what it is."},"clip":"Audio/Voice/uni00080_1/uni00080_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00080_1/uni00080_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"