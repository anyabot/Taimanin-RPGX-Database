blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00020",8],[41,"evo00023",32],[41,"evo01016",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00020",8],[46,"evo00023",32],[46,"evo01016",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"我が名はイシュタル。お前の様なただの人間が淫魔族の大幹部である私を従えると？　ふん、身の程を知れ","en":"My name is Ishtar. You think a mere human like you can command me, a high-ranking officer of the demon tribe? Ha, know your place."},"clip":"Audio/Voice/uni07016_1/uni07016_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"淫魔の王に相応しいのは幻夢卿の血を引く純粋な淫魔族であるべきだ。血統を無視するなど言語道断","en":"The one worthy of being the king of the demons should be a pure-blooded demon, descended from Kamadeva's bloodline. Ignoring bloodlines is unthinkable."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"人間界に来ている淫魔族は多いが……なんだこの体たらくは","en":"There are many demons in the Human Realm, but... what's with this state of affairs?"},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"人の欲求は浅ましく膨大だ。さらには際限無く増えるとくれば、淫魔族にとって実に都合の良い存在だ","en":"Human desires are shallow and vast. And they just keep growing without limit - it's a convenient existence for us demons."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お前の様な力もなく冴えない人間となれ合う淫魔族がいるだと？　不愉快以外の何物でもないな","en":"You're saying there are demons who associate with weak and insignificant humans like you? It's nothing but unpleasant."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"対魔忍……あの幻影の魔女もそうだが、我らに刃向かう忌々しい存在だ","en":"The Taimanin... that phantom witch is the same - they're detestable beings that dare to oppose us."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"下等な人であろうと血の繋がりは無視出来ぬ。それが高貴なる淫魔の王ともなれば……な","en":"Even if they're inferior, blood ties can't be ignored. And if that person is to become the king of the noble demons... well."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"幻夢卿の血を引く者を時期王へと推す……それが私の使命","en":"My mission is to support those with Kamadeva's bloodline and make them the king... that's my duty."},"clip":"Audio/Voice/uni07016_1/uni07016_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07016_1/uni07016_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","i