3,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"待たせたなっ！　子供達のヒーロー、ジェネラルハロウィン・ルネ！　見参！　どうだ、かっこいいだろぉー？","en":"You've been waiting, huh! The kids' hero, General Halloween Rene! I'm here! How's that, pretty cool, right?"},"clip":"Audio/Voice/uni00251_1/uni00251_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ねぇねぇ、暇ならちょっと見てほしいんだけど……こっちのポーズと、こっちのポーズ……どっちがかっこいいと思う？","en":"Hey hey, if you're free, could you take a look… this pose or that pose… which do you think looks cooler?"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふぁぁ、眠たいなぁ……。ちょっとだけ寝るから、ご飯の時間になったら起こしてね？","en":"Ugh, so sleepy… I'm just gonna nap a bit, so wake me up when it's time to eat, okay?"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あの……お茶、一緒に飲む？　……か、勘違いしないでよ！　セシリアがいないからあんたを誘っただけなんだからね","en":"Um… want to have tea together? …D-Don't get the wrong idea! I only invited you because Cecilia's not here, got it?"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"嵐と共にやってきた……違うな。この世を照らす一筋の希望の光……これも違う。あー、かっこいい登場の台詞が全然まとまらない！","en":"I came with a storm… no, that's not it. A single beam of hope lighting this world… nope, that's wrong too. Ah, I can't get a cool entrance line together!"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"……ん？　……んんん？　こ、こらぁ！　ほっぺたぷにぷにしないでよぉ！　もう！","en":"…huh? …hmm? Hey! Don't squeeze my cheeks! Enough!"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この世に蔓延る悪を殲滅する、ジェネラルハロウィン・ルネ、参上！　子供達を泣かす奴らは、この私が許さないぞー！","en":"To eradicate the evil spreading in this world, General Halloween Rene, is here! I won't let anyone make kids cry!"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"んんっ……んー……もう！　ぷにぷにするな！　なでなでするなぁ！　仕返ししてあげるからお腹出しなさい！","en":"Ugh… enough! Stop the squishy! Don't pet me! I'll get you back, so show me your belly!"},"clip":"Audio/Voice/uni00251_1/uni00251_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00251_1/uni00251_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00251_