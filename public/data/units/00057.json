00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「この私と取引？　ハンッ、いい度胸ね。なら、殺されたい奴を連れてきな！」","en":"A deal with me? Hah, you've got some nerve. Then bring me the ones who want to be killed!"},"clip":"Audio/Voice/uni00057_1/uni00057_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"人も魔族も差別なんてしない。みんな同じ。平等に『紙クズ』よ","en":"I don't discriminate between humans and demons. They're all the same. Equal… \"paper scraps.\""},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私にとって殺しは何より価値があるもの。セックスを超える最高の快楽なのよ","en":"To me, killing is more valuable than anything. It's the ultimate pleasure, even beyond sex."},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"生まれた瞬間から私の傍にあったのは暴力だった。その次に見たのは、死","en":"From the moment I was born, violence was by my side. The next thing I saw was death."},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"何人殺したかって？　お前は今まで食べたパンの数がわかるっていうの？","en":"You ask how many I've killed? Do you expect me to know the number of loaves of bread you've eaten?"},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私のナンバーの意味？　知りたいなら米連の奴らに聞けばいい。最も、知ってそうな奴はみんな殺したけど","en":"The meaning of my number? If you want to know, ask the US officials. The ones who'd know the most? I've killed them all."},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"女が女らしくして何の意味があるの？　私は死ぬまでこのままよ。……多分ね","en":"What's the point of a woman acting like a woman? I'll stay like this until I die… probably."},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"人殺しに違いなんて無い。親の仇だろうが快楽殺人だろうが、殺しは殺し","en":"There is no difference in killing. Whether it's avenging a parent or a pleasure kill, a kill is a kill."},"clip":"Audio/Voice/uni00057_1/uni00057_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00057_1/uni00057_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"t