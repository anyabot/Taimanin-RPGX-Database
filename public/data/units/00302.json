00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"こんにちは。私は、呪われた魔女・カテジナ。……もし、私の噂を聞いたことがあるのなら……それは全て真実ですよ","en":"Hello. I am the cursed witch, Catejina… If you've heard rumors about me… they're all true."},"clip":"Audio/Voice/uni00302_1/uni00302_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"これ、作ってみたんです。糸電話。……ほら、私に近づくとあなた呪われてしまいますから。これを使えば少し繋がれた気分になりませんか？","en":"I made this. A string telephone… See, if you get close to me you'll be cursed. Using this, don't you feel a little more connected?"},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"それは私だって……あなたにぎゅっとしたりぎゅっとされたりしたいです。しませんけど……","en":"Even I… want to hold you tightly, be held tightly. But I won't…"},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あ、これは魔導書です。……いえ、私の呪いが解ける方法があったりしないかな、と思いまして……","en":"Ah, this is a grimoire… I was wondering if there might be a way to break my curse…"},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"どうしたんです？　……あぁ、そんなことが……慰めにもなりませんが、せめて心だけでも寄り添わせて下さい","en":"What's wrong? …Ah, that… It won't comfort you, but at least let me keep my heart close to yours."},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"降りかかる火の粉を振り払う為の鞭ですが……使わないでいられたらそれが何よりなのに……","en":"It's a whip to shake off falling sparks… If I could just not use it, that would be best."},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この距離が心の距離であると思わないで下さい。心はもっと、あなたのお傍にいるのです","en":"Don't think this distance reflects the distance of our hearts. My heart is much closer, right by you."},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"いけませんよ、それ以上は。……全く、あなたは命知らずで私の方がハラハラしてしまいます","en":"You mustn't go any further… Good grief, you're reckless and it makes me nervous."},"clip":"Audio/Voice/uni00302_1/uni00302_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00302_1/uni00302_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,