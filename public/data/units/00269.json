大アップ、敵１体に特大威力で攻撃する"}}],"effects":[{"text":"1 enemy: 616% Superhuman damage"},{"text":"Before attacking: Self: crit rate +40 for 4 turns","icon":"crt_up"}]}},"leader":{"name":{"ja":"心酔乙女"},"detail":{"ja":"超人属性ユニットのHPをターン終了時に極小回復する"},"effects":[{"text":"Superhuman allies: restore 4% HP at end of turn","icon":"Healing_hp"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"黒田巴です、どうぞお見知りおきを。我が家の――いえ、蓮魔先生に鍛えられたこの剣技で、お役に立ってみせます","en":"I'm Kuroda Tomoe, nice to meet you. I'll show you my skills, honed by Hasuma Reiko, and prove myself useful."},"clip":"Audio/Voice/uni00269_1/uni00269_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"なんですか、その制服の着崩しは……ボタンは上まで留めて、裾はズボンにしまうように！","en":"What's with that sloppy uniform? Button it up all the way and tuck the hem into your pants!"},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"遅刻、早退、欠席、サボり……よくぞここまで……呆れを通り越して、感心さえしてしまいますね","en":"Tardiness, leaving early, absenteeism, slacking off... you've made it this far, I'm impressed, or rather, astonished."},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"その弛んだ性根、少し鍛え直してあげましょう。さぁ剣を取りなさい、訓練を始めますよ！","en":"Let's whip that lackluster spirit into shape. Take up your sword, training starts now!"},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あ、蓮魔先生！　相変わらず凛として、素敵な立ち振る舞い……私もいつか、あんな対魔忍に――","en":"Ah, Hasuma Reiko! As always, so poised and elegant... I hope to become a Taimanin like her one day."},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"はぁっ！？　蓮魔先生を知らないんですか！？　あんな素敵な先生を知らないなんて、人生の半分以上を損しています！","en":"You don't know Hasuma Reiko? You're missing out on half your life! Not knowing such an amazing instructor is a shame."},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"見習いだと侮っていると、痛い目を見ますよ。私の剣はどこまでも届きます――どこまでも、遠くへ","en":"Don't underestimate me just because I'm a trainee. My sword can reach far - and I mean far."},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"は、蓮魔先生！　よろしければ、お荷物をお運びしますっ……その、あとで……個人指導を、お願いできますか……？","en":"Hasuma Reiko, if it's alright with you, I'd like to carry your luggage... and, uh, maybe have some personal training later?"},"clip":"Audio/Voice/uni00269_1/uni00269_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00269_1/uni00269_1_evo_1.ogg"},{"type":"evo","label":"Awakening",