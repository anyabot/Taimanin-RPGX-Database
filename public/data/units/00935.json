15",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"九摩羅ジュンよ。諜報や戦略を練ることなら任せてちょうだい。前線に出るのではなければ役に立ってみせるわ","en":"Kumara Jun here. If it's gathering intel or planning strategy, leave it to me. As long as I'm not on the front lines, I'll prove useful."},"clip":"Audio/Voice/uni00935_1/uni00935_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あら、何か情報が欲しいのかしら。私なら、誰の、どんな情報だって探ってみせるわよ","en":"Oh? Looking for some info? I can dig up anyone's, whatever kind of info you want."},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"いらっしゃい。将棋やチェスでもする？　もちろんボードゲームでもいいわよ？","en":"Welcome. Want to play shogi or chess? Of course a board game works too."},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"クロスワードの答えを検索したりするのは何だか負けた気になるのよね……","en":"Searching for crossword answers feels like admitting defeat…"},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"トレーニングってあまりすぎじゃないのよね。ほら、私って頭脳担当でしょう？","en":"Isn't training a bit much? Come on, I'm the brains, after all."},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私って肩こりがすごくて……。良かったら、誰か揉んでくれないかしら","en":"My shoulders are terrible… If anyone wants to give them a rub, I wouldn't mind."},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ふふっ、情報を探るのは楽しいわね。敵の情報も味方のプライベートも、全部私が抜いてみせるわ。もちろん、あなたのヒミツも……ね？","en":"Hehe, digging up info is fun. Enemy intel, allies' private lives, I'll pull them all. And of course, your secret… too?"},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あら、この情報に興味あるの？　そうね……かわりにあなたのことを色々教えてくれれば、特別に教えてあげるわ","en":"Ah, interested in this info? Hmm… if you tell me all about yourself, I'll share it specially."},"clip":"Audio/Voice/uni00935_1/uni00935_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"んはぁ……っ。オナニーをしても全然足りないわ……。だから、あなたのオチンチン、貸してくれる……？","en":"Mmm… even after masturbating I'm still not satisfied… So, could you lend me your… you know?"},"clip":"Audio/Voice_r18/uni00935_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"もう、人の姿を見てそんなに勃起しちゃって……。いいわよ、検索した知識を全部その身体で試させてくれるのなら……ね","en":"Seriously, just seeing a person gets you all hard… Fine, if you'll let me test every piece of knowledge I've searched with that body of yours… okay?"},"clip":"Audio/Voice_r18/uni00935_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"あはんっ、すごい、固くて大きいわ……。セックスは、電脳よりも本物の方がずっと気持ちいいかもぉ……！","en":"Ahh, wow, it's so hard and big… Sex might actually feel better than cyberspace…!"},"clip":"Audio/Voice_r18/uni00935_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00935_1/uni00935_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0783_r18"]],"stills":[["chr_0783a_r18"]],"obtain":[{"kind":"gacha","type":"Pickup","title":{"ja":"ピックアッププレミアムガチャ"},"start":"2025-09-18","end":"2025-09-30"},{"kind":"gacha","type":"Pickup","title":{"ja":"ステップアッププレミアムガチャ"},"start":"2025-09-18","end":"2025-09-30"},{"kind":"spark","title":null,"need":100,"start":"2025-09-18","end":"2025-09-30"}],"standardPool":true,"origin":"Permanent","art":{"graphicId":"uni_00935","graphicNum":2,"r18GraphicId":"uni_00935_r18","r18GraphicNum":2,"spineId":"Chr_0783"}}