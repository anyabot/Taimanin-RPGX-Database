blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00066",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「どんな任務も、必ず完遂してみせよう」","en":"No matter the mission, I'll see it through to completion."},"clip":"Audio/Voice/uni00066_1/uni00066_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"任務とはいえ、娼婦の真似をしていると知ったら弟はどう思うかな？","en":"Even if it's a mission, I wonder what my brother would think if he found out I'm pretending to be a courtesan?"},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私の術は潜入任務にも向いている。諜報活動なら任せてくれ","en":"My techniques are suited for infiltration. Leave the intel work to me."},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私が他の男に抱かれたとしたら、君は……どう思う？","en":"If I were taken by another man, you... what would you think?"},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"な、なんだその目は？　そんなに私の胸が気になるのか……？","en":"W-what's with that look? Are you that fascinated by my chest...?"},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"娼婦の振る舞いは学んだが、少し不安だな。君で試しても良いか？","en":"I've learned the ways of a courtesan, but I'm a bit uneasy. May I try it on you?"},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"任務とはいえ、嫌な思いをしなくてすむならその方がいい","en":"Even if it's a mission, it'd be better to avoid any unpleasant feelings."},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"くっ……まさか、私が娼婦の真似事をすることになるなんて","en":"Ugh... I never thought I'd have to act like a prostitute."},"clip":"Audio/Voice/uni00066_1/uni00066_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00066_1/uni00066_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"