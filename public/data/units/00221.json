,[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"対魔忍、槇島あやめ。これより単独での潜入任務に入ります。大丈夫、必ず戻るわ","en":"Taimanin Makishima Ayame. I'm now embarking on a solo infiltration mission. Don't worry, I'll definitely come back."},"clip":"Audio/Voice/uni00221_1/uni00221_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"独りで潜入するのはお手の物だけれど、紅様のそばを離れるのは少し不安ね","en":"Going in alone is a piece of cake, but being away from Lady Kurenai makes me a bit uneasy."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あら。この服が気になるの？　ふふ、女としての武器を使わない手はないでしょう？","en":"Oh? Curious about this outfit? Hehe, there's no reason I wouldn't use my feminine charms as a weapon."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"娼婦のふりをして潜入ね……この程度の汚れ役、なんてことはないわ","en":"Pretending to be a prostitute for infiltration… a dirty role like this is nothing to me."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"持ち込める物が少ないから得物は少し頼りないけれど、そこは経験と知識でカバーできるわよ","en":"I can't bring much gear, so my weapons are a bit lacking, but I can cover that with experience and knowledge."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"今回の任務の内容は紅様には秘密よ？　心配をかけてしまうから","en":"The details of this mission are a secret from Lady Kurenai. I don't want to cause her worry."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"敵地に身を潜め情報を得る。対魔忍の大切な仕事の一つよ","en":"I hide in enemy territory to gather intel. That's one of the Taimanin's important duties."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"任務を達成するためなら、例えこの身を穢そうと私は躊躇わない","en":"If it means completing the mission, I won't hesitate to soil myself."},"clip":"Audio/Voice/uni00221_1/uni00221_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00221_1/uni00221_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0142_1_r18"],["chr_0142_2_r18"]],"obtain":[{"kind":"event","type":"Map event","title":{"ja":"Map event #7","en":"Map event #7"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00221","graphicNum":2,"r18GraphicId":"uni_00221_r18","r18GraphicNum":2,"spineId":"Chr_0142"}}