",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"若様、お久しぶりでございますっ、ふうま廻ですぅ！　本日からお傍にお仕えいたしますので、なんなりとお命じくださいませっ！","en":"Ah, Master, it's been a while! I'm Fuuma Mawari. From today on, I'll be serving by your side, so please don't hesitate to give me any orders!"},"clip":"Audio/Voice/uni00426_1/uni00426_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"若様ぁ、どうされましたか？　なにかあれば報告するよう、時子様にも言われておりますから。なんなりと仰ってくださいね？","en":"Master, what's wrong? Fuuma Tokiko told me to report to you if anything happens, so please let me know if there's anything I can do."},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"わわっ、とっ……ふぅ、大丈夫でした。すいません、いつまでもどんくさくって……でも、若様のお邪魔にならないよう、頑張りますので！","en":"W-wait... *huff*... I'm okay. Sorry about that, I'm always so clumsy... But I'll do my best to not be a bother to you, Master."},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"――えっ？　ご存知、だったんですか……はい、そうです。私がよく転んだりするのは、能力の対価で……さすが若様、なんでもお見通しですね！","en":"R-really? You knew that already, Master? Yes, that's right. My clumsiness is a result of my ability's cost... You're perceptive, as always, Master."},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"視界内の動きを遅くする邪眼――そして使用後は、その感覚のズレが、少し残ってしまうんですよね。でもそれも、能力の一部なわけですから","en":"My evil eye ability slows down everyone within my line of sight... and after using it, the sensation of time and space being distorted lingers for a bit. But that's just part of the ability, I suppose."},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この力が、若様のお役に立つのでしたら……これからもたくさん使っていきます。これからも廻を、お傍に置いてくださいませっ！","en":"If this power can be of use to you, Master... I'll keep using it as much as I can. Please keep me by your side, Master."},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"あ、若様だ。おーい、若様ぁ～！　はうぁっ！？","en":"Ah, Master! Hey, Master! *thud*"},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"え、えへへ。へっちゃらです。私もふうまの名に連なる対魔忍なんですから！　ふんす！","en":"Hehe, it's nothing. I'm also a Taimanin, a member of the Fuuma clan, after all! *puffs out chest*"},"clip":"Audio/Voice/uni00426_1/uni00426_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"若様はお見通しなんですね……だったら、私も若様にだけは、甘えちゃいます","en":"You're always so perceptive, Master... In that case, I'll allow myself to be a bit spoiled by you."},"clip":"Audio/Voice_r18/uni00426_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"んぅ、はぁ……あっ、若様っ！？　すいません、気持ちよくて、眠っちゃってました……また、夜伽のご命令……お待ちしていますね、えへへ","en":"Mmm... *yawn*... Oh, Master! Sorry, I dozed off... I'm looking forward to your orders tonight... Hehe."},"clip":"Audio/Voice_r18/uni00426_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"若様……いえ、お、お館様……ですね、ふふっ。私もすっかり、お館様の女として躾けられてしまいました……今宵も、お待ちしております","en":"Master... I mean, my lord... *giggles*. I've been trained to be a proper lady, it seems... I'll be waiting for you tonight."},"clip":"Audio/Voice_r18/uni00426_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00426_1/uni00426_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0298_r18"]],"stills":[["chr_0298a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00426","graphicNum":2,"r18GraphicId":"uni_00426_r18","r18GraphicNum":2,"spineId":"Chr_0298"}}