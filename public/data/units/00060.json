60],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「対魔忍、弓走颯推参！　風遁と弓の腕なら何者にも遅れはとらない」","en":"\"Taimanin, Yubashiri Hayate reporting! With wind-style ninjutsu and my archery skill, I won't fall behind anyone.\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"これからの予定は決まっているか？　私はすぐにでも動けるぞ","en":"\"Do you have the schedule set? I can move right away.\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"弓走家は武門の家系だ！　お嬢様等と言う呼ばれ方は侮辱に等しい、取り消せ！","en":"\"The Yubashiri family is a martial lineage! Being called 'young lady' or the like is an insult—cancel it!\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"なに！？　それはほんと……くっ、冗談だと！？　また騙された！","en":"\"What!? That's really… huh, you were joking!? I've been fooled again!\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"弓走の名に恥じぬ対魔忍になるため、日々の鍛錬は欠かせない。そうだ、お前も一緒にどうだ？","en":"\"To become a Taimanin worthy of the Yubashiri name, daily training is essential. Hey, why don't you join me?\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私もまだまだ精神の鍛錬が足りないな……その様な言葉に揺さぶられるとは","en":"\"I still lack mental training… to be shaken by such words.\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"我が弓走家は代々武門の家柄だ、こと武術においては敗北など許されないのだ！","en":"\"Our Yubashiri line has been a martial house for generations; defeat is unacceptable in combat!\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私が弓が得意なだけのお嬢様だと！？　武人を愚弄しておいて、冗談ではすまされないぞ！","en":"\"You think I'm just a delicate lady good with the bow? Mocking warriors won't be excused as a joke!\""},"clip":"Audio/Voice/uni00060_1/uni00060_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00060_1/uni00060_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text