39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00161",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00161",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"“花の静流”こと高坂静流です。どうですいい香りでしょう？　チョコレートに薔薇のフレーバーを足してみました。よろしくお願いしますね♪","en":"\"I'm 'Flower Shizuru' Kousaka Shizuru. How's that scent? I added rose flavor to chocolate. Nice to meet you♪\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"もうすぐバレンタインデー。ねえ知っていて？　西洋では男の人からも、好きな女性にチョコをプレゼントするのよ","en":"\"Valentine's Day is coming up. Did you know? In the West, men also give chocolates to the women they like.\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ここは学園なんだから、私のことは『先生』と呼びなさいっ！　もう。他の人が聞いてたら、どうするのぉ","en":"\"This is the Academy, so call me 'Sensei'! Seriously. What would happen if the others heard you?\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"また先生の胸やお尻をジロジロ見てたでしょう？　もう……メッ！　ですよっ♪","en":"\"You were staring at Sensei's chest and hips again, weren't you? Geez… *tch*!\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"チョコレートの甘い香りがするわねぇ。誰ですか、教室にチョコを持ってきた人はー？　先生が食べちゃいますよぉー","en":"\"I can smell the sweet scent of chocolate. Who brought chocolate to the classroom? Sensei will eat it~\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"えぇ、先生にチョコレートですか？　まあ、ありがとう。……うーん。でもまたちょっと太っちゃうかしら？","en":"\"Chocolate for Sensei? Well, thanks… hmm. But I might gain a little weight again?\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"バレンタインデーって、どこからか甘いイイ香りがするわねぇ。……アラ。授業中に食べちゃダメよ？","en":"\"Valentine's Day always brings a sweet scent from somewhere… Ah, you shouldn't eat it during class, okay?\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"先生に黙ってチョコレートを食べるなんて。もう！　……甘い匂いがするから、すぐにわかっちゃうわ♪","en":"\"You ate chocolate without telling Sensei. Ugh! …I can tell right away from the sweet smell♪\""},"clip":"Audio/Voice/uni00161_1/uni00161_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00161_1/uni00161_1_lup_