00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00290",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00290",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00290",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00290",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00290",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00290",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"五車学園の生徒会長、八津紫だ。急にいなくなったさくら――友人を探しているのだが、心当たりはないか？","en":"I'm Yatsu Murasaki, student council president of Gosha Academy. Sakura disappeared suddenly—I'm looking for my friend; have you heard anything?"},"clip":"Audio/Voice/uni00290_1/uni00290_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"若い、だと？　妙なことを言うな……まだ学生なのだから、若く見えて――というか、若いのは当然なのだが……","en":"You say I'm young? That's a strange thing to say… I'm still a student, so I look young—well, it's only natural that I'm young…"},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私の名は紫。行方不明になった友人を探して、旅をしている。私はどうでもいいのだが、彼女のお姉さまが、異常に心配していらしてな……","en":"My name is Murasaki. I'm traveling to find a missing friend. I don't really care, but her older sister is unusually worried…"},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"なにか手がかりを見つけたら、すぐに報告してくれ。特徴――そうだな……いつも幸せそうな、マヌケ面を晒しているはずだ","en":"If you find any clue, report it to me right away. As for her description… let's see… she always shows that happy, goofy face."},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"友人の名前？　彼女は井河さくら――強く美しいお姉さまと違い、能天気な阿呆だ。まぁ、あいつなりにいいところはあるがな","en":"Her name? She's Igawa Sakura—unlike her strong, beautiful older sister, she's a carefree fool. Well, she does have her own good points, though."},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"見たところ、お前は鍛え方が足りないようだな……世話になっている礼だ、鍛錬に付き合ってやろう。なに、遠慮はいらんぞ、さぁ構えろ","en":"Looks like your training's lacking… Consider this a favor; I'll train with you. No need to hold back, get ready."},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"忍法・不死覚醒――これで回復せぬ負傷はない。さぁ続けるぞ――私はまだまだ、戦えるっ……","en":"Ninjutsu: Undying Awakening—no wound can't heal now. Let's keep going—I'm still more than capable of fighting…"},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"こ、ここ、これはっ……アサギお姉さまがお召しになった、ブブ、ブブ……ブラウスッ……いや、ダメだ、もし知られたら……だが、しかし――","en":"Th-this… this is… Asagi-onee-sama's… uh, uh… blouse… No, I can't… if anyone finds out… but still—"},"clip":"Audio/Voice/uni00290_1/uni00290_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00290_1/uni00290_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/u