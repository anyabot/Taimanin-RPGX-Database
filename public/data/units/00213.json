"ja":"敵１体に特大威力で攻撃、DEFを中ダウンする"}},{"level":4,"sp":330,"detail":{"ja":"敵１体に特大威力で攻撃、DEFを中ダウンする"}},{"level":5,"sp":330,"detail":{"ja":"敵１体に特大威力で攻撃、DEFを中ダウンする"}}],"effects":[{"text":"1 enemy: 616% Devilish damage","tag":"instant"},{"text":"1 enemy: DEF -30% for 4 turns","icon":"def_down","tag":"debuff"}]}},"leader":{"name":{"ja":"忍法【血流狂薬】"},"detail":{"ja":"魔性属性ユニットの最大HPを大アップ"},"effects":[{"text":"Devilish allies: Max HP +20%","icon":"hp_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"……あン、ボク？　ボクは柳六穂、対魔忍。……それ以上なんか聞きたいことあるー？","en":"…Um, me? I'm Yanagi Mutsuho, a Taimanin. …Anything else you want to know?"},"clip":"Audio/Voice/uni00213_1/uni00213_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あーあ、メンドくさー。……んぁ、どうかしたの？","en":"Ah, what a hassle… Hey, what's up?"},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ちょっとぉ。さっきからボクの方ばっか見ちゃって。なんか用ぉー？","en":"Hey… you've been staring at me forever. Got something you need?"},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"こっちだって忙しいんだからさぁ、面倒事は増やさないでよねー？","en":"I'm busy too, you know. Don't go adding more trouble, okay?"},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"……卑怯ぉ？　ナニそれ。対魔忍相手にして言うことがそれ？　幾らなんでもマヌケ過ぎるでしょ！","en":"…Coward? What's that supposed to mean? Talking like that to a Taimanin? That's just plain stupid!"},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ちょっとぉ。用もないのに、突っつかないでくんない？","en":"Hey, stop poking me when you have nothing to say."},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ボクに幾ら斬りつけてもムダだよ？　最後に立ってるのはこのボクさ。試してみるぅ……？","en":"No matter how much you slash at me, it's useless. I'm the one still standing. Want to try?"},"clip":"Audio/Voice/uni00213_1/uni00213_1_hom_6.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00213_1/uni00213_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","v