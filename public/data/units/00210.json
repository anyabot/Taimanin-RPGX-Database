"1 enemy: SPD -15% for 4 turns","icon":"spd_down","tag":"debuff"}]},"240006":{"slot":"ultimate","id":240006,"name":{"ja":"秘技・バーニングサマー"},"hits":4,"cutin":true,"levels":[{"level":1,"sp":280,"detail":{"ja":"敵１体に超特大威力で攻撃、自身に中威力のダメージ"}},{"level":2,"sp":280,"detail":{"ja":"敵１体に超特大威力で攻撃、自身に中威力のダメージ"}},{"level":3,"sp":280,"detail":{"ja":"敵１体に超特大威力で攻撃、自身に中威力のダメージ"}},{"level":4,"sp":280,"detail":{"ja":"敵１体に超特大威力で攻撃、自身に中威力のダメージ"}},{"level":5,"sp":280,"detail":{"ja":"敵１体に超特大威力で攻撃、自身に中威力のダメージ"}}],"effects":[{"text":"1 enemy: 820% Natural damage","tag":"instant"},{"text":"Self: take 30% of max HP as damage","tag":"instant"}]}},"leader":{"name":{"ja":"褐色女帝のビーチ"},"detail":{"ja":"自然属性ユニットのATKを小アップ+SPDを極小アップ"},"effects":[{"text":"Natural allies: ATK +10%","icon":"atk_up","tag":"passive"},{"text":"Natural allies: SPD +8%","icon":"spd_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00210",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00210",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00210",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00210",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00210",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00210",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00210",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"今日は休暇の予定だったが……ちょうどいい、お前に付き合ってやるとしよう","en":"I had a day off planned, but… perfect, I'll keep you company."},"clip":"Audio/Voice/uni00210_1/uni00210_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こんな状況でも気を緩めすぎるな。油断は死に直結する、常に意識しておけ","en":"Even in a situation like this, don't let your guard down. Carelessness leads straight to death, stay alert."},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"……この水着か？　部下の女たちが選んだものだ、問題はないと思うが……なにか気になるのか？","en":"…This swimsuit? The girls under my command picked it out; I don't see a problem… Is something bothering you?"},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"スイカ割り？　ふん、くだらん……なに？　割る自信がないのか、だと……いいだろう。魔剣ダークフレイムの冴え、拝ませてやる","en":"Watermelon-smashing? Hmph, childish… What? You don't have the confidence to break it? Fine. Let me show you the brilliance of my Dark Flame sword."},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"たまの休暇だというのに、周囲の目がわずらわしいな……おいお前、人気のない場所を知らんか？","en":"Even on a rare day off, the eyes of others are a nuisance… Hey, you, know any place without crowds?"},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"……おい、そのいやらしい目をやめろ。胸ばかり凝視するな、あと脚もだ、まったく……こら、尻もだ！","en":"…Hey, cut that lewd stare. Stop just staring at my chest, and my legs too—good grief… and my butt!"},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どこにいようと、どんな格好だろうと、私は身も心も魔界騎士だ……浮ついた気持ちなどない、本当だぞ","en":"No matter where I am or what I'm wearing, I'm body and soul a Demon-Realm Knight… I have no frivolous feelings, that's the truth."},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"たまにはこうして……日差しを浴びるというのも、なかなか……悪くはないな","en":"Sometimes, like this… basking in the sunlight isn't so bad, actually."},"clip":"Audio/Voice/uni00210_1/uni00210_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00210_1/uni00210_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0132_1_r18"],["chr_0132_2_r18"]],"stills":[["chr_0132_1a_r18"],["chr_0132_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"gacha","type":"Pickup","title":{"ja":"【復刻】ピックアップガチャ"},"start":"2025-06-30","end":"2025-07-16"},{"kind":"gacha","type":"Pickup","title":{"ja":"【復刻】サマーピックアップガチャ"},"start":"2026-07-08","end":"2026-07-15"},{"kind":"spark","title":null,"need":300,"start":null,"end":null}],"standardPool":false,"art":{"graphicId":"uni_00210","graphicNum":2,"r18GraphicId":"uni_00210_r18","r18GraphicNum":2,"spineId":"Chr_0132"}}