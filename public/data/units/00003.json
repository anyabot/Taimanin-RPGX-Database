",5],[41,"blo00003",25],[41,"ubl00003",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00003",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ニャニャ！　ボクを養ってくれるのかニャ？　やったー！　これでお魚に困らないニャ～！」","en":"Nya nya! You're gonna feed me, nya? Yay! Now I won't run out of fish, nya~!"},"clip":"Audio/Voice/uni00003_1/uni00003_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ニャ～……お腹すいたニャ～。お魚にネコ缶にかつおぶし……ハァ、食べたいニャぁん……","en":"Nya~… I'm hungry, nya~. Fish, cat food, katsuobushi… ha, I want to eat, nyaaa…"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ん～、今日もいい天気ニャ～♪　何かいい事ありそうニャ～♪","en":"Nya~, today's weather's purrfect, nya~♪ Something good's gonna happen, nya~♪"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"早く連れてってニャ～。ボク、待ちくたびれて死んじゃうニャ～","en":"Take me quickly, nya~. I'm getting bored waiting and might die, nya~"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"くんくんくん……むむっ！　この匂いは……おさかな！！","en":"Sniff sniff sniff… mmm! This smell… fish!!"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"くんくんくん……むむぅッ！　この匂いは……カリカリ！！","en":"Sniff sniff sniff… mmm! This smell… kibble!!"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"すやすや……ニャ？　ふわぁ～。暇すぎて寝てたニャー……","en":"Sleepy… Nya? Fluffy~. I'm so bored I fell asleep, nya~"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふニャ……今日もコタツで丸くなるニャー……ニャ？　お前も一緒に丸くなるかニャ？","en":"Funya… gonna curl up in the kotatsu again, nya~… Nya? Want to curl up together, nya?"},"clip":"Audio/Voice/uni00003_1/uni00003_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00003_1/uni00003_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni000