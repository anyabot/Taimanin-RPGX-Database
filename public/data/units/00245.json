"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふふ……この獄炎の前に立つだなんて、勇気のある子……熱い抱擁で、骨まで焼き蕩かしてあげるわ……ほら、いらっしゃい？","en":"Heh… standing before this infernal flame takes some guts… I'll give you a scorching embrace that'll burn you to the bone… Come on, step right up?"},"clip":"Audio/Voice/uni00245_1/uni00245_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"今日も退屈だこと……ねぇ、一緒に遊びましょう？　ほら、本気で遊ばないと焼け死んでしまうわよ？","en":"Another boring day… Hey, want to play together? Come on, if you don't play for real you'll get burned to death."},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私が地上にやってきた理由？　聞いても詮無いことよ……まぁ、あなたというペットを見つけたのは僥倖だったわね","en":"Why I came to the surface? It's pointless to ask… Well, finding a pet like you was just lucky."},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ちょっと脚を揉んでくれないかしら。あら、急に目が生き生きとしてきたじゃない……その先を望むなら、丹念に揉むことね","en":"Could you give my legs a little rub? Oh, you're looking all lively now… If you want more, you'll have to knead them carefully."},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"……あなたにも才能があったのね、驚きだわ。指揮能力？　違うわ……マッサージの才能よ。次は別の場所も揉ませてあげるわ","en":"…You actually have talent, I'm surprised. Command ability? No… a talent for massage. Next time I'll let you knead somewhere else."},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ここにいれば退屈も紛れるし、あいつがなにを考えているのか、情報も手にしやすいわ……しばらく身を置かせてもらうわよ、ボウヤ","en":"Staying here kills the boredom, and it's easy to get info on what that guy's thinking… I'll hang around for a while, you brat."},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"さぁ、もっと強くなってちょうだい……私の退屈を紛らわせられなければ、燃え尽きて死ぬだけよ。あなたも、あなたの仲間も――","en":"Now, get stronger… If you can't ease my boredom, you'll just burn out and die. You and your comrades—"},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふふっ、強い男は好きよ……戦いだけでなく、ベッドの上でも強ければなおさら……ね","en":"Heh, I like strong men… Not just in battle, but even in bed, the stronger the better… right?"},"clip":"Audio/Voice/uni00245_1/uni00245_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00245_1/uni00245_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0156_1_r18"],["chr_0156_2_r18"]],"obtain":[{"kind":"event","type":"Story event","title":{"ja":"Story event #9","en":"Story event #9"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00245","graphicNum":2,"r18GraphicId":"uni_00245_r18","r18GraphicNum":2,"spineId":"Chr_0156"}}