],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"フォルシアです、また呼んでいただけたなんて、嬉しいです……戦闘は苦手ですけど、お役に立てるように頑張りますね","en":"It's Faurecia. I'm glad you called me again... I'm not good at fighting, but I'll do my best to help."},"clip":"Audio/Voice/uni00345_1/uni00345_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"隊長さん……あ、任務の準備ですか。気をつけてくださいね、無事をお祈りして――えっ、私も行くんですかっ！？","en":"Captain... ah, preparing for the mission? Take care, I pray for your safety—huh, I'm going too!?"},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あまり力を使うと、反動が……そのときは守ってやる、ですか……？　わかりました、それなら……頑張れる気がします♪","en":"If I use too much power, there's recoil... so you want me to protect you then...? Got it, in that case... I think I can do my best♪"},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"今日はお休みですね。せっかくですから、一緒になにかしましょう？　そうですね……お天気もいいですし、ひなたぼっこなんてどうでしょうか","en":"It's a day off today. Since it's a rare chance, shall we do something together? Hmm... the weather's nice, how about a sunbathing?"},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あ……あっちの道、危ない感じがしますね……こっちから行きましょう。えっ、ま、待って、どうしてそっちに行くんですか！　もうっっ！","en":"Ah... that road over there looks dangerous... let's go this way. Huh, w-wait, why are you going that way!?! Jeez!"},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"はうぅぅぅ、怖かったです……もう無理です、今日は帰れません……隊長さんのおうちに、泊めてもらいますからぁっ……","en":"Haa... that was scary... I can't... I can't go home today... I'll stay at your house, Captain..."},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"このまま平穏に、人間さんと一緒に暮らしていきたいんですけど……やっぱり私には、難しいんでしょうかぁ……","en":"I want to live peacefully like this with humans... but maybe it's too hard for me..."},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"隊長さんにはすっかり助けていただきました……このご恩は、きっとお返しします……あの、なんなら……すぐにでも……身体、で……","en":"Captain, you've helped me so much... I'll definitely repay this debt... um, if you like... right now... with my body..."},"clip":"Audio/Voice/uni00345_1/uni00345_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00345_1/uni00345_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0233_r18"]],"stills":[["chr_0233a_r18"]],"obtain":[{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【超人】"},"start":"2025-04-01","end":"2025-04-30"},{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00345","graphicNum":2,"r18GraphicId":"uni_00345_r18","r18GraphicNum":2,"spineId":"Chr_0233"}}