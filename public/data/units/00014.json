2",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00014",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「沙耶ＮＥＯだよ♪　なんか面白そうだから殺すのは後にして協力してあげる♪」","en":"It's Saya NEO♪ Since it looks fun, I'll hold off on killing and cooperate with you♪"},"clip":"Audio/Voice/uni00014_1/uni00014_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"面倒臭いのは全部あなたに任せるから、面白そうな時だけ呼んでね♪","en":"I'll leave all the hassle to you, so just call me when it looks fun♪"},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"人間のくせに生意気だねあなた。う～ん、もう殺しちゃおうか？","en":"You're so cheeky for a human. Hmm, should I just kill you now?"},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あははは♪　あなた見てるとなんか面白～い♪　あれ？　なんで怒ってるの？","en":"Ahahaha♪ It's kind of fun watching you♪ Huh? Why are you angry?"},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"本なんてつまんないじゃん。それより私と遊ぼうよ～殺し合いとか！","en":"Books are boring, right? Let's play together instead—like a killing match!"},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"男の人がみんなジロジロ見てくるんだよね～しかも前屈みになっちゃって、変なの♪","en":"All the guys keep staring at me, and they end up bending over, it's weird♪"},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私はね、つまらないことが大嫌いなの。だから、頑張って私を楽しませて、さもないと殺しちゃうよ♪","en":"I hate boring stuff. So work hard to entertain me, or I'll kill you."},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"殺したり、気持ちいいことだけしてればいいよね♪　我慢なんかしても良い事ないよ","en":"All we need is killing and feeling good♪ There's no point in holding back."},"clip":"Audio/Voice/uni00014_1/uni00014_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00014_1/uni00014_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00014_1