{"level":5,"sp":330,"detail":{"ja":"味方全体のATKを大アップ、敵１体に特大威力で攻撃する"}}],"effects":[{"text":"1 enemy: 616% Superhuman damage"},{"text":"Before attacking: All allies: ATK +60% for 4 turns","icon":"atk_up"}]}},"leader":{"name":{"ja":"ワルキューレの理"},"detail":{"ja":"部隊全体の最大HPを中アップ"},"effects":[{"text":"All allies: Max HP +15%","icon":"hp_up"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00344",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00344",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00344",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00344",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00344",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00344",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00344",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"これも天帝の意思なれば……いいだろう、お前の配下となろう。この双剣を振るうに値するか、見定めさせてもらうぞ","en":"I'll follow the will of the Heavenly Emperor, it seems... Very well, I'll serve under you. Let's see if you're worthy of wielding these twin swords."},"clip":"Audio/Voice/uni00344_1/uni00344_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ほう、私を恐れず傍へ侍らすか。見た目によらず豪胆さはあるようだな","en":"Hmm, you're not afraid of me and serve by my side. You're bolder than you look, I'll give you that."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"人も魔も関係ない。天帝の理の導くままに、私はここにいる","en":"It doesn't matter if you're human or demon. I'm here, following the Heavenly Emperor's will."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"鬼神乙女よりも強い男……なかなかいないものだ。私もまた出会えずに戦死するのだろうか……","en":"A man stronger than the Oni Goddess... they're hard to come by. I wonder if I'll die in battle without ever meeting one..."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふっ、天帝のご加護を受けたこの肉体、見せつける事はあれど隠す事などありえぬ","en":"Hmph, this body, blessed by the Heavenly Emperor, is not something to be hidden - it's meant to be shown off."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あまり油断しないほうがいいぞ。私はいつでも、お前を見定めているからな","en":"Don't get too complacent. I'm always watching you, sizing you up."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お前には聞こえないのか？　天帝のご意思が、お声が……ふっ、どうやらお前が私の伴侶となる事はなさそうだな","en":"Can't you hear it? The Heavenly Emperor's will, their voice... Hmph, I suppose it's unlikely you'll become my partner."},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私の『固定化』は肉体を鋼よりも硬く強くさせる。……なっ、柔らかくなる事もあるかだと？　そ、それは……この変態め！","en":"My \"fixation\" makes my body harder and stronger than steel... W-what, you think it could also make me softer? T-that's... you pervert!"},"clip":"Audio/Voice/uni00344_1/uni00344_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"はぁぁ……ダーリンはいつ見ても逞しくてカッコイイ……んんっ、発情して、女の部分が出て来ちゃう♪","en":"Haa... my darling is always so strong and handsome... Nnn, I'm getting aroused, and my feminine side is coming out♪"},"clip":"Audio/Voice_r18/uni00344_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"んんっ、いつでも子を孕む準備はできているわ、旦那様♪　強いオスの子を産んで次世代の鬼神乙女を作るのが私の務め","en":"Nnn, I'm always ready to conceive, Master♪ It's my duty to bear the child of a strong male and create the next generation of Oni Goddesses."},"clip":"Audio/Voice_r18/uni00344_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"ち、違うのぉ、シたいのは私がドスケベ女だからじゃなくて、これは天帝の……そう、天帝のご意思だからぁ……","en":"N-no, it's not because I'm a lewd woman... it's because of the Heavenly Emperor's... yes, the Heavenly Emperor's will..."},"clip":"Audio/Voice_r18/uni00344_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00344_1/uni00344_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0232_1_r18"],["chr_0232_2_r18"]],"stills":[["chr_0232_1a_r18"],