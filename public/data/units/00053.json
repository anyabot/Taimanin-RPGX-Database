00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00053",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「私を仲間にしようなんて、あなたも変わってるのね♪」","en":"You want to make me your ally? You're weird too, huh♪"},"clip":"Audio/Voice/uni00053_1/uni00053_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私にいたずらなんてしてみなさい……猛毒で苦しませながら殺してあげるわよ♪","en":"Go ahead and try to prank me… I'll make you suffer with deadly poison and kill you, you know♪"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"強い男も好きだけど、守ってあげたくなるくらい弱い男の方が好きよ♪","en":"I like strong men, but I prefer weak ones that make me want to protect them♪"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"早く起きなさいよぉ……私が暇を持て余してるでしょう？","en":"Wake up already… I'm just twiddling my time, you know?"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"毒なんて入ってないわよ♪はい、あ～ん……フフフ、どうぉ？","en":"There's no poison in it, you know♪ Here, open wide… Hehe, how is it?"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"女の子って難しいわねぇ、だからこそ攻略しがいがあるんだけど♪","en":"Girls are so complicated, that's exactly why they're worth the challenge♪"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私にとってカオス・アリーナなんて、ただの遊び場にすぎないわ♪","en":"To me, the Chaos Arena is just a playground♪"},"clip":"Audio/Voice/uni00053_1/uni00053_1_hom_6.ogg"