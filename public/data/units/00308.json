１体に超特大威力で攻撃する"}},{"level":5,"sp":330,"detail":{"ja":"自身のATKを超特大アップ、敵１体に超特大威力で攻撃する"}}],"effects":[{"text":"1 enemy: 820% Superhuman damage"},{"text":"Before attacking: Self: ATK +100% for 4 turns","icon":"atk_up"}]}},"leader":{"name":{"ja":"白き戦慄"},"detail":{"ja":"部隊全体のATKを中アップ+SPDを極小アップ"},"effects":[{"text":"All allies: ATK +15%","icon":"atk_up"},{"text":"All allies: SPD +5%","icon":"spd_up"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00308",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00308",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00308",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00308",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00308",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00308",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00308",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"フル装備で固めるのも久しぶりね……ええ、今日はあなたが指揮官よ。私のことを、存分に使いこなしてみせなさい","en":"It's been a while since I went full gear...yes, today you're the commander. Put me to good use."},"clip":"Audio/Voice/uni00308_1/uni00308_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"どうかしら、準備は進んでいる？　期待しているわよ、私を使いこなすのを……","en":"How's it going, are the preparations coming along? I'm looking forward to you mastering me..."},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふぅ……お疲れ様、どうだったかしら？　ふふっ、気に入ってもらえてよかったわ……また私を使ってちょうだいね、隊長さん？","en":"Phew...good work, how was it? Heh, glad you liked it...use me again, Captain?"},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あ、こらっ……もう、だめよ……仕方ないわね。まったく、教師と生徒が一緒のお風呂に入るなんて……今日だけ、指揮のご褒美よ？","en":"Ah, hey...that's enough...I can't help it. Honestly, a teacher and student sharing a bath...just for today, it's a reward for your command?"},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"どうしたの、そんな顔で見て……え、浩介くん？　さぁ、私は知らないけれど……ええ、この学園にはいない名前だわ","en":"What's up, staring at me like that… huh, Kosuke? Well, I don't know… yeah, that's not a name you find here."},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"なぁに、そんなに擦り寄ってきて……あんっ、だめ……こら、だめよ？　ご褒美が欲しいなら、また成果を上げてちょうだい……期待しているわ♪","en":"What? Getting so clingy… ah, no… hey, don't do that, okay? If you want a reward, go earn some results again… I'm looking forward to it♪"},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"教職に身を置いていても、鍛錬を怠った日はないわ――井河アサギ、推して参る！","en":"Even as a teacher, I never miss a day of training—Igawa Asagi, forging ahead!"},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"いつか私以上の対魔忍が、この学園から育ってくるはずよ……あるいはそれは、あなたかもしれないわね","en":"One day, a Taimanin stronger than me will graduate from this academy… or perhaps that could be you."},"clip":"Audio/Voice/uni00308_1/uni00308_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00308_1/uni00308_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"