ni00038_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"なに？　お仕事？　そんな事より私と気持ちいいことしようよぉ♪","en":"What? Work? Forget that, let's do something pleasurable together♪"},"clip":"Audio/Voice/uni00038_1/uni00038_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"なんかつまらないわねえ……あなた、死にたくなかったら私の相手しなさい♪","en":"I'm bored… If you don't want to die, deal with me♪"},"clip":"Audio/Voice/uni00038_1/uni00038_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ふふふ……私はもう対魔忍じゃないの♪　対魔忍のゆきかぜはもういないのよ♪","en":"Hehe… I'm not a Taimanin anymore♪ The Taimanin Yukikaze is gone♪"},"clip":"Audio/Voice/uni00038_1/uni00038_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ねえ、私を楽しませてくれるんでしょう？　そうじゃないなら殺しちゃうから♪","en":"Hey, you're going to entertain me, right? If not, I'll kill you♪"},"clip":"Audio/Voice/uni00038_1/uni00038_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00038_1/uni00038_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index"