lo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私は……エルヴィーラ……偉大なる屍の王、レイスロードに……仕えし……死霊騎士……立ち塞がりし者は……ただ、千々に切り刻む、のみ……","en":"I am... Elvira... a death knight, serving the great Lord of the Dead, the Rais Lord... those who stand in my way will be... cut down, nothing more..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"……私は、屍の王に救われた……死霊騎士……未来永劫、我が君のため……ただ、戦いつづける……だけだ……","en":"...I was saved by the Lord of the Dead... a death knight... for all eternity, I will fight on, only for my master..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"……高位の魔族、レイス……にして……誇り高き……騎士……この死霊騎士を、侮ると……待つのは……永遠の解放……のみ……","en":"...as a high-ranking demon, a Rais, and a proud knight... do not underestimate this death knight... or you will face... eternal liberation..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"……死とは……解放…………貴様にも……至高の……解放を………","en":"...death is... liberation... I will grant you... the ultimate liberation..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"……このエルヴィーラと……対峙したものは……大鎌での……死……あるのみ……","en":"...those who face me, Elvira, will... meet their end by my scythe... that is all..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"……屍の王に授かりし……大鎌の……切れ味……その首で……試してみよ……","en":"...try testing the sharpness of my scythe, granted by the Lord of the Dead... with your own neck..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"……首か、胴か……我が大鎌で……どこを、刈られたいか……選べ…………","en":"...choose where you want to be cut down... by my scythe... your head or your body..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"……死霊騎士は……決して……退かない……かならず……敵に……死の祝福を……","en":"...a death knight... will never retreat... I will always... bestow death upon my enemies..."},"clip":"Audio/Voice/uni00577_1/uni00577_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"……ん、んん……んふぅ……お尻にも……あ、あそこにも……ブルブルって、来てぇ……ん、んぁぅッ","en":"...mmm, mmm... oh, I want it to come... to my butt, to that place... make it come, make it come..."},"clip":"Audio/Voice_r18/uni00577_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"……こんなことで……気持ちよくなっては……死霊騎士のプライドが……ぐ、ぐぅ、あぐぅ、あぐぐぅ、あぐぅんッ、あっぐぅうううぅ――ッ！","en":"...I shouldn't be feeling this way... the pride of a death knight... is being, gu, guu, ah, guu, guu, ah, guu, guu, uuuu..."},"clip":"Audio/Voice_r18/uni00577_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"……屍の王に……救われし……清らかな身体が……ひぐ、ふぐぅ……下衆どもに好き放題……このような、屈辱……","en":"...my body, saved by the Lord of the Dead... is being, higu, fuguu... treated like this, by these vile creatures... this humiliation..."},"clip":"Audio/Voice_r18/uni00577_1_hom_r18_3.ogg"},{"type":"hom","label":"Home","variant":"r18","index":4,"text":null,"clip":"Audio/Voice_r18/uni00577_1_hom_r18_4.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00577_1/uni00577_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00577_1/uni00577_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00577_1/uni00577_1_atk_3.ogg"},