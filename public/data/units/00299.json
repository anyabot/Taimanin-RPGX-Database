160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"獣遁使いの望月卯奈だよ、よろしくねっ♪　　　なんの獣かって？　それは見てのお楽しみ――えぇっ！？なんでウサギってわかったの！？","en":"I'm Mochizuki Una, the Beast-style Taimanin - nice to meet you! What kind of beast, you ask? That's for me to know and you to find out - eh?! How did you figure out it's a rabbit?!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ぴょん、ぴょん、ぴょーん♪　あ、隊長！　これはね、修行中だよ♪　脚を鍛えるための――え、膝を悪くする？　そうなの！？","en":"Pyon, pyon, pyon! Oh, Captain! I'm in the middle of training - I'm working on building up my leg strength. Is it bad for my knees? Yeah, it is!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"うぅ～ん、いい修行方法が思いつかない……お願い、一緒に考えて？　ほら、二人のほうが賑やかで楽しいし……いいの？　ありがとう！","en":"Ugh, I'm having a hard time coming up with a good training method... Can you help me brainstorm? It's always more fun with two people, and it's more lively... Is that okay? Thanks!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"……あ！　隊長、あっちで先生が呼んでるみたい！　どうしてわかるかって、聞こえたからだよ……あれ？　どうして逃げるの、隊長！","en":"Ah! Captain, it looks like Sensei is calling us over there! How did I know? I heard it, of course! Wait, why are you running away, Captain!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"隊長、見～つけた！　この長い耳なら、どこにいたって声が聞こえちゃうからねっ、すぐわかるよ♪","en":"Captain, found you! With these long ears, I can hear you from anywhere, so it's easy to track you down!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"うえっ！？　ふ、太くないよ！　鍛えてるけど、ちゃんとマッサージして太くならないようにしてるもん！　太もも、触ってみればわかるよ！","en":"Ew, no way! My legs may be thick, but I work out and give them massages so they don't get too bulky! You can touch them and see for yourself!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私の獣遁は、兎の力を身体に宿すの。可愛い動物だからって、甘く見ちゃだめだよ？　兎の脚力を人間並みにするんだから……岩だって砕けるよ！","en":"My Beast-style technique lets me tap into the power of a rabbit. Don't underestimate me just because it's a cute animal - I can crush rocks with my leg strength!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"うひゃあ！？　あ、やっ……その、耳は……ひんっ！　よ、よく聞こえる分、ちょっと敏感で……あっ、んっ……触っちゃ、だめぇ……ぁんっ……","en":"Ahh! Oh no, my ears... are a bit sensitive... You can hear really well, but it's also kind of... ah, don't touch them, please!"},"clip":"Audio/Voice/uni00299_1/uni00299_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00299_1/uni00299_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0199_1_r18"],["chr_0199_2_r18"]],"stills":[["chr_0199_1a_r18"],["chr_0199_2a_r18"]],"obtain":[{"kind":"event","type":"Story event","title":{"ja":"Story event #12","en":"Story event #12"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00299","graphicNum":2,"r18GraphicId":"uni_00299_r18","r18GraphicNum":2,"spineId":"Chr_0199"}}