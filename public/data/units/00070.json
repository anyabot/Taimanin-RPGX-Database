0009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「対魔忍、井河さくら見参ッ！　……って言いたいところだけど、ここはいったい何処なのよー？」","en":"Taimanin Igawa Sakura, reporting for duty! …that's what I'd say, but where on earth is this place?"},"clip":"Audio/Voice/uni00070_1/uni00070_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あぁ。誰かと思えばキミかー？　んっ。元気してたー？","en":"Ahh. If it's anyone, it's you? Hmm. How've you been?"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"こぉら！　そんなところを突っつかないの。どうせやるなら、堂々としなよ♪","en":"Hey! Don't poke there. If you're gonna do it, do it with confidence♪"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"えぇ？　私そっくりな先生を知ってるって？　……い、いやあ。なんの話しかなー？　ふっふ～ん","en":"Eh? You know a teacher just like me? …n-no. What are you even talking about? Heh~"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はぁ、やっぱすごいなあ。お姉ちゃんは。こっちの世界じゃ校長先生だなんて。……あ、ううん。なんでもない。こっちの話し！","en":"Ha, she's amazing. My sister. In this world she's the principal. …ah, never mind. That's a different story!"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ねえ、いまさっき私を見掛けなかった！？　……あーん、もうマズイってばぁ。とにかく逃げなきゃ。急いでんだ。じゃねっ！","en":"Hey, didn't you just see me a moment ago!? …Ugh, this is bad. We gotta run. Hurry up. Later!"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ここはいったいどこなのー？　もう、あのタコ頭は居なくなっちゃうし、いったいどうすれば帰れるんだろー？","en":"Where on earth is this? That octopus-head's gone, so how do we get back?"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あぁ、稲毛屋のあんみつ食べたいなー。白玉トッピング全部乗せ。ううっ。……こっちの世界にもあるのかなー？","en":"Ahh, I want Inamaya's anmitsu with all the shiratama toppings. Ugh… I wonder if they have it here too?"},"clip":"Audio/Voice/uni00070_1/uni00070_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00070_1/uni00070_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2