],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00171",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00171",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00171",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00171",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00171",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"早速で悪いが、今夜は任務でパーティへと向かう。……なに、一緒に行きたいだと！？","en":"Sorry for the sudden notice, but tonight I'm on a mission heading to a party. …What, you want to come along!?"},"clip":"Audio/Voice/uni00171_1/uni00171_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふうまか。今夜はパーティなので早めに失礼させてもらうぞ。……なんだ。私がパーティに行ってはおかしいのか？","en":"Fuuma? Tonight's a party, so I'll excuse myself early. …What? Is it odd for me to attend a party?"},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私を出し抜こうなど、十年早いな。……ふふっ、そのマヌケ面、若い頃のさくらを思い出すなぁ","en":"Trying to outwit me? You're ten years too early. …Heh, that dumb look reminds me of Sakura in her youth."},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"アサギ様、必ずやこの任務、私一人で成し遂げてみせます。どうか遠くから紫を見守っていてください！","en":"Asagi-sama, I will definitely see this mission through on my own. Please watch over me, Murasaki, from afar!"},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"まったく貴様は隙だらけだな。もう少し授業にマジメに出て、鍛錬をしっかりと積むのだな？","en":"Honestly, you're full of gaps. Attend class more seriously and train properly, got it?"},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"オイ。余り教師を怒らせない方がいいぞ？　これは忠告だ。次は……斬るぞ","en":"Hey. You'd better not piss off the teacher, alright? That's a warning. Next time… I'll slash you."},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"そんな甘い踏み込みでヤツらを倒せるとでも思ったか？　一から勉強し直せ！","en":"Did you really think you could take those guys down with such a half-hearted charge? Start studying from the beginning!"},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この任務、嫌な予感しかしない。嗚呼、アサギ様ぁ。……ハッ！？　私としたことが。い、いま言ったことは忘れろっ！！","en":"I've got a bad feeling about this mission. Ah, Asagi-sama… …Huh!? Me, of all people. Forget what I just said, now!!"},"clip":"Audio/Voice/uni00171_1/uni00171_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00171_1/uni00171_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0105_1_r18"],["chr_0105_2_r18"]],"stills":[["chr_0105_1a_r18"],["chr_0105_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"exchange","title":null,"start":"2022-09-01","end":"2022-11-30"},{"kind":"exchange","title":null,"start":"2023-09-01","end":"2023-11-30"},{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【超人】","en":"Kessen Pick-up Gacha (Superhuman)"},"start":"2025-04-01","end":"2025-04-30"},{"kind":"spark","title":null,"need":300,"start":null,"end":null}],"standardPool":true,"origin":"Permanent","art":{"graphicId":"uni_00171","graphicNum":2,"r18GraphicId":"uni_00171_r18","r18GraphicNum":2,"spineId":"Chr_0105"}}