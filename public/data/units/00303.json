lo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"はじめまして、一日対魔忍のお仕事でお世話になります、すーぱーそに子と申します！　隊長さん、どうぞよろしくお願いします","en":"Nice to meet you, I'm Super Sonico - I'll be working with you as a Taimanin for the day, so please take care of me, Captain!"},"clip":"Audio/Voice/uni00303_1/uni00303_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"実は、お仕事をいただいたときから、ずっと考えていたのですが……対魔忍というのは、いったいどういう職業なのでしょうか……？","en":"To be honest, I've been thinking about this since I got the job... what exactly does being a Taimanin entail?"},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"な、なるほど～、つまり警察や軍人さんみたいなお仕事、ということですね……わかりました！","en":"I see - so it's like being a police officer or a soldier, right? Got it!"},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"恥ずかしながら、わたしは朝にめっぽう弱くて……え？　この目覚まし時計、いただけるんですか？　嬉しいです、大切にしますね","en":"I'm a bit embarrassed to admit it, but I'm really weak in the mornings... wait, can I keep this alarm clock? I'm happy to have it, and I'll take good care of it!"},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"順に、ちゃー・シュー・メン・なると・あじたま……はい、この子たちのお名前です♪　とっても大切な、うちの子たちなんですよ","en":"Okay, let's see... Cha, Shu, Men, Naruto, Ajitama... yeah, these are their names! They're really precious to me, my little ones."},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"そろそろ撮影のお時間ですね、がんばります！　対魔忍すーぱーそに子、推して参ります！　えへへへ……","en":"It's almost time for the photo shoot, so I'll do my best! I'm Super Sonico, Taimanin - I'll give it my all! Hehehe..."},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ガールズスリーピースバンド『第一宇宙速度』Ｖｏ．／Ｇｔ．担当のすーぱーそに子です。バンドの二人からはニコちゃんって呼ばれてるんですよ","en":"I'm Super Sonico, the vocalist and guitarist for the girls' three-piece band \"First Cosmic Velocity\" - my bandmates call me Nico-chan."},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"どう、でしょう……いただいたご衣装、見苦しくありませんか？　はぁ、よかったです……では、よろしくお願いします！","en":"How do I look... is this outfit not too embarrassing? Ah, I'm glad... well, nice to meet you, then - please take care of me!"},"clip":"Audio/Voice/uni00303_1/uni00303_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00303_1/uni00303_1_lup_1.ogg"},{"ty