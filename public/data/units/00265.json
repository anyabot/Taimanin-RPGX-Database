"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"はじめまして、マスター。支援型アンドロイドメイド、シアリーです。今後のマスターの生活は、すべてシアリーが支えますので、ご安心を","en":"Nice to meet you, Master. I'm Shirley, a support-type android maid. From now on I'll take care of everything in your life, so you can rest easy."},"clip":"Audio/Voice/uni00265_1/uni00265_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おはようございます、マスター。朝食の支度は整っておりますので、ダイニングのほうへいらしてください","en":"Good morning, Master. Breakfast is ready, so please come to the dining area."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"さぁマスター、今宵も訓練をお願いします……ええ、私の訓練です。マスターに夢中になってもらうためです、手で抜いても、手は抜きません","en":"Alright, Master, please give me training tonight… yes, my training. It's so you'll become completely devoted to me. Even if you try to take it easy, I won't hold back."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おかえりなさいませ、マスター。こちらの冊子ですか？　マスターの部屋にて発見した、不要な資源ゴミです。シアリーがいれば、必要ありません","en":"Welcome back, Master. This booklet? I found it in your room—just unnecessary resource waste. With me, you don't need it."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お湯加減はいかがでしょう、マスター。お湯が少ない、ですか？　二人で入るに、ちょうどよい湯量のはずです。それでは、失礼いたします","en":"How's the water temperature, Master? Not enough hot water? It should be just right for the two of us. Well then, excuse me."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"おやすみなさいませ、マスター。手を繋ぐのと抱き締めるのと、どちらの体勢でお休みになりますか？　おすすめは抱き締めるほうです、マスター","en":"Good night, Master. Would you prefer to hold hands or be embraced while you sleep? I recommend the embrace, Master."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いかがされましたか、マスター。押しが強く、クールで、素直で、愛情たっぷり――マスターの嗜好を、パーフェクトに満たしているはずですが","en":"Is something the matter, Master? Strong, cool, obedient, full of affection—I'm sure I've perfectly satisfied your preferences."},"clip":"Audio/Voice/uni00265_1/uni00265_1_hom_6.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00265_1/uni00265_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Vo