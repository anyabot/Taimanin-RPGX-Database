"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00006",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00006",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00006",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00006",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「私は対魔忍、心願寺紅。“義”により参戦する。よろしくお願いする」","en":"I'm a Taimanin, Shinganji Kurenai. I fight for justice. Pleased to meet you."},"clip":"Audio/Voice/uni00006_1/uni00006_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"戦いの支度はまだできていないのか？　あまり無駄な時間を使いたくない","en":"Haven't you gotten ready for battle yet? I don't want to waste any unnecessary time."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"なんだジロジロと……用もないのに見られても困るんだが","en":"What are you staring at… It's troublesome to be watched when you have no business."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ハーフヴァンパイアの対魔忍と聞くと忌避する者も多いのだが……そうか、気にならないのか","en":"Many people shy away when they hear about a half-vampire Taimanin… I see, you aren't bothered."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"確かに私も同じ対魔忍ではあるが人と魔の血を引いていて……どうも調子が狂うな","en":"Sure, I'm also a Taimanin, but I carry both human and demon blood… My condition's a bit off."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"そう言えばあやめを見なかったか？　恐らく近くに居るとは思う","en":"Speaking of that, haven't you seen Ayame? I think she's probably nearby."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この身に魔を宿す私だからこそよくわかる。人には、守らなければならない正しき“道”があるということを――","en":"Because I, who harbors demons within me, understand it well. Humans have a righteous \"path\" they must protect—"},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私の風の刃は鋭く迅い。一度放てば相手は痛みを感じる間もなくあの世に旅立っている","en":"My wind blades are sharp and swift. Once I unleash them, the opponent is gone to the afterlife before they even feel the pain."},"clip":"Audio/Voice/uni00006_1/uni00006_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00006_1/uni00006_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00006_1/uni00006_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00006_1/uni00006_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00006_1/uni00006_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00006_1/uni00006_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":