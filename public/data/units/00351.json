":300,"start":null,"end":null}],"standardPool":false,"origin":"Summer","art":{"graphicId":"uni_00351","graphicNum":2,"r18GraphicId":"uni_00351_r18","r18GraphicNum":2,"spineId":"Chr_0236"}}