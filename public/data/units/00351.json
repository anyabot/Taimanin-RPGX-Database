,[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00351",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00351",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00351",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00351",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00351",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00351",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"うふふ、お待たせ♪　水着なんて久しぶりだから、少し見苦しいかもしれないわね……そんなことない？　ふふっ、ありがとう♪","en":"Hehe, sorry to keep you waiting♪ It's been ages since I wore a swimsuit, so it might look a bit off… not really? Hehe, thanks♪"},"clip":"Audio/Voice/uni00351_1/uni00351_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"本当によかったの？　私までついてきちゃって……まぁ、来た以上はしっかりと監督役をさせてもらうけれど","en":"Are you really glad? I even followed you… Well, now that you're here, I'll make sure to keep a close watch."},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"せっかく来たんだし、少し焼いていこうかしら……ねぇ、オイル塗るの、手伝ってちょうだい？　ふふっ、変なトコロは触っちゃダメよ？","en":"Since you came all this way, maybe I'll give you a little roast… Hey, could you help me apply the oil? Hehe, don't touch any weird places, okay?"},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"んっ……そう、そこもよ……水着の下にも塗っておかないと、焼きムラになっちゃうから。オイルも、たっぷり使ってちょうだい……あんっ♪","en":"Mmm… right there too… I have to put some under the swimsuit too, or it'll be uneven. Use plenty of oil… Ahh♪"},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この岩場、人があまりこない穴場なのよ。たぶん、あの子たちにも見つからないと思うから……んっ……少し、こうしていていいかしら……","en":"This rocky spot is a hidden place people rarely come to. I think even those kids won't find it… Mmm… is it okay if I stay like this a bit…"},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"なんだかゆきかぜに悪いわね……でも、あの子がちゃんと捕まえておかないのもいけないのよ……こんな悪いお母さんが近くにいるのに、ねぇ？","en":"I feel bad for Yukikaze… but it's also wrong that she doesn't catch them properly… having a bad mother like me nearby, huh?"},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どうかしら、この水着……え？　昔のじゃないわよっ、当たり前でしょうっ？　今日のために、新しくしたのに……もういい、知らないっ","en":"How about this swimsuit… huh? It's not an old one, of course! I got a new one just for today… Fine, I don't care."},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"さっきはごめんなさい……ん、あの男の人？　ふふっ、ちょっとね……あなたとのケンカの、愚痴を聞いてもらっただけよ……二人きりで、ね","en":"Sorry about earlier… um, that man? Hehe, I was just venting about our fight to you… just the two of us, okay?"},"clip":"Audio/Voice/uni00351_1/uni00351_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"そんなに見つめられたら私の中の女が疼いてきちゃうわ……♪　ふふふ、あなたならいいかしら……？","en":"If you stare at me like that, the woman inside me starts throbbing…♪ Hehe, maybe it's okay with you…?"},"clip":"Audio/Voice_r18/uni00351_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ねえどうしたの？　そんな興奮した目でこっちを見て。あは、私のおっぱいに視線がくぎ付けね♪","en":"Hey, what's wrong? Looking at me with those excited eyes. Ahah, your gaze is glued to my breasts♪"},"clip":"Audio/Voice_r18/uni00351_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"あら、水着がほどけちゃったわ。でも、丁度いいわよね？　この後一緒に……うふふ♪","en":"Oh, the swimsuit came undone. But it's just right, isn't it? After this, together… hehe♪"},"clip":"Audio/Voice_r18/uni00351_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00351_1/uni00351_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00351_1/uni00351_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00351_1/uni00351_1_atk_3.ogg"},{"