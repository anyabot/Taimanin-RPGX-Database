o00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00246",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00246",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふっふっふ～、真打は遅れて登場するんだよねぇ？　井河さくら、ただいま見参！　さくら先生に、まっかせなさ～い♪","en":"Hehe, the star makes a late entrance, huh? Igawa Sakura, now reporting! Leave it to Teacher Sakura~"},"clip":"Audio/Voice/uni00246_1/uni00246_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"お？　どうしたぁ、そんな赤い顔でこっち見て……もしかして、よからぬことでも企んでないかぁ～？　うぅ～ん？","en":"Oh? What's with that flushed face looking at me… plotting something naughty, perhaps? Hmm?"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"うん？　うん、なんかねぇ……最近どうも、寝てるときにさぁ……ていうか起きたとき？　身体の調子が変なんだよね～、年かなぁ～","en":"Hmm? Yeah, something… lately, when I sleep… or rather when I wake up? My body feels off… maybe I'm getting old…"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"うぅ～ん、疲れたぁ……ちょっとだけ仮眠しよっかなぁ。キミも来るかい？　いまなら添い寝を許してやるぞよ、にゃはははっ♪","en":"Ugh, I'm tired… maybe I'll take a quick nap. Want to join? If you come now I'll let you cuddle, nyahaha♪"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はぁ～、よく寝たぁ……んっ、じゅるぅ……やばっ、涎すっご……こら！　女性の寝起きを見るなんて、マナー違反だぞ！","en":"Ha~ slept well… mmm, slurp… wow, drool… hey! Watching a woman wake up is a breach of etiquette!"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"よぉーし！　今日は抜き打ちテストを行うぞ、お前らぁー！　にゃっははは、これ教師になったら、一回は言ってみたかったんだよねぇ～","en":"Alright! Today we're doing a surprise test, you all! Nyahaha, I've always wanted to say that once I become a teacher~"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お、ちゃんとノート取ってるねぇ、感心かんしん♪　それじゃあ、テストのヤマでも教えてあげよっかなぁ～？","en":"Oh, you're actually taking notes, I'm impressed♪ So, shall I give you a lesson on the test mountain~?"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ごっめ～ん、テストにだすって言ってたとこ、どこだったか忘れちゃってた♪","en":"Sorry~ I forgot where I said I'd put it on the test♪"},"clip":"Audio/Voice/uni00246_1/uni00246_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00246_1/uni00246_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"