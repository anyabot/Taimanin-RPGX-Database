lo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふふっ……クリスマスのご指名、ありがとうございます♪　静流サンタのこと、めいっぱい可愛がってちょうだいね？","en":"\"Hehe… thank you for assigning me for Christmas♪ Please dote on Santa Shizuru as much as you can, okay?\""},"clip":"Audio/Voice/uni00275_1/uni00275_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"メリークリスマス♪　ちょっと恥ずかしいけど、いつも頑張ってるあなたのために、サービスしてみたわよ","en":"\"Merry Christmas♪ It's a bit embarrassing, but I gave you a little service for all your hard work.\""},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"そういえば、国によってはクリスマスも真夏なのよね……だったら、この下が水着になってても、なにもおかしくないわよねぇ？","en":"\"Come to think of it, in some countries Christmas is in summer… So even if I'm in a swimsuit down there, it wouldn't be weird, right?\""},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"どう、目の保養は済んだかしら？　それじゃ――プレゼントの配達、付き合ってちょうだいね？　トナカイくん♪","en":"\"So, did that treat your eyes? Then—let's deliver the presents together, okay? Reindeer-chan♪\""},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"んん～～～～っ♪　子供たちも、お姉さんサンタに大喜びだったわねぇ……え？　もうっ、子供相手に、ヤキモチ妬かないの♪","en":"\"Mmmmmm♪ The kids were thrilled with Sister Santa… huh? Oh no, you don't get jealous over kids, do you?\""},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"それじゃ、今夜は二人っきりで……大人のクリスマス、過ごしてみる？　ふふっ、なーんてね♪","en":"\"Then, tonight just the two of us… how about an adult Christmas? Hehe, just kidding♪\"]"},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"クリスマスだからって、ハメを外しすぎないようにしないといけないわね……この格好？　うふふ、いつも通りでしょ？","en":"It's Christmas, but we have to make sure we don't go overboard… this outfit? Hehe, it's just like always, right?"},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"やっぱり薄着だと冷えるわね……どうかしら、どこかで暖まっていかない？","en":"Being light-clothed does get chilly… How about we warm up somewhere?"},"clip":"Audio/Voice/uni00275_1/uni00275_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00275_1/uni00275_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00275_1/uni00275_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00275_1/uni00275_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00275_1/uni00275_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00275_1/uni00275_1_dmg