,3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"セドナ・アルストナ。今はこんな格好だけど、れっきとした兵士。任務はしっかりこなす","en":"\"Cedna Arstonna. I may look like this now, but I'm a proper soldier. I'll carry out the mission properly.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"制服でも武器は所持している。いつでも任務に向かえる","en":"\"Even in uniform I carry weapons. I can head to a mission anytime.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"授業に遅れたくないので、任務は手早くすませる。でももちろん、確実に","en":"\"I don't want to be late for class, so I finish missions quickly. But of course, reliably.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"スカートは動きにくい上に、足下もすーすーする。それに……翻るから困る","en":"\"The skirt is hard to move in, and my feet get all breezy. And… it flutters, which is a problem.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"制服はこの着こなしでいいと、アスカから聞いた。おかしい？","en":"\"Asuka told me this uniform looks fine. Is that weird?\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"学校が楽しいかは、わからない。けど、私を特別扱いしない人達に囲まれるのは、嫌いじゃない","en":"\"I don't know if school's fun. But I don't hate being surrounded by people who don't treat me specially.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"学校生活は楽しいかと聞かれても、よくわからない","en":"\"Even if you ask whether school life is fun, I really don't know.\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"感情が戻ってきた？　そう、なのかな？","en":"\"Did my emotions come back? I guess… maybe?\""},"clip":"Audio/Voice/uni00316_1/uni00316_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00316_1/uni00316_1_msr_1.ogg"},{"type":"msr","label":"Mission","