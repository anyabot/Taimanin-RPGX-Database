3,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"おらー！　かわいそうなモテない男子のために、ミナサキちゃんがチョコ作りに来てやったぞー！　盛大に歓迎しろー♪","en":"Yo! For those poor, unpopular boys, Minasaki-chan is here to make chocolate! Give a big welcome~"},"clip":"Audio/Voice/uni00294_1/uni00294_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ほうほう、チョコはユセンで溶かす……ユセン？　温泉の仲間？","en":"Hmm, melt chocolate in yusen… yusen? A hot spring buddy?"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あーだめだめ、この本はわかりにくいね。こんなのに頼ってちゃ、おいしいチョコは作れない！","en":"Ah, no no, this book is hard to understand. Relying on this, I can't make good chocolate!"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"さて、そろそろ本格チョコをお披露目しますか――ん？　もちろんだいじょぶだよ、まっかせてー♪","en":"Alright, shall we debut the real chocolate now— huh? Of course it's fine, leave it to me♪"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"えーっと、ここに黒焼きヤモリの粉末と、ニンニク少々……隠し味にシナモンを……あ、こら！　できるまで見ちゃダメ！","en":"Um, here's powdered black-baked gecko, a pinch of garlic… a secret cinnamon… Hey! You're not allowed to watch until it's done!"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"結局さぁ……チョコは買うのが一番！　ってことで、あの有名店で買ってきて！　そんでボクにちょーだい♪","en":"In the end… buying chocolate is the best! So go get it from that famous shop! Then give it to me♪"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"うーん、ちょっと甘すぎるかな……ボクはこれでもいいけど、あいつはもうちょいビターのほうが……って、わわっ！　な、なんでもないよ！","en":"Hmm, maybe it's a bit too sweet… I guess this is fine, but that guy needs something a bit more bitter… wha—! N-no, it's nothing!"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふへへへ～、ついに完成だぞ、か～んせ～い♪　どうだ、欲しいか？　ボクのチョコ、食べたいか～？","en":"Hehehe~ it's finally done, ka—nsei♪ How about it, want it? Want to eat my chocolate~?"},"clip":"Audio/Voice/uni00294_1/uni00294_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00294_1/uni00294_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00294_1/uni00294_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00294_1/uni00294_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00294_1/uni00294_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00294_1/uni00294_1_dmg_2.ogg"},{"type":"dmg","label":"Damage