0004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"誰にでも恐怖心という心の弱さは存在するものよ……それを私に見せてちょうだい","en":"Everyone has that weak spot of fear… Show it to me."},"clip":"Audio/Voice/uni00172_1/uni00172_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の左目を見てみなさい……お前の弱い心はそれだけで私によって支配される。二度と正気に戻る事などできないわよ","en":"Look into my left eye… Your feeble heart will be yours to command. You'll never regain your sanity."},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"どうして私の顔を見ただけで逃げ出すのよ？　私は何もしないわよ……ほら、こっちにおいで、いい事をしてあげるから……","en":"Why do you run off just at the sight of my face? I won't do a thing… Come over here, I'll give you a treat…"},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私には邪眼しかないと思っているの？　ふふ、それなら一戦交えてみる？　それだけじゃないってとこ見せてあげるわよ……","en":"You think all I have is that cursed eye? Heh, how about a little duel? I'll show you there's more to me…"},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"人が恐怖に怯える顔って、どうしてこんなに興奮するのかしら……人の希望を踏みつぶすのって面白いわよね","en":"I can't help but get excited by a terrified face… Crushing someone's hope is so entertaining."},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お前はどんな顔で怯えてくれるの？　少しでも私を満足させる事ができたなら、その命の寿命も少しは伸びるかもしれないわよ","en":"What kind of face will you make when you cower? If you can please me even a little, perhaps your life will be extended a bit."},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この左目の邪眼を見たければ私を本気にさせる事ね……でも、本気になった私と戦ったら最後。地獄のような恐怖を与えるわよ","en":"If you want a glimpse of this cursed eye, you have to drive me to the edge… But once I'm serious, that's the end. I'll unleash a hellish terror."},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お前はどんな顔で命乞いをするのか楽しみだわ？　さあ、かかってきなさい……戦いはもう始まっているわよ","en":"I can't wait to see the face you'll make begging for your life. Come at me… the fight's already begun."},"clip":"Audio/Voice/uni00172_1/uni00172_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00172_1/uni00172_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0106_r18"]],"stills":[["chr_0106a_r18"]],"obtain":[],"standardPool":true,"art":{"graphicId":"uni_00172","graphicNum":2,"r18GraphicId":"uni_00172_r18","r18GraphicNum":2,"spineId":"Chr_0106"}}