],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00398",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00398",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"また、会えた……そう、ナーサラ。鮮烈な記憶、渇望……欲しい、たくさん","en":"We meet again... that's right, Nasara. A vivid memory, a craving... I want so much."},"clip":"Audio/Voice/uni00398_1/uni00398_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"希望、食事……おいしいもの。この店……行く、すぐ","en":"Hope, food... something tasty. This shop—let's go right now."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"経験、五感、大事……食事、すべて満たす、優良","en":"Experience, all five senses matter... food that satisfies everything is superb."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"……なにかくる。気配、小型……あれは、四足歩行、哺乳類……小型犬？","en":"...something's approaching. A small presence... it's a quadruped mammal... a small dog?"},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"元気、攻撃的……違う？　甘え、懐き……求愛行動、把握","en":"Energetic, aggressive... or not? Sweetness, attachment... I should understand its courtship behavior."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"安堵……そう、飼い主、庇護者。気配、一致……ナーサラと、ふうま","en":"Relief... yes, master, protector. Our presences align... Nasara and Fuuma."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ナーサラにはない、身体……硬さ……心地いい","en":"I lack a body, but this hardness feels comfortable."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"やはり、必須……ふうまの存在、大きい……経験、もっと欲しい……","en":"Indeed, essential... Fuuma's existence is significant... I want more experience."},"clip":"Audio/Voice/uni00398_1/uni00398_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ん……この、硬さ……クセになる。興味、強い興味……もっと欲しい、奥まで……いっぱい、満たして","en":"Hmm... this hardness... it's addictive. My interest is strong... I want more, deep down... fill me completely."},"clip":"Audio/Voice_r18/uni00398_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"んぅっ、はぁっ、あっ、あぅっ……いい、そのまま……強くっ……イクッ……イクまで、してっ……","en":"Mmm, ha, ah, ah... good, just like that... harder... I'm coming... keep going until I climax..."},"clip":"Audio/Voice_r18/uni00398_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00398_1/uni00398_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","i