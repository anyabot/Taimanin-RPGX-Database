il":{"ja":"味方全体のHPを中回復、SPを大回復する（対象の残りHPが低いほど回復量がアップ）"}},{"level":3,"sp":340,"detail":{"ja":"味方全体のHPを中回復、SPを大回復する（対象の残りHPが低いほど回復量がアップ）"}},{"level":4,"sp":335,"detail":{"ja":"味方全体のHPを中回復、SPを大回復する（対象の残りHPが低いほど回復量がアップ）"}},{"level":5,"sp":330,"detail":{"ja":"味方全体のHPを中回復、SPを大回復する（対象の残りHPが低いほど回復量がアップ）"}}],"effects":[{"text":"All allies: restore 25% HP","icon":"Healing_hp","tag":"instant"},{"text":"All allies: restore 70 SP","icon":"Healing_sp","tag":"instant"},{"text":"Healing +20% per 25% of the target's HP missing (up to +60%)","tag":"modifier"}]}},"leader":{"name":{"ja":"花嫁妖狐"},"detail":{"ja":"魔性属性ユニットの最大HPを大アップ"},"effects":[{"text":"Devilish allies: Max HP +20%","icon":"hp_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ど、どうかな……うん、ブリジットだよ。今回のお仕事で、花嫁役がいるって聞いたから……ボクも役に立てるかなって思って、えへへ♪","en":"Um… I guess so… yeah, it's Brigitte. I heard this job involves a bride role, so I thought maybe I could be useful too, eheh♪"},"clip":"Audio/Voice/uni00588_1/uni00588_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふっ、うれしいなぁ……こんなかわいいドレスが着られるなんて、ボクとっても幸せだよ♪","en":"Hehe, I'm so happy… being able to wear such a cute dress makes me super happy♪"},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"えっ、撮影もするの？　そ、そうなんだ……えっと、誰と写るんだろ？　できれば、ふうまと一緒がいいなぁって……いいの？　ほんとにっ？","en":"Huh, we're doing a photo shoot too? I-I see… um, I wonder who I'll be in the picture with? If possible, I'd love to be with Fuuma… Is that okay? Really?"},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"いい写真も撮ってもらえたし、これで心置きなく仕事に行けるねっ♪　えっ、いまのが仕事？　って、どういうこと？","en":"We got some great shots, so now I can go to work without any worries♪ Wait, that was work? What does that even mean?"},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"そ、そうなんだ、広報のお仕事……うぅぅ、恥ずかしい……潜入任務だと思って、勘違いしちゃってたよ……あうぅぅっ……","en":"So… it's PR work… ugh, how embarrassing… I thought it was an infiltration mission and totally misread it… aah…"},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"すてきなドレスを着させてもらって、ふうまと写真も撮ってもらえて……お仕事なのに、楽しいことばっかりだったよ。こういうこともあるんだね","en":"I got to wear a lovely dress and take photos with Fuuma… even though it's work, it was all fun. Guess things like this happen."},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いつか本当に、こういうの着れたらいいなぁ……えっ、だ、誰とって……そ、そんなの知らないよっ、もう……ばかぁ……","en":"I'd really love to wear something like this someday… huh, w-who with… I don't even know… geez… you idiot…"},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あれ、こんなお天気なのに雨が……ふふっ♪　ボクがこんな格好してるから、お空も勘違いしちゃったみたいだね","en":"Huh, it's raining even though the weather's fine… hehe♪ Maybe the sky got confused because I'm dressed like this."},"clip":"Audio/Voice/uni00588_1/uni00588_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"んっ、んんぅっっ……はぁっ、ふうまぁ……んっ、ちゅ……うれしい、こんな風に……ふうまと、ひとつになれてぇ……あぁっっ！","en":"Mmm, nnh… haah, Fuuma… mmm, *kiss*… I'm so happy, like this… to be one with Fuuma… ahh!"},"clip":"Audio/Voice_r18/uni00588_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ボクね、がんばるから……がんばって、たくさん……赤ちゃん、産むね？　だから、どうか……末永く、よろしくお願いします、旦那さま♪","en":"I'll do my best… work hard, and… have lots of babies, okay? So please… take care of me forever, Master♪"},"clip":"Audio/Voice_r18/uni00588_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00588_1/uni00588_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0436_1_r18"],["chr_0436_2_r18"]],"stills":[["chr_0436_1a_r18"],["chr_0436_2a_r18"]],"obtain":[{"kind":"event","type":"Raid event","title":{"ja":"Raid event #30","en":"Raid event #30"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00588","graphicNum":2,"r18GraphicId":"uni_00588_r18","r18GraphicNum":2,"spineId":"Chr_0436"}}