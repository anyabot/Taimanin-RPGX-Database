1",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"識別コード、解析――完了。Ａ－６６・ルーナ、これより貴官の指揮下に所属します。大規模殲滅作戦の折には、私をお使いください","en":"Identification code and analysis complete. A-66 Luna now reporting under your command. For large-scale annihilation missions, feel free to deploy me."},"clip":"Audio/Voice/uni00263_1/uni00263_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"若い対魔忍が多く存在――育成機関と推定。いえ、スパイではなく、単なるデータ収集です。破棄……かしこまりました、情報をデリートします","en":"There are many young Taimanin present—likely a training facility. No, I'm not a spy, just gathering data. Discard… understood, I will delete the information."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"なんでしょう……マスター、とお呼びすればよいのですか？　かしこまりました、呼称登録を変更……以後、マスターとお呼びします","en":"Should I address you as Master? Understood, updating designation… from now on, I will call you Master."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"マスターの呼気より、アルコール分を検出。時子への伝達シークエンスに移行――は、やめろ、ですか？　やめてください、なら考えます","en":"Detecting alcohol in your breath, Master. Initiating transmission sequence to Tokiko… stop, is that what you want? If you say \"stop,\" I will consider it."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"任務了解。マスターとともにショッピングモールへ向かいます。任務確認、物資調達――ルーナ用ランジェリー……不要ではないかと推察します","en":"Mission acknowledged. Heading to the shopping mall with you, Master. Mission check, resource procurement—Luna-type lingerie… I infer it may not be unnecessary."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私の本来の用途は、広範囲殲滅兵器です。ですから――あまり華やかな衣装は、不要……ですが……一応、お預かりしておきます","en":"My original purpose is a wide-area annihilation weapon. Therefore—flashy outfits are unnecessary… but… I will keep it on standby."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"任務了解。アルテミスを行使します――殲滅は不許可、了解しました。出力95％カット、オートターゲットオフ。敵指揮官の捕縛を優先","en":"Mission acknowledged. Deploying Artemis—annihilation not permitted, understood. Output reduced to 95%, auto-target off. Prioritizing capture of enemy commander."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"隊長殿、ご指示を――は、マスターと呼称せよ？　かしこまりました、呼称登録変更――エラー発生、登録をキャンセルします","en":"Captain, awaiting orders—should I address you as Master? Understood, changing designation… error occurred, cancelling registration."},"clip":"Audio/Voice/uni00263_1/uni00263_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00263_1/uni00263_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0168_1_r18"],["chr_0168_2_r18"]],"stills":[["chr_0168_1a_r18"],["chr_0168_2a_r18"]],"obtain":[{"kind":"event","type":"Raid event","title":{"ja":"Raid event #10","en":"Raid event #10"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00263","graphicNum":2,"r18GraphicId":"uni_00263_r18","r18GraphicNum":2,"spineId":"Chr_0168"}}