08",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"篠原まりです！　得意術は土遁、好きな物は甘い物。特に……和菓子でしょうか","en":"I'm Shinohara Mari! My specialty is earth-style ninjutsu, my favorite thing is sweets. Especially… Japanese confections, I guess."},"clip":"Audio/Voice/uni00190_1/uni00190_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ちょっといいですか？　え、訓練中？　なら仕方ないですね……","en":"Do you have a moment? Huh, training? Well, can't be helped then…"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"こら！　廊下を走っちゃいけません！　まったく、子供じゃないんですから……","en":"Hey! You can't run in the hallway! Seriously, you're not a child!"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あ、さっき先生が探してましたよ？　どこでって、あっち――あ、どうして反対に逃げるんですか！","en":"Ah, the teacher was looking for it earlier, right? Where? Oh, over there—ah, why are you running the opposite way!"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"そろそろ試験ですけど、準備はできてますか？","en":"The exam's coming up soon, are you ready?"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"たまには私も、任務に連れて行ってくださいよ、活躍してみせますよっ？","en":"Sometimes take me on missions too, I'll show you what I can do!"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"みなさんを守るためなら、これくらいどうってことありません、大丈夫です！","en":"If it's to protect everyone, this is no problem at all—I'm fine!"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"どうしたんですか？　そんな顔をしてないで、一緒にお団子でもどうです？　落ち着きますよ？","en":"What's wrong? Don't make that face—how about some dumplings together? It'll calm you down, you know?"},"clip":"Audio/Voice/uni00190_1/uni00190_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00190_1/uni00190_1_rdy_2.ogg"},{"type":"res","label":"Result","vari