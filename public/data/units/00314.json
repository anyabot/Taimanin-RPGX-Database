,3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"対魔忍、心願寺紅……五車学園の制服にて失礼する。わたしが五車に来ている事は、どうか内密に頼むぞ","en":"Taimanin, Shinganji Kurenai… I apologize in the Gosha Academy uniform. Please keep it confidential that I'm at Gosha."},"clip":"Audio/Voice/uni00314_1/uni00314_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"五車の街並み、何もかもが懐かしいな……今回の誘い、感謝しているぞ","en":"The streets of Gosha feel nostalgic… I'm grateful for this invitation."},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"追放された五車の街をこんな格好で歩くなど綱渡りもいい所だが……それだけお前を信用しているという事だ。守ってくれよ？","en":"Walking through the expelled Gosha town in this outfit is a tightrope act, but it just shows how much I trust you. Please protect me, okay?"},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"制服を着ているのは、五車に入るにあたりそう提案されたからだ。決してわたしの意思ではないぞ。勘違いするなよ","en":"I'm wearing the uniform because I was suggested to when joining Gosha. It's not my own choice. Don't get the wrong idea."},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"実は持ってきたのは制服だけではないぞ。学園に通うのに必要な物もひと通り揃えてある","en":"Actually, I didn't just bring the uniform. I also have everything needed to attend the academy."},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"な、なんだ。ジロジロと見つめて……そんなにこの格好がおかしいか？　似合ってる？　そ、そうか……","en":"W-what? Staring at me like that… Is this outfit that weird? Does it suit me? I-I see…"},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"採寸と購入は昔あやめに頼んだのだがな……妙な所ばかり測ろうとするので困ったよ。なのにサイズは恐ろしいくらいにピッタリなんだ……","en":"I used to have Ayame handle the measurements and purchases back in the day… She always tried to measure the weirdest spots, which was a hassle. Still, the sizes turned out terrifyingly perfect."},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あの事さえなければ、お前とこうして何気ない会話をしながら登下校をする日々もあったのだろうな……いや、無粋な事を言った。忘れてくれ","en":"If it weren't for that incident, we'd probably still be having casual conversations while going to and from school… No, that was uncouth of me. Forget it."},"clip":"Audio/Voice/uni00314_1/uni00314_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00314_1/uni00314_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00314_1/uni00314_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00314_1/uni00314_1_atk_3.ogg"},{"type":"dmg","label":"Damaged"