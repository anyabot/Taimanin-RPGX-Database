,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「シュヴァリエの書物に興味を持つとは珍しい人間ね。研究の邪魔をしないのならば、閲覧を許可するわ」","en":"It's rare for a human to take an interest in my books. As long as you don't hinder my research, I'll allow you to peruse them."},"clip":"Audio/Voice/uni00040_1/uni00040_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あなたがしたいことは？　目的をなそうとしたらそれを知ることから全てが始まるわ","en":"What is it you wish to do? If you set a goal, everything begins with knowing it."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"人にとって有用なことでも他人にとっては無用な事は多い。分かったら行動を反省しなさい","en":"What may be useful to one person can be useless to another. Once you understand that, reflect on your actions."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"なるほど、中々に興味深い……あなたのその行動も一つの哲学と言えるわね","en":"I see, quite intriguing… Your actions could even be called a philosophy."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あなたは読書が好きなのね。しかし、そのわりには……これは失言ね。忘れて","en":"You like reading, don't you? Yet, for that reason… that's a slip of the tongue. Forget it."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"欲情した目で見られることは特に気にはしていないわ。生き物としての本能の様なものだから","en":"I'm not particularly bothered by being watched with lustful eyes. It's just a creature's instinct, after all."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ホレイショー、天と地の間にはシュヴァリエの哲学では思いもよらない出来事がまだまだあるわ","en":"Listen up, between heaven and earth there are events that my philosophy could never have imagined."},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この出会いはさながら気まぐれな運命からの来訪者のようだ。シュヴァリエの物語、寝物語にはいささか重いが覚悟はいい？","en":"This encounter feels like a whimsical visitor sent by fate. My story may be a bit heavy, but are you prepared?"},"clip":"Audio/Voice/uni00040_1/uni00040_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00040_1/uni00040_1_atk_1.ogg"},{"type":"atk","label":"Attack","varia