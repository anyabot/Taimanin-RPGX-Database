":345,"detail":{"ja":"敵３体に中威力で攻撃、与えたダメージの一部で自身のHPを中回復する"}},{"level":3,"sp":340,"detail":{"ja":"敵３体に中威力で攻撃、与えたダメージの一部で自身のHPを中回復する"}},{"level":4,"sp":335,"detail":{"ja":"敵３体に中威力で攻撃、与えたダメージの一部で自身のHPを中回復する"}},{"level":5,"sp":330,"detail":{"ja":"敵３体に中威力で攻撃、与えたダメージの一部で自身のHPを中回復する"}}],"effects":[{"text":"3 enemies: 235% Spiritual damage","tag":"instant"},{"text":"1 enemy: heal self for 20% of damage dealt","tag":"modifier"}]}},"leader":{"name":{"ja":"夢の中で"},"detail":{"ja":"精神属性ユニットのATKを大アップ"},"effects":[{"text":"Spiritual allies: ATK +20%","icon":"atk_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"また会えたわね？　誰って――ミレイユよ、夢魔のミレイユ！　あの落ちこぼれに感化されて、脳みそ溶けちゃったのかしらっ！？","en":"We meet again, huh? Who am I— Mireille, the dream demon! Have you been swayed by that loser and had your brain melt?!"},"clip":"Audio/Voice/uni00331_1/uni00331_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"なによ、まだあんな落ちこぼれとつるんでるの？　まったく……ご褒美より、お仕置きが必要みたいね。もう一度、私の味を覚えさせてあげる","en":"What, you're still hanging out with that loser? Good grief... Looks like you need a punishment rather than a reward. Let me make you taste me again."},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふぅ……とりあえずは、これくらいでいいかしら。本当に、これだけは一人前なんだから……まぁ、おいしくいただいておいてあげるわ","en":"Phew... For now, this should be enough. Honestly, this is the only thing I'm decent at... Well, enjoy it while I feast."},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"たまの人間界も、暇つぶしにはなるわね。新作も出てるし、ショッピングして行こうかしら……ほら、ついてきなさいよ、荷物持ち","en":"Even the human realm can be good for killing time. There's a new release, so maybe we should go shopping... Come on, follow me, you pack mule."},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ちょっと――待て！　まったく、盛りのついた牡犬はこれだから……ご褒美がもらえるのは、ご奉仕ができてからよ。お・あ・ず・け、わかる？","en":"Hey—wait! Seriously, a brat in heat is just like that... You only get a reward after you serve me. Understand?"},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"まったく、物欲しそうな目しちゃって……いいわよ。ほら、眠りなさい……改めて教えてあげるわ、夢魔にも格があるってことをね","en":"Seriously, those greedy eyes... Fine. Sleep now... I'll teach you once more that even dream demons have ranks."},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"何度も言うけど、夢魔にも格というものがあるの……落ちこぼれもいれば、弱気なのもいて、強くて美しいのもいるってことよ","en":"I keep saying it, but dream demons have ranks... There are losers, there are timid ones, and there are strong and beautiful ones."},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"なに、犬扱いするなって？　だって、犬じゃない……私にたっぷり啼かされたの、忘れてないわよねぇ？","en":"What, you say don't treat me like a dog? But I'm not a dog... You haven't forgotten how much I made you howl, have you?"},"clip":"Audio/Voice/uni00331_1/uni00331_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00331_1/uni00331_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0221_1_r18"],["chr_0221_2_r18"]],"stills":[["chr_0221_1a_r18"],["chr_0221_2a_r18"]],"obtain":[{"kind":"event","type":"Raid event","title":{"ja":"Raid event #14","en":"Raid event #14"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00331","graphicNum":2,"r18GraphicId":"uni_00331_r18","r18GraphicNum":2,"spineId":"Chr_0221"}}