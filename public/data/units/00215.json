,[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"甲斐原菜央だよ、よろしく！　おいしいお野菜が食べたいときは、いつでも相談してね？","en":"I'm Kaibara Nao, nice to meet you! If you ever want some delicious veggies, just let me know, okay?"},"clip":"Audio/Voice/uni00215_1/uni00215_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こう見えても、木遁が得意なんだよ。え、そうとしか見えなかった？　そ、そう……","en":"Even though I look like this, I'm actually good at wood-style. Huh, you only saw it that way? I-… yeah…"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"木遁の応用で、いつものお野菜が何倍もおいしく成長するの。ほら、食べてみて？","en":"My wood techniques make ordinary veggies grow way tastier. Here, give it a try?"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あ、ちょうどいいところに。どうかな、この張りとツヤ、おいしそうでしょ？　うん、この大根だよ♪","en":"Ah, just in time. How's this firmness and shine? Looks tasty, right? Yep, it's a radish♪"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"いつか五車の野菜をブランド化して、大儲けして、大豪邸に住むのが夢なんだ……","en":"One day I dream of turning Gosha's veggies into a brand, making a fortune, and living in a huge mansion…"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"いや、農家じゃないよ！　あくまで対魔忍で、農業は副業っていうか、趣味みたいなもので……","en":"No, I'm not a farmer! I'm a Taimanin, and farming's just a side gig—more like a hobby…"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私の木遁は、誰も知らない植物を新しく生みだせる……使い方によっては、なんだってできちゃうんだから","en":"My wood style can create brand-new plants nobody's ever seen... depending on how I use it, I can do anything."},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"もうちょっと戦闘もできれば、後方支援以外でも活躍できるんだけどね","en":"If I could fight a bit more, I could shine beyond just rear-line support…"},"clip":"Audio/Voice/uni00215_1/uni00215_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00215_1/uni00215_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0137_r18"]],"obtain":[{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00215","graphicNum":2,"r18GraphicId":"uni_00215_r18","r18GraphicNum":2,"spineId":"Chr_0137"}}