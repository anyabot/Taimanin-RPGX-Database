lo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"いえーい、海だー！　あっ……んんっ……アイナ・ウィンチェスターだ。ンだよ、なに見てんだよ！　俺が海ではしゃいでちゃ悪ィか！？","en":"Yay, the beach! Ah... *mmph* I'm Aina Winchester. Huh, what are you looking at! Is it bad for me to have fun at the beach!?"},"clip":"Audio/Voice/uni00209_1/uni00209_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"今日はいい波が来てるな……なに、ボード乗れんのかって？　ったりまえだろ、なんだったら教えてやろうか？","en":"The waves are great today... What, you can't ride a board? Of course you can, want me to show you how?"},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"綺麗な海だよなぁ……さっきシュノーケリングしてたんだけどよ、もう別世界って感じだぜ、海ン中はよ","en":"What a beautiful sea... I was just snorkeling, feels like another world, the whole ocean's amazing."},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"……なーんか、視線が気になんだけど。あんまジロジロ見んなよ？　いや、別に恥ずかしいとかじゃ……なぁ、これ……変じゃねぇよな？","en":"...Hey, I'm kinda feeling your stare. Don't stare so much, okay? It's not like I'm embarrassed or anything... huh, this... isn't weird, right?"},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"っ……しょっ……おわっ、なに見てやがる！　うっせぇな、水着の紐ってのは、こういうこともあんだよ！　食い込むのは仕方ねぇだろ！","en":"Ugh... hey... what the hell are you looking at! Shut up, swimsuit straps can be like this! If they dig in, it's just how it is!"},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"っくしゅっ！　うぅ、ちっと冷えてきたかな……おっ……なんだよ、パーカーとか準備いいな。その……ありがとよ","en":"Achoo! Whew, getting a bit chilly... Oh... what's this, a hoodie? Nice prep. Uh... thanks."},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"しっかし、水着で戦場に行くってのも、なかなかねぇよな……もうちょい、布が多いのにすりゃよかったか……","en":"But going to the battlefield in a swimsuit, that's something... Maybe I should've had more fabric."},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お前もなかなか、いい身体してんじゃねぇか……へ、俺も？　なっっ……ば、馬鹿野郎！　ジロジロ見てんじゃねぇ！","en":"You've got a pretty good body yourself... Huh, me too? Damn... you idiot! Stop staring!"},"clip":"Audio/Voice/uni00209_1/uni00209_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00209_1/uni00209_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00209_1/uni00209_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00209_1/uni00209_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00209_1/uni00209_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00209_1/uni00209_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"