restore 20% HP","icon":"Healing_hp"}]}},"leader":{"name":{"ja":"浜辺の翠玉"},"detail":{"ja":"超人属性ユニットのATKを大アップ"},"effects":[{"text":"Superhuman allies: ATK +20%","icon":"atk_up"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00005",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"由利翡翠、任務のために推参。……え？　いや、水着は任務のために必要だから。何か気になる？","en":"\"Yuri Hisui, reporting for duty. …Huh? No, the swimsuit is necessary for the mission. Something catch your eye?\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ビーチパラソル、得物としてまあ悪くない、かな？","en":"\"A beach parasol as a weapon? Not bad, I guess.\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"この水着が気になるの？　店の人にたずねたら、これを勧められたから。ただ着てるだけ。……何かヘン？","en":"\"You're curious about this swimsuit? The shop clerk recommended it, so I just wore it. …Weird?\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"日焼け止めって、塗った方がいいのかな？　ベタベタするのは、ちょっと嫌","en":"\"Should I put on sunscreen? It gets all sticky, which I kinda dislike.\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"悪いけれど先約があるの。……ぼ、ボーイフレンド？　……い、一応それっぽい人なら、いるけど","en":"\"Sorry, I have a prior engagement… a boyfriend? …Well, I do have someone who kinda fits the bill.\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"潮風で、髪が……。んぅ、絡みやすいから余計にっ。んっ……少し、じゃま","en":"\"The sea breeze makes my hair… hmm, it gets tangled easily, so it's a bit annoying.\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"こっちの空には、カモメくらいしかいないのね？　……まあいいけれど。エサとかあげちゃダメかな？","en":"\"Only seagulls are up there, huh? …Fine then. Is it okay to feed them?\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"動きやすいし、水着も悪くないかも。……ただ、人目を集めるのが、ちょっと……ね","en":"\"It's easy to move in, and the swimsuit isn't bad… but drawing attention is a little… you know.\""},"clip":"Audio/Voice/uni00211_1/uni00211_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00211_1/uni00211_1_msr_1.ogg"},{"type":