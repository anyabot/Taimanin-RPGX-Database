[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00008",10],[23,"blo00009",15],[24,"blo00011",10],[24,"blo00012",15],[25,"blo00014",10],[25,"blo00015",15],[26,"evo00020",8],[26,"evo00023",32],[26,"evo01023",1],[27,"blo00007",4],[27,"blo00010",4],[27,"blo00013",4],[28,"blo00007",4],[28,"blo00010",4],[28,"blo00013",4],[29,"blo00007",4],[29,"blo00010",4],[29,"blo00013",4],[30,"blo00007",4],[30,"blo00010",4],[30,"blo00013",4],[31,"evo00020",8],[31,"evo00023",32],[31,"evo01023",1],[32,"blo00007",4],[32,"blo00010",4],[32,"blo00013",4],[33,"blo00007",4],[33,"blo00010",4],[33,"blo00013",4],[34,"blo00007",4],[34,"blo00010",4],[34,"blo00013",4],[35,"blo00007",4],[35,"blo00010",4],[35,"blo00013",4],[36,"evo00020",8],[36,"evo00023",32],[36,"evo01023",1],[37,"blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00020",8],[41,"evo00023",32],[41,"evo01023",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00020",8],[46,"evo00023",32],[46,"evo01023",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふうま時子、参りました。大きな若様にお仕えするなんて、なんだか緊張しますね。未熟者ですが、よろしくお願いいたします","en":"I'm Fuuma Tokiko, nice to meet you. I'm a bit nervous about serving such a great young master, but please take care of me."},"clip":"Audio/Voice/uni07021_1/uni07021_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"異次元に飛ばされたと思ったら、こんな大きな若様にお会いできるなんて。ふふ、天音に言ったら悔しがりますね","en":"I thought I'd been transported to another dimension, and then I met you, a great young master. Hehe, Fuuma Amane would be so jealous."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"若様……いえ、今はお館様でしたね。つい若様と呼んでしまいますが、お許しくださいね","en":"Young master... no, I mean, Master. I keep calling you young master, but please forgive me."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"まあ、まだゲームがお好きなんですか。大きくなっても男の子なんですね。でも、やりすぎはいけませんよ","en":"You still like games, I see. You're still a boy at heart, even though you've grown up. But don't overdo it, okay?"},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"若様、あのう……その棚の上にあるお皿を取ってくださいませんか？　私、手が届かなくて……","en":"Young master, could you please get that plate on the top shelf for me? I couldn't reach it..."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"若様の手、大きい……私の片手に収まるくらいでしたのに、今では私の手が包まれてしまいます","en":"Your hand is so big, young master... it used to fit in my hand, but now my hand is engulfed by yours."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"蛇子ちゃんはさぞ立派な大蛇になられたのでしょうね。え？　タコ？　まあ……","en":"I'm sure Aishu Hebiko has become a magnificent snake by now. What? An octopus? Well..."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"たまにはこの時子に甘えてくださいね。大きいほうの時子には、甘えにくいこともあるでしょう？　","en":"Every now and then, let me pamper you, okay? It's not often that I get to be pampered by the older me, after all."},"clip":"Audio/Voice/uni07021_1/uni07021_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07021_1/uni07021_1_wav_1.ogg"}],"trust":[],"scenes":[],"stills":[],"obtain":[{"kind":"event","type":"Kessen","title":{"ja":"결전 퀘스트 #23","en":"Kessen quest"}},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_07021","graphicNum":4,"r18GraphicId":"uni_07021","r18GraphicNum":0,"spineId":"Chr_7021"}}