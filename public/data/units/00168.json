0011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私は葉隠真千子。葉隠家を束ねる者。私とともにありたくば、武勇を示しなさい！","en":"I am Hagakure Machiko, the one who leads the Hagakure clan. If you want to be by my side, show your bravery!"},"clip":"Audio/Voice/uni00168_1/uni00168_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の名は、葉隠家頭首、葉隠真千子！　この街で好き勝手は許さない","en":"My name is Hagakure Machiko, head of the Hagakure clan! I won't tolerate anyone running wild in this city."},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私に意見したければ、相応の実力を見せてくれなくては。さあ来なさい。この剣が真実を導いてくれるわ","en":"If you want to argue with me, you'll have to prove your worth. Come on, this sword will guide the truth."},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"葉隠に集う者を養う義務が私にはあるの。私の怠慢で彼らを飢えさせるわけにはいかない。それが頭首の役目","en":"I have a duty to support those who gather under Hagakure. I can't let my negligence starve them—that's the head's role."},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"さあ集え勇者たち！　葉隠の名のもとに！　葉隠真千子とともにいざ！　その武勇をふるえ！","en":"Gather, heroes! In the name of Hagakure! With Hagakure Machiko, forward! Wield your bravery!"},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"面白いことを言うわね。でも武勇を伴わぬ知恵を葉隠は、この葉隠真千子は認めない。実力をもって正しさをしめしなさい！","en":"That's an interesting remark. But Hagakure, and I, Hagakure Machiko, won't accept cleverness without courage. Show your righteousness with strength!"},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私とともにありたくば、剣をとりなさい！　さあ、その勇猛さをみせるとき！　続け葉隠の勇者よ！","en":"If you want to be by my side, take up a sword! Now's the time to display your valor! Onward, heroes of Hagakure!"},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この剣と葉隠の名に賭けて。葉隠真千子は私のもとに集う者を見捨てない。信は勇によって立つ！","en":"I stake this sword and the name of Hagakure. Hagakure Machiko never abandons those who gather under me. Faith stands on bravery!"},"clip":"Audio/Voice/uni00168_1/uni00168_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00168_1/uni00168_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0102_r18"]],"stills":[["chr_0102a_r18"]],"obtain":[],"standardPool":true,"art":{"graphicId":"uni_00168","graphicNum":2,"r18GraphicId":"uni_00168_r18","r18GraphicNum":2,"spineId":"Chr_0102"}}