00003",40],[1,"ubl00439",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00439",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00439",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00439",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00439",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00439",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00439",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"対魔忍、水城不知火よ。随分と若い隊長さんね。あら？　不思議そうな顔だけどどうかしたの？","en":"I'm a Taimanin, Mizuki Shiranui. You're quite a young captain, aren't you? Hmm, you look surprised - what's wrong?"},"clip":"Audio/Voice/uni00439_1/uni00439_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ゆきかぜと仲良くしてくれているようね。お礼を言うわ","en":"You're getting along with Yukikaze, I see. I'll thank you for that."},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"１０年以上未来だなんて……小さかったゆきかぜもあんなに大きく成長してて、なんか感慨深いわ","en":"Over 10 years in the future... Yukikaze, who was so small, has grown up so much - it's kind of moving, isn't it?"},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あまり人妻に不躾な視線を送るものじゃないわ。ま、それだけ私が魅力的なのかしら？","en":"You shouldn't be looking at a married woman like that. But I suppose it's because I'm just that charming?"},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"え？　アサギはまだ結婚してないの？　確か今もう……","en":"What? Asagi isn't married yet? I could've sworn she was already..."},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"今の対魔忍は組織が大きくなったからこそ、君みたいな若手の内から指揮官としての訓練がいるのかもね","en":"Now that the Taimanin organization has grown, maybe we need training for young officers like you to become leaders."},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"水遁の術を極めれば、水を自在に操って幻影を見せることも可能なのよ","en":"If I master water manipulation, I can control water and create illusions."},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"対魔忍は危険と隣り合わせだけれど、女としての幸せを求めたっていいはずよ","en":"Being a Taimanin is dangerous, but that doesn't mean we can't pursue happiness as women."},"clip":"Audio/Voice/uni00439_1/uni00439_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"いやぁっ、そんな……！　だめよぉっ、あ、あなた……ごめんなさいぃ！","en":"No, stop...! That's not okay, I... I'm sorry!"},"clip":"Audio/Voice_r18/uni00439_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"どんなに身体を穢されようと、心だけは……ああっ、なのにどうしてこんなに感じちゃうのぉっ！？","en":"No matter how much my body is defiled, my heart... ah, but why do I feel this way?"},"clip":"Audio/Voice_r18/uni00439_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"そ、そんな事言わせないでっ、あぁ、んひぃっ♪　あ、あの人のより大きくて硬くて、奥までくるのぉっ！","en":"Don't say that, ah, hmm...! It's bigger and harder than that person's, and it goes all the way in!"},"clip":"Audio/Voice_r18/uni00439_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00439_1/uni00439_1_dmg_3.ogg"},{"type":"evo","l