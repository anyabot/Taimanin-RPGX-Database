012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00264",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00264",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00264",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"穂稀なおだよ、よろしくね。男同士、気楽にいこうよ。えっ、女かと思った？　はぁ、よく間違われるんだよねぇ","en":"I'm Homare Nao, nice to meet you. Let's keep it easy between guys. Huh, thought I was a girl? Ha, people really mistake me a lot."},"clip":"Audio/Voice/uni00264_1/uni00264_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あっ、あの服可愛い！　次の任務が終わったら買いに行こうかな","en":"Ah, that outfit is cute! Maybe I'll go buy it after the next mission."},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あのね、僕は男だよ。いつもそうやってからかうんだから……","en":"You know, I'm a guy. You always tease me like that…"},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"このスーツ結構気に入ってるんだ。この耳とか尻尾とかさ、可愛いよね♪","en":"I really like this suit. The ears and tail are cute, right♪"},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"なぁ、一緒に部屋に飾る小物を買いに行かない？　で、デートって、バカ言うなよぉ、男同士だろ？","en":"Hey, want to go buy some room decorations together? And don't call it a date, okay? It's just guys, right?"},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"別に女になりたいとか、心が女ってわけじゃないよ。ただカワイイのが好きなだけさ","en":"It's not that I want to be a girl or that my heart's female. I just like cute stuff."},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いつも女と間違われるのは面倒だけれど……でも、そのくらい可愛いセンスしているように見えるのかなって思うと、そう悪くもないかな","en":"Being mistaken for a girl is a hassle, but… thinking that maybe it means I have a cute sense, that's not so bad."},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"五車には可愛いくて強い子が多いから、僕も負けていられないなって、いい刺激になるよね","en":"Gosha has a lot of cute and strong girls, so I can't afford to fall behind. It's a good motivation."},"clip":"Audio/Voice/uni00264_1/uni00264_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00264_1/uni00264_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip"