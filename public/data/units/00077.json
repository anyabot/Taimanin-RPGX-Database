",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00077",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00077",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00077",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00077",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00077",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00077",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふうま時子、参りました……はい、お任せください。ふうまの執事として、恥じない仕事をお見せしましょう","en":"\"Fuuma Tokiko, at your service… Yes, leave it to me. As the Fuuma butler, I'll show you work I can be proud of.\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こらっ、廊下は走らない！　まったく、子供ではないのですから、当たり前の注意をさせないように","en":"\"Hey, no running in the hallway! Honestly, you're not a child, so I shouldn't have to give you the obvious warning.\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"学校ではちゃんと、先生と呼んでください。言い慣れないようなら、家でも先生と呼んでもらいますからね","en":"\"At school, be sure to call me 'Sensei.' If that feels odd, you can call me 'Sensei' at home too, alright?\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お帰りなさいませ、お館様。今日は少し遅かったようですが、寄り道もほどほどにしてくださいね","en":"\"Welcome back, my Lord. You were a bit late today, but please keep any detours to a minimum.\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふぅ……え？　いえ、特に疲れていません、大丈夫です。お気遣い、ありがとうございます、お館様","en":"\"Huh…? No, I'm not tired at all, I'm fine. Thank you for your concern, my Lord.\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"んぅ……すやぁ……くぅ、すぅ……ふふ……はい、約束ですよ……いつか私を……時子を、お嫁さんに……すぅ……むにゃ……","en":"\"Mmm… sleepy… *yawns*… hehe… Yes, it's a promise… someday, you'll make me… Tokiko your bride… *murmurs*… nyah…\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"はい？　だめですよ、今月のお小遣いは、もうお渡ししましたからね。少ない額からでも、お金の使い方には計画性を持つように、いいですね？","en":"\"Excuse me? No, you can't. I already gave you this month's allowance. Even with a small amount, you should plan how you spend your money, understand?\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お疲れさまです、お館様。そうそう、こちらとこちらの書類、目を通しておいてください。ふふっ、これも立派な当主になるための、お勉強ですよ？","en":"\"Good work, my Lord. By the way, please review these two documents. Hehe, consider it study material for becoming a proper head of the house.\""},"clip":"Audio/Voice/uni00077_1/uni00077_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00077_1/uni00077_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0093_1_r18"],["chr_0093_2_r18"]],"stills":[["chr_0093_1a_r18"],["chr_0093_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-09-25","end":"2022-04-05"},{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"exchange","title":null,"start":"2022-08-16","end":"2023-02-27"},{"kind":"exchange","title":null,"start":"2023-08-16","end":"2024-02-27"},{"kind":"exchange","title":null,"start":"2024-09-01","end":"2025-03-15"},{"kind":"exchange","title":null,"start":"2025-08-31","end":"2025-11-30"},{"kind":"exchange","title":null,"start":null,"end":"2026-12-02"}],"standardPool":true,"origin":"Gosha Fes","art":{"graphicId":"uni_00077","graphicNum":2,"r18GraphicId":"uni_00077_r18","r18GraphicNum":2,"spineId":"Chr_0077"}}