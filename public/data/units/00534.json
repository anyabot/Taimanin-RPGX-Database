wer the target's remaining HP"},{"text":"All allies: restore 90 SP","icon":"Healing_sp"}]}},"leader":{"name":{"ja":"鋼鉄の魔女"},"detail":{"ja":"魔性属性ユニットの最大HPを小アップ+DEFを極小アップ"},"effects":[{"text":"Devilish allies: Max HP +10%","icon":"hp_up"},{"text":"Devilish allies: DEF +8%","icon":"def_up"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00534",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00534",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00534",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00534",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00534",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00534",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00534",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"さて、お仕事ね――このアンネローゼに、どんな依頼をくれるのかしら。期待させてもらうわよ、対魔忍のボウヤ","en":"Now, about the job - what kind of request do you have for me, Captain of the Taimanin?"},"clip":"Audio/Voice/uni00534_1/uni00534_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"井河アサギの秘蔵っ子っていうから、どんな子かと思ったけど……意外と普通なのね、少なくとも見た目は","en":"I thought you'd be some kind of prodigy, being Igawa Asagi's secret student and all, but... you seem pretty normal, at least at first glance."},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふんふん、なるほどねぇ……直接戦闘は苦手だけど、分析と作戦指揮が得意なタイプか。私をどう使ってくれるのか、楽しみだわ","en":"Hmm, I see... so you're not too great at direct combat, but you're good at analysis and strategy. I'm looking forward to seeing how you'll use me."},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"探偵といえば、ヨミハラにもいたわよね……どんなやつなのか、あなたは知っている？","en":"Speaking of detectives, didn't you used to work in Yomihara? What was that like, do you know?"},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"護衛に配達に調査、そんなところかしら。殺し？　殺しはやらないわよ、探偵の仕事じゃないでしょう。立ちふさがる相手は斬るけど","en":"As a detective, I do guard work, deliveries, and investigations, that kind of thing. Killing? No, I don't do that - it's not a detective's job. But if someone gets in my way, I'll cut them down."},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この町も悪くないわね。おいしいお酒をだす店があるのが、特にいいわ","en":"This town isn't so bad, either. They have some great bars that serve good alcohol, which is a big plus."},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ピンチのとき、どう乗り切るか……それも腕の見せどころ、というわけね","en":"When things get tough, it's all about how you handle it - that's what separates the pros from the amateurs, right?"},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"いざというときは、私を置いて逃げるのよ。たぶんそのほうが、どっちも助かる可能性が高いから","en":"If things get really bad, just leave me behind and escape. That's probably the best way to increase our chances of survival."},"clip":"Audio/Voice/uni00534_1/uni00534_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ひぐっっ、んっ、あぁぁぁっっっ！　まだっ、あぁっっ！　まだよっ、おわっ、終わりじゃ、なひっ、いひぃぃんっっ！","en":"Ahhh, nnng, ahhh! Not yet, ahh! It's not over yet, no, no, no!"},"clip":"Audio/Voice_r18/uni00534_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"あっ、あぁぁ……だめっ、もっ、もう無理っ、ひぃぃっっ！　あぅっ、許してっっ、許してぇぇっっ！","en":"Ahh, ahhh... no, no, it's too much! Hiiiii! Forgive me, please forgive me!"},"clip":"Audio/Voice_r18/uni00534_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00534_1/uni00534_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0385_1_r18"],["chr_0385_2_r18"]],"stills":[["chr_0385_1a_r18"],["chr_0385_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"spark","title":null,"need":300,"start":"2021-11-30","end":"2021-12-16"},{"kind":"exchange","title":null,"start":"2023-09-01","end":"2023-11-30"},{"kind":"spark","title":null,"need":300,"start":"2024-01-01","end":"2024-01-31"},{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【魔性】"},"start":"2025-05-01","end":"2025-05-31"}],"standardPool":true,"art":{"graphicId":"uni_00534","graphicNum":5,"r18GraphicId":"uni_00534_r18","r18GraphicNum":2,"spineId":"Chr_0385"}}