,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ミナサキだよー。どう、このドレス？　似合ってるでしょー♪　羽根も出したままでも着られるし、お気に入りなんだぁー♪","en":"It's Minasaki~. How about this dress? It looks good, right? I can even wear it with my feathers out, it's my favorite~"},"clip":"Audio/Voice/uni00199_1/uni00199_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"どう、このドレス？　素敵でしょー。ボクだってたまにはこういう格好もするんだから♪","en":"How about this dress? It's lovely, right? Even I wear this kind of outfit sometimes♪"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あぁ、リリムちゃん。背中のファスナー、ちょっと下げてくれない？　ボクじゃ手が届かなくって。……ふえぇぇ～","en":"Ahh, Lilim-chan. Could you lower the back zipper a bit? I can't reach it… *fwee*"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"黒い羽根に白いドレス。……ふふっ。結構気に入っちゃった♪　しばらくこの格好で過ごそうっと♪","en":"Black feathers and a white dress… fufu. I kinda like it♪ I'll stay like this for a while♪"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ダメだよ引っ張っちゃ。ボクはともかく、このドレスは破けやすいんだからー。……盗んだやつだけど","en":"No pulling! I might be fine, but this dress tears easily… …I did steal it though"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ねえキミ、このボクに見とれてた？　いいよぉ。たまにはこういうドレスに着替えるってのも、悪くないよね♪","en":"Hey you, were you staring at me? It's fine. Changing into a dress like this once in a while isn't so bad, right♪"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"……え、ドレスが似合ってる？　ボクだって、たまにはこういう格好をしてもいいでしょ♪","en":"…Eh, does the dress suit me? I can wear this kind of outfit sometimes too, right?"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"えへへ♪　いいでしょ、このウェディングドレス。拾ったんだよー。……盗んだ？　まあ、そうとも言うかなぁー","en":"Ehehe♪ Isn't this wedding dress nice? I found it—…stole it? Well, I guess you could say that~"},"clip":"Audio/Voice/uni00199_1/uni00199_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00199_1/uni00199_1_rdy_2.ogg"},{"type":