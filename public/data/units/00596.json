,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"“人外のお諒”参上！　最初から遠慮無し！　全力全開でトバしてくよっ！","en":"Inhuman Oryou's here! No holding back from the start! I'm going full-throttle!"},"clip":"Audio/Voice/uni00596_1/uni00596_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"道理がわかんねぇヤツが増える季節だ。気合入れてくよ！","en":"It's that season when more clueless idiots appear. I'll get fired up!"},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"へへっ、この姿も悪くないだろう？　見惚れるんじゃないよ？","en":"Hehe, not a bad look, huh? Don't stare too long, okay?"},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"水辺だろうが、スジ通さねぇとヒドイ目に合うってこと、分からせてやるよ！","en":"Water's fine or not, if you don't keep your guard up you'll get a nasty lesson, and I'll make sure you learn it!"},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"こんなナリでも悪魔じゃない。仁義通すならそれなりに面倒も見てやる","en":"Even looking like this I'm not a devil. If you keep your word, I'll look after you in kind."},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ちっ……、流石にジロジロ見過ぎだ。痛い目みたいのかい？","en":"Tch… you're staring way too much. Want a taste of pain?"},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どうだい？　楽しんでるか？　付き合ってもらってあんたには感謝してるよ。おかげで全部曝け出せてるんだ","en":"How's it? Enjoying yourself? I'm grateful you're keeping me company. Thanks to you I can lay it all bare."},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"めんどくせぇことがあったらいつでも声かけな。あんたの為ならいつだって力になってやる","en":"If something pesky comes up, just call me anytime. I'll always be there for you."},"clip":"Audio/Voice/uni00596_1/uni00596_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"はぁ、んん……っ、苦しいけど、興奮しちまう……。ここにはあたしとあんたしかいないんだ。もっと楽しもう。んぅ……っ","en":"Ha… nnn… it hurts but I'm getting turned on… It's just you and me here. Let's enjoy it more. Nn…"},"clip":"Audio/Voice_r18/uni00596_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"見てくれよ。もうぐしょぐしょになっちまってるだろ。あんたも突っ込みたくなってきたろ、遠慮はいらないからねぇ……","en":"Look at this. I'm already all… drenched, right? You're probably itching to jump in too, so don't hold back…"},"clip":"Audio/Voice_r18/uni00596_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"もっとだ……。もっとあたしがめちゃくちゃになるまで。おかしくなるまでイジめておくれよ","en":"More… more until I go completely crazy. Keep teasing me until I lose it."},"clip":"Audio/Voice_r18/uni00596_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00596_1/uni00596_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0444_1_r18"],["chr_0444_2_r18"]],"stills":[["chr_0444_1a_r18"],["chr_0444_2a_r18"]],"obtain":[{"kind":"event","type":"Map event","title":{"ja":"Map event #31","en":"Map event #31"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00596","graphicNum":4,"r18GraphicId":"uni_00596_r18","r18GraphicNum":2,"spineId":"Chr_0444"}}