,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00202",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00202",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00202",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00202",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"いぇ～い、リリムちゃんが来てやったぞ～♪　ほらほら、早くお菓子の準備してよね～","en":"Yay, Lilim-chan's here! Come on, hurry up and get the snacks ready~"},"clip":"Audio/Voice/uni00202_1/uni00202_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おやびん、ヤベーやつに追われてるんですよ、助けてくださいよ～♪","en":"Hey there, I'm being chased by some crazy guy, please help me~"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"むふふ、いい儲け話見つけちったぁ……へ？　な、なんでもないよ～？","en":"Mufufu, I found a great money-making scheme… huh? N-nothing, never mind~?"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おやびん、一緒に稼ぎに行きませんか？　大丈夫っすよ、囮とか盾とかになんてしませんからぁ","en":"Hey there, want to go make some cash together? Don't worry, I won't be a decoy or shield or anything~"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"なんだか疲れてるね～？　たまにはゆっくり寝たら？　いい夢見させてあげるからさ～","en":"You look kinda tired… why not get some proper rest? I'll give you a nice dream, okay?"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あぁ――っ！　そのお菓子は私のなんだけどぉ！？","en":"Ah—! That snack is mine!"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"眠くなってきたでしょ～、いいよ～、寝ちゃえ寝ちゃえ～♪　夢の中で、おいしくいただいてあげるからね～","en":"You're getting sleepy, huh? It's fine, just fall asleep…♪ I'll enjoy you nicely in the dream."},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あいたー！　ぐぬぬぬ、おやびんのクセに生意気なぁ……覚えてろ～！","en":"I'm hungry! Grrr, you're such a cheeky human… remember this!"},"clip":"Audio/Voice/uni00202_1/uni00202_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00202_1/uni00202_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","in