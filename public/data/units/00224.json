"}]},"abilities":[],"bloom":{"points":2,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00001",160],[1,"blo00004",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"霧原純子と申します。あなたが隊長さんですね、よろしくお願いいたします","en":"I'm Kirihara Junko. You're the Captain, right? Pleased to meet you."},"clip":"Audio/Voice/uni00224_1/uni00224_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はい、なにか？　相談？　ええ、もちろん構いませんよ。どうぞ、お入りになってください","en":"Yes, what is it? A consultation? Sure, go right ahead, please come in."},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"そうですね、他の生徒からも、よく相談を受けますよ。内容ですか？　ふふっ、もちろんヒミツです♪","en":"Well, other students often come to me for advice, too. The details? Hehe, that's a secret ♪"},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"これでも、米連に派遣されていたことだってあるんです。実は腕利きなんですよ、私♪","en":"Even so, I've been dispatched to the United States before. Actually I'm pretty good, you know, I am."},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"雷遁の術は、科学技術との相性が最もいい忍術なんですよ。あなたの学年にも一人、とっても相性のいい子がいますよね？","en":"Thunder-style ninjutsu pairs best with scientific tech. There's also someone in your class who's a perfect match, right?"},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"はい、どうぞ。温かい薬草茶です。任務の前に飲むと、心が落ち着きますよ","en":"Here you go. Warm herbal tea. Having it before a mission steadies the mind."},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"米連に派遣されている間は、戦闘だけでなく、外交に近いお仕事もしていましたね……色々とあるんですよ、国と国の関係は、ね","en":"During my assignment in the United States, I handled not just combat but also diplomatic-type duties... There's a lot, the relations between countries, you know."},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"外交のコツ、ですか？　そうですね……周囲と波風を立てないこと、でしょうか。でも、けして……相手に譲歩すること、ではありませんからね？","en":"The key to diplomacy? Well... not causing ripples around you, I suppose. But never... giving in to the other side, okay?"},"clip":"Audio/Voice/uni00224_1/uni00224_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00224_1/uni00224_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0145_r18"]],"stills":[["chr_0145a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00224","graphicNum":2,"r18GraphicId":"uni_00224_r18","r18GraphicNum":2,"spineId":"Chr_0145"}}