blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00522",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00522",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00522",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00522",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00522",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"また会いましたね、メイドウィッチのリリスです！　ご主人様の身の回りのお世話は私にお任せですよ♪","en":"We've met again, I'm the maid witch Lilith! Leave your personal care to me, Master ♪"},"clip":"Audio/Voice/uni00522_1/uni00522_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ベリリクは執事服にしたんですよかわいいでしょ♪　ふぇ？　執事の方が偉いから私がベリリクの言うことを聞かなきゃいけないんですか！？","en":"I dressed Berylic in a butler outfit, cute right? Huh? Because the butler is higher rank, do I have to obey Berylic?"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"お掃除にお洗濯、お食事の用意っと……。うぅ……メイドさんてやること多くて大変なんですね……","en":"Cleaning, laundry, preparing meals… ugh… being a maid is a lot of work, huh…"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お帰りなさいませご主人様♪　えへへ、この台詞一度言ってみたかったんですよぉ！","en":"Welcome home, Master ♪ eheh, I've always wanted to say this line!"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"うぅ～ん……このメイド服、かわいいから気に入ってるんですが……ちょっと胸が苦しいのが残念ですぅ……","en":"Ugh… I love this maid outfit because it's cute, but it's a shame my chest feels a bit cramped…"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"おはようからおやすみまで、クラシックメイドウィッチの私がご主人様のお世話をしますから、安心してくださいね！","en":"From good morning to good night, the classic maid witch Lilith will take care of you, Master, so rest assured!"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ご主人様、このメイドウィッチのリリスになんなりとお申し付けくださいですよー♪　ね、ベリリク！","en":"Master, feel free to tell this maid witch Lilith whatever you like ♪ Right, Berylic!"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"あわわっ！？　ちょっとお掃除しようとしたらメイド服の胸のボタンが飛んで行っちゃいましたぁ……","en":"Oh no!? I was about to clean and the chest button on my maid outfit flew off…"},"clip":"Audio/Voice/uni00522_1/uni00522_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ご主人様、気持ちよさそうですね～。オチンチンが手の中で暴れてますよぉ……でも、まだ出しちゃ……め、ですよ……うふふ♪","en":"Master, you look so pleased… your… uh… is writhing in my hand… but don't… release it yet… hehe ♪"},"clip":"Audio/Voice_r18/uni00522_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"はぐぐ！？　そんなっ、オチンチン子宮に突き刺したら！？　私っ、私！　おぐっ、お！　お！　イグ！　ダメぇえッ！","en":"Ahh!? No, you stabbed… your… into my womb!? Me, me! Oops, stop… no!"},"clip":"Audio/Voice_r18/uni00522_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00522_1/uni00522_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0375_1_r18"]