uni00074_1/uni00074_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"はぁ……暇だと男で遊びたくなってくるー","en":"Haa… when I'm bored I just want to play with a man~"},"clip":"Audio/Voice/uni00074_1/uni00074_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ここのみんなは楽しいから好きよ？　何事も面白さが第一ね！","en":"Everyone here is fun, so I like it? Fun is the most important thing!"},"clip":"Audio/Voice/uni00074_1/uni00074_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"次はどんな風にして遊ぼうかしら？　迷っちゃうなー","en":"I wonder how we should play next? I'm so indecisive~"},"clip":"Audio/Voice/uni00074_1/uni00074_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"尻尾、二本しかないのよねー。もっと増えないかしら","en":"I only have two tails, you know. I wish I had more."},"clip":"Audio/Voice/uni00074_1/uni00074_1_hom_6.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00074_1/uni00074_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00074_1/uni00