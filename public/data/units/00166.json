a":"桃華の賢者"},"detail":{"ja":"部隊全体のSPDを中アップ"},"effects":[{"text":"All allies: SPD +15%","icon":"spd_up"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あなたはこのシュヴァリエにどんな新たな知識を与えてくれるの？　それとも快楽？　さあ教えなさい","en":"What new knowledge will you give to me, Chevalier? Or pleasure? Come now, tell me."},"clip":"Audio/Voice/uni00166_1/uni00166_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"知識という深淵無辺の桃園を散策する者、それがシュヴァリエと知りなさい","en":"Those who wander the endless peach garden of knowledge—know that they are dealing with Chevalier."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"古来より桃は神仙のちからを秘めし果実に例えられる。シュヴァリエの手にする桃もまた同じこと。霊薬に匹敵する滋味を味わいなさい","en":"Since ancient times, peaches have been likened to fruits that hold the power of immortals. The peach I hold is no different—taste its essence, comparable to an elixir."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"知識浅きものの知恵など知れたもの。どのような攻撃もシュヴァリエのあらかじめ知るところだというのに","en":"The wisdom of the shallow knows only shallow things. No matter the attack, I already know it in advance."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"知識というのは恐るべきもの。このシュヴァリエであっても、日々己が無知を思い知らされる。未読の書物、新発見の生命、宇宙の原理……あぁ","en":"Knowledge is terrifying. Even I, Chevalier, am reminded daily of my own ignorance—unread tomes, newly discovered life, the principles of the universe… ah."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"これか？　これはシュヴァリエが新たに手に入れた魔除け。ゆるキャラというのだそうよ。ひとの知恵もなかなかにあなどれないわ","en":"This? This is a new talisman I've acquired. They call it a \"yurukyara.\" Human cleverness shouldn't be underestimated."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"名を問われればシュヴァリエと答えよう。天と地の間のすべてを知らんとする者よ","en":"If you ask my name, I will answer Chevalier. One who seeks to know everything between heaven and earth."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"行けども行けども、知れども知れども。まだあらたな発見はあるというもの。さあこのシュヴァリエにあらたな知識を与えてちょうだい","en":"Go as you will, know as you will. There are still new discoveries to be made. Now, give this Chevalier some fresh knowledge."},"clip":"Audio/Voice/uni00166_1/uni00166_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00166_1/uni00166_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0100_1_r18"],["chr_0100_2_r18"]],"obtain":[{"kind":"event","type":"Raid event","title":{"ja":"Raid event #4","en":"Raid event #4"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00166","graphicNum":2,"r18GraphicId":"uni_00166_r18","r18GraphicNum":2,"spineId":"Chr_0100"}}