2% every turn (up to 10 turns)","icon":"def_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00410",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00410",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00410",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00410",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00410",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00410",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00410",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"メリークリスマース♪　このさくらちゃんと聖夜を過ごせるなんて、キミはと～っても幸せモノだぞ？　ま、一緒のバイトってだけだけどね♪","en":"Merry Christmas♪ Spending this holy night with this little Sakura, you're super lucky, you know? Well, it's just because we work part-time together though♪"},"clip":"Audio/Voice/uni00410_1/uni00410_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"さてさて、本日のバイトは――これだぁ！　恵まれない子供たちのための、クリスマス玩具セール！　売るのかよって？　しょうがないじゃん！","en":"Alright then, today's part-time job—here it is! A Christmas toy sale for underprivileged kids! Sell them? Well, what can you do!"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"そうそう、売るのがお仕事だけど、無料の配送サービスがあるっぽいんだよねぇ。私とふうまくんで行くみたいだから、がんばろー！","en":"Yeah, selling is the job, but there's apparently a free delivery service. Looks like I'll be going with Fuuma-kun, so let's give it our all!"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふぃ～、よく働きましたなぁ！　時給はいいし、お給料は日払いだし、売れ行きで歩合も――あ、これ内緒だった……あははは、なんでもないよ♪","en":"Phew—great work! The hourly rate's good, we get paid daily, and there's a commission on sales—oh, that was supposed to be a secret… ahahaha, never mind♪"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"さーて、仕事も終わったし、ごはん食べて帰ろっか♪　クリスマスディナー行こうよぉ、カラメマシマシで、一緒にニンニク臭くなろうよぉ","en":"All right, the job's done, let's eat and head home♪ How about a Christmas dinner, extra sauce, and let's get garlicky together♪"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"……いや、普通に驚いてる。え、なんで？　レストラン予約してたの？　しかも、あんなすっごいお店……私ね、いまちょー幸せかも♪","en":"…No, I'm genuinely surprised. Huh, why? Did you make a reservation? And at such an amazing place… I think I'm super happy right now♪"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ふふ～、サンタコスだと思った？　今日の私はトナカイだよ、なにせ働き者だからね！","en":"Hehe—did you think I was in a Santa costume? Today I'm the reindeer, because I'm such a hard worker!"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ヒゲ、似合わないねぇ……やっぱ私がサンタで、そっちがトナカイのがよかったかなぁ？","en":"A beard doesn't suit you… Maybe I should've been Santa and you the reindeer?"},"clip":"Audio/Voice/uni00410_1/uni00410_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"いいよ、中にちょうだい……んっ、あっっ♪　ふふっ、あったかぁい……ほらぁ、まだ休んじゃだめだよ？　もっかいしよっ♪","en":"Sure, bring it inside… mmm, ahh♪ Hehe, it's so warm… Come on, you can't rest yet—let's do it again♪"},"clip":"Audio/Voice_r18/uni00410_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"こうやってくっついてるだけで、すっごい気持ちいい……あうっ、あんっっ♪　やっ、ちょっ、動いちゃ……あうっ、あはぁっ♪","en":"Just being this close feels amazing… ah, ahh♪ Wait, don't move… ah, ahh♪"},"clip":"Audio/Voice_r18/uni00410_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00410_1/uni00410_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00410_1/uni00410_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00410_1/uni00410_1_atk_3.ogg"},{