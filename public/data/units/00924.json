,320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"みてみろ、ついに極上の酒を手に入れたんだ……お前も一緒にどうだ？　私と私の槍をつまみに飲ませてやっても良いんだぜ？","en":"Look, I finally got my hands on some top-grade booze… want to join? I could even let you drink from my spear if you like."},"clip":"Audio/Voice/uni00924_1/uni00924_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"お、この衣装、てめぇはどう思う？　私はかっこよくて気に入ってるんだが……もう少し女性らしい格好をしろって言うやつもいるんだよなぁ","en":"Hey, what do you think of this outfit? I think it looks cool and I like it… but some people say I should dress a bit more feminine."},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"今は素面なのかって？　たりめぇだろっ！　私がいつもいつも酔っ払ってるって思ったら大間違いだからな……んぐっ、ぷはぁ、うめぇえっ！","en":"You think I'm sober right now? No way! It'd be a huge mistake to assume I'm always drunk… *gurgle* *phew* So good!"},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"よっぱらってよぉが素面だろうが人魔相手に私が不覚をとるわけがねぇだろ？　それともなにか、てめぇ私のことをうたがってやがるのかぁ？","en":"Whether I'm drunk or sober, there's no way I'd slip up against a human-demon opponent, got it? Or are you doubting me or something?"},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"帰ってきたときに飲む用にとびっきり極上の酒を用意しとけよ？　心配すんなって、私は良い酒を残して逝くようなバカじゃねえからよ！","en":"When you get back, make sure you've got the finest booze ready for drinking, okay? Don't worry, I'm not the type to leave good liquor behind and die!"},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この衣装のかっこよさと私の可憐な美しさが混ざり合って最高のマリアージュを奏でてるだろ？　ん？　美しすぎて直視できねぇってかっ！！","en":"The coolness of this outfit mixed with my delicate beauty creates the perfect marriage, right? Huh? It's so beautiful you can't even look at it!!"},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"あぁっ？　もしかして私の酒が飲みてぇのか？　へへっ、これはだめだ。てめぇみてぇな酒の味もわからねぇやつに飲ませる酒じゃねぇんだ","en":"Huh? You wanna drink my booze? Heh, that won't do. I won't give my drink to someone like you who can't even tell its flavor."},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"もし私についてこれたら……私のことを好きにしてかまわねぇぞ？　もっとも、私よりもてめぇが先に潰れたら……どうなるかわかるよな？","en":"If you can keep up with me… you can do whatever you want with me, okay? Though if you're the one who crashes first… you know what'll happen, right?"},"clip":"Audio/Voice/uni00924_1/uni00924_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00924_1/uni00924_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0772"]],"stills":[["chr_0772a","chr_0772b","chr_0772c"]],"obtain":[{"kind":"gacha","type":"Collab","title":{"ja":"【バジリスク】コラボ限定ガチャ"},"start":"2025-07-31","end":"2025-08-16"},{"kind":"gacha","type":"Collab","title":{"ja":"【バジリスク】コラボ限定ユニット確定ガチャ"},"start":"2025-07-31","end":"2025-08-16"},{"kind":"spark","title":null,"need":30,"start":"2025-07-31","end":"2025-08-16"}],"standardPool":false,"art":{"graphicId":"uni_00924","graphicNum":2,"r18GraphicId":"uni_00924_v","r18GraphicNum":2,"spineId":"Chr_0772"}}