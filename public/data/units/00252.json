8,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"トリックオアトリート♪　私はナディア。あらあら、お菓子もいたずらも欲しいなんて、貪欲な人ね","en":"Trick-or-treat ♪ I'm Nadia. Oh my, you want both sweets and mischief? How greedy."},"clip":"Audio/Voice/uni00252_1/uni00252_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はい、お菓子よ。受け取って？　フフッ、変なものは入っていないわ。ただとっても美味しいだけよ","en":"Here, the sweets. Take them? Hehe, there's nothing weird inside—just delicious."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"わぁ！　びっくりした！　……アハハ、そのカボチャのお面、あなたが作ったの？　凄いわね","en":"Wow! You scared me! …Haha, that pumpkin mask—did you make it? Amazing."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"さぁ食べて。秋の食材を使って腕を振るってみたの。だって収穫祭ですものね","en":"Come on, eat it. I tried whipping up something with autumn ingredients. After all, it's the harvest festival."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"少しだけ、一緒に出掛けましょうか？　だって今日は、子供達だって夜の街を走り回っている日なんだから","en":"How about we go out just a little together? After all, today even the kids are running around the night streets."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"アハハハ……今日はずっと笑っている気がする。きっと、あなたと一緒だからね","en":"Hahaha… I feel like I've been laughing all day. Must be because I'm with you."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"フフッ、今日の日の舞はあなたに見てほしいの","en":"Hehe, I want you to watch today's dance."},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"だってこんな夜よ？　せめてあなたとは、楽しい時間を過ごしたいって思うのは……いけないことかしら？","en":"But it's such a night, right? Wanting to spend a fun time with you— is that wrong?"},"clip":"Audio/Voice/uni00252_1/uni00252_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00252_1/uni00252_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00252_