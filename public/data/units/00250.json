,[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00250",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00250",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00250",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"トリック・オア・トリート！　ねぇねぇ、可愛くない？　この衣装――って、コラ！　エッチな目で、おっぱいばっかり見ないの！","en":"\"Trick or treat! Hey hey, isn't this cute? This costume—hey! Stop giving me that lewd look, only staring at my chest!\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"トリック・オア・トリート！　ほらほら、お菓子よこしなさいよ♪","en":"\"Trick or treat! Come on, hand over the candy♪\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"え――なっ、し、しないわよ、イタズラなんて！　いいから、そこに隠してるお菓子だしなさい！","en":"\"W-what? N-no, I'm not doing any mischief! Just give me the candy you're hiding!\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"んふ～、甘ぁ～い♪　うん、もらってきたお菓子よ、あんたも食べる？　それじゃ――はい、あ～ん♪","en":"\"Mmm~ so sweet♪ Yeah, I got some candy, want some too? Then—here, ahh~\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふぅ、疲れた……町内の子供会で、いっぱいお菓子配ってきたのよ。みんなハロウィン衣装で、可愛かったなぁ～♪","en":"\"Phew, tired… I handed out a bunch of candy at the kids' club in town. Everyone was in Halloween costumes, so cute~\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あ、お菓子切れちゃった……えっ！？　い、いま言われても……うぅ……仕方ないから、してもいいわよ……イタズラ……","en":"\"Ah, I'm out of candy… what!? Even if you say it now… ugh… fine, I guess I'll… prank you…\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"じゃじゃ～ん、どうだ！　こういう魔法使いの衣装だと、いつもより知的に見えたりしない？","en":"\"Ta-da! How about it! In this wizard outfit I look more intellectual, don't I?\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"痴的じゃない！　ち・て・き！　知力的！　もうっ、いやらしいことばっかり考えてるんだから……","en":"\"Not perverted! Per…ceptual! Intellectual! Jeez, you keep thinking about dirty stuff…\""},"clip":"Audio/Voice/uni00250_1/uni00250_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00250_1/uni00250_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"