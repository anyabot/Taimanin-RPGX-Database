o00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ほ、ほらこれあげるわよ！　ありがたく受け取りなさい！」","en":"Here, take this! Be grateful and accept it!"},"clip":"Audio/Voice/uni00046_1/uni00046_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こんな日までいつも通りなの？　感心しちゃうわ……","en":"Is every day just like this? I'm actually impressed…"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ちょっと、何よその態度は！　私が用があるって言ってるのよ！","en":"Hey, what's with that attitude! I'm telling you I have business!"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"え？　こ、これ欲しいの？　ま、まあ、別に良いんだけどね！","en":"Huh? You… want this? Well, I guess it's fine…"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"て、手作りに決まってるじゃない！　これくらい私にかかれば余裕よ余裕！","en":"Of course it's handmade! This is a breeze for me, no problem!"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"が、頑張って作ったんだから、感謝して食べなさいよ？","en":"I worked hard on this, so you better thank me and eat it, okay?"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"こ、これはちょっと作ってみただけだから！　な、なに期待してるのよ！","en":"This is just something I made for fun! Wh-what are you expecting?!"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"わ、私だってこれくらい出来るんだから！　馬鹿にしないで！","en":"I can at least do this much! Don't look down on me!"},"clip":"Audio/Voice/uni00046_1/uni00046_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni