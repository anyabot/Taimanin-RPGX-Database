特大アップ"},"effects":[{"text":"All allies: Curse resistance +100","icon":"abnormality_up","tag":"passive"}]},"abilities":[],"bloom":{"points":2,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00001",160],[1,"blo00004",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私が、お嫁さん……で、いいの？　そう……なら、よかった。大丈夫、幸せにしてあげる……任せておいて","en":"\"Me, as a wife… is that okay? If so, great. Don't worry, I'll make you happy… leave it to me.\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はぁ……緊張するね……お芝居だから、平気？　そんなことない……形はお芝居でも、気持ちはお芝居じゃない……だから、真剣にしなさい。メッ","en":"\"Ha… I'm nervous… It's just acting, right? No, that's not it… The form may be acting, but my feelings aren't. So take it seriously. Me—\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"こんなドレス、初めて着た……どう、似合う？　そういえば、このデザインを選んだのは、キミの趣味って……本当？","en":"\"I've never worn a dress like this before… How does it look? By the way, you chose this design because of your taste… really?\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"校内でこれ着てたら……うん、すごかった。みんなから質問攻め……え？　ちゃんと言ったよ、キミのお嫁さんになるって……任務のことは、内緒","en":"\"If I wore this at school… yeah, it would be amazing. Everyone would bombard me with questions… Huh? I told them properly, that I'm going to be your wife… The mission part stays secret.\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"どうしたの？　すごいケガ……え？　私と結婚するって、どういうことかって……怒られたの？　可哀想……じゃあ、本当にする？","en":"\"What's wrong? Such a big injury… huh? You asked what it means to marry me… got scolded? Poor thing… then, are you really going to do it?\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ん……まだ着替えないのかって？　せっかくだから……もう少し、着てようかなって――え？　結婚前に着ると、婚期が遅れる？　嘘……ガーン","en":"\"Hmm… you haven't changed yet? Since it's a good chance… maybe I'll stay dressed a bit longer—what? Wearing it before marriage delays the wedding? No way… wow.\""},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"昔なら、こんなこと考えなかった……お嫁さんとか、結婚式とか、ウェディングドレスとか……全部、キミと出会ってから……だよ","en":"I never used to think about stuff like that… a wife, a wedding, a wedding dress… all of it, only since I met you."},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"結婚したら、広い庭のある家に住んで……そこに、近くの森から動物たちが集まってくる……そんな風に、暮らしたいね……ね","en":"I want to live in a house with a big garden when we get married… and animals from the nearby forest gather there… that's how I'd like to live… right?"},"clip":"Audio/Voice/uni00341_1/uni00341_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00341_1/uni00341_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0230_r18"]],"stills":[["chr_0230a_r18"]],"obtain":[{"kind":"gacha","type":"Pickup","title":{"ja":"【復刻】ブライダルピックアップガチャ","en":"Rerun: Bridal Pick-up Gacha"},"start":"2025-06-16","end":"2025-06-30","pull":["Pick-up select"]},{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】ブライダル限定ガチャ","en":"Rerun: Bridal Limited Gacha"},"start":null,"end":"2026-06-03","pull":["Pick-up select"]},{"kind":"spark","title":null,"need":30,"start":null,"end":null}],"standardPool":false,"origin":"June Bride","art":{"graphicId":"uni_00341","graphicNum":2,"r18GraphicId":"uni_00341_r18","r18GraphicNum":2,"spineId":"Chr_0230"}}