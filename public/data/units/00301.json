1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"熱川るみ。まだ学生だけど、対魔忍は対魔忍だから、君の役に立てると思うよ","en":"I'm Atagawa Rumi. I'm still a student, but I'm a Taimanin, so I think I can be of help to you."},"clip":"Audio/Voice/uni00301_1/uni00301_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"お母さんが水遁使い、お父さんが火遁使いなの。だからかなぁ、チョー高温水蒸気忍法なんて使えるの","en":"My mom's a water-style user, and my dad's a fire-style user. I guess that's why I can use this super-high-temperature steam ninja art."},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"かっ、可愛い！？　私が！？　そっ、それ以上褒めないでぇ～っ！　恥ずかしすぎるよぉ！","en":"C-cute?! Me?! Stop praising me, it's too embarrassing!"},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"うわわ！？　また頭から蒸気噴き上がってるぅ！　やだやだみんな！　向こう向いててぇッ！","en":"Ahh, not again! Steam's shooting out of my head! Everyone, don't look!"},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あがり症を治す……じゃなくて！　私は対魔忍の前線アタッカーになるのが目標なの！","en":"My goal is to become a frontline attacker for the Taimanin - not to overcome my stage fright, but..."},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私を怒らせたら、水蒸気の爆発でぶっ飛ばしちゃうからね！","en":"If you make me angry, I'll blow you away with a steam explosion!"},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ひーーーん。また頭から蒸気噴いちゃったよぉ……。恥ずかしいから見ないでぇ……！","en":"Oh no, steam's coming out of my head again... it's so embarrassing, don't look..."},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"同い年なんだから、るみ、でいいよ？","en":"We're the same age, so just call me Rumi, okay?"},"clip":"Audio/Voice/uni00301_1/uni00301_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni00301_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00301_1/uni