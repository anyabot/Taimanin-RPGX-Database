o00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あ、れ……？　ふうまくん！　ふうまくんじゃない！　会えて嬉しいわ……運命を感じてしまいそう、フフッ","en":"Ah, could it be...? Fuuma-kun! It's not Fuuma-kun! I'm so happy to see you... I feel like it's fate, hehe..."},"clip":"Audio/Voice/uni00271_1/uni00271_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ねぇ、お膝に来てくれる？　変なことなんてしないわよ。耳かきをしてあげるだけ。……ね？","en":"Hey, come sit on my lap? I won't do anything weird, I promise. I'll just scratch your ears for you... okay?"},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ん？　何してるの？　……あぁ、課題ね。私も一緒にやっていい？","en":"Huh? What are you doing? ...Oh, homework, right? Can I help you with it?"},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"次のお休みの日って何か予定ある？　もしないのなら、お買い物につきあってほしいんだけど……駄目？","en":"Do you have any plans for the next day off? If not, I was thinking maybe you could accompany me shopping... would that be okay?"},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"え？　お腹が空いたの？　……じゃあ、何か作ってあげるね。ふうまくんは、何が好き？","en":"What's wrong? Are you hungry? ...Well, in that case, I'll make something for you. What does Fuuma-kun like?"},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"何か疲れてるように見えるよ？　今日はゆっくりお風呂に入ったら？　背中流してあげるから","en":"You look like you're tired. Why don't you take a relaxing bath today? I'll wash your back for you."},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"離れたくないの、あなたと……絶対に。ずっと傍にいる為なら、私は……何だってするわ","en":"I don't want to be apart from you... ever. If it means I can be by your side, I'll do anything."},"clip":"Audio/Voice/uni00271_1/uni00271_1_hom_6.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00271_1/uni00271_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00271_1/uni00271_1_atk_2.ogg"},{"type":"atk","l