0007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"若様、私の鎖遁の術からは逃れられませんわよ。たとえ若様が拒絶されようとも、この鉄華院カヲル、無理矢理にでも従いますから。ふふっ","en":"You can't escape my Chain Escape Technique, Master. Even if you try to resist, I, Tekkain Kaworu, will make you obey me by force. Hehehe."},"clip":"Audio/Voice/uni00581_1/uni00581_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私は夜に薫る華、と呼ばれておりますが……できれば若様のおそばでそっと咲く小花でありたいですわ","en":"They call me the flower that blooms in the night... But I'd rather be a small, delicate flower that blooms by your side, Master."},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"闇家業が板についてしまった私には、あなた様は眩しく見えますわ。良き友、良き従者に恵まれましたね","en":"You shine so brightly, Master... It's dazzling. You're surrounded by good friends and loyal followers, aren't you?"},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふぅ……。このカクテルはなかなかいけますわね。どうですか、若様もご一緒に","en":"This cocktail is quite good, isn't it, Master? Would you like to join me?"},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"手駒を増やすのにパーティは持ってこいなんだけど、粘着質な男は本当に面倒だわ","en":"I need to attend parties to gather more allies, but it's so annoying to deal with clingy men."},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"万が一あなたがアミダハラ監獄に身を堕とすようなことがあれば、私が便宜を図ってあげてもいいわよ？","en":"If you ever find yourself in a tight spot in Amida Prison, I'll be happy to help you out, Master."},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"若様に見つめられるのは、とても気分がいいですわ。このドレス、気に入っていただけましたか？","en":"It feels wonderful to be looked at by you, Master... Do you like this dress?"},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"若様、カクテルはいかがです？　あら、私と杯を交わすのは嬉しくありませんか？　ふふっ、冗談です","en":"How's your cocktail, Master? Ah, I'm just joking, but it's nice to share a drink with you, isn't it? Hehehe."},"clip":"Audio/Voice/uni00581_1/uni00581_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"こんなカクテル……おいしくなんてないのにっ、飲んでしまう……！　どろどろの汁ゴックンして……ああっ、ザーメンおいしい！","en":"This cocktail is disgusting... But I'll drink it anyway...! I'll gulp down the gooey liquid... Ah, the semen is delicious!"},"clip":"Audio/Voice_r18/uni00581_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"陰毛まで入って汚いのに……っ、くはぁ、生臭くてっ、気持ち悪いくらい塩辛いのに……っ、ザーメン飲んで感じてる……っ！","en":"It's dirty, with even pubic hair getting in the way... But I'll drink it, feeling the salty, fishy taste... The semen is making me feel so good..."},"clip":"Audio/Voice_r18/uni00581_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00581_1/uni00581_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"cli