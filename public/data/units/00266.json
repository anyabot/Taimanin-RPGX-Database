,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"五車学園で教師をしている、蓮魔零子だ。……あぁ、貴様だったのか。こんなところで何をしている？","en":"I'm Hasuma Reiko, a teacher at Gosha Academy... Ah, so it's you. What are you doing here?"},"clip":"Audio/Voice/uni00266_1/uni00266_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"貴様は……少しは勉学に励め。正直、見ていて不安になる","en":"You... should at least study a bit. Honestly, watching you makes me uneasy."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"はぁ？　ここが分からないのか？　……はぁ、分かった。教えてやる。ただし、徹底的にな","en":"Huh? You don't get this? ...Fine, I understand. I'll teach you. But I'll be thorough."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おい、甘えるな。私は貴様に気を許した訳ではないぞ","en":"Hey, don't get soft. I haven't lowered my guard for you."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"貴様の劣等生っぷりには呆れるが……私が関わってしまったからには少しはマシにしてやらなくてはな","en":"I'm amazed by how much of an underachiever you are... Since I'm involved, I have to make you a bit better."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あのなぁ、私と貴様は教師と生徒だ。……そこを分かっているのか？","en":"Listen, I'm your teacher and you're my student... Do you get that?"},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"貴様には真剣味が足らん。弛んでいる証拠だ、私が根性を叩き直してやる","en":"You lack seriousness. It's proof you're slacking, so I'll toughen you up."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"試験の結果を見せろ。貴様のことだ、どうせひどい点数を……ん？　なかなかいい成績ではないか。これは驚いた、褒めてやる","en":"Show me your exam results. As for you, I expect terrible scores... Huh? Not bad at all. I'm surprised, I'll praise you."},"clip":"Audio/Voice/uni00266_1/uni00266_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00266_1/uni00266_1_msr_1.ogg"},{"type":"msr",