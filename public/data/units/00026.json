oice/uni00026_1/uni00026_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふふ、のんびりしている様に見えるけど大丈夫なのかしら？","en":"\"Hehe, you look all relaxed, but are you really okay?\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あまり女性をジロジロ見る物じゃないわよ。まあ、私はなれているけど♪","en":"\"Don't be staring at women all the time. Well, I'm used to it though♪\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"そんなに緊張しなくて良いのよ、何かあったら助けてあげるわ♪","en":"\"You don't have to be so nervous; I'll help you out if anything comes up♪\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ん～……最近デスクワークが多くてちょっと身体が鈍り気味ね","en":"\"Hmm… I've been doing a lot of desk work lately, so my body feels a bit sluggish.\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"花と呼ばれて嫌がる女はいないわ。でも、綺麗な花には棘があるものよ♪","en":"\"No woman hates being called a flower. But beautiful flowers do have thorns, you know♪\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私は“花の静流”植物ならなんでも意のままに操ることからそう呼ばれているの","en":"\"I'm called 'Flower Shizuru' because I can control any plant at will.\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"元気な男の子は嫌いじゃないけれど、あまりイタズラが過ぎるようなら……ふふふ♪","en":"\"I don't mind energetic boys, but if they get too mischievous… hehe♪\""},"clip":"Audio/Voice/uni00026_1/uni00026_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00026_1/uni00026_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00026_1/uni00026_1_atk_2.ogg"},{"type":"atk","label":"