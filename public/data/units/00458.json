o00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"おめかししてみたんだ。なかなか色っぽいだろ～？　イメチェンしてみりゃあ、酒の味も変わるかもしれねぇな！　さ、飲むぞ～！","en":"I dressed up. Not bad, huh? A makeover might even change the taste of my booze! Come on, let's drink~!"},"clip":"Audio/Voice/uni00458_1/uni00458_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"この格好だと皆、結構奢ってくれるんだよ～。はぁー！　タダで飲む酒も美味いよな～♪","en":"When I wear this, everyone pretty much buys me drinks~. Ahh! Free booze tastes great~♪"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"おっ、視線を感じるね～。アタシを肴に飲んでくれても構わんよ～","en":"Oh, I feel your gaze~. I don't mind if you drink with me as a snack~"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あははっ、まだまだ全然酔ってないってばっ、おっとっと……","en":"Ahaha, I'm still not drunk at all, oops…"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"今日はセレブな気分なんで、ちょっと良いボトルでも開けてみようかねぇ。アンタも一杯どうだい？","en":"I'm feeling fancy today, so maybe I'll open a nice bottle. How about you have a drink too?"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"中身が変わってないって？　言うじゃねーか、当社比120％くらいキャパあがってるってーの。試してみっか？","en":"You say the contents haven't changed? I tell ya, my capacity's up about 120% compared to before. Want to try?"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"へへっ、エスコートしてくれてもいいんだぜ。次の居酒屋にな♪","en":"Hehe, you can escort me if you want. Next stop, an izakaya~"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"おおっ、ちょっとふらっときた……。ま、もうちょい大丈夫だろ～♪","en":"Whoa, just popped in casually… well, I should be fine for a bit longer~"},"clip":"Audio/Voice/uni00458_1/uni00458_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ま、いいから飲んでいきなよ。売上に貢献してくれたら特別サービスもつけるよ♪　飲も～☆","en":"Whatever, just keep drinking. If you boost sales I'll throw in a special service~ Drink up~☆"},"clip":"Audio/Voice_r18/uni00458_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ふふ……っ、なーにじっと見てるんだよ？　背中がヤケドしちまいそうだぜ。なーんてなっ♪","en":"Hehe… what are you staring at? My back's about to get sunburned. Just kidding~"},"clip":"Audio/Voice_r18/uni00458_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00458_1/uni00458_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00458_1/uni00458_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00458_1/uni0