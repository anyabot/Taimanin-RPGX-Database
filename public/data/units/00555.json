"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"眞田咲よ……焔姉さんの仇は、私が必ず討つっ……まりさん、ゆきかぜさん、アスカさんたちとともに――","en":"I'm Sanada Saki... I'll definitely avenge my sister, Sanada Homura... with the help of Mari, Yukikaze, and Asuka..."},"clip":"Audio/Voice/uni00555_1/uni00555_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あなたが――首領たちが仰っている、ふうま小太郎……？　だとしたら、ここは異次元……並行世界の、過去ということ……？","en":"You're... the one the leaders call Fuuma Kotaro? If so, this must be a different dimension... a parallel world's past..."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あなたの力は、とてもすばらしいと思う……大勢で戦うことの大切さを、誰よりも知っている戦い。私はそれを怠って……馬鹿なことをしたわ","en":"I think your power is truly remarkable... a battle that knows the importance of fighting together. I was careless and did something foolish..."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"焔姉さんの仇を討つため、私は単身でブレインフレーヤーに挑んで……戦えなくなった。再び力をくれたまりさんにはすべてを捧げて尽くすつもり","en":"To avenge my sister, I challenged Brain Flayer alone and ended up unable to fight. But thanks to Mari, who gave me new power, I'll dedicate everything to her."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この槍は、姉さんの形見……まりさんから、そう聞いてる。私は、一人じゃない……みんなと、姉さんとともに戦っているの","en":"This spear is a memento of my sister... Mari told me that. I'm not alone... I'm fighting with everyone and my sister."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あの……ふうま様と、呼んでもいい？　命の恩人のまりさんや、ゆきかぜさんたちからも信頼の厚い方だから……","en":"May I call you Fuuma-sama? You're a person of great trust, not just to me, but to Mari and Yukikaze as well..."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"姉さんとは性格が違うって……ええ、よく言われる。私は姉さんのようにはなれない、そんなに強くないから……だからこそ、やれることをやる","en":"People say I'm different from my sister... yes, that's true. I'm not as strong as she is, so I'll do what I can."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふうま様と肩を並べて戦えるなんて、夢のよう……どうかご命令を。あなたの指揮で戦えることを、誇りに思います","en":"To be able to fight alongside Fuuma-sama is like a dream... please give me your orders. I'm honored to be able to fight under your command."},"clip":"Audio/Voice/uni00555_1/uni00555_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"っ……どれだけ犯されようと、屈服なんてしないっ……私には、果たすべき目的がある……それを果たす日までは――んぅっ、あぁぁっっっ！","en":"No matter how much I'm violated, I won't surrender... I have a purpose to fulfill... until that day..."},"clip":"Audio/Voice_r18/uni00555_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"はいぃっ、ごめんなさいっ、私が間違っていましたぁっ！　私は、ザコでっ……ゴミクズでっ……なんの価値もない、性処理女ですぅっっ！","en":"Yes, I'm sorry... I was wrong... I'm just a disposable, worthless sex object..."},"clip":"Audio/Voice_r18/uni00555_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00555_1/uni00555_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0403_r18"]],"stills":[["chr_0403a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":"2022-01-31","end":"2022-02-14"},{"kind":"spark","title":null,"need":30,"start":"2024-08-01","end":"2024-08-31"}],"standardPool":true,"art":{"graphicId":"uni_00555","graphicNum":2,"r18GraphicId":"uni_00555_r18","r18GraphicNum":2,"spineId":"Chr_0403"}}