0014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「リリスです！　伝説の大魔女……というのはおばあ様の事ですが、いつかは私もすごい魔女になりますから！」","en":"I'm Lilith! The legendary great witch… that's my grandma, but someday I'll become an amazing witch too!"},"clip":"Audio/Voice/uni00020_1/uni00020_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はいは～い、私の準備はバッチリですよ！　なんでもバッチコイです♪","en":"Yep yep, I'm all set! Anything's a perfect fit♪"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"う、うわあああ！？　ど、どこ触ってるんですか！　やめて下さいよもうっ！","en":"W-what!? Where are you touching me! Stop it already!"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふふ、私いい感じですか、よかった～……て、おっぱいの事だったんですか！？","en":"Hehe, am I looking good? Great… wait, were you talking about my breasts!?"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"まだまだ未熟ですが、才能は十分、な、はずです！","en":"I'm still inexperienced, but my talent's plenty, I think!"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ベリリク～また失敗しちゃいました……でも、へこたれませんよ！","en":"Berylic~ I messed up again… but I won't get discouraged!"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"はい！　私のおばあ様は伝説の大魔女って呼ばれてて、私はその名を継いだんです！","en":"Yes! My grandma is called the legendary great witch, and I inherited that name!"},"clip":"Audio/Voice/uni00020_1/uni00020_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"伝説の大魔女って呼ばれたお