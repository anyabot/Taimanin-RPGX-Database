19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ノマド騎士軍所属、『嵐騎』リーナだ。私に勝てば協力をしてやろう！」","en":"I'm Lina of the Nomad Knight Corps, the Storm Rider. Beat me and I'll cooperate!"},"clip":"Audio/Voice/uni00021_1/uni00021_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ん、なんだ？　まさか……なんの用もなく私を呼びつけたわけではないだろうな？","en":"Hm? What is it? You didn't just call me here for no reason, did you?"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"貴様！　人間の分際で騎士を愚弄するつもりか！","en":"You! How dare you mock a knight as a mere human!"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"これでも『嵐騎』の二つ名を授かっているんだ。どうだ、すごいだろう？","en":"Even so, I've been granted the title \"Storm Rider.\" How's that, impressive, right?"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"なに？　そ、それくらい知っているに決まっているだろ！　た、食べ物の名前だろ？　え、違う？","en":"What? Of course I know that! It's… a food name, right? Wait, no?"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ううん……最近人間共の空気に染められている気がする……うわっ！？　い、いつからそこに！？","en":"Ugh… lately I feel soaked in human atmosphere… Whoa! Wh-when did you appear there!?"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私はノマドの誇り高き騎士、リーナ。真の騎士の力を見せてやる。正々堂々、私と勝負しろ！！","en":"I am Lina, proud knight of the Nomads. I'll show you the true power of a knight. Fair and square, face me!!"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"騎士の名において脆弱な精神はゆるさん、たたき直してやる！　当然貴様もだ！","en":"In the name of a knight, I won't tolerate a weak spirit—I'll crush it! And you, of course!"},"clip":"Audio/Voice/uni00021_1/uni00021_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00021_1/uni00021_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0021_r18"]],"stills":[["chr_0021a_r18"]],"obtain":[{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【魔性】"},"start":"2025-05-01","end":"2025-05-31"}],"standardPool":true,"art":{"graphicId":"uni_00021","graphicNum":3,"r18GraphicId":"