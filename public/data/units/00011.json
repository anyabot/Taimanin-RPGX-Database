,[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00011",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00011",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00011",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「私の名前は知ってるわよね？　鬼腕の対魔忍、紫藤凜花の眼鏡にかなう力があるか見せて貰うわよ？」","en":"You know my name, right? The demon-armed Taimanin Shido Rinka—let's see if you've got the power to match these glasses."},"clip":"Audio/Voice/uni00011_1/uni00011_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"先輩に対して何かお願いをするんだったら、筋はしっかり通しなさいよ？","en":"If you're going to ask a senior for something, make sure your reasoning's solid, okay?"},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"下級生のくせに、随分生意気な事を言うのね。私は優しい先輩じゃないわよ？","en":"You're just a lowerclassman, yet you're saying such cheeky things. I'm not a kind senior, you know?"},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あら、私に相談事？　そうやって殊勝な態度をとるなら話を聞いてあげてもいいわ","en":"Oh, you have a problem you want to discuss? If you keep that self-righteous attitude, I might just listen."},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"凜子ちゃんが『妹の同級生に面白い男がいる』って言ってたけど……あなたじゃないわよね？","en":"Rinko-chan said there's an interesting guy in her sister's class… it isn't you, is it?"},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"本ばかり読んでいて鈍っているんじゃないの？　私が直々に稽古をつけてあげようか？","en":"All you do is read books and get dull, huh? Want me to give you some personal training?"},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"先輩対魔忍としてこの鬼腕の対魔忍、紫藤凜花があなたの実力をテストしてあげる","en":"As a senior Taimanin, I, the demon-armed Shido Rinka, will test your abilities."},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"次代のエースである私があなたの指揮下に入ってあげるのよ？　下手な事したら容赦しないんだからね？","en":"Since I'm the next ace, I'll join under your command, alright? Don't mess up, or I won't show any mercy."},"clip":"Audio/Voice/uni00011_1/uni00011_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00011_1/uni00011_1_evo_2.ogg"},{"