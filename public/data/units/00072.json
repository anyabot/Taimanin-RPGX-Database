00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「おう、俺が神村舞華だ。しけたツラしやがって、気合い入れてやっから覚悟しろよおら！」","en":"Yo, I'm Kamimura Maika. You got a sour face, so brace yourself 'cause I'm gonna pump you up!"},"clip":"Audio/Voice/uni00072_1/uni00072_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おい、なにボーッとしてやがんだ。しゃきっとしやがれ！","en":"Hey, what the hell are you zoning out for? Snap out of it!"},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あ？　てめえ俺の事舐めてんじゃねえだろうな？　燃やしてやろうか？","en":"Huh? You think you can mess with me? Want me to burn you?"},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ああもうしょうがねえなあ。手伝ってやるから何に困ってるか言ってみろ","en":"Fine, fine, I guess. I'll help—just tell me what you're stuck on."},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふ～……ちっ、ヤニが切れちまった。おい、お前ちょっとパシってこいや","en":"Phew… damn, the tar ran out. Hey, you go fetch some more."},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"はあ？　か、可愛い服なんか俺が着れっかよ！　調子こいてんじゃねえぞ、ああ！？","en":"What? Cute clothes? Like I'd wear that! Don't get cocky, huh!?"},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"おうおうおう！　俺が神村舞華だ！　人呼んで“爆炎の対魔忍”、夜露死苦！","en":"Yo yo yo! I'm Kamimura Maika! Call me the \"Flame-blazing Taimanin\", yo!"},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この神村舞華様をあんまなめてっと、ぶっ飛ばすぞおら！","en":"If you keep underestimating Lady Kamimura Maika, I'll blast you away!"},"clip":"Audio/Voice/uni00072_1/uni00072_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00072_1/uni00072_1_msr_2.ogg"},{"type":"rdy"