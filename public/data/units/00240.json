,640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"お疲れさまです。たまには私と、街までお出かけしませんか？　え――でで、デートではないですっ、お出かけです！","en":"Good work. How about we go out to town together sometime? W-well, it's not a date, just an outing!"},"clip":"Audio/Voice/uni00240_1/uni00240_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"どうしました？　そんなにジロジロ見て……えっ？　ああ、私服で会うのは初めてでしたね、そういえば","en":"What's wrong? Staring at me like that… huh? Oh, it's our first time meeting in civilian clothes, right?"},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あ、あのっ、さっきからずっと見てますけど……どこか変ですか？　えっ……に、似合ってる、ですか……ありがとうございます……はぅ……","en":"Um, uh, I've been watching you the whole time… is something off? …Do I look good…? Thank you… *sigh*"},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"街に行くときも制服や対魔忍スーツじゃ、目立っちゃいますからね……周囲に溶け込む装いも、対魔忍のたしなみです","en":"Even when we go out, wearing the uniform or Taimanin suit makes us stand out… blending in is also a Taimanin's etiquette."},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"え、外出時は制服着用の校則っ！？　そんな校則ありましたっけ……え、ウソ？　もうっ、からかわないでください！","en":"Wait, the school rule says we have to wear the uniform when we go out!? Was there such a rule… huh, kidding? Stop teasing me!"},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"いつか私も、ビジネススーツや白衣の似合う、スラッとした素敵な大人になるんです！　紫おね――いえ、紫先生のように！","en":"Someday I'll be a sleek, wonderful adult who looks good in business suits and lab coats! Like… like Sister Yatsu— I mean, Sensei Yatsu!"},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いつかは紫お姉さまみたいな、カッコよくて強い対魔忍になりたいんです……いえ、なってみせます！","en":"One day I want to be a cool, strong Taimanin like Sister Yatsu… No, I'll become one!"},"clip":"Audio/Voice/uni00240_1/uni00240_1_hom_6.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00240_1/uni00240_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"tex