0009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00402",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00402",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"なんだ、若様……？　あ、いや今はお館様なのか？　まあ、よろしく頼みますよっと","en":"What's up, Master...? Ah, I mean, Captain, right? Well, nice to meet you, I guess."},"clip":"Audio/Voice/uni00402_1/uni00402_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あ、若。時子どっかいきました？　あいつなんか滅茶苦茶迫力増してるんだよなぁ……","en":"Hey, Boss. Have you seen Tokiko? She's gotten a lot more intimidating, hasn't she?"},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あのちっこかった若様がこんなに大きくなってて、すげえ変な感じだ……","en":"It's weird to see you all grown up, Boss... you used to be so small."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おや？　若様もう忍者ごっこはしなくて良いんですか？　アハハッ！　大きくなったもんだ","en":"Hey, Boss, don't you play ninja games anymore? Haha, you've really grown up."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"若、時子のやつはあんなすまし顔してますけど、中身はあんま変ってないですよあれ","en":"You know, Tokiko may look all sweet and innocent, but she's still the same on the inside, if you know what I mean."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"戦闘はないんですか若様？　読書しろ？　それはいいや……","en":"No battles, Boss? Just reading books? That sounds okay, I guess..."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"戦って死ぬなんて怖くねえよ。“悪鬼羅刹”なんて言われるけど、どうでもいい","en":"I'm not afraid of fighting and dying. Being called \"Akki Rasetsu\" doesn't bother me either."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"なんかよく分かんねえけど、『ふうまの敵を倒せ』と言われたら私は戦うだけだ","en":"I don't really get it, but if I'm told to take down the Fuuma's enemies, I'll just do it."},"clip":"Audio/Voice/uni00402_1/uni00402_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あひっ、きゃんきゃん♪　天音は若様の雌犬でしゅぅ☆　ご褒美下しゃいぃ♪","en":"Hehe, kyaa kyaa♪ I'm your pet, Boss☆ Give me a treat, please♪"},"clip":"Audio/Voice_r18/uni00402_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"若様、お手ですか？　おかわりですか？　あぁ、チンチンなんて……ありがとうございますぅ♪","en":"Do you need a hand, Boss? Do you want more? Ah, don't mind the... thank you, I guess♪"},"clip":"Audio/Voice_r18/uni00402_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"お、おあずけなんてヒドイです若様ぁ……！　雌犬天音をお散歩に連れて行って下さいぃ","en":"Oh, leaving me behind is cruel, Boss...! Take your pet, Amane, for a walk, please♪"},"clip":"Audio/Voice_r18/uni00402_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00402_1/uni00402_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0278_1_r18"],["chr_0278_2_r18"]],"stills":[["chr_0278_1a_r18"],["chr_0278_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"exchange","title":null,"start":"2022-08-16","end":"2023-02-27"},{"kind":"exchange","title":null,"start":"2023-08-16","end":"2024-02-27"},{"kind":"exchange","title":null,"start":"2024-09-01","end":"2025-03-15"},{"kind":"exchange","title":null,"start":"2025-08-31","end":"2025-11-30"},{"kind":"exchange","title":null,"start":null,"end":"2026-12-02"}],"standardPool":true,"art":{"graphicId":"uni_00402","grap