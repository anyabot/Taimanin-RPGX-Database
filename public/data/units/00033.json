ndex":1,"text":{"ja":"「対魔忍、由利翡翠……それだけって……？　うん、よろしく」","en":"\"Taimanin, Yuri Hisui… that's all? Yeah, nice to meet you.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"……ん、なにか用かと思って。別にないの？　そう……","en":"\"…Hmm, I thought you had something for me. Nothing? I see…\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"提案をして貰って悪いけど……全然興味ないの","en":"\"Sorry for the suggestion, but I'm really not interested at all.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"特に話す必要が無いと思っただけで、嫌がってはないから安心して","en":"\"I just thought there was no need to talk, but I'm not refusing, so don't worry.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"よく趣味とか好きな物を聞かれるけど、特にない……あ、でも動物は可愛くて好きかな","en":"\"People often ask about my hobbies or likes, but I don't really have any… Ah, but I do think animals are cute.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"その、別に人が嫌いなわけじゃない……むしろ皆大事だと思ってるんだけど……","en":"\"It's not that I dislike people… Actually I think everyone is important…\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"対魔忍、由利翡翠。仲間は絶対に守るから、安心して","en":"\"Taimanin, Yuri Hisui. I'll absolutely protect my comrades, so rest assured.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私の合食の術は効果が出るまで遅いけど、粘り強さが売りだから……うん","en":"\"My combined-food technique takes a while to kick in, but persistence is my strength… yeah.\""},"clip":"Audio/Voice/uni00033_1/uni00033_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00033_1/uni00033_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0033_r18"]],"stills":[["chr_0033a_r18"]],"obtain":[{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【超人】","en":"Kessen Pick-up Gacha (Superhuman)"},"start":"2025-04-01","end":"