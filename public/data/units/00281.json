2",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00281",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00281",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00281",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00281",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"一年の計は元旦にあり――お昼になる前に、気持ちを新たにしておきなさいね","en":"A year's plan starts on New Year's—make sure to refresh your spirit before noon."},"clip":"Audio/Voice/uni00281_1/uni00281_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あけましておめでとう。今年もよろしくね、隊長さん？","en":"Happy New Year. Looking forward to another great year, Captain?"},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あら、初詣？　結構なことね、年始のお参りは気が引き締まると同時に、自身の目標を定められる、いい機会になるわ","en":"Oh, a first shrine visit? Not bad, New Year's prayers sharpen your mind and let you set goals—a great opportunity."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふっ、先生とお参りすることになるなんて、気が休まらないかしら？　私もオフなのだから、気を張らなくていいのよ？","en":"Heh, going to the shrine with Sensei, you can't relax? I'm off as well, so you don't have to push yourself."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お参りも済んだし、少し休んで行かない？　お茶屋さんがあるわ……あのお店の抹茶ぜんざいがおいしいって、さくらが言っていたかしら","en":"Now that the shrine visit's over, want to take a little break? There's a tea shop... I heard Sakura say their matcha zenzai is delicious."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"今日のことは、みんなには内緒よ？　生徒の一人を贔屓したと思われたら、大変だもの……もちろん、時子先生にもね？","en":"Keep today secret from everyone, okay? If I'm thought to be favoring a student, that'll be trouble...including Sensei Tokiko, of course."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"一応はオフだけれど、これでも挨拶回りの途中なのよ……まぁ、一緒にお参りする時間くらいは、あると思うわ","en":"I'm technically off, but I'm still on my rounds...well, we should have time to go to the shrine together."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私が言うのもなんだけれど……さすがはふうまの当主様ね。紋付の礼装、とてもよく似合っているわ","en":"I know I'm the one saying this, but as expected of the Fuuma head, that crested formal wear looks perfect on you."},"clip":"Audio/Voice/uni00281_1/uni00281_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00281_1/uni00281_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00281_1/uni00281_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00281_1/uni00281_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00281_1/uni00281_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip"