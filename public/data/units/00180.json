on":"atk_down"}]}},"leader":{"name":{"ja":"小悪魔の誘惑"},"detail":{"ja":"精神属性ユニットのATKを大アップ"},"effects":[{"text":"Spiritual allies: ATK +20%","icon":"atk_up"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"こんばんは。私は夢魔ミーティア。どんな夢が見たいですか？","en":"Good evening. I'm Metier, the dream succubus. What kind of dream would you like to see?"},"clip":"Audio/Voice/uni00180_1/uni00180_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私はミーティアと言います。依頼を受けて誰かに夢を見せるのを仕事にしています。ええ、夢魔ですから","en":"My name's Metier. I take commissions to show people dreams. Yes, I'm a dream succubus, after all."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私の見せる夢は、素敵な夢から悪夢までなんでもあります。でもそれはすべてあなたの願望。それが夢魔ミーティアの見せる夢","en":"The dreams I give range from wonderful fantasies to nightmares. But they're all based on your desires—that's the dream succubus Metier's promise."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私は夢魔ミーティア。夢魔だからといってあなどらないでくださいね。私の見せる夢は現実よりもほんとうなのですから","en":"I'm Metier, the dream succubus. Don't underestimate me just because I'm a dream succubus. The dreams I give are more real than reality itself."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"私は夢魔ミーティア。夢魔だからといって別に夢見がちというわけではありません。夢は見せるもので見るものではないのです","en":"I'm Metier, the dream succubus. Just because I'm a dream succubus doesn't mean I'm prone to daydreaming. Dreams are meant to be shown, not merely seen."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あなたの見る夢はどんなでしょう。夢魔ミーティアは、ただ夢を見せるだけ。夢を見るのはあなた自身なのです","en":"What kind of dream do you see? Dream succubus Metier only shows dreams. It's you who actually experiences them."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"夢魔ミーティアの見せる夢は現実と同じ。だからずうっとその中で暮らしてください。朽ち果てるまで","en":"The dreams I show are just like reality. So live inside them forever—until you decay."},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"依頼ですか？　いったい誰に夢をみせればいいのかしら。素敵な夢？　それとも悪夢？　それとも淫らな夢かしら","en":"A commission, huh? Who exactly am I supposed to give a dream to? A wonderful dream? A nightmare? Or perhaps a lewd one?"},"clip":"Audio/Voice/uni00180_1/uni00180_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00180_1/uni00180_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"A