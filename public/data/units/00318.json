o00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"春風の如く！　井河さくら、参上！　はーい、挨拶は終わったね！　じゃっ、お花見行こう♪","en":"Like the spring wind! Igawa Sakura, here I come! Okay, the greeting's done! Now, let's go cherry-blossom viewing♪"},"clip":"Audio/Voice/uni00318_1/uni00318_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おお～♪　見事に咲いてるねぇ！　ライトアップされた夜の桜は幻想的で美しいよね～。さっすが、私と同じ名前！　な～んちって♪","en":"Whoa~♪ They're blooming beautifully! Illuminated night sakura is so dreamy and gorgeous. No wonder we share the same name! Just kidding~"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"お花見と言ったらお酒でしょ！　盃の中に映る夜桜ぁ～、うーん、風流だねぇ","en":"Cherry-blossom viewing means sake, right! The night sakura reflected in the cup… ah, how refined♪"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"んー……疑ってるなぁ？　まだ酔ってない……酔ってないってばぁ……にゃははは～♪","en":"Hmm… you doubt it? I'm not drunk yet… I'm not drunk, nyahaha~"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お♪　さくらは綺麗だなって？　きみも言うようになったじゃん！　え？　花の桜？　きみ、宿題倍ね♪","en":"Oh♪ You think Sakura's pretty? You're finally saying that too! Huh? Flower sakura? You, double the homework♪"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お花見と言ったらお団子もね～♪　うーん、稲毛屋のお菓子は何食べてもおいしいよね～♪","en":"Cherry-blossom viewing also means dango~♪ Hmm, anything from Inage-ya is delicious~"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"おーいちみたち、一緒にお花見しよ♪　ほらほら、無礼講ぶれーこー！","en":"Hey everyone, let's have a cherry-blossom party together♪ Come on, no-holds-barred drinking!"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"大人にはねぇ、お酒の力が必要なときもあるんだよ～♪　にゃはははは♪","en":"Adults sometimes need the power of alcohol~ nyahaha~"},"clip":"Audio/Voice/uni00318_1/uni00318_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00318_1/uni00318_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text