5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00315",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00315",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00315",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00315",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"秋山凜子だ、よろしく。今日から同じ学舎で鍛錬に励む同志だ、そんなに硬くならなくていい。後輩を導くのも私の勤めだ","en":"Akiyama Rinko here, nice to meet you. From today we're comrades training at the same academy, so no need to be so stiff. Guiding juniors is my duty."},"clip":"Audio/Voice/uni00315_1/uni00315_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"さ、新入生はこちらだ。整列してくれ","en":"Alright, the new students are here. Line up."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"制服はいい。気が引き締まるし、動きやすいので気に入っている","en":"Uniforms are good. They keep me sharp and are easy to move in, so I like them."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふぁん、くらぶ……？　まあ、悪い気はしないが……。何事もほどほどに、深入りしすぎないようにな","en":"Fan club...? Well, it's not a bad feeling... Just take it easy, don't get too involved."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふ。皆、何をもじもじしている。今日はただの課外学習で、危険はない。互いに制服なのだから、気楽に行こう","en":"Hmph. What's everyone hesitating about? Today's just an extracurricular outing, no danger. Since we're all in uniform, let's take it easy."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ああ、構わない。稲毛屋だろう？　付き合おう。あそこの菓子は、私も好物だからな","en":"Sure, I don't mind. Inage-ya, right? I'll go with you. Those sweets over there are one of my favorites, too."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"そこの下級生、ネクタイが曲がっているぞ。衣服の乱れは気の乱れ。きちんと着こなしてこそ、精神も鍛えられるというものだ","en":"Hey junior over there, your tie's crooked. A sloppy outfit means a sloppy mind. Dress properly and you'll strengthen your spirit."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私達は同じ対魔忍。命を賭け、任務を全うする仲間だ。私と話すだけでその緊張では、大事なときに失敗してしまうぞ","en":"We're both Taimanin, comrades who risk our lives to fulfill missions. If you're that tense just talking to me, you'll mess up when it counts."},"clip":"Audio/Voice/uni00315_1/uni00315_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00315_1/uni00315_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0210_1_r18"],["chr_0210_2_r18"]],"stills":[["chr_0210_1a_r18"],["chr_0210_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】新生活応援限定ガチャ"},"start":"2026-04-22","end":"2026-05-06"},{"kind":"spark","title":null,"need":300,"start":null,"end":null}],"standardPool":false,"art":{"graphicId":"uni_00315","graphicNum":2,"r18GraphicId":"uni_00315_r18","r18GraphicNum":2,"spineId":"Chr_0210"}}