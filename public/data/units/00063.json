",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「米連から派遣されたロッカだ。魔族を根絶やしにする為に協力を願う」","en":"I'm Rocca, dispatched from the United Nations. I ask for your cooperation in eradicating the demons."},"clip":"Audio/Voice/uni00063_1/uni00063_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おい、いつまでここで待たせるつもりだ？　早く魔族を倒しに行くぞ","en":"Hey, how long are you planning to keep me waiting here? Let's go take down those demons quickly."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私が魔族以外になら優しいとでも思ったか？　随分甘く見られた物だ","en":"Did you really think I'd be kind to anyone but demons? You seriously underestimated me."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふん……気遣いは無用だ、魔族を倒す目的を邪魔しないなら、不要な波風は私も望まない","en":"Hmph… No need for concern. As long as you don't get in the way of wiping out demons, I don't want any unnecessary trouble either."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"レールアローにあまり触るな。これは私にしか使えない上に整備も簡単じゃないんだ","en":"Don't fiddle with the rail arrow too much. It's a weapon only I can use, and it's not easy to maintain."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この町は、私の住んでいた田舎に少しだけ似ているな……町並みなどは全然違うのに","en":"This town reminds me a little of the countryside I used to live in… even though the streets are completely different."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私の目的は、魔族を滅ぼすこと。暗殺特殊部隊に属しているのもその為だ。協力するのは良いが、邪魔はするな","en":"My goal is to annihilate demons. That's why I'm part of an elite assassination unit. Cooperation is fine, but don't get in my way."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"米連所属、ロッカ、レールアローを主兵装として使っている。魔族の殲滅ならば協力しよう","en":"United Nations operative Rocca, using the rail arrow as my primary weapon. If it's demon extermination you need, I'll cooperate."},"clip":"Audio/Voice/uni00063_1/uni00063_1_hom_7.ogg"},{