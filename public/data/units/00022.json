0,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「よろしく、君に協力すれば良いんでしょ？　お互いの利害が一致してる限りはね」","en":"Alright, I'll cooperate with you, right? As long as our interests line up."},"clip":"Audio/Voice/uni00022_1/uni00022_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"何……？　必要無いのに声かけてこないでくれる？","en":"What…? Don't call out to me when you don't need anything."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"現状何も問題なし、それ以上でもそれ以下でもないよ","en":"At the moment there's no problem—nothing more, nothing less."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふん……どうでもいい。好きにすれば？","en":"Hmph… I don't care. Do as you like."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"やることがあるならさっさとして、無駄な時間使いたくないから","en":"If there's something to do, get on with it. I don't want to waste time."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"君には別に興味ないけど……あまり調子にのってると殺すよ？","en":"I'm not really interested in you, but if you get too cocky I'll kill you."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"なに？　私はもう対魔忍とかどうでもいいの、それ以上うざいと殺すよ？","en":"What? I don't give a damn about being a Taimanin anymore. If you keep being annoying I'll kill you."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"うざい敵は殺すだけ。君も敵になる？　なら殺すだけだけど","en":"Annoying enemies just get killed. You becoming an enemy? Then I'll just kill you."},"clip":"Audio/Voice/uni00022_1/uni00022_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00022_1