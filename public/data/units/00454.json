014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"装備が新しくなったよ。これで君の事……もっと守ってあげられるから、安心してね","en":"The gear's been upgraded. Now I can protect you even more, so don't worry."},"clip":"Audio/Voice/uni00454_1/uni00454_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の新装備、どうかな、似合ってる？　そう……むふー","en":"What do you think of my new gear? Does it suit me? Yeah… *muh*"},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"今度の武器は、こっちで攻撃したあとすぐ反対側でこうできる……強い","en":"The new weapon lets me strike here and instantly hit the opposite side… it's strong."},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"えいっ、やっ……！　新装備の具合は中々、錫杖も使いやすい。それに、格好いい","en":"Take that! …! The new gear feels great, the tin staff's easy to use too. And it looks cool."},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"仲間を守る為には攻撃も大事。もちろん防御はそれ以上に大事、えへん","en":"Attacking is important to protect my comrades. Of course defense is even more important, eheh."},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"新しいスーツはちょっと露出が増えた、ほらこことか肌が見えて……なんで慌ててるの？","en":"The new suit is a bit more revealing—look, you can see some skin… why are you panicking?"},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"おニューの装備……一番最初に君に見てもらえて良かった","en":"The new gear… I'm glad you were the first to see it."},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この対魔忍スーツは動きやすく作られてる。ぽろり……？　した事は無いけど……どう思う？","en":"This Taimanin suit is made for mobility. A slip…? I haven't… but what do you think?"},"clip":"Audio/Voice/uni00454_1/uni00454_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ふふふ……君の視線ずっと感じてたから、ほら、こんなにグショグショでもっと見て欲しいの、わかるよね……♪","en":"Hehe… I've been feeling your eyes on me, so look, I'm all drenched… you want to keep watching, don't you…♪"},"clip":"Audio/Voice_r18/uni00454_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"じゅる……♪　もう我慢出来ないから、君をいっぱい気持ち良くさせちゃう……♪","en":"Slurp…♪ I can't hold back any longer, I'll make you feel amazing…♪"},"clip":"Audio/Voice_r18/uni00454_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"もう、おっきくなってるね……私を見て興奮してくれたんだから、私が責任持って気持ち良くする……♪","en":"You're already getting hard… you got turned on watching me, so I'll take responsibility and make you feel good…♪"},"clip":"Audio/Voice_r18/uni00454_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00454_1/uni00454_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/V