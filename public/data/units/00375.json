":"paralysis","tag":"ailment","ref":"ab:2"},{"text":"All enemies: ATK -25% for 4 turns","icon":"atk_down","tag":"debuff"}]}},"leader":{"name":{"ja":"野生の血潮"},"detail":{"ja":"超人属性ユニットのATKを大アップ"},"effects":[{"text":"Superhuman allies: ATK +20%","icon":"atk_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"がるるる。獣王会のトラジローだぞ！　人間なんて全員うんこだが、特別にお前には力を貸してやるのだ！","en":"Grrr... I'm Torajiro of the Beast King Society! Humans are all worthless, but I'll lend you my strength - just this once."},"clip":"Audio/Voice/uni00375_1/uni00375_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふんっ、獣人はほこり高い種族だぞ。簡単に人間なんかに懐かないんだからなっ","en":"Hmph, beastmen are a proud species. We don't easily take a liking to humans, got it?"},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"にゃっ？　オレが強そうでカッコいい？　ふにゃあぁ……お前、なかなか分かってるやつなのだ……♪","en":"Nyaa? You think I look strong and cool? Hehe, you're not so bad yourself... I suppose you're pretty perceptive."},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お前、兄貴がどこに行ったか知らないか？　まったく、兄貴はオレがいないとぜんぜんダメなんだからっ","en":"Hey, do you know where my brother-figure went? Honestly, he's useless without me."},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"働きのほうしゅーはお肉でいいぞ！　みんなで焼き肉パーティーするのだ！","en":"Meat is the best reward! Let's have a barbecue party with everyone!"},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"こうしてお前に協力してるけど、オレのホームは獣王会だぞ。あいつらはダメダメだけどオレの家族だから","en":"Even though I'm cooperating with you, my home is still the Beast King Society. They're a bunch of idiots, but they're my family."},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お前は人間のわりにできるやつだな。兄貴の次にスゴイと認めてやるのだ！","en":"You're not like other humans - you're actually capable. I'll give you credit, you're almost as good as my brother-figure."},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふにゃ！？　あ、頭をかいてくれるのか……？　はうぅ、仕方がないにゃあ……存分にカイカイして良いのだ……♪","en":"Hehe, you're going to scratch behind my ears? Oh, I suppose it's okay... go ahead and pet me all you want."},"clip":"Audio/Voice/uni00375_1/uni00375_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"にゃううぅ……なんだかおまたがもじもじして……なぁお前、これはどうしたらいいのだ……？","en":"Nyaa... my tail is twitching... what's going on? Hey, what should I do about this?"},"clip":"Audio/Voice_r18/uni00375_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ふにゃあぁ、体が熱くてたまらないぞ……こ、これだから、人間はゆだんできないのだ……","en":"Hehe, my body is burning up... ugh, humans are just so frustrating."},"clip":"Audio/Voice_r18/uni00375_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"はううぅぅ……だ、ダメだぞ……こんなえっちな姿、あにきに見られでもしたら……っ","en":"Ahhh, no way... if my brother-figure saw me like this..."},"clip":"Audio/Voice_r18/uni00375_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00375_1/uni00375_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0255_1_r18"],["chr_0255_2_r18"]],"stills":[["chr_0255_1a_r18"],["chr_0255_2a_r18"]],"obtain":[{"kind":"event","type":"Map event","title":{"ja":"Map event #16","en":"Map event #16"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"origin":"Event","art":{"graphicId":"uni_00375","graphicNum":2,"r18GraphicId":"uni_00375_r18","r18GraphicNu