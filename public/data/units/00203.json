4",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"メイドのユーリヤと申します……よ、よろしくお願いします、ご主人様！","en":"I'm Yulia, the maid... nice to meet you, Master!"},"clip":"Audio/Voice/uni00203_1/uni00203_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あわわわわ、花瓶がっ……も、申し訳ありません！","en":"Whoa, the vase... I-I'm so sorry!"},"clip":"Audio/Voice/uni00203_1/uni00203_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふぅ……今日はなにも壊しませんでしたよ、えへへっ","en":"Phew... I didn't break anything today, hehe."},"clip":"Audio/Voice/uni00203_1/uni00203_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"本日のお夜食は、ユーリヤがご用意したんですけど……いかがですか？","en":"I prepared tonight's snack, how about it?"},"clip":"Audio/Voice/uni00203_1/uni00203_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はぁ～、いい天気ですね……これなら洗濯物も、よく乾きそうです","en":"Ahh, what nice weather... the laundry should dry nicely."},"clip":"Audio/Voice/uni00203_1/uni00203_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"夜、部屋に来るように、ですか？　はい、かしこまりました","en":"You want me to come to your room at night? Yes, understood."},"clip":"Audio/Voice/uni00203_1/uni00203_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いつも失敗ばかりですけど、見捨て