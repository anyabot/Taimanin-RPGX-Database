,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あたしは暴力教会のクソ尼、エダってもんだ。儲け話なら大歓迎――あっ、お、お前か。いや、これは例の映画の台本読みでな……","en":"I'm Edá, a damn nun from the Church of Violence. I'm all for a profit scheme—oh, it's you. No, this is just a read-through of that movie script…"},"clip":"Audio/Voice/uni00607_1/uni00607_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ここの台本読みに付き合ってくれないか？　『この田舎もん！　原版はこっちのもんだ……く、クソッ……タレ……』や、やっぱり別の所にしよう","en":"Want to join me in reading this script? \"You country bumpkin! The original is ours… damn… slime…\" Maybe we should pick something else."},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"この格好、思った以上に動きづらいな……この姿で大立ち回りをする彼女には脱帽だよ。しかも酔っていてもあの動きだろう？","en":"This outfit is more restrictive than I thought… seeing her go all-out like this, I'm impressed. And even drunk she moves like that?"},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"彼女の話は結構教養になる事も多いんだぞ……例えば聖典の一節に曰く『厄介事を持ち込むなこのアマ』だそうだ","en":"She actually teaches me a lot… For example, a holy text says, \"Don't bring trouble, you bitch.\""},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"エダの事はとても尊敬できる女性だと感じたが、いざ演じるとなると台詞回しが……ええと、結構独特でな。もっと練習しなくては","en":"I respect Edá as a woman, but when it comes to performing, her line delivery is… well, pretty unique. I need more practice."},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あやめ？　彼女は留守だぞ。休暇を取ってベガスに……いや！　これはエダの真似じゃなくて本当に……ああ、もうややこしいな！","en":"Ayame? She's not here. She took a vacation to Vegas… no! This isn't Edá's imitation, it's real… Ah, this is getting messy!"},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"付き合えよふうま、ダチだろ！　……う、うぅ、彼女のようにすれば気負わず誘えるかと思ったが、余計に恥ずかしいだけだったな","en":"Come on, Fuuma, you're a buddy! …Ugh, I thought if I acted like her I could invite you without feeling self-conscious, but it just made it more embarrassing."},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"彼女の祖国への気持ち、正直私も重なる所は多い。私も彼女のように、どんな状況に翻弄されようと自分の信念だけは最後まで曲げずにいたいな","en":"I honestly share a lot of her feelings toward her homeland. Like her, I want to stay true to my convictions no matter how I'm tossed around."},"clip":"Audio/Voice/uni00607_1/uni00607_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00607_1/uni00607_1_lup_1.ogg"},{"type":"msr","label":"