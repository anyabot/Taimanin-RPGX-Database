],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あけまして、おめでとうございます……こんな華やかな服、初めてです……に、似合います、か……？","en":"Happy New Year... I've never had such fancy clothes before... Do they... suit me?"},"clip":"Audio/Voice/uni01011_1/uni01011_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"これがおせち料理ですか、とってもキレイですね……な、なにか、食べるときのお作法とかはあるんでしょうか……ゴクリ……","en":"Is this osechi? It's so beautiful... Are there any proper manners for eating it...? *gulp*"},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"一年の初めに、神様へのご挨拶をするっていう、初詣……こんなに大勢で押しかけて、神様に把握していただけるんでしょうか……","en":"At the start of the year we do hatsumode, greeting the gods... With so many people crowding, will the gods notice us...?"},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お正月は、お店の屋台がたくさん出ていますねぇ……どれもおいしいですけど、食べ過ぎないようにしないといけませんね","en":"During New Year, there are lots of stalls... they all look tasty, but we have to make sure not to overeat."},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"よっ、ほっ、はっ……うふふ、どうですか？　近所の子供たちと、よく遊んでいるので……羽根つき、得意になっちゃいました","en":"Yo, ho, ha... hehe, how's it? I often play with the neighborhood kids... I'm pretty good at hanetsuki now."},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"コタツ、大好きなんですけど……着物では、どうやって入ったらいいのか……えっ、ぬ、脱ぐんですかっ？　わ、わかりました……","en":"I love kotatsu... but in a kimono, how do you get in... eeh, d-do I have to take it off? Got it..."},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"本当に、よかったんですか？　こんな、素敵な着物……い、いつか、お代金はお支払いしますのでっ……！　それまで、い、一緒に……","en":"\"Is it really okay? This lovely kimono… I-I'll pay for it someday…! Until then, let's stay together…\""},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"どうぞ……あ、あ～ん、してください……来年は、このお料理……私も、作れるようになっておきますから……ね？","en":"\"Please… a-ah—mmm, do it… Next year, this dish… I'll learn to make it too… okay?\""},"clip":"Audio/Voice/uni01011_1/uni01011_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あひっっ♪　んっ、だ、だめぇ……ほぉっ、おっ……お着物ぉ……んよっ、汚れ、ひゃい、ますぅ……んひぃぃっ♪","en":"\"Ahh♪ nnh, no—no… ho—oh… the kimono… it's getting dirty… nnhii♪\""},"clip":"Audio/Voice_r18/uni01011_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"はい？　えっ……あ、はい……こんな、お外で……うぅ、わかりました……勃起チンポ、お口で……ご奉仕、させてもらいます……","en":"\"Huh? Wh-what… okay… here, outside… ugh, I understand… I'll serve your… erection with my mouth…\""},"clip":"Audio/Voice_r18/uni01011_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"あむぅぅぅ……んむっ、ぢゅぱぁ……じゅるっ、んぇぇぇ……えっろぉぉぉぉ……んちゅっ、いひゅれもぉ、らひて、くゃはぁい……♪","en":"\"Amm… nmu, ju-pa… juru… nēē… erooo… nchu, ihuremo, rahite, kyahai…♪"},"clip":"Audio/Voice_r18/uni01011_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01011_1/uni01011_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_1011_r18"]],"stills":[["chr_1011a_r18"]],"obtain":[{"kind":"gacha","type":"Limited","title":{"ja":"正月限定ピックアップガチャ"},"start":"2025-12-31","end":"2026-01-16","pull":["Guaranteed 11-pull"]},{"kind":"spark","title":null,"need":100,"start":"2025-12-31","end":"2026-01-16"}],"standardPool":false,"art":{"graphicId":"uni_01011","graphicNum":2,"r18GraphicId":"uni_01011_r18","r18GraphicNum":2,"spineId":"Chr_1011"}}