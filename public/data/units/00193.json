,640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"益田理化学研究所で開発された、日本初のアンドロイド。そのプロトタイプ、ユノーと申します。あなたが私の、新しい所有者ですか？","en":"I am Yuno, the prototype—the first Japanese android developed at the Masuda Rika Research Institute. Are you my new owner?"},"clip":"Audio/Voice/uni00193_1/uni00193_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"肯定します。私はそのために作られた日本初のアンドロイド、そのプロトタイプです","en":"That's correct. I am the prototype, the first Japanese android created for that purpose."},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"サイボーグではなく、アンドロイドです。……とはいえ、この身体の２０パーセントは、生体のままなのですが","en":"I'm not a cyborg, I'm an android…though twenty percent of this body remains biological."},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"この行為にどのような意味があるのですか？　なぜ私の……頭を撫でるのでしょうか？","en":"What does this action mean? Why are you…petting my head?"},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"その程度のことでは、私のボディに傷すら付けられません。無駄な抵抗です。あきらめてください","en":"That level of effort can't even scratch my body. It's a futile resistance. Give up."},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私の顔に何か付いていますか？　そのように間近で観察されましても。その、なんでしょうか、……この高揚感は","en":"Is something on my face? Even being examined so closely…what is this, this exhilaration?"},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"はい。私はあなたのために戦うアンドロイドです。ご命令を……","en":"Yes. I am an android who fights for you. Your orders…"},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お父様の名誉に賭けて、私はあなたを護ります！　私はそのために作られたのですから","en":"In honor of my father's name, I will protect you! I was made for that."},"clip":"Audio/Voice/uni00193_1/uni00193_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00193_1/uni00193_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":nu