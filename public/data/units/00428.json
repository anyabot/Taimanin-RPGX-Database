,[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"お館くん、ハッピーバレンタイン。ガーディアンがチョコになっちゃったけど、バレンタイン仕様ってことかな？","en":"Happy Valentine's Day, Captain. The Guardian turned into chocolate, but I guess that's just the Valentine's version"},"clip":"Audio/Voice/uni00428_1/uni00428_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ガーディアンが気になるの？　ふふ、ちょっと舐めてみてもいいよ","en":"You're interested in the Guardian? Hehe, you can take a little lick if you want"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"腕のリボン可愛いでしょ？　せっかくのバレンタインだしね","en":"Isn't the ribbon on my arm cute? It's Valentine's Day, after all"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"今回、いつもと格好も違うんだけど、お館くんは何を考えていたのかな？","en":"This time, my outfit is different from usual, but I wonder what you were thinking, Captain"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"こういうイベントを、お館くんと一緒に過ごせるなんて思ってなかったから嬉しい","en":"I'm happy we get to spend this event together, Captain - I didn't think that would be possible"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"チョコになっちゃってちょっと弱くなっちゃったと思う？　実はこれはこれで新しい使い方があるの","en":"You think the Guardian's weakened because it turned into chocolate? Actually, this new form has its own uses"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ガーディアンがチョコになっちゃったのは、実体化する時にお館くんが変なことを考えてたせいじゃないかな","en":"I think the Guardian turned into chocolate because you were thinking weird things when I materialized, Captain"},"clip":"Audio/Voice/uni00428_1/uni00428_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あぁ……♪　乳首とお腹の奥がうずくぅ……♪　お館くんに静めてもらわないと、んんぅっ♪","en":"Ah... my nipples and the pit of my stomach are tingling... I need you to calm me down, Captain"},"clip":"Audio/Voice_r18/uni00428_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"せっかくのバレンタインだから、甘いチョコと一緒に私も食べて……♪","en":"It's Valentine's Day, so I'll eat some sweet chocolate with you..."},"clip":"Audio/Voice_r18/uni00428_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"はふ、ふぅ……んん、お館くんに身体をじっと見られてる……んぅ、あぁ、も、もっと見てほしくなっちゃう……！","en":"Hah, fuu... nn, Captain's staring at my body... nn, ah, I want you to look at me more..."},"clip":"Audio/Voice_r18/uni00428_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00428_1/uni00428_1_msr_1.ogg