00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「よろしく、セドナ・アルストナ！　後ろには気をつけなよ！」","en":"\"Nice to meet you, Cedna Arstonna! Watch your back!\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の標的になったものは、逃げられない","en":"\"My targets can't escape.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"このブレードすごいよ！　試しに切ってみようか","en":"\"These blades are amazing! Want to try cutting something?\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あいつは絶対殺す。感情がない私でも誰かを殺す事はできる","en":"\"I'll definitely kill them. Even I, who have no emotions, can kill someone.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ゼロ・ステルスすごく高性能で優れもの。あなたから隠れる事も容易い","en":"\"Zero-Stealth is incredibly high-performance and superior. Hiding from you is easy.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"任務に忠実な最強の兵士として、実験され新しくつくられたのが私","en":"\"As the strongest soldier loyal to the mission, I am the product of a new experiment.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"光学迷彩使わなくても任務なんて簡単。なぜなら私にはこのブレードがある","en":"\"Even without using optical camouflage, the mission is easy—because I have these blades.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"喜怒哀楽に欠け冷めているとよく言われるが、それすらもよくわかっていない","en":"\"They say I'm cold and lack emotions, but I don't even understand that.\""},"clip":"Audio/Voice/uni00049_1/uni00049_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00049_1/uni00049_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip