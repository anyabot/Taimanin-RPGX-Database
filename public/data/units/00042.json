00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ふっ、驚いた顔してるわね。訳あって今日はこの衣装なの。似合うかしら？」","en":"Heh, you look surprised. For a reason I'm wearing this outfit today. I wonder if it suits me?"},"clip":"Audio/Voice/uni00042_1/uni00042_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"さ、これからどうしようかしら。え？　この格好が気になる？　色々あるのよ","en":"Well, what shall we do from now on? Huh? You're curious about this look? There's a lot going on."},"clip":"Audio/Voice/uni00042_1/uni00042_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"確かに露出の多いドレスではあるけれど、あまりジロジロと眺めるのはエチケット違反よ","en":"Sure, it's a revealing dress, but staring at me like that is a breach of etiquette."},"clip":"Audio/Voice/uni00042_1/uni00042_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"今は今後どう動くかに集中しなさい。状況は刻一刻と変わるのだから","en":"Focus on how we'll move forward now. The situation changes by the minute."},"clip":"Audio/Voice/uni00042_1/uni00042_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"こう見えて社交界なんかのマナーは完璧なの。任務としてそういう所に潜入する時必要でしょう？","en":"Believe it or not, I'm perfect at high-society manners. It's necessary when we infiltrate those places on a mission, right?"},"clip":"Audio/Voice/uni00042_1/uni00042_1_hom_4.ogg"},{"type":"hom"