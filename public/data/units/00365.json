blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふうま亜希、祭りのあとの参戦だ。はっぴ姿だが充分に戦えるから、心配はいらない","en":"Fuuma Aki, joining after the festival. It's a happi, but I can fight just fine, so no worries."},"clip":"Audio/Voice/uni00365_1/uni00365_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"参加してみれば、夏祭りは案外楽しいものだな","en":"Give it a try, and you'll find summer festivals are surprisingly fun."},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"さらしにはっぴ、ふんどしか。これはこれで動きやすくて、戦闘も問題ないだろう","en":"A happi over a sarashi, fundoshi. It's easy to move in, and combat's fine."},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ああ、子供達がはしゃぐ姿がいい！　祭りがこんなにも可愛いものだとは思わなかった！","en":"Ah, seeing the kids having fun is wonderful! I never thought a festival could be this cute!"},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"わっしょい、わっしょい！　さあ、みんな元気に声出して！　神輿を力一杯揺らそう！","en":"Wasshoi, wasshoi! Come on, everyone shout with energy! Let's shake the mikoshi with all our might!"},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"そこの可愛い子供達ー！　神輿は重くて危険だからしっかりと担いで。私のあとをついてきてくれ","en":"Hey cute kids— the mikoshi is heavy and dangerous, so hold it steady. Follow me."},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"夏祭りで子供達の引率か。ふふ、気合いが入るな","en":"Leading the kids at the summer festival, huh. Hehe, that gets me fired up."},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"子供達にもこの格好は好評だった。可愛い子達に可愛いと言われるのも悪くない。いや、いい！","en":"The kids liked this outfit too. Being called cute by cute kids isn't bad. Actually, it's great!"},"clip":"Audio/Voice/uni00365_1/uni00365_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"いつものより、サラシの方が胸が固定されていいな。でも……どうしても谷間が出てしまう。ああっ、汗が入って気持ち悪い……","en":"The sarashi holds my chest better than usual. But… it always leaves a cleavage. Ah, sweat gets in and it's disgusting…"},"clip":"Audio/Voice_r18/uni00365_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"魔薬で……身体が熱い……っ。ハァ……愛液が漏れて……っ、ふんどしまでべとべとに、なってる……っ","en":"The demon drug… my body's heating up… Hah… my fluids are leaking… even my fundoshi's all sticky…"},"clip":"Audio/Voice_r18/uni00365_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"祭りのあとも、興奮は冷めないものだな……。ふぅ、シャワーのとき、自分でして……少し解消しないと……っ","en":"Even after the festival, the excitement doesn't fade… *sigh* during a shower, I have to… relieve a bit myself… huh?"},"clip":"Audio/Voice_r18/uni00365_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00365_1/uni00365_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0247_1_r18"],["chr_0247_2_r18"]],"stills":[["chr_0247_1a_r18"],["chr_