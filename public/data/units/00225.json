,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"星乃深月、参りました。学園のＯＧですから、先輩に当たりますけど……お気遣いは不要ですからね、隊長殿？","en":"Mitsuki Hoshino, reporting for duty. I'm an OG of the Academy, so I'm technically a senior… but there's no need for you to worry, Captain?"},"clip":"Audio/Voice/uni00225_1/uni00225_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"この扇ですか？　風遁の術とは相性がいいんです、竜巻を起こしたり、風の刃を飛ばしたり、使いやすくて","en":"This fan? It works great with my wind-style ninjutsu—I can summon tornadoes, launch wind blades, it's really handy."},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"学園の先生方はお元気ですか？　え、私の話を聞いた？　詰めが甘くて、よく注意を……そ、そういうことは、聞かなくていいんですっ","en":"How are the teachers at the Academy doing? Huh, you heard about me? They keep warning me about my loose claws… uh, you don't need to hear that."},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"次の任務まで、少し休暇がもらえそうです。よければ訓練に付き合いませんか？　大丈夫ですよ、死なないように加減しますから","en":"Looks like we'll get a short break before the next mission. If you like, we could train together. Don't worry, I'll hold back so you don't die."},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はぁ……この味、たまりませんっ……ほら、隊長殿も遠慮なくどうぞ。ここのすき焼きは、絶品なんですよ♪","en":"Ah… this flavor is irresistible… Here, Captain, help yourself. The sukiyaki here is absolutely divine♪"},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"疲れましたか？　でしたら、私の家にいらしてください。とっておきの紅茶で、おもてなししますから","en":"Feeling tired? Then come over to my place. I'll treat you to some special tea."},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"得意な術は風遁……立ちはだかる壁はすべて、この扇と風で吹き飛ばして見せます","en":"My specialty is wind-style… any wall that stands in our way will be blown away with this fan and the wind."},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"え？　紅茶が好きなのに、すき焼きと納豆が好きって……なにかおかしいですか？　おかしくない、ですよね？","en":"What? I love tea, but I also love sukiyaki and natto… is that weird? It's not weird, right?"},"clip":"Audio/Voice/uni00225_1/uni00225_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00225_1/uni00225_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0146_1_r18"],["chr_0146_2_r18"]],"stills":[["chr_0146_1a_r18"],["chr_0146_2a_r18"]],"obtain":[{"kind":"event","type":"Story event","title":{"ja":"Story event #8","en":"Story event #8"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_00225","graphicNum":2,"r18GraphicId":"uni_00225_r18","r18GraphicNum":2,"spineId":"Chr_0146"}}