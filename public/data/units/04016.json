,{"text":"Magic allies: crit rate +9","icon":"crt_up","tag":"passive"}]},{"level":6,"description":{"ja":"味方の米連特性のATKを170アップ、味方の魔術特性の会心率を10%アップ"},"effects":[{"text":"UFS allies: ATK +170","icon":"atk_up","tag":"passive"},{"text":"Magic allies: crit rate +10","icon":"crt_up","tag":"passive"}]},{"level":7,"description":{"ja":"味方の米連特性のATKを180アップ、味方の魔術特性の会心率を11%アップ"},"effects":[{"text":"UFS allies: ATK +180","icon":"atk_up","tag":"passive"},{"text":"Magic allies: crit rate +11","icon":"crt_up","tag":"passive"}]},{"level":8,"description":{"ja":"味方の米連特性のATKを190アップ、味方の魔術特性の会心率を12%アップ"},"effects":[{"text":"UFS allies: ATK +190","icon":"atk_up","tag":"passive"},{"text":"Magic allies: crit rate +12","icon":"crt_up","tag":"passive"}]},{"level":9,"description":{"ja":"味方の米連特性のATKを200アップ、味方の魔術特性の会心率を13%アップ"},"effects":[{"text":"UFS allies: ATK +200","icon":"atk_up","tag":"passive"},{"text":"Magic allies: crit rate +13","icon":"crt_up","tag":"passive"}]}]}],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl04016",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl04016",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl04016",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl04016",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl04016",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl04016",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl04016",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"この度のご用命、感謝いたします。情報屋のフルフルの名に懸けて、どのような情報でも、手に入れてみせますよ","en":"Thank you for this assignment. In the name of the information broker Furfur, I'll obtain any information you need."},"clip":"Audio/Voice/uni04016_1/uni04016_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"勘違いなさらないでくださいね。仲間ではなく、あくまで協力関係……どこの陣営にも肩入れするつもりはありませんので","en":"Don't get the wrong idea. We're not allies, just a cooperative relationship… I have no intention of favoring any side."},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"蟲はいいですよ。どこにでもいますし、どこへでも入り込める……情報収集にうってつけだと思いませんか？","en":"Insects are great. They're everywhere and can get anywhere… Don't you think they're perfect for gathering intel?"},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふ、この極秘情報をどうやって手に入れたのかを知りたければ、それなりの対価が必要になりますよ？","en":"Hehe, if you want to know how I got this top-secret info, it'll cost you a suitable price, okay?"},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"どのような蟲を操れるのか、ですか。……ふふっ。秘密です。手の内を晒すような真似はしません","en":"You want to know what kind of insects I can control? …Hehe. That's a secret. I won't expose my hand."},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この子、変わった蟲でしょう？　私が作ったのですよ。製造方法？　ふふっ、秘密です♪","en":"This one's a strange insect, right? I made it myself. The method of creation? Hehe, that's a secret♪"},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私、情報料はお金以外で受け取る事もあるんですよ。例えば、マッサージ……とかね。ふふっ、期待してますよ","en":"I sometimes accept payment for information in forms other than money. For example, a massage… or something. Hehe, I'm looking forward to it."},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私に対価以上の働きを期待するのはやめてくださいね。前からそう言っているでしょう？　…………はぁ、今回だけですよ？","en":"Stop expecting me to do more than your payment warrants. I've been saying that from the start, right? …*sigh* Just this time, okay?"},"clip":"Audio/Voice/uni04016_1/uni04016_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"はううぅっ、くぅ、迂闊でしたね。まさか私の弱みを握られているとは……わざと流した情報？　さて、何のことでしょう……","en":"Hauuu… ku… that was careless. To think you'd got hold of my weakness… Was that info I deliberately leaked? Well, what could it be…"},"clip":"Audio/Voice_r18/uni04016_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"どうですかぁ、あなたの弱点を知り尽くした私の動きはぁ……んあぁっ、はぁ……ふふふ、簡単に集められる情報でしたよぉ","en":"How about it, my movements now that I know your weak point… nnh… ha… hehe, the info was easy to gather."},"clip":"Audio/Voice_r18/uni04016_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"あんっ、んんっ……私の性感帯を知りたいんですか？　だったら対価は……あなたからのキスでどうでしょう？　んふふ、んー……","en":"Ahh, you want to know my erogenous zones? Then the price… how about a kiss from you? Nn… hehe…"},"clip":"Audio/Voice_r18/uni04016_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni04016_1/uni04016_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":nu