blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"出雲きぬ、参りました。この格好ですか？　ふふ、アウトローな雰囲気ですが、格好良いと思いませんか？","en":"I'm Izumo Kinu. I've arrived. What do you think of this outfit? It has a bit of an outlaw vibe, but I think it looks good, don't you?"},"clip":"Audio/Voice/uni00950_1/uni00950_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"普段は刀を使って戦うから、拳銃を使うのは新鮮ですね。威力は低いですが、手軽に扱えると考えると悪くないです","en":"I usually use a sword in battle, so it's refreshing to use a gun. The firepower is low, but it's easy to handle, so it's not bad."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"文庫様……夫にこの服を見せたらなんとも不思議な顔をしていました。ただ、格好良いとは言って貰えましたよ","en":"Bunko... when I showed him this outfit, he had a rather puzzled expression. But he did say it looks good on me."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"対魔忍スーツは動きやすさを最優先したデザインですが、スーツにコートは少し動きづらいですね。でも、潜入には便利でしょうか？","en":"Taimanin suits are designed with mobility in mind, but adding a coat makes it a bit harder to move. However, it might be useful for infiltration."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この拳銃、普通の物と明らかに違いますよね……？　何というか、華美な装飾というか……でも、こだわりを感じます","en":"This gun is clearly different from a normal one... it has a decorative flair to it, but I can sense the attention to detail that went into making it."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私が操る木霊は無機物に取憑いてくれるから、銃弾に取憑いて貰うとすごい動きをしてくれるんです。ご覧になりますか？","en":"The wood spirits I control can possess inorganic objects, so if I have them possess bullets, they can move in some amazing ways. Would you like to see it?"},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"娘の鶴が拳銃に妙に関心を示してるんです。私とも夫とも違う、遠距離を得意とする対魔忍になるのかも知れませんね","en":"My daughter, Tsuru, has been showing a strange interest in guns. She might become a Taimanin who excels at long-range combat, unlike her parents."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"中々アウトローな物言いは上手くできませんが……怒った時の迫力はよく出ているって言われちゃって、少し複雑です……","en":"I'm not very good at talking like an outlaw, but... I've been told that my intimidating aura when I'm angry is quite convincing, which makes me a bit complicated..."},"clip":"Audio/Voice/uni00950_1/uni00950_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00950_1/uni00950_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0798"]],"obtain":[{"kind":"gacha","type":"Collab","title":{"ja":"BLACKLAGOONコラボピックアップガチャ"},"start":null,"end":"2025-11-16"},{"kind":"gacha","type":"Collab","title":{"ja":"BLACKLAGOONコラボピックアップガチャ限定ユニット確定ガチャ"},"start":null,"end":"2025-11-16"},{"kind":"spark","title":null,"need":100,"start":null,"end":"2025-11-16"}],"standardPool":false,"art":{"graphicId":"uni_00950","graphicNum":2,"r18GraphicId":"uni_00950_v","r18GraphicNum":2,"spineId":"Chr_0798"}}