o00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"はい、ビールおまちどおさま。……ん？　ああ、お前か。今は給仕で忙しいけど……お前に頼まれたら断れない。一緒に行く","en":"Yes, your beer, sir. …Hm? Ah, it's you. I'm busy serving right now… but I can't turn you down. I'll go with you."},"clip":"Audio/Voice/uni00501_1/uni00501_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"これ、ディアンドル……という民族衣装らしい。どうだ、可愛いか？","en":"This is a Diandor outfit, I hear. How does it look? Cute?"},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"この、ビールか……そんなにおいしいのか？　苦くてピリピリするから嫌い……","en":"This beer… is it really that tasty? It's bitter and prickly, so I don't like it."},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ご飯はおいしい……。ソーセージ、ポテト……とても好き","en":"The food's tasty… sausage, potatoes… I really love them."},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はーい、ビールとソーセージだぞ。今日は、食べて飲んで騒いで……楽しんでいけ","en":"Alright, here's beer and sausage. Today, eat, drink, party… enjoy yourself."},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"給仕にも慣れてきた……。注文を運ぶのも、触手があってとても便利。たくさん運べる……","en":"I'm getting the hang of serving… delivering orders is really handy with my tentacles. I can carry a lot…"},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"このディアンドルが似合ってる……？　うん、ありがとう。接客のやる気、出た","en":"Does this Diandor suit me…? Yeah, thanks. I'm feeling motivated to serve."},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"給仕の仕事でコミュニケーション能力が上がるはず……。お前も手伝ってほしい","en":"Serving should boost my communication skills… I want you to help, too."},"clip":"Audio/Voice/uni00501_1/uni00501_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あああっ、いやぁ……！　動きたいのに身体が制御不能……。頭の中もふわふわしてぇ……っ、ああんっ、気持ち悪いのに気持ちいい……！","en":"Ahh, no... I want to move but my body won't obey... My head's all fuzzy... Ahh, it's disgusting but it feels good...!"},"clip":"Audio/Voice_r18/uni00501_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"こんなの弟じゃない……っ。触手来ないで……！　オマンコもお尻もっ、中でグリュグリュするのダメぇえッ！","en":"This isn't... my brother...! Don't let the tentacles come...! My pussy and my butt... grinding inside is forbidden!!"},"clip":"Audio/Voice_r18/uni00501_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00501_1/uni00501_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00501_1/uni00501_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00501_1/uni00501_1_atk_3.ogg"},{"type":"