,[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「対魔忍、八津紫だ。これからよろしく頼む」","en":"Taimanin Yatsu Murasaki, reporting. Let's get along."},"clip":"Audio/Voice/uni00017_1/uni00017_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"さて、何をするかさっさと決めろ。私の方はもう準備が出来ている","en":"Alright, decide what we're doing, and make it fast. I'm ready."},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"貴様、まさかたるんでいるなどと言う事はないだろうな？　しっかりしろ！","en":"You wouldn't be saying you're slacking, would you? Snap out of it!"},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"最近下の者の指導も多く少し身体が鈍っているな……鍛錬でもするか","en":"Lately I've been training the lower ranks a lot, and my body feels a bit dull… I should get some training in."},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"なんだ？　あまりジロジロとこっちを見るな。別にやることがあるだろ","en":"What? Stop staring at me. I have things to do, after all."},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ああ、アサギ様ぁ……♪　はっ！？　な、なんでもないぞ！　気のせいだ！","en":"Ah, Asagi-sama…♪ Huh!? N-no, it's nothing! Just my imagination!"},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"アサギ様……あ、いや！　アサギ隊長の為、この八津紫、粉骨砕身努力してみせる！","en":"Asagi-sama… ah, no! For Captain Asagi, I, Yatsu Murasaki, will push myself to the limit!"},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"対魔忍八津紫推参！　大斧の餌食になりたい者からかかってこい！","en":"Taimanin Yatsu Murasaki, stepping forward! Whoever wants to become the great axe's meal, bring it on!"},"clip":"Audio/Voice/uni00017_1/uni00017_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00017_1/uni00017_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,