30,"blo00015",5],[31,"blo00003",25],[31,"ubl00688",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00688",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00688",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00688",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ブレインフレーヤーの騎士ラティクールだ。受けた恩を忘れるほど、恥知らずではない。しばらく力を貸そう","en":"I'm Latticour, a Brain Fryer knight. I won't forget the debt I owe you, so I'll lend you my strength for a while"},"clip":"Audio/Voice/uni00688_1/uni00688_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"下等生物だと侮っていたが、なかなか興味深い。しばらく観察を続ける意味がありそうだ","en":"I used to think of you as inferior beings, but you're quite interesting. It seems worth observing you for a while longer"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"おかげさまで、こちらの暮らしには不自由していない。あなた達の助力には感謝している","en":"Thanks to you, I've been living comfortably here. I appreciate your help"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"新しい装備のコンディションは良好だ。こちらのテクノロジーもなかなか侮れないものだな","en":"The condition of my new equipment is excellent. Your technology is quite impressive"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"私に出来ることがあれば相談してくれ。こちら側の知識も多少役に立つはずだ","en":"If there's anything I can do, feel free to ask. My knowledge from the other side might be of some use"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"次元移動装置はまだ故障中だが、やれるだけやってみせるさ","en":"My dimensional movement device is still malfunctioning, but I'll do what I can"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"人間達のコミュニケーション手段に興味がある。お前のやり方を教授してくれないか？","en":"I'm interested in your methods of communication. Will you teach me how you do it?"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ここの風習を模倣するのは骨が折れる。行動パターンを分析しているが、個体差があり過ぎるな","en":"It's exhausting trying to mimic your customs. I'm analyzing your behavior patterns, but there's too much individual variation"},"clip":"Audio/Voice/uni00688_1/uni00688_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"んっ……、はぁ、はぁ、お前のマッサージはやみつきになるな。依存性があるのか……。んっ、あぁ……","en":"Mmm... ah, ah, your massage is addictive. Is it because it's so relaxing?... Mmm, ah..."},"clip":"Audio/Voice_r18/uni00688_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"あぁっ、うぅ……、人間との生殖行為が、まさかここまでとはな……。予想以上だ。もっと……、してほしい……。んんぅ……っ","en":"Ah, uh... I never thought human reproduction could be so... intense. It's more than I expected. I want more... Mmm..."},"clip":"Audio/Voice_r18/uni00688_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"ふむ……、お前のチンポ、また反応しているな……。さらに分析させてくれ。はむっ、んんっ、じゅるっ、ちゅっ、ちゅるっ、んむ……っ","en":"Hmm... your cock is reacting again, isn't it?... Let me analyze it further. Mmm, ah, juu, chu, chu ru, nnmu..."},"clip":"Audio/Voice_r18/uni00688_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00688_1/uni00688_1_wav_1.ogg"}],"trust":[100,200],"scenes