4],[29,"blo00007",4],[29,"blo00010",4],[29,"blo00013",4],[30,"blo00007",4],[30,"blo00010",4],[30,"blo00013",4],[31,"evo00019",8],[31,"evo00023",32],[31,"evo01012",1],[32,"blo00007",4],[32,"blo00010",4],[32,"blo00013",4],[33,"blo00007",4],[33,"blo00010",4],[33,"blo00013",4],[34,"blo00007",4],[34,"blo00010",4],[34,"blo00013",4],[35,"blo00007",4],[35,"blo00010",4],[35,"blo00013",4],[36,"evo00019",8],[36,"evo00023",32],[36,"evo01012",1],[37,"blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00019",8],[41,"evo00023",32],[41,"evo01012",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00019",8],[46,"evo00023",32],[46,"evo01012",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"美のインキュバス、アンブローズよ♪　気さくに『美しきアンブローズ様』と呼んでちょうだい","en":"I'm Ambrose, the Incubus of beauty♪ Please, call me \"Beautiful Ambrose\" in a friendly manner."},"clip":"Audio/Voice/uni07013_1/uni07013_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"はぁ……今日も私は美しいわね……鏡？　そんなものなくとも、分かり切っている事でしょう？","en":"Ha... I'm beautiful today, as always... Do I need a mirror? It's not like I wouldn't know, even without one."},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あなた、よく見ればなかなか素材は悪くないわね……何逃げようとしているのよ、何もしないわ。ただあなたが美しくなるだけ♪","en":"You, if you take a closer look, aren't bad material at all... What are you trying to escape from? Don't worry, I won't do anything. You'll just become more beautiful♪"},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"美しさに基準などないわ。でも不思議と美を極める者同士が対峙すれば分かるのよ……どちらがより美しいか、ね","en":"There's no standard for beauty. But somehow, when those who pursue beauty to the extreme face each other, it becomes clear... which one is more beautiful, that is."},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"これから任務？　仕方ないわね、ネイルサロンの予約はキャンセルしましょう……いいのよ、協力を反故にする方が美しくないわ","en":"A mission, now? Well, I suppose we have no choice... Let's cancel my nail salon reservation, shall we? It's okay, abandoning our cooperation wouldn't be beautiful, after all."},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"世界で一番美しいのは？　もちろんこの私……と言いたい所だけれど、まだまだなのは自分でも分かっているわ。一歩一歩着実に、よ","en":"Who's the most beautiful in the world? I'd like to say it's me, of course... but even I know I still have a way to go. I'll just keep making steady progress, one step at a time."},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"鹿之助ちゃん！　鹿之助ちゃんはいるかしら？　今度こそ私の方が美しいと証明してみせるわ","en":"Uehara Shikanosuke! Are you there, Uehara Shikanosuke? This time, I'll prove that I'm the more beautiful one."},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"そうね、こういう作戦はどう？　私が美で敵の視線を釘付けにする。その隙に全滅させる。必勝間違いなしよ！","en":"How about this strategy? I'll use my beauty to captivate the enemy's attention. Then, in that opening, we'll annihilate them. It's a sure win, don't you think!"},"clip":"Audio/Voice/uni07013_1/uni07013_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07013_1/uni07013_1_wav_1.ogg"}],"trust":[],"scenes":[],"stills":[],"obtain":[{"kind":"event","type":"Kessen","title":{"ja":"결전 퀘스트 #12","en":"Kessen quest"}},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_07013","graphicNum":2,"r18GraphicId":"uni_07013","r18