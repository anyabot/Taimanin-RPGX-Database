],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00191",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"改めて自己紹介ね、鬼崎きららよ。私の力とあんたの頭があれば、敵はいないわ！","en":"\"Alright, let me introduce myself—Kirara Onisaki. With my power and your head, there's no enemy!\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"まだ男は苦手……っていうか、嫌い。でもあんたは――いや、いまのなしっ","en":"\"I'm still not good with men… actually, I hate them. But you—no, never mind.\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"たまには修行に付き合いなさいよ。少しは強くならないと、また大ケガするわよ","en":"\"Come train with me once in a while. If you don't get a little stronger, you'll get seriously hurt again.\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"な、なに、その目は……はぁ、やっぱり気になるのね、この服……ほんと、スケベなんだから……","en":"\"W-what's with that look… huh, I guess you're curious about this outfit… you really are a pervert…\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ジロジロ見るな！　ったく……まぁ、でも……あんたになら、別にそこまで……ヤじゃないけど……","en":"\"Don't stare! Geez… well, but… for you, it's not that big of a deal… not that I'm into it or anything…\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"次の任務？　またあんたと一緒なの？　へー、ふーん……へぇ、そうなんだぁ♪","en":"\"Next mission? Again with you? Huh, huh… oh really?\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ちょっと、やらしい目で見ないでくれる！？　あーサイッテー、これだから男って……","en":"\"Hey, stop looking at me lecherously! Ugh, men are the worst…\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"はぁっ？　それくらい知ってるわよ、バカにしないで！","en":"\"Huh? I know that already, don't mock me!\""},"clip":"Audio/Voice/uni00191_1/uni00191_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00191_1/uni00191_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":