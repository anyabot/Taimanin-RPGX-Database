,[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「私になにか用？　……ふぅん？　ま、特別に付き合ってあげてもいいわよ？」","en":"You need something from me? …Hmm? Fine, I might hang out with you specially."},"clip":"Audio/Voice/uni00068_1/uni00068_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あ～暇だなぁ～。ねぇねぇ、どっか遊びに行かない？","en":"Ah— I'm bored… Hey, hey, wanna go somewhere to have fun?"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ほらほら、行こ？　どこって、外に出るの！　行き先なんか、どうでもいいじゃない","en":"Come on, come on, let's go! Where? Just go outside! The destination doesn't matter, does it?"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"勝負しない？　負けたらジュースおごりねっ！　ま、絶対負けないけど","en":"Wanna make a bet? If I lose, you buy me a juice! …I won't lose, though."},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ねー、遊ぼうよぉ。任務まで、まだまだたっぷり時間あるでしょ？","en":"Hey, let's play! We still have plenty of time before the mission, right?"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"もう、どうしてさっきから知らんぷりするの？　もっと構いなさいよっ","en":"Geez, why have you been ignoring me since earlier? Pay attention to me!"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ちょっと、さっきからなにチラチラ見てるの？　もう、いやらしいんだからっ……","en":"Hey, what've you been glancing at since a while ago? It's so lewd…"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"うぅ～。あんまり見てると、私の雷撃をお見舞いしてやるんだからっ！　覚悟しなさいよね！","en":"Ugh— If you keep staring, I'll give you a taste of my lightning strike! Be ready!"},"clip":"Audio/Voice/uni00068_1/uni00068_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00068_1/uni00068_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00068_1/u