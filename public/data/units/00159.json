010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ただの鬼といっしょにするな！　アタイは羅刹。羅刹のラークシャシャ！","en":"Don't lump me together with ordinary demons! I'm a Rasetsu. Rasetsu Lark Shasha!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"でかい女は嫌いかい？　アタイは小さい男も嫌いじゃないよ？　あっちが小さいのは勘弁だけどね！","en":"You don't like big women? I don't mind small men either—though I'll spare you the tiny ones!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"どんなわからず屋の石頭だって、アタイの金棒に比べたら柔らかいもんさ！","en":"No matter how thick-skinned a clueless blockhead is, he's softer than my iron clubs!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"荒事ならこのラークシャシャに任せておきな！　アタイの後ろからついてくりゃあ、あっというまに片がつく！","en":"Leave the rough work to me, Lark Shasha! Stick with me from behind and it'll be over in a flash!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"鬼族だからって怖がるこたぁない。このラークシャシャ様は優しい女で通ってるんだ。文句を言った奴ぁみんな墓の下だけどね！","en":"Just because I'm a demon, don't be scared. This Lark Shasha is known as a kind woman. Anyone who complained ended up six feet under!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"アタイより強い奴に会いに行く！　そしてこの金棒でぶちのめす！","en":"I'm going to meet someone stronger than me! And I'll smash them with these clubs!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ただの鬼じゃあないよっ、アタイは羅刹、ラークシャシャ！","en":"I'm not just any demon—I'm a Rasetsu, Lark Shasha!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"昔むかし、最強の鬼族、羅刹のラークシャシャがいましたとさっ。もちろんいまでもここにいるよっ！","en":"Long ago, the strongest demon, Rasetsu Lark Shasha, existed. Of course I'm still here!"},"clip":"Audio/Voice/uni00159_1/uni00159_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00159_1/uni00159_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0079_r18"]],"stills":[["chr_0079a_r18"]],"obtai