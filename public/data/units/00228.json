0],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"対魔忍、磯咲伊織！ まだまだ見習いだけど、お姉ちゃんにも負けない、すごい対魔忍になるんだからっ♪","en":"Taimanin, Isozaki Iori! I'm still just a trainee, but I'll become an amazing Taimanin who won't lose to my big sister! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"お姉ちゃんなら留守よ、残念だったわねー？　あっ、私が代わりに遊んであげよっか♪","en":"If my sister's not home, too bad, huh? Ah, want me to play in her place for you? ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"得意術は水遁よ。水遁……水放弾！　ってね♪","en":"My specialty is Water Release. Water Release… Water Blast! That's right! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"どうかしら、この刀！　凜子先輩の逸刀流より大きな太刀、使ってる人はすっごい少ないんだからねっ？","en":"How about this sword! It's a huge katana, even bigger than Senior Rinko's Ittō-ryū, and hardly anyone uses one! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"んくっ、んくっ……ぷはぁっ！　ふぅ、本当に効果あるのかな……ふぇっ！？　べべべべ、別になんでもないわよ、牛乳好きなだけだし！","en":"Ngh, ngh… phew! Hmm, does it really work… huh!? Bebe… it's nothing, I just love milk! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あぁ～……え、なにがあったって？　なんかね、クラスの男子からね、小さくらって呼ばれてて……嬉しいような複雑なような……","en":"Ahh… what? What happened? Well, the boys in class call me \"little Sakura\"… it's kind of nice, kind of complicated… ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"対魔忍、磯咲伊織よ。得意の水遁で、どんな敵でも吹き飛ばしちゃうんだから！","en":"Taimanin, Isozaki Iori here. With my Water Release, I'll blow any enemy away! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"小さくらじゃないわよっ……まだ成長期なんだから、すぐに中さくら……ううん、大さくらくらいになれるわよ！","en":"I'm not \"little Sakura\"! I'm still growing, soon I'll be \"middle Sakura\"… no, I can become a \"big Sakura\"! ♪"},"clip":"Audio/Voice/uni00228_1/uni00228_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00228_1/uni00228_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"