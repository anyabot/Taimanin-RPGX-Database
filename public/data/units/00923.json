lo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"この服どう……？　わたしは可愛くて気に入ってる……特に気に入ってるのはこの蛇と蝶……見て、すっごく可愛いでしょ……？","en":"What do you think of this outfit? I think it's cute and I like it... especially the snake and butterfly patterns... look, they're really cute, right?"},"clip":"Audio/Voice/uni00923_1/uni00923_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"着物は戦いにくいけど……かわいいって言われる方が大事だから大丈夫……慣れればいいだけだから","en":"Kimonos are hard to fight in... but being told they're cute is more important, so it's okay. I just need to get used to it."},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"着物を自分で着られるのってすごいんだって……ちゃんと一人で着られるわたしはえらい？","en":"Being able to wear a kimono by myself is a big deal, right? I'm proud of myself for being able to do it."},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"忍術ごっこ、ふうまにもみて貰いたい。白蛇も蝶もわたしも、ふうまのためにがんばるから今度見に来て？","en":"I want Fuuma to see my ninja training. The white snake, the butterfly, and I will all do our best for Fuuma, so come and see us next time."},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"着物、もっと見たいの？　いいよ、好きなだけ見て？　ふうまにみて貰えて……わたしも嬉しいから……♪","en":"You want to see more of my kimono? It's okay, you can look as much as you want. It makes me happy when Fuuma looks at me...♪"},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"激しい動きをすると着物がはだけるの……あ、ふうま……いまヘンなこと考えてるときの顔になってたよ……","en":"When I move around a lot, my kimono comes undone... ah, Fuuma, you had a weird expression on your face just now..."},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どうかな、着物かわいい……？　ふうまが気に入ったなら……これからずっと着物でもいいよ？","en":"Do you think my kimono is cute? If Fuuma likes it, I'll wear it all the time from now on."},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"帯がふりふりのリボンみたいで可愛いの。ふうまもこういうのすき？　可愛いって思ってくれてる？","en":"The sash is like a fluffy ribbon, and it's cute. Do you like this kind of thing, Fuuma? Do you think it's cute?"},"clip":"Audio/Voice/uni00923_1/uni00923_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00923_1/uni00923_1_rdy_1.ogg"},{"type":"rdy","lab