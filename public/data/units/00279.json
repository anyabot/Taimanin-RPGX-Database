],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"こういう格好でないと入れない場所、というのもあるのよ――対魔忍に言っても、釈迦に説法かしらね","en":"There are places you can't enter unless you're dressed like this—telling a Taimanin is like preaching to Buddha."},"clip":"Audio/Voice/uni00279_1/uni00279_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"なにを驚いているの？　仕事着だもの、ドレスの一着や二着、持っていて当然でしょう？","en":"What are you surprised about? It's work clothes; of course it's natural to have a dress or two."},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ほら、ついてきなさい……邪魔をしても殺すし、足を引っ張っても殺すから、そのつもりでね？　まぁ、あんたなら大丈夫だろうけど","en":"Come on, follow me… If you get in my way I'll kill you, if you hold me back I'll kill you, so keep that in mind. Well, you should be fine though."},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"久々に楽しめそうな仕事だわ……手ごわい相手だから？　違うわ、あんたを連れていくからよ……うふふ……","en":"This looks like a fun job after a while… because the opponent's tough? No, it's because I'm taking you with me… heh heh."},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"……まだよ、まだお預け。やることを済ませたら、この火照りを鎮めるのに協力してもらうから……あんたもしっかり昂らせておきなさい","en":"…Not yet, not yet. Once I've finished what I need to do, you'll help calm this heat… you better keep yourself aroused too."},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"さて――仕事も終わったし、一杯だけ付き合いなさい。そのあとは……ふふ……ね？","en":"Alright—work's done, have a drink with me. After that… heh… okay?"},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"いつか、あなたの赤黒いアレを見たいものね……アレよ、わかるでしょ？　ピクピク震える……抉りたての、し・ん・ぞ・う♪","en":"Someday I want to see your red-black thing… you know what I mean, right? All twitching… freshly gouged, death…"},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"はぁっ、はぁぁぁ……もう、我慢できないっ……この昂りを鎮められるのは、あんただけ……やるわよ……殺し合うわよっ♪","en":"Haah, haaa… I can't hold back any longer… Only you can calm this arousal… I'll do it… let's kill each other♪"},"clip":"Audio/Voice/uni00279_1/uni00279_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00279_1/uni00279_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["ex_0003_1_r18"],["ex_0003_2_r18"]],"stills":[["ex_0003_1a_r18"],["ex_0003_2a_r18"]],"obtain":[],"standardPool":false,"art":{"graphicId":"uni_00279","graphicNum":2,"r18GraphicId":"uni_00279_r18","r18GraphicNum":2,"spineId":"Chr_0190"}}