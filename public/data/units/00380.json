10% Science damage","tag":"instant","when":"25% chance"},{"text":"1 enemy: 1050% Science damage","tag":"instant","when":"25% chance"}]}},"leader":{"name":{"ja":"コーデリアの若き姫君"},"detail":{"ja":"部隊全体の被ダメージを極小軽減+HPを中アップ"},"effects":[{"text":"All allies: Max HP +15%","icon":"hp_up","tag":"passive"},{"text":"All allies: damage taken -5%","icon":"protect","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00380",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00380",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00380",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00380",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00380",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00380",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00380",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"コーデリア公国皇女、マヤ・コーデリアです。ええ、やるべきことは聞き及んでいます――私の力が必要でしたら、存分にお使いください","en":"I'm Maya Cordelia, the princess of the Cordelia duchy. Yes, I've heard what's expected of me - if you need my power, don't hesitate to use it."},"clip":"Audio/Voice/uni00380_1/uni00380_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おはようございます。ええ、こちらの生活にも慣れました……身を置かせていただいて、感謝しています","en":"Good morning. Yes, I've gotten used to life here... I'm grateful to be allowed to stay."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"お出かけになるんですか？　でしたら私もご一緒して構いませんか？　周囲の散策をしてみたかったんですが一人では不安で……お願いしますね","en":"Are you going out? If so, may I join you? I wanted to explore the surroundings, but I'm a bit uneasy about going alone... please take me with you."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ここは、自然が豊かで素敵な町ですね……コーデリアにも、このような区画を作れるといいんですけど","en":"This town is rich in nature and lovely, isn't it? I wish Cordelia had a district like this too."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あの建物はなんですか？　宮殿のようにも見えますが……あの、どうしたんですか？　あっちょっと、どうして引っ張るんです？　あのお城は――","en":"What's that building? It looks like a palace... what's going on? Ah, why are you pulling me? What's with that castle?"},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"――お仕事ですか？　はい、任せてください……コーデリア式剣技の冴え、とくとご覧に入れましょう","en":"Is it work? Yes, leave it to me... I'll show you the splendor of Cordelia-style swordsmanship."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"姫姉さま――どうか、ご無事でいてくださいっ……きっと、すぐに見つけてみせますからっ……","en":"Lady Alicia, please be safe... I'll definitely find you soon."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私とは歳もそんなに違いがありません、あまり畏まられては申し訳ないです","en":"We're not that different in age, so please don't be too intimidated by me."},"clip":"Audio/Voice/uni00380_1/uni00380_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ああ……こんな姿を殿方に見せてしまうなんて、はしたないと笑わないで下さい……♪","en":"Ah, don't laugh at me for showing you this side of me... it's embarrassing."},"clip":"Audio/Voice_r18/uni00380_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"わ、私をただの女として扱って下さい……どのような行為も受け入れますから","en":"Treat me like a normal woman, please... I'll accept whatever you do."},"clip":"Audio/Voice_r18/uni00380_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"こ、こういったことには疎くて……でも、身体が内側から火照って、胸がジンジンと疼きます……♪","en":"I'm not used to this kind of thing, but... my body is burning up inside, and my chest is throbbing..."},"clip":"Audio/Voice_r18/uni00380_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00380_1/uni00380_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0260_1_r18"],["chr_0260_2_r18"]],"stills":[["chr_0260_1a_r18"],["chr_0260_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-09-25","end":"2022-04-05"},{"kind":"exchange","ti