007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私の名は、ティナ・ウォーレル。……あなたに協力はするけれど……私のことは、構わないで","en":"My name is Tina Worrell... I'll cooperate with you, but don't get too close to me."},"clip":"Audio/Voice/uni00260_1/uni00260_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"プラズマライフルの手入れをしているから、近寄らないで。危ないわ","en":"I'm maintaining my plasma rifle, so don't come near. It's dangerous."},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ほっといてって言っているでしょう？　どうしてそんなに構うの？　この義肢が、珍しい？","en":"Didn't I tell you to leave me alone? Why are you so interested? Is it because of these prosthetics?"},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"これは、アンドロイドアームとレッグ。至って自然に動かすことが出来るわ。動力源は、私の命よ","en":"This is an android arm and leg. I can move them quite naturally. They're powered by my own life force."},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はぁ、疲れた。……勿論義肢は疲労しないわ、でも……心は時々疲れるわよ","en":"Sigh... I'm tired. Of course, my prosthetics don't get tired, but my heart does sometimes."},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"何度も言っているでしょう？　私のことは放っておいて。……もう、聞こえないふりをするなんて","en":"I've told you before, haven't I? Leave me alone. Don't pretend you didn't hear me."},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"仲間には、ならない。そんなものは二度と作らないと決めているの。……え？　友達？　な、何を言っているの、駄目に決まってるでしょ！","en":"I won't be your friend. I've decided not to make any more friends. What are you talking about? Friends? Don't be ridiculous!"},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"構わないでと言っているでしょう？　……いえ、つまらない訳じゃないわ。あなたと話すのは……えぇ、楽しい……","en":"I said don't get too close, didn't I? It's not that it's unimportant... talking to you is... actually, it's kind of fun."},"clip":"Audio/Voice/uni00260_1/uni00260_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00260_1/uni00260_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0167_r18"]],"obtain":[],"standardPool":true,"art":{"graphicId":"uni_00260","graphicNum":2,"r18GraphicId":"uni_00260_r18","r18GraphicNum":2,"spineId":"Chr_0167"}}