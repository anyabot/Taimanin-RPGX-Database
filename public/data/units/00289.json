0008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"よっ♪　へへへ、どうだよこの槍ぃ……こいつがありゃ、どこまでもぶっ飛ばしていけるぜ！　ほら、お前も掴まってみろよ！","en":"Yo♪ Heh heh, check out this spear… with this, I can blast anything away! Hey, try grabbing it!"},"clip":"Audio/Voice/uni00289_1/uni00289_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"くっそぉ……このパーツ、メンテとか掃除とか、色々手間がかかんだよなぁ……おっ？　なぁ、暇なら手伝えよ♪","en":"Damn… these parts need maintenance, cleaning, a lot of work… huh? Hey, if you're free, lend a hand♪"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"イメージ的には、バイクみたいな感じだよなぁ……なぁお前、バイクの免許とか持ってるか？　あるなら今度、ケツに乗せてくれよ♪","en":"It kinda looks like a bike, right? Hey, you got a motorcycle license? If you do, ride me next time♪"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お、そろそろ任務の時間か？　へへへ、腕が――いや、槍が鳴るぜ！","en":"Oh, is it mission time soon? Heh heh, my arm—no, my spear's ringing!"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"こいつの突破力なら、ちょっとやそっと捕まったところで、一気に振り切れるからな！","en":"With this piercing power, even if I get snagged a bit, I can break right through!"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"よぉし、一番槍はもらったぜ！　オラオラ、死にてーやつからかかってきやがれ！","en":"Alright, I got the top spear! Come at me, you who want to die!"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"あぁん？　なに見てんだ、てめぇ……私の槍、だぁ？　へへっ……ンだよ、見る目あんじゃねーか♪","en":"Huh? What are you staring at, you… my spear, huh? Heh… you've got good taste, don't you♪"},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"おいお前、ちょっと訓練に付き合えよ。大丈夫だって、死なねー程度には加減してやるからよ……死なないギリギリだけどな","en":"Hey, you—join me for a little training. Don't worry, I'll dial it back so you don't actually die… just barely."},"clip":"Audio/Voice/uni00289_1/uni00289_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00289_1/uni00289_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00289_1/uni00289_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00289_1/uni00289_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00289_1/uni00289_1_dmg_1.ogg"}