blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00008",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00008",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ナーサラ……名前、興味、なら、利害一致、その、知識、欲しい」","en":"Nasara... if you're curious about my name, then our goals align. I want knowledge."},"clip":"Audio/Voice/uni00008_1/uni00008_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"待機、不満、なにかやること、経験、求む","en":"I'm on standby, bored. I need something to do, some experience."},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"行動、理解不能、許容範囲、逸脱、敵対行動？","en":"Your actions are beyond my comprehension. Deviating from my acceptable range—does that mean hostility?"},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"興味深い行動、不快感、ない、もっと知りたい、許可","en":"Interesting behavior. No discomfort. I want to learn more—may I?"},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"他の人間、敵意、恐怖、悪意、少しの興味、おまえ、それがない。理解したい","en":"Other humans show hostility, fear, malice—just a hint of interest. You lack that. I want to understand."},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"学校、知識、経験、教育、これこそ、求めていた。人間の言う、楽しい、多分","en":"School, knowledge, experience, education—this is exactly what I've been looking for. Humans call it fun, I suppose."},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ナーサラ、目的、知識、取得、あらゆること。あなた、興味深い、とても。知りたい、もっと","en":"My purpose is to acquire knowledge—everything. You are fascinating, truly. I want to know more."},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"心、感情、理解不可、ただ目的、知識、その為に、捕食する","en":"Feelings and emotions are beyond me; I have only one purpose: knowledge. For that, I will prey."},"clip":"Audio/Voice/uni00008_1/uni00008_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00008_1/uni00008_1_msr_2.ogg"},{"type":"rdy","l