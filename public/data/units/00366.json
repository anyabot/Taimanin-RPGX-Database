を大アップ、最大HPを中アップする"}},{"level":4,"sp":335,"detail":{"ja":"味方全体のSPDを大アップ、最大HPを中アップする"}},{"level":5,"sp":330,"detail":{"ja":"味方全体のSPDを大アップ、最大HPを中アップする"}}],"effects":[{"text":"All allies: SPD +60% for 4 turns","icon":"spd_up","tag":"buff"},{"text":"All allies: Max HP +30% for 4 turns","icon":"hp_up","tag":"buff"}]}},"leader":{"name":{"ja":"夏祭りの探偵団"},"detail":{"ja":"部隊全体のATKを中アップ"},"effects":[{"text":"All allies: ATK +15%","icon":"atk_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00366",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00366",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00366",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00366",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00366",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00366",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00366",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"祭囃子に太鼓の音……ふふっ、いい夜ね。日頃の憂さを忘れて今夜は一緒に楽しみましょう","en":"The festival drums are beating… hehe, what a nice night. Forget your worries and let's enjoy it together."},"clip":"Audio/Voice/uni00366_1/uni00366_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ヨミハラの夏祭りは休戦がルール。最も平和な一日よ","en":"Yomihara's summer festival has a cease-fire rule. It's the most peaceful day."},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"みんな、買い食いは一人一点までよ。うちの事務所はカツカツなんだから、お祭りと言ってもそこは譲れないわ","en":"Everyone, limit yourself to one snack each. My office is already packed, so even at a festival I can't give in."},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ここは悪党だらけの吹き溜まりのような街……だけど私は意外と気に入っている。あなたはどう？","en":"This city is a den of villains… but I actually like it. How about you?"},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この浴衣、似合ってる？　ふふ、ありがとう。思い切って着てきてよかったわ♪","en":"Does this yukata suit me? Hehe, thanks. I'm glad I took the plunge and wore it."},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"サイボーグアームとレッグに浴衣なんておかしな組み合わせでしょう？　でもいいの、今夜は特別だから","en":"A yukata with cyber arms and legs—sounds like a weird combo, right? But it's fine, tonight's special."},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"逃亡者の私がこんな催しを楽しめる日が来るなんて……ふふっ、あの頃からは想像もつかないわ","en":"I never imagined I'd be able to enjoy an event like this as a fugitive… hehe, it's beyond what I pictured back then."},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"事務所の皆は……今夜は別行動にしたわ。だって、あなたと二人でいたいから……いいでしょう？","en":"The staff are… going separate ways tonight. Because I want to be alone with you… is that okay?"},"clip":"Audio/Voice/uni00366_1/uni00366_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"えっ？　こんなところで……え、ええ、もちろん良いわ……ただ、せめて人がいない裏の方に行きましょう……？","en":"Huh? Here, of all places… Yeah, of course it's fine… but let's at least go to a secluded spot where no one's around, okay?"},"clip":"Audio/Voice_r18/uni00366_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"少し飲みすぎちゃったわね、なんだか体が火照っている……ねえ、鎮めるの手伝ってくれない？","en":"I drank a little too much, my body's all warm… Hey, can you help me cool down?"},"clip":"Audio/Voice_r18/uni00366_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"私は探偵……でも、昔は娼婦をしていたわ……だから、なのかしら？　時々どうしようもなく……いえ、この先はあなたが体で確かめて？","en":"I'm a detective… but I used to work as a prostitute… maybe that's why? Sometimes I get… no, you'll have to find out for yourself."},"clip":"Audio/Voice_r18/uni00366_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00366_1/uni00366_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0248_1_r18"],["chr_0248_2_r18"]],"stills":[["chr_0248_1a_r18"],["chr_0248_2a_r18"]],"obtain":[{"kind":"exchange","title":