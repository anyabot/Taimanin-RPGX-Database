,5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00002",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「槇島あやめ、紅様の命によりあなたに協力するわ。“風読み”の力、役立てて下さいね」","en":"Makishima Ayame, under Lady Kurenai's orders, I'll assist you. Put my \"Wind-reading\" power to good use, okay?"},"clip":"Audio/Voice/uni00002_1/uni00002_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"戦いはそこに至るまでどれだけ備えをしたかで大勢が決するわ。ぬかりないように頼むわね","en":"How well you prepared determines the outcome of battle. Don't let anything slip, alright?"},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私の本領は紅様の従者よ。そこだけは勘違いしないでほしいわ","en":"My true role is Kurenai's attendant. Please don't get that wrong."},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふふ、親しくしてくれるのはいやではないけれど、私はそんなに優しくはないわよ？","en":"Hehe, I don't mind getting close, but I'm not that gentle, you know?"},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"何かしら？　紅様なら先程……あら、私に用なの？","en":"What is it? Lady Kurenai just… oh, you need something from me?"},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"風読みは風の動きを読んでいるの。別に未来予知をしているわけじゃないのよ","en":"Wind-reading means I read the movement of the wind. I'm not actually predicting the future."},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どこまで逃げても無駄なこと。私の銃弾はすでに相手の心臓に狙いをつけているわ","en":"Running away is pointless. My bullet is already aimed at the target's heart."},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"紅様をお守りするのが私の全て。それを邪魔する者は……わかっているでしょう？","en":"Protecting Lady Kurenai is everything to me. Anyone who gets in the way… you know what will happen, right?"},"clip":"Audio/Voice/uni00002_1/uni00002_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00002_1/uni00002_1_rdy_1.ogg"},{"type":"rdy","label":"Battl