"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00376",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00376",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00376",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00376",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00376",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00376",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00376",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"お久しゅうございます、若様。……長らくの間お暇をいただいておりました。これからはこの鉄華院の力、存分にお役立て下さいませ","en":"Ah, it's been a while, Master. I've been on leave for a long time, but from now on, I'll be at your service with the full power of the Tekkain family."},"clip":"Audio/Voice/uni00376_1/uni00376_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふっ、何でもありませんわ。若様の精悍な顔つきに見惚れていただけ……白々しい？　あら、心外ですね","en":"Oh, it's nothing, really. I was just captivated by your handsome face, Master... Am I being too obvious? Ah, how disappointing."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"これですか？　これは普通の鎖です。術の鎖と組み合わせたり、目くらましにしたり……気に入った者を捕らえたり……うふふ","en":"This? It's just a regular chain. I can combine it with my ninjutsu, use it as a distraction, or capture someone I like... Hehehe."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"何も企んでなどいませんわ。若様のもとに下ったからには、全身全霊でお仕えするのみです","en":"I'm not plotting anything, Master. Now that I've sworn my loyalty to you, I'll serve you with all my heart and soul."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふふ、どうしたのですか？　怪しい所がないか見張っている？　ふふふ、そう見つめられるのも悪くはないですわね","en":"What's wrong, Master? Are you suspicious of me? Hehehe, it's not so bad being looked at like that."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"銃兵衛は相変わらずフラフラとしているようですわ。今度二人で訪ねに？　それも一興かもしれませんね","en":"Kanezaki Jubei is still as carefree as ever, it seems. Maybe we can visit him together sometime? That could be fun."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"成長なされた若様のお姿をこんな近くで見る事ができる日が来るなんて……少し前からは想像もできませんでした","en":"I never thought I'd see the day when I'd get to see you up close like this, Master... It's hard to believe it's really happening."},"clip":"Audio/Voice/uni00376_1/uni00376_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ふふふ、私が生み出したこの鎖、どうしたいですか？　縛りたい？　縛られたい？　どちらでも対応いたしますわ","en":"What do you want to do with the chains I've created, Master? Do you want to bind someone, or be bound yourself? I'll accommodate your desires either way."},"clip":"Audio/Voice_r18/uni00376_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"既に私は若様の所有物……こんな私の体や穴でよろしければ、もよおした時にはいかようにもお使い下さい","en":"I'm already yours, Master... If you'll have me, you can use my body, my holes, however you like."},"clip":"Audio/Voice_r18/uni00376_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"はぁ、はぁ……激しい若様も悪くはないですわね。このまま縊り殺されたらと思うと、下腹部がきゅうきゅうと疼きます","en":"Ah, ah... Your intensity is quite something, Master. The thought of being strangled to death like this is making my lower abdomen throb."},"clip":"Audio/Voice_r18/uni00376_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00376_1/uni00376_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0256_1_r18"],["chr_0256_2_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"exchange","title":null,"start":"2022-09-01","end":"2022-11-30"},{"kind":"exchange","title":null,"start":"2023-09-01","end":"2023-11-30"},{"kind":"spark","title":null,"need":300,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00376","graphicNum":2,"r18GraphicId":"uni_00376_r18","r18GraphicNum":2,"spineId":"Chr_0256"}}