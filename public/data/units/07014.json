blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00018",8],[41,"evo00023",32],[41,"evo01014",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00018",8],[46,"evo00023",32],[46,"evo01014",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"よう兄ちゃん！　といけねえ、今回は雇い主と傭兵の関係か？　ま、そんな堅苦しいのはなしにしてよろしく頼むぜ！","en":"Alright, Captain! No need for formalities, let's just get along, okay? So, what's the job this time?"},"clip":"Audio/Voice/uni07014_1/uni07014_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"思えば俺達知り合ってから結構経つよなあ……対魔忍とオーク傭兵なのに、変な話しだよな","en":"It's been a while since we met, hasn't it? It's weird to think about - a Taimanin and an Orc mercenary..."},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"おう、お疲れさん。どうだ？　これから一緒に飲みに……学生だからダメ？　真面目だなあ","en":"Hey, you look tired. Want to grab a drink with me? Oh, you're a student, so that's a no-go, huh? You're really responsible, aren't you?"},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"弟……？　あー……俺とは色々違ってなあ……まあ、兄弟ってのは簡単じゃねえんだよ","en":"My brother... well, he's a lot different from me. But I guess that's just how it is with siblings - it's not always easy."},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"兄ちゃんの隊は女が多いけど本命は誰なんだ？　元気な姉ちゃんか？　貧乳の姉ちゃんか？　タコの姉ちゃん……あ、お～い","en":"So, Captain, which of the girls in your team is your favorite? The energetic one? The flat-chested one? Or the... uh, octopus girl? Hey, wait up!"},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"傭兵は雇われたら何でもやるけどよ、やっぱり雇い主や仕事の差ってのはデカいもんだよ","en":"As a mercenary, I'll take on any job I'm hired for, but the difference between employers and jobs is huge, you know?"},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"欲望のままに媚びへつらって生きるヤツも居れば、俺みたいな傭兵もいる。オークにも色々いるって事だ","en":"Some people live their lives catering to their desires, while others, like me, are mercenaries. I guess that just shows there's all sorts of Orcs out there."},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ああー……タコか……いや、なんでか知らないけど背筋がゾクゾクするんだよなあ、タコ……","en":"Ugh, octopuses... I don't know why, but they just give me the chills, you know?"},"clip":"Audio/Voice/uni07014_1/uni07014_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07014_1/uni07014_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"cl