]}},"leader":{"name":{"ja":"斬鬼のクリスマス"},"detail":{"ja":"部隊全体のATKを中アップ"},"effects":[{"text":"All allies: ATK +15%","icon":"atk_up"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00147",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00147",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00147",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00147",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00147",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00147",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00147",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"は、はーいっ！　凜子サンタでーすっ♪　……はっ！？　って、これは違うんだ！　これはその、任務のためでぇぇっ！","en":"Ha—hey! It's Santa Rinko! …Huh!? No, that's not right! This is, uh, for the mission!"},"clip":"Audio/Voice/uni00147_1/uni00147_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ぅ、うぅっ……。さ、さすがに、この格好は……なんというか、落ち着かないな……","en":"Ugh, ugh... As expected, this outfit... I don't know, it feels unsettling."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"は、恥ずかしいが、これも任務のためだっ……え、笑顔で、子供たちに希望を届けないとな","en":"It's embarrassing, but it's for the mission... I have to give the kids hope with a smile."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"な、なにっ？　表情が、硬いだとっ？　しっ、仕方ないだろうっ！　私はその、笑顔は苦手で……","en":"W-what? My expression is... stiff? I guess there's no helping it! I'm not good at smiling..."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふふっ……。子供というのは、無邪気なものだな。眺めているだけで、心が穏やかになる","en":"Hehe... Kids are so innocent. Just watching them soothes my heart."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"たまには、こういうことをするのも悪くはない。いつも私は、日陰の仕事ばかりだから……","en":"Sometimes doing something like this isn't so bad. I'm always stuck with behind-the-scenes work..."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ひ、酷い目に遭った……。まさか、あの子たちがあんなことをするなんて……私は、悪い夢でも見ていたのだろうか","en":"I had a terrible experience... I never imagined those kids would do something like that... Was I just having a nightmare?"},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この事件の黒幕は間違いなく……いや、変なことは考えないようにしよう","en":"The mastermind behind this incident is definitely... No, I shouldn't start thinking weird things."},"clip":"Audio/Voice/uni00147_1/uni00147_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00147_1/uni00147_1_msr_1.ogg"},{"type":"