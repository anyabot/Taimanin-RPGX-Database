:1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00005",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ヨミハラで魔草屋を営んでいる、メルメ・エルヒェムです。植物のことなら大体わかるので、もし質問があったらお姉さんに聞いてくださいね～","en":"I'm Merme Elchim, running a magical grass shop in Yomihara. If you have any questions about plants, feel free to ask me, okay?"},"clip":"Audio/Voice/uni00460_1/uni00460_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふふ。お姉さんのお店のこと、心配してくれるんですかぁ？　じゃあ今度、お店に買いに来てください。　サービスしますよ～","en":"Hehe, you're worried about my shop? Well, come visit me, and I'll give you a special service, okay?"},"clip":"Audio/Voice/uni00460_1/uni00460_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あらあら、いらっしゃい。君、いつも来てくれますね～。魔草に興味があるんですかぁ？　それとも、お姉さんに興味があるのかしら？　ふふふっ","en":"Ah, welcome. You're a regular, aren't you? Are you interested in magical grass, or is it me that's caught your eye? Hehe."},"clip":"Audio/Voice/uni00460_1/uni00460_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"本当は、魔界でハープを奏でながら魔草達に囲まれていたかったんです。ふかふかなこの子達のベッドでお昼寝とかぁ、最高なんですから～","en":"Honestly, I wanted to live in the Demon Realm, surrounded by magical grass, playing my harp. Taking a nap in this soft, fluffy bed of grass is just the best."},"clip":"Audio/Voice/uni00460_1/uni00460_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お姉さん、魔草使いなんですよ。このお店にいる子達ならすべて、私の言うことを聞いてくれます","en":"I'm a magical grass wielder, and all the kids in my shop listen to me."},"clip":"Audio/Voice/uni00460_1/uni00460_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お姉さん、争い事は苦手で……。けれどやるときはやりますから、覚悟しておいてください。魔草の洗礼をお見舞いしますね～","en":"I'm not fond of conflict, but when I do fight, I won't hold back. You can expect a magical grass baptism from me, so be prepared."},"clip":"Audio/Voice/uni00460_1/uni00460_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"まさかぁ……っ、自分が育てた子達に犯されるなんてぇ……！　オマンコもお尻もぁっ、ダメになってるのぉッ！","en":"No way... I never thought I'd be violated by the very magical grass I cultivated... My pussy and ass are ruined..."},"clip":"Audio/Voice_r18/uni00460_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"潜入なんてしてごめんなさい……！　もう許してぇ！　気持ちよすぎてイクから！","en":"I'm sorry for sneaking in... Please forgive me! It feels too good, and I'm going to come!"},"clip":"Audio/Voice_r18/uni00460_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"イキすぎて死んじゃうっ、あああっ、あなた達の仲間になりますからぁ！","en":"I'm coming too much, I'm going to die... Ah, yes, I'll join your group now."},"clip":"Audio/Voice_r18/uni00460_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00460_1/uni00460_1_evo_1.ogg"},{"type":"evo","labe