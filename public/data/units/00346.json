08",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふぅん、ボクを仲間にしたい？　……いいですよ、ボクは人狗族の葉月って言います。よろしくお願いしますね","en":"I see, you want me to join you? ...Alright, I'm Hazuki from the dog-human tribe. Nice to meet you."},"clip":"Audio/Voice/uni00346_1/uni00346_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"何か御用ですか？　……そうですか、用事があればいつでも言ってくださいね","en":"Do you need something? ...Okay, just let me know if you have any business."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"はっ、はぁっ！　ふぅ……鍛錬も欠かさずやっていきたいですね","en":"Ha, haa! ...I'd like to keep up my training without slacking off."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"うーん……いい天気ですねぇ。え？　お外で散歩したくないか？　もう、犬扱いしないでください！","en":"Hmm, nice weather, isn't it? Want to go for a walk outside? And stop treating me like a dog, okay?"},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ぐるるるぅ……はっ！　今唸ってました？　ち、違いますから。犬ではありませんから","en":"Grrr... Hah! Were you just growling? N-no, I'm not a dog, so it's different."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"出会ったころと印象が違う？　ははは……ボク、仲間以外には冷たい所がありますから","en":"You think I'm different from when we first met? ...Heh, I can be a bit cold to those outside my group."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ボクたち人狗族は何よりも仲間を大事にするんですよ。もちろん、遊撃部隊の皆はもう仲間です","en":"My people, the dog-human tribe, value our comrades above all else. Of course, the Taimanin are my comrades now."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"褒めていただき光栄です。でも、ノマドを倒すためにはもっと風の力を鍛えなくては","en":"I'm honored by your praise, but to take down the nomads, I need to hone my wind powers even more."},"clip":"Audio/Voice/uni00346_1/uni00346_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あうぅぅ、ご主人様には敵いません……ボクのメス本能屈服しちゃって、犬丸出しの服従ポーズとってしまいます","en":"Oh no, I'm no match for you, Master... My female instincts are surrendering, and I'm posing in submission."},"clip":"Audio/Voice_r18/uni00346_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"くうぅぅん……参りましたぁ。ご主人様のわんことして一生尽くしますぅ。命令して下さい、ご主人さまぁ","en":"I've had enough... I'll serve you, Master, for the rest of my life. Please give me your orders."},"clip":"Audio/Voice_r18/uni00346_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"戦力としてよりもメスとして求められる方が嬉しいなんてぇ……わふうぅん……すっかりキバ、抜かれちゃいましたぁ","en":"It's nicer to be wanted as a female rather than just a fighter... Wufuun... My fangs are fully bared now."},"clip":"Audio/Voice_r18/uni00346_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00346_1/uni00346_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0234_r18"]],"stills":[["chr_0234a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":null,"end":null}],"standardPool":true,"art":{"graphicId":"uni_00346","graphicNum":3,"r18GraphicId":"uni_00346_r18","r18GraphicNum":2,"spineId":"Chr_0234"}}