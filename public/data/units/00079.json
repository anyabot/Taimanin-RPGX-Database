1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ふっふっふ、私は魔女ミリアム……って何だその目は！　子供ではないぞ、無礼者め！」","en":"Heh heh heh, I am the witch Merriam… what's with that look! I'm not a child, you insolent brat!"},"clip":"Audio/Voice/uni00079_1/uni00079_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふふ……どうしたさっきから。遠慮するな、私は寛大だから発言をゆるしてやる","en":"Hehe… what's the matter, ever since earlier? Don't hold back, I'm generous enough to let you speak."},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"が、ガキ！？　それは私にいってるのか！？　ムキー！　ゆるさんぞ！","en":"W-what, kid!? Are you talking to me!? Hmph! I won't forgive you!"},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おかしい……使い魔のクロとシロが見当たらん。勝手に遊びに行くなど使い魔失格だな！","en":"Strange… I can't find my familiars Kuro and Shiro. Running off on their own makes them unfit as familiars!"},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"おい、退屈だから私の相手をしろ。この私の話し相手だぞ、光栄に思え","en":"Hey, I'm bored so entertain me. I'm your conversation partner, consider it an honor."},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ぬう……最近ここでの生活に馴染んで来てしまっている……偉大な魔女のこの私が！","en":"Ugh… I've started getting used to life here lately… this great witch, me!"},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私は魔女ミリアム、人間よ恐れおののきひれ伏すのだ！　ううっ、ひれ伏すのだー！","en":"I am the witch Merriam, human, tremble in fear and bow down! Ugh, bow down!"},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふふふ……人間よ、この魔女ミリアムに刃向かうのならばこの使い魔のシロとクロが……あれ？　ど、どこに行ったのだ？","en":"Hehe… human, if you dare oppose this witch Merriam, my familiars Shiro and Kuro will— huh? Wh-where did they go?"},"clip":"Audio/Voice/uni00079_1/uni00079_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00079_1/uni00079_1_rdy_1.ogg"},{"type":"rdy"