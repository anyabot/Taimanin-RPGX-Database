0,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00001",320],[12,"blo00004",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"不肖、元井河長老衆、井河扇舟。七生を以て、御身御守護を―――勤めさせて頂きます。ふふっ、これ？　ある人の台詞の真似事よ","en":"I, Igawa Senshu, former member of the Igawa elder group, will dedicate my life to protecting you. Hehe, this is just something someone else once said, but I'll make it my own."},"clip":"Audio/Voice/uni00951_1/uni00951_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"毒を抜いた魔草の料理、あなたも試してみる？　あら、素直ねぇ。私がわざと抜き忘れるかもしれないと、思わなかったの？　ふふっ","en":"Want to try some cooking with detoxified magical herbs? Oh, you're so straightforward. Didn't you think I might \"forget\" to remove the poison? Hehe."},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"もしも生まれが違ったら……そう思う事はあるわ。だけど、人は立場なしには生きられない。たとえそれで死ぬことになってもね","en":"If I had been born into a different family... Sometimes I think about that. But people can't live without their positions, even if it means dying for them."},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"この白鞘は闇市で買った粗悪品だけれど……いつか味龍のアルバイトで貯めた綺麗なお金で、ちゃんとしたものを買いたいわね","en":"This white scabbard is a low-quality product I bought on the black market... One day, I want to use the money I saved up from working at Miryu to buy a nice one."},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"私、生きたいわ。といっても、どうしても死にたくないってわけでもないの。死ぬ時は、生きたいと思いながら、死にたいのよ","en":"I want to live. But that doesn't mean I'm afraid to die. When I do die, I want it to be while I still have the will to live."},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"生きたいと思う事って、そんなに弱い事かしら？　だけど、私たちのような存在にとっては、そうなのかもしれないわね","en":"Is it really that weak to want to live? But for people like us, maybe that's just the way it is."},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"味龍の子たちは守ってあげたいけれど、仕える主ってタイプじゃないわね。……あなたが私の、銀さんにとっての雪緒になってみる？","en":"I want to protect the kids at Miryu, but I'm not the type to serve a master... How about you become my \"Yukino\" - my silver-san, for Igawa Asagi?"},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"……ん？　ああ、ごめんなさい、さっきまで大音量で映画を見てたから……し、失礼ね、遠くなってなんかいないわよ、一時的なモノよっ！","en":"...Huh? Oh, sorry, I was just watching a movie at full volume earlier... I-I'm sorry, I didn't mean to be rude, it's just a temporary thing!"},"clip":"Audio/Voice/uni00951_1/uni00951_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00951_1/uni00951_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0799"]],"stills":[["chr_0799a","chr_0799b","chr_0799c"]],"obtain":[{"kind":"gacha","type":"Collab","title":{"ja":"BLACKLAGOONコラボピックアップガチャ"},"start":null,"end":"2025-11-16"},{"kind":"gacha","type":"Collab","title":{"ja":"BLACKLAGOONコラボピックアップガチャ限定ユニット確定ガチャ"},"start":null,"end":"2025-11-16","pull":["Guaranteed 11-pull"]},{"kind":"spark","title":null,"need":30,"start":null,"end":"2025-11-16"}],"standardPool":false,"art":{"graphicId":"uni_00951","graphicNum":2,"r18GraphicId":"uni_00951_v","r18GraphicNum":2,"spineId":"Chr_0799"}}