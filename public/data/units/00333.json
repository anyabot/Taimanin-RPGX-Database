00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"逸刀流、陽炎。私の全ては源之助殿のモノ。……それでも良いなら手を貸しましょう","en":"I'm Kagero of the Ittō-ryū. Everything I have belongs to Lord Gennosuke... if that's okay with you, I'll lend you a hand"},"clip":"Audio/Voice/uni00333_1/uni00333_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"言っておきますが、慣れ合うつもりはありませんよ","en":"Let me make one thing clear: I have no intention of getting cozy with you"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"失礼。任務の指示以外を、聞き入れるつもりはありませんので","en":"Forgive me, but I won't be listening to anything other than mission briefings"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"まだ何か用が？　……そうですか、ならば私はこれにて","en":"Is there something else you need? ...I see, in that case, I'll take my leave"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"皆と交流を？　いえ、そのような気遣いは無用です","en":"You want me to socialize with the others? No, there's no need to go out of your way for me"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"源之助殿……たとえ捨てられても、何としてでもあなたのお力に……","en":"Lord Gennosuke... even if you abandon me, I'll do anything to be of use to you..."},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"全てを源之助殿に捧げて参りました。それ以外の事は私にとっては全て些末些少……今ここにいるのもひとえに源之助殿のためゆえです","en":"I've dedicated everything to Lord Gennosuke. Anything else is just trivial to me... and I'm only here because of him"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"すべきことは果たします。ですから私の事は放っておいてくださいませ。きっとこの想いは、誰にも理解できるものではありませぬゆえ","en":"I'll do what I need to do, so please don't mind me. This feeling I have... probably won't be understood by anyone"},"clip":"Audio/Voice/uni00333_1/uni00333_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"この身は大切な方の為に子をなしたのです、そこに後悔などあるはずがありません","en":"This body of mine has borne a child for the one I care about, so I have no regrets"},"clip":"Audio/Voice_r18/uni00333_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ああ、乳房がパンパンに張り詰めて、お腹の中で子が動いているぅ……！　でも、この苦しみも源之助殿の為ならばっ！","en":"Ah, my breasts are swollen and my belly's moving... but if it's for Lord Gennosuke's sake, I'll endure this suffering"},"clip":"Audio/Voice_r18/uni00333_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"んぉおおっ……♪　こ、これもう生まれるぅ、う、生まれりゅぅうううううぅっ♪","en":"Nnnoo... this is it, I'm giving birth... uuuuh!"},"clip":"Audio/Voice_r18/uni00333_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00333_1/uni00333_1_evo_1.ogg"},{"type":"evo","label":"Awakening","varia