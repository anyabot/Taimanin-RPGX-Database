lo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふうま災禍バニーバージョンです。けれど若様、これは任務です。私ばかりに目を向けていては事をし損じますよ？","en":"This is the Fuuma Saika bunny version. But Young Master, this is a mission. If you keep focusing only on me, we'll fail, you know?"},"clip":"Audio/Voice/uni00497_1/uni00497_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"若様、高級クラブでのお仕事、一緒に頑張りましょうね","en":"Young Master, let's work hard together at the high-class club."},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふふっ、この格好が気になりますか？　それでは、任務を無事に終えましたら……若様のお好きにどうぞ","en":"Hehe, does this outfit catch your eye? Then, once the mission is safely completed… feel free to do as you wish, Young Master."},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ここはやはりお金持ちばかりですね。ふうまの家もこのくらい裕福だととても助かるのですが……","en":"It seems only the rich gather here. If the Fuuma family were this wealthy, it would be a great help…"},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"まあお客様、チップをいただけるのですか？　ではこちらに……はい、私の胸の谷間に差し込んでいただけますか？","en":"Well then, sir, may I have a tip? Then, could you… insert it into the cleavage of my chest?"},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お客様、お飲み物をどうぞ。あっ、いけませんよ。バニーへのお触りは厳禁です。ふふふっ","en":"Sir, please have a drink. Ah, no—you must not touch the bunny. Hehehe."},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"若様との任務でしたら私はどんな衣装だろうと着こなしてみせますよ。バニーガールな災禍はいかがです？","en":"If it's a mission with you, Young Master, I'll pull off any costume. How about a bunny-girl Saika?"},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ラグジュアバニー、ですか？　ふふっ、若様ったら口がお上手ですね。でも、とても嬉しいです","en":"A luxury bunny, is it? Hehe, you have quite the way with words, Young Master. But I'm very pleased."},"clip":"Audio/Voice/uni00497_1/uni00497_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"わっ、若様正気に戻って！　部屋に戻ってから存分にお相手いたします……きゃんんっ！？　セックスはダメです！","en":"Young Master, you're finally sane! Once we're back in the room, I'll give you all the attention you want… kyaaa!? No sex allowed!"},"clip":"Audio/Voice_r18/uni00497_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"オーク化した若様を止められない！　襲われてまでいるのに……っ、感じてしまうなんて私……！　ああっ、オークのザーメンダメぇえッ！","en":"I can't stop you, Young Master, when you're turned into an Orc! Even though I'm being assaulted… I actually feel it… Ah, that damned Orc!"},"clip":"Audio/Voice_r18/uni00497_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00497_1/uni00497_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0354_r18"]],"stills":[["chr_0354a_r18"]],"obtain":[{"kind":"spark","title":null,"need":100,"start":"2021-08-16","end":"2021-08-31"},{"kind":"gacha","type":"Pickup","title":{"ja":"【復刻】ピックアップガチャ","en":"Rerun: Pick-up Gacha"},"start":"2025-08-18","end":"2025-08-31","pull":["Pick-up select"]},{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】バニー限定ガチャ","en":"Rerun: Bunny Limited Gacha"},"start":null,"end":"2026-08-12","pull":["Pick-up select"]}],"standardPool":true,"origin":"Bunny","art":{"graphicId":"uni_00497","graphicNum":2,"r18GraphicId":"uni_00497_r18","r18GraphicNum":2,"spineId":"Chr_0354"}}