0013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「魔界騎士イングリッドだ。なに？　そうは見えない？　こ、これは部下に無理矢理……！」","en":"I'm the Demon-Realm Knight Ingrid. What? You don't see it? Th-this… I had my subordinates force it on me…!"},"clip":"Audio/Voice/uni00045_1/uni00045_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こ、この格好か？　いや、部下に無理矢理着せられてだな……","en":"Th-this outfit? No, my subordinates made me wear it against my will…"},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あ、明けましておめでとう……だったか？　どうもこの挨拶にはまだ慣れない","en":"Ah, Happy New Year… I think? I still aren't used to this greeting."},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"晴れ着、というのだったな。綺麗ではあるが、動きにくいのがどうもな","en":"So it's called a formal kimono, right? It's pretty, but it's so stiff."},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"あ、侮るな。この様な格好をしていても私は魔界騎士だ！　遅れなどとらぬ！","en":"Don't underestimate me. Even dressed like this, I'm still a Demon-Realm Knight! I won't be delayed!"},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ふふふ……この格好ならば……あ、いやなんでもない！","en":"Heh heh… in this outfit… Ah, never mind!"},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"こ、この魔界騎士イングリッドを侮辱するか！　この格好は気にするなと言っている！","en":"You dare insult this Demon-Realm Knight Ingrid! I told you not to worry about this outfit!"},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"くっ……私は魔界騎士、このような屈辱、耐えがたい……！","en":"Damn… I'm a Demon-Realm Knight, this kind of humiliation is unbearable…!"},"clip":"Audio/Voice/uni00045_1/uni00045_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00045_1/uni00045_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"