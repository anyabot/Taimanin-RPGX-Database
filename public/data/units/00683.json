,3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"遅くなってごめんね、メイド喫茶のお仕事が長引いちゃって。ご、ご飯食べてて遅れたわけじゃないから……ね？","en":"Sorry I'm late, I was working at the maid cafe and it took longer than expected. I wasn't late because I was eating, I promise!"},"clip":"Audio/Voice/uni00683_1/uni00683_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"アルバイト先が見つかってよかった～。食費も抑えられるし、なにより賄いも食べさせてもらえるから最高！　おいしー！","en":"I'm glad I found a part-time job. Not only can I save on food expenses, but I also get to eat for free, which is the best!"},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"奢ってくれるの？　やったー！　実はさ、まだ出入り禁止になってない食べ放題のお店、発見したんだよね～！","en":"You're going to treat me? Yes! I actually found an all-you-can-eat place that I'm not banned from yet."},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お帰りなさいませご主人様……って、隊長！？　お客様としてきてくれたんだ、ありがとうございます。こちらのお席へどうぞ","en":"Welcome home, Master... I mean, Captain! I'm glad you came to visit me as a customer. Please, have a seat."},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"メイド服って着たことなかったからちょっとドキドキだったけど、クラシカルで可愛くてよかった～。料理もしやすいしね！","en":"I was a bit nervous about wearing a maid uniform, but it's classic and cute, and it makes cooking easier too!"},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"アフタヌーンティーをお持ちしました。どうか優雅な午後のひとときをお過ごしくださいませ――どう？　いい感じでしょ♪","en":"I brought you some afternoon tea. Please enjoy your elegant afternoon... how is it? Doesn't it feel nice?"},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ね、隊長、大食いデートって変かな……？　ボクと二人で、新しくできた食べ放題のお店……行って、くれない？","en":"Hey, Captain, do you think a big eater's date would be weird...? Just the two of us, going to a new all-you-can-eat place... want to go with me?"},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"お茶とお菓子のおかわりはいかがですか？　いらないならボクが食べちゃいます……てお仕事中だった！　失礼しました","en":"Would you like a refill on your tea and dessert? If not, I'll eat them... oh, I'm working right now! Sorry about that."},"clip":"Audio/Voice/uni00683_1/uni00683_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"はぁ、お腹空いたな……ちゅぱっ、ちゅばっ、指おしゃぶりしてもお腹の足しにならないから……おちんちん、ほしい……","en":"I'm so hungry... slurp, slurp, sucking on my fingers won't fill my stomach... I want your penis..."},"clip":"Audio/Voice_r18/uni00683_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"フェラチオして……はんっ、おちんちんの精液ゴックンしたら、少しはお腹がマシになるの……ジュブブ、ぐじゅうっ","en":"If I give you a blowjob... ah, your semen will fill me up a bit... slurp, gulp..."},"clip":"Audio/Voice_r18/uni00683_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"おちんちん、クセになっちゃったみたい……。おまんこにもほしい、おまんこにも精液飲ませて……っ！","en":"I've gotten used to it, I guess... now I want it in my pussy too, I want you to cum in my pussy..."},"clip":"Audio/Voice_r18/uni00683_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00683_1/uni00683_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":