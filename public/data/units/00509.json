0015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00509",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00509",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00509",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"今回は二人で登場！　真夏の美女二人組！　水着で戦うのって恥ずかしいけど……、よろしくね","en":"We're appearing together this time! A pair of beautiful women in the middle of summer! Fighting in swimsuits is embarrassing, but... nice to meet you"},"clip":"Audio/Voice/uni00509_1/uni00509_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"水着でウロウロするのって、ちょっと頼りない気がする……　先輩の場合、いつものスーツの方が際どくない？？","en":"Lying around in swimsuits makes me feel a bit unreliable... Don't you think your usual suit is more modest, Senpai?"},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"無理無理！　この格好で任務なんて行かないからねっ！　けど、敵の油断は誘えそうねぇ","en":"No way! I won't go on a mission dressed like this! But it might be a good way to lull our enemies into a trap"},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"やっぱり先輩への視線が多めな気がするのよねぇ……　そ、そんなことないわよ……っ","en":"I feel like people are staring at you more than usual, Senpai... N-no, that's not true..."},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふぅ……、少し喉が渇いたわね……　、そうだ！　二人でふうま悩殺して、飲み物ご馳走してもらいましょ！","en":"I'm a bit thirsty... Ah, I know! Let's use our Fuuma charms to get someone to treat us to drinks!"},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"リゾートでまったりするのも悪くないわねぇ。　そうそう！　最近、任務でずっと忙しかったもんねぇ","en":"It's not so bad to just relax at the resort. Yeah, we've been busy with missions lately"},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ねぇ、私達とプールで遊びましょ！　先輩がさっきからずっと気にしてたわよ。　ちょ、ちょっと！？　そういうのじゃないってば！！","en":"Hey, let's play with you at the pool! I've been noticing you've been looking at us since earlier. H-hey, not like that!"},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふふ……っ、両手に花ってこのことよねぇ。嬉しいでしょ？　あぁっ、くっつきすぎだってば……っ！","en":"Hehe... having someone on both sides is nice, isn't it? You're happy, right? Ah, stop clinging to me so much..."},"clip":"Audio/Voice/uni00509_1/uni00509_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ねぇねぇ、日焼け跡～。えっちすぎじゃない？？　もう！　あんまりジロジロ見ないで……。恥ずかしいから……っ","en":"Hey, hey, look at that tan line... Isn't it a bit too sexy? Stop staring at me, it's embarrassing..."},"clip":"Audio/Voice_r18/uni00509_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"先輩のおっぱい、なかなかの揉み心地ねぇ。ふふ……っ　やぁ……、ヘンな触り方しないでよぉ……っ、んぅ……","en":"Senpai's breasts are really nice to touch. Hehe... Yeah, don't touch me like that... Nn, stop it..."},"clip":"Audio/Voice_r18/uni00509_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"ふぅ……、なんだか今日熱いわね……　ん？　いつも通りだと思うけど。あ、もしかして先輩、発情してる？　なぁ！？　なんてこというのよっ！","en":"I feel like it's really hot today... But I think it's just normal. Ah, could it be that you're in heat, Senpai? What are you talking about?!"},"clip":"Audio/Voice_r18/uni00509_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00509_1/uni00509_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0364_1_r