"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00157",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00157",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00157",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00157",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私の名は、獅子神自斎。この名に聞き覚えはあるでしょう？　呪い殺されたくなければ、立ち去りなさい","en":"My name is Shishigami Jisai. Does that ring a bell? If you don't want to be cursed to death, step away."},"clip":"Audio/Voice/uni00157_1/uni00157_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"なんと言われようと、このマスクは外さないわ","en":"No matter what anyone says, I'm not taking this mask off."},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私はただ、超常の存在に護られているだけに過ぎないのよ……","en":"I'm just being protected by supernatural beings, that's all…"},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あなたは、不思議ね……。こんな私と、自然体で接してくれる。本当、おかしな人","en":"You're strange… you can treat me so naturally. Honestly, you're a weird one."},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"人は誰もみな平等だと言うけれど、そんなのは嘘。この私の存在が、いい証拠よ","en":"People say everyone's equal, but that's a lie. My very existence is proof."},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"誰も私と話さない。誰も私を愛さない。それでいいと、ずっと思ってきたわ……","en":"No one talks to me. No one loves me. And that's fine—I've thought that forever…"},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私にあんなことをするなんて……。あの時はどうかしていると思ったけれど、でも、それがあなたのいいところでもあるのよね","en":"You did that to me… I thought you were out of your mind back then, but that's also part of what makes you good."},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私の素顔を見て死ななかったのは、あなたが初めてよ。こんな奇跡も、たまにはあるのね……","en":"You're the first to see my true face and not die. Even miracles happen sometimes…"},"clip":"Audio/Voice/uni00157_1/uni00157_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00157_1/uni00157_1_dmg_3.ogg"},