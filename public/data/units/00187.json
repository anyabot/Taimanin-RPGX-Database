",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00187",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00187",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00187",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"……私はアサギ、探偵よ。といってもなんでも屋といったところかしら？　……同じ顔の女を見たことがある？　気のせいじゃないかしら","en":"...I'm Asagi, a detective. Though maybe more of a jack-of-all-trades? ...Have you ever seen a woman with the same face? Maybe it's just your imagination."},"clip":"Audio/Voice/uni00187_1/uni00187_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"人は“彷徨いサイボーグ”と呼ぶ。言い得て妙ね。……ま、嫌いじゃないわ","en":"People call me a \"wandering cyborg.\" That's a fitting description. ...Well, I don't hate it."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"オリジナルに興味なんてないわ。私は私。アサギという存在に変わりはない","en":"I'm not interested in the original. I'm me. I'm still Asagi, unchanged."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"お金になれば人捜しでもなんでもするわ。ただし、殺しは悪党限定でお願い","en":"If it pays, I'll take any case—find a missing person or whatever. Just make sure the killings are limited to villains."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"私の後ろに立たないことね。早死にしたいのなら、止めはしないけど","en":"Just don't stand behind me. If you want to die young, I won't stop you."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"サイボーグアームを気安く触らないで。“ネメシス”の威力は、知っているでしょう？","en":"Don't go touching my cyber arms casually. You know how powerful Nemesis is, right?"},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この腕は、あの忌まわしき特務機関Ｇの産物。……嗚呼、メンテナンスなら、ある魔界医に頼んでいるから大丈夫よ","en":"These arms are a product of that cursed special agency G… Ah, but for maintenance I rely on a doctor from the Demon Realm, so I'm fine."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"若い？　私はサイボーグソルジャーよ。年齢という概念などとは無縁なのだけれど","en":"Young? I'm a cyborg soldier. Age is a concept that doesn't apply to me."},"clip":"Audio/Voice/uni00187_1/uni00187_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00187_1/uni00187_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null