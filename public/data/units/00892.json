,[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"若様、鉄華院カヲル参りました。この装いは軍神の物だそうです。確かに厳めしいですが、同時に美しさもありますね","en":"Master, I've arrived. They say this armor is from a military god. It's certainly intimidating, but it also has a certain beauty to it."},"clip":"Audio/Voice/uni00892_1/uni00892_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"対魔忍スーツと違ってまるで鎧武者の様な格好だけれど、闘うのならこれはこれで心強いわね","en":"Unlike my Taimanin suit, I look like a armored warrior, but if I'm going to fight, this is reassuring in its own way."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"対魔忍スーツよりも、若様の視線を感じますが……ふふ、殿方は皆鎧兜が大好きなのですね。なら、しばらくこの装備でいましょうか","en":"I feel your gaze more than I do in my Taimanin suit... Hehe, I suppose men all love armor, don't they? Well, I'll wear this for a while, then."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"いつもより速度は落ちるけど防御はこちらのほうが上。それをいかした戦法も編み出さなければならないわね","en":"My speed may be slower than usual, but my defense is better. I need to come up with strategies that take advantage of that."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"対魔忍でありながら武者の格好というのは少し違和感もありますが……和装は身が引き締まっていいですね","en":"As a Taimanin, wearing a warrior's armor does feel a bit off... but I have to say, the Japanese clothing is flattering."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"どんな状況にあろうとも、この鉄華院カヲル、若様に忠義を尽くすことを改めてお誓いいたしますわ","en":"No matter the situation, I, Tekkain Kaworu, swear to devote myself to you, Master."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この鎧、誰かの魂が宿ってるのかと思うくらい強い意思を感じるわ……それも、優しく、純粋な力……","en":"This armor feels like it has someone's soul in it - I sense a strong will, gentle and pure..."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"重装備を着ていると、普段の対魔忍スーツの良さと、危うさ、両方を改めて考えさせられますね","en":"Wearing heavy armor makes me appreciate the good and bad points of my usual Taimanin suit."},"clip":"Audio/Voice/uni00892_1/uni00892_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あぐう！？　まさかこの鎧が破壊されるなんて……！　それに身体がっ、くあっ、ハァ……勝手に熱くなってきてる！？","en":"Ahh, no! This armor can't be destroyed...! And my body... it's getting hot on its own!"},"clip":"Audio/Voice_r18/uni00892_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"媚薬を打ち込まれたというの……！？　ハァハァっ、犯されてるのにっ、気持ち悪いのに……んぁ、気持ちいい！","en":"You're telling me this armor has been injected with an aphrodisiac...! I'm being violated, it's disgusting... but it feels good..."},"clip":"Audio/Voice_r18/uni00892_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"オマンコも口マンコもケツマンコ感じるぅ！　どこもグチョグチョに掻き回されてもうダメ！　イグぅぅぅッ！！","en":"My pussy, my mouth, my ass - everything's sensitive! I'm being stimulated everywhere, and it's too much! Ahhh!"},"clip":"Audio/Voice_r18/uni00892_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_lup_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00892_1/uni00892_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0740_r18"]],"stills":[["chr_0740a_r18"]],"obtain":[{"kind":"gacha","type":"Collab","title":{"ja":"【アリスソフト】コラボ限定ガチャ"},"start":"2025-04-19","end":"2025-05-03"},{"kind":"gacha","type":"Collab","title":{"ja":"【アリスソフト】コラボ限定ユニット確定ガチャ"},"start":"2025-04-19","end":"2025-05-03"},{"kind":"spark","title":null,"need":100,"start":"2025-04-19","end":"2025-05-03"}],"standardPool":false,"art":{"graphicId":"uni_00892","graphicNum":2,"r18GraphicId":"uni_00892_r18","r18GraphicNum":2,"spineId":"Chr_0740"}}