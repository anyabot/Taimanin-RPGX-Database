07",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「俺の名はアイナ・ウィンチェスター。その、なんだ……ちょっと匿ってくれねえか？」","en":"My name's Aina Winchester. Uh, uh... could you hide me out for a bit?"},"clip":"Audio/Voice/uni00043_1/uni00043_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"お、俺の格好はどうでもいいだろ！　それ以外にやらなきゃいけない事があるだろ！","en":"Hey, my outfit doesn't matter, right? I've got other things I gotta do!"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"はあ？　動きづらくないのか……って、余計なお世話だ！","en":"Huh? Doesn't it make you hard to move...? Whatever, that's none of your business!"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"う、うるせえ！　あんまり綺麗とか言うな！　着たくて着てるんじゃない！","en":"Shut up! Don't go calling me pretty! I'm not wearing this because I want to!"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"分かってねえなあ、こいつは普通の銃とはわけが違うぜ？　なんなら試して見るか？","en":"You don't get it, this thing's not a regular gun. Want to try it out?"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"こ、こんな格好似合わないと思ったけど、悪くねえかもな……って、い、いつから見てた！？","en":"I thought this outfit didn't suit me, but maybe it's not so bad... Wait, since when have you been watching!?"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"親に勝手に結婚させられそうになってるんだけど、俺にはそんなつもりはねえ！　協力してくれないか？","en":"My parents are trying to force me into a marriage, but I have no intention of that! Can you help me out?"},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"このウェディングドレスってのはなんというか、落ちつかねえな……俺らしくねえっていうか","en":"This wedding dress... it's just... unsettling. Not really like me at all."},"clip":"Audio/Voice/uni00043_1/uni00043_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00043_1/uni00043_1_rdy_2.og