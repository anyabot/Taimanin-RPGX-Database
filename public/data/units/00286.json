9",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ニャン、ちょうどよかったニャ♪　暇してたところだから、ボクを雇って欲しいニャ♪　一日三食、お魚と昼寝付きニャ","en":"Nyan, perfect timing, nya♪ I was bored, so hire me, nya♪ Three meals a day, fish and naps included, nya"},"clip":"Audio/Voice/uni00286_1/uni00286_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"学校もなかなかいいニャ……屋上、静かで……ポカポカ……よく寝られそう、ニャ……","en":"School's not bad, nya… the rooftop's quiet… warm… I could nap a lot, nya…"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"クラクルにはテストも宿題もないニャ、夜はベッドで運動会ニャ～","en":"Crackle has no tests or homework, nya; at night it's a sports day in bed, nya~"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ファ～……どこ行くんニャ……？　ああ、学校ニャ、ご苦労さんニャァ……んぅ、スヤスヤ……","en":"Faa… where are we going, nya…? Ah, school, good job, nyaaa… nnu, snooze…"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お腹も空いたし、そろそろ狩りに行くかニャ……ニャ？　今夜はお刺身――やったニャ、ご相伴に預かるニャア♪","en":"I'm hungry too, time to hunt, nya… Nya? Tonight it's sashimi— yay, I'll take you as my companion, nya~"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"暇だニャァ……釣りにつれてくニャ！　お前が釣って、ボクが食べる、完璧なコンビネーションだニャ♪","en":"Bored, nya… take me fishing! You fish, I eat, perfect combo, nya~"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"ここらはボクの縄張りだから、通りたかったらお魚をだすニャ","en":"This is my territory, so if you wanna pass, bring fish, nya"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ニャッ！？　こ、こんなにくれるなんて……よかったら、しばらくボクを養って欲しいニャア、ゴロニャァン♪","en":"Nya! ? G-given so much… if you like, keep feeding me for a while, nyaa, purr~"},"clip":"Audio/Voice/uni00286_1/uni00286_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00286_1/uni00286_