,9],[45,"blo00013",9],[46,"evo00020",8],[46,"evo00023",32],[46,"evo01003",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"女神のジュノよ。言っておくけど結婚関係の話はもう飽き飽きだからしないでよね？","en":"I'm Juno, the goddess. Just so you know, I'm sick of talking about marriage, so let's not, okay?"},"clip":"Audio/Voice/uni07006_1/uni07006_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"は？　恋愛相談？　ウザっ！　そんなん勝手にしてよ。ジュノ知らなーい","en":"Huh? A love consultation? Ugh, how annoying. Just figure it out yourself, I don't know anything about it."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"散々人間の結婚を守護して祝福してきたんだから、たまにはジュノを祝福してよ。ほらほら","en":"Since I've been guarding and blessing human marriages all this time, it's about time someone blessed me. Come on, do it."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"まったく人間ってのはなにかと理由をつけてイチャイチャイチャイチャ……ウザイったらないわね","en":"Humans are just so annoying, always coming up with excuses to be lovey-dovey... it's just so irritating."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"え？　なんて呼べば良いかって？　女神なんだからジュノ様って呼びなさいよ。当然でしょ？","en":"What do you mean, what should I be called? I'm a goddess, so call me Lady Juno, of course."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あなた絶対幸せな家庭なんて築けないわよ。結婚を守護するジュノが言うんだから間違いないわ♪","en":"You'll never have a happy family, that's for sure. I'm Juno, the goddess of marriage, and I'm telling you, it's a fact."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"６月ってほんと大嫌い！　何が女神の祝福よ、やってられないわよ、バーカ！","en":"I hate June! What's with this \"goddess's blessing\" nonsense? It's just so... ugh."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"なあに？　あまりふざけたこと言ってると大嫌いな奴と結婚させるわよ？","en":"What's with you? If you keep talking like that, I'll make you marry someone you hate."},"clip":"Audio/Voice/uni07006_1/uni07006_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07006_1/uni07006_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07006_1/uni