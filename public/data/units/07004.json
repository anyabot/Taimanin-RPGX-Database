,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00022",8],[46,"evo00023",32],[46,"evo01008",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"オ前ガ今回ノ雇イ主カ？　私ハファウスト……ふっ、お前が相手ならこの喋り方をする必要もないか","en":"Who's your employer this time? I'm Faust... Ha, I guess I don't need to talk like this with you."},"clip":"Audio/Voice/uni07004_1/uni07004_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"用心棒として色々な場所に滞在したが、ここは色々な奴がいて中々居心地がいい","en":"I've stayed in various places as a bodyguard, but this place is pretty comfortable with all sorts of people around."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふっ、私を繋ぎ止めておきたいのなら簡単だ、納得出来る契約と報酬を提示しろ","en":"If you want to keep me tied down, it's simple - just offer me a contract and compensation that I can accept."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ドウシタ？　何カ気ニナル事デモ……？　ああ、この喋り方もたまにはしておかないとと思ってな","en":"What's wrong? Is something bothering you? Ah, I thought I'd talk like this every now and then."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"情報共有の為にコミュニケーションは必要だが、馴れ合いは用心棒には禁物だ","en":"Communication is necessary for sharing information, but getting too close is taboo for a bodyguard."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"なんだ小僧、私のこの身体が気になるのか？　残念ながら詳細は教えられん","en":"What's with you, kid? Are you interested in my body? Sorry, but I won't give you any details."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"かつては米連に所属していたが、今はただの用心棒だ。そう警戒するな","en":"I used to be with the US military, but now I'm just a bodyguard. Don't be so wary of me."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"雇われれば魔族人間、悪人善人問わず力を貸す……お前はよく分かっているはずだ","en":"If I'm hired, I'll lend my power to anyone - demon or human, good or bad... You should know that by now."},"clip":"Audio/Voice/uni07004_1/uni07004_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07004_1/uni07004_1_msr_2.ogg"},{"type":"rdy","label":"Ba