0004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"寒いときはこれ、ホットチョコが一番にゃ♪　猫の頃は飲めにゃかったけど、いまはおいしくいただけるにゃ～","en":"When it's cold, this hot chocolate is the best, nya~. I couldn't drink it when I was a cat, but now I can enjoy it, nya~"},"clip":"Audio/Voice/uni00297_1/uni00297_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"うー、さむさむ……厚着をすると動きにくいし、冬は困りものにゃぁ……","en":"Ugh, so cold... Wearing thick clothes makes me stiff, winter's a hassle, nya..."},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"むふふ、この時期は甘い匂いがいっぱいで、嬉しいにゃあ……お、新作チョコ発見にゃ♪","en":"Mufufu, this season's full of sweet smells, I'm happy, nya... Oh, I found a new chocolate!"},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ペロペロ……ふぁ、甘いにゃあ……マタタビよりカツオより、やっぱりチョコだにゃあ……","en":"Peropero... fuh, it's sweet, nya... More than catnip or tuna, chocolate is the best, nya..."},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"うにゃ？　チョコを集めるより、配る日じゃないかって？　そんなもったいないこと、するわけないにゃ","en":"Ny? You think it's a day to hand out chocolate instead of collecting it? I would never waste it like that, nya."},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"んん～、新発見にゃ！　チョコを飲むなんて、人間はやっぱりかしこいにゃ！","en":"Mmm~ new discovery! Humans drinking chocolate, they're so clever, nya!"},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"リーダーにもチョコあげたかったんにゃけど、全部食べちゃったにゃ、許せにゃ","en":"I wanted to give the leader some chocolate too, but I ate it all, forgive me, nya."},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"さて、そろそろ真面目に働くかにゃ……と思ったけど、くっそ寒いからやめるにゃ。こんな日は、コタツに入るのが一番にゃ……ふにゃぁ……","en":"Well, time to get serious and work... I thought, but it's freezing, so I quit. On days like this, a kotatsu is the best... funya~"},"clip":"Audio/Voice/uni00297_1/uni00297_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00297_1/uni00297_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voic