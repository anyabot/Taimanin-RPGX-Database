t"},{"text":"1 enemy: DEF -20% for 4 turns","icon":"def_down","tag":"debuff"}]},{"level":3,"sp":250,"detail":{"ja":"敵１体に大威力で攻撃、DEFを小ダウンする"},"effects":[{"text":"1 enemy: 457% Superhuman damage","tag":"instant"},{"text":"1 enemy: DEF -20% for 4 turns","icon":"def_down","tag":"debuff"}]},{"level":4,"sp":250,"detail":{"ja":"敵１体に大威力で攻撃、DEFを小ダウンする"},"effects":[{"text":"1 enemy: 461% Superhuman damage","tag":"instant"},{"text":"1 enemy: DEF -20% for 4 turns","icon":"def_down","tag":"debuff"}]},{"level":5,"sp":250,"detail":{"ja":"敵１体に大威力で攻撃、DEFを小ダウンする"}}],"effects":[{"text":"1 enemy: 465% Superhuman damage","tag":"instant"},{"text":"1 enemy: DEF -20% for 4 turns","icon":"def_down","tag":"debuff"}]},"740006":{"slot":"ultimate","id":740006,"name":{"ja":"雪ウサギの煌き"},"hits":1,"cutin":true,"levels":[{"level":1,"sp":320,"detail":{"ja":"味方全体のDEFと会心率を大アップする"}},{"level":2,"sp":315,"detail":{"ja":"味方全体のDEFと会心率を大アップする"}},{"level":3,"sp":310,"detail":{"ja":"味方全体のDEFと会心率を大アップする"}},{"level":4,"sp":305,"detail":{"ja":"味方全体のDEFと会心率を大アップする"}},{"level":5,"sp":300,"detail":{"ja":"味方全体のDEFと会心率を大アップする"}}],"effects":[{"text":"All allies: crit rate +25% for 4 turns","icon":"crt_up","tag":"buff"},{"text":"All allies: DEF +60% for 4 turns","icon":"def_up","tag":"buff"}]}},"leader":{"name":{"ja":"バニー先輩"},"detail":{"ja":"部隊全体のSPDを中アップ"},"effects":[{"text":"All allies: SPD +15%","icon":"spd_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00372",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00372",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00372",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00372",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00372",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00372",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00372",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"お待たせー！　姿はか弱いウサギでも、侮らないでよね！　餌付けしようなんて不埒な考え起こしたら、引き裂いてやるんだから！","en":"\"Sorry to keep you waiting! I may look like a frail rabbit, but don't underestimate me! If you start feeding me, I'll tear you apart!\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"別にあんたに媚びるためにこんな衣装を着てるわけじゃないから！　これは私が着たいから着てるだけ！　……何よその顔は？","en":"\"I'm not wearing this just to flatter you! I'm wearing it because I want to! …What's with that face?\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あんまりジロジロ見るなぁ……あ……い、一切見るなとは言ってないでしょ！　ワガママ？　う、うっさいっ！","en":"\"Don't stare so much… ah… I didn't say you have to stop looking entirely! Whiny? Shut up!\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"えっ、任務！？　じゃあすぐに着替えて……そんな暇ない！？　そんなっ、この格好で戦わなくちゃいけないっていうの！？","en":"\"What, a mission!? Then I have to change right away… No time for that!? You expect me to fight in this outfit!?\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"きらきらきらりん☆ウサきらら登場だぴょん♪　……っだあぁ！　次の勝負は絶対勝つからね！　この衣装着せて恥ずかしい事言わせるんだから！","en":"\"Sparkle sparkle Kirara the Bunny appears—hop♪ …Aa! I'll definitely win the next match! You made me wear this and say embarrassing things!\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"はあ……本物のウサギみたいに素直に甘えられたらなぁ。……っ！？　う、ウソ、今の聞いてた？　そ、そう、聞いてないならいいのよ","en":"\"Sigh… if I could be as obedient as a real rabbit… huh!? Liar, did you hear that? If you didn't… then fine.\""},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"どうしてバニーなのかって……あんたがこういうの好きって聞いたから……ち、違うからね、挑発してからかってやろうとしただけなんだから！","en":"You ask why I'm in a bunny outfit… because I heard you like this kind of thing… N-no, that's not it, I was just trying to tease you!"},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"こ、この格好で潜入任務！？　何やらせるつもりよ！　……え、カジノとかバー？　あ、あはは、そうよね、分かってたわよ、最初から","en":"Infiltration mission in this outfit!? What are you trying to make me do! …huh, a casino or a bar? Ah, haha, right, I knew it from the start."},"clip":"Audio/Voice/uni00372_1/uni00372_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"こんな惨めな格好見て興奮するなんて変態……えっ？　わ、私も見られて興奮してるだろうって？　……うぅ、こんな風にしたのはあんたでしょ？","en":"Getting off on seeing me in this pathetic outfit, you pervert… huh? You think I'm also getting excited being watched? …Ugh, you were the one who made me look like this, weren't you?"},"clip":"Audio/Voice_r18/uni00372_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"エロカワバニーとか言うなしぃ……に、ニヤニヤなんてしてない！　嬉しくなんてないから！　今から奥で休むけど、勝手に入ってこないでよね！","en":"Don't call me a \"sexy cute bunny\"… I-I'm not smirking! I'm not happy about this! I'm going to rest in the back now, so don't just barge in!"},"clip":"Audio/Voice_r18/uni00372_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"はぁっ！？　負けてないんだけどぉ！？　まだまだ全然ヤれるし！　だから私の勝ちは確定……あっ、ちょっと、やんっ♪　それ、ずるいぃ……","en":"Huh!? I'm not losing! I can still keep going! So my victory is a given… Ah, hey, stop it♪ That's cheating…"},"clip":"Audio/Voice_r18/uni00372_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00372_1/uni00372_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0252_1_r18"],["chr_0252_2_r18"]],"stills":[["chr_0252_1a_r18"],["chr_0252_2a_r18"]],"obtain":[{"kind":"exchange","title":null,"start":"2021-10-15","end":null},{"kind":"exchange","title":null,"start":"2022-09-01","end":"2022-11-30"},{"kind":"spark","title":null,"need":300,"start":"2022-12-01","end":"2022-12-31"},{"kind":"spark","title":null,"need":300,"start":"2023-08-01","end":"2023-08-31"},{"kind":"exchange","title":null,"start":"2023-09-01","end":"2023-11-30"},{"kind":"spark","title":null,"need":300,"start":"2024-07-01","end":"2024-07-31"},{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【超人】","en":"Kessen Pick-up Gacha (Superhuman)"},"start":"2025-04-01","end":"2025-04-30"},{"kind":"spark","title":null,"need":300,"start":null,"end":null}],"standardPool":true,"origin":"Permanent","art":{"graphicId":"uni_00372","graphicNum":2,"r18GraphicId":"uni_00372_r18","r18GraphicNum":2,"spineId":"Chr_0252"}}