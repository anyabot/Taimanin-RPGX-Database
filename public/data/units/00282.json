us":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00005",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"このような格好、軍人には似合うまい……宴席が終わったら、すぐに着替えさせてもらう","en":"This kind of outfit doesn't really suit a soldier… I'll change as soon as the banquet's over."},"clip":"Audio/Voice/uni00282_1/uni00282_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"……しつこいな、私は結構だと言っている――と、隊長か。すまない、なんでもないんだ","en":"…You're being persistent. I told you I'm fine—oh, it's the captain. Sorry, never mind."},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"うん？　そんなにイライラして見えるか……新年なのだから呑めと、先ほどから周りがしつこくてな","en":"Huh? Do I look that irritated… It's New Year's, so they keep telling me to drink, and they've been pestering me all this time."},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"……ありがとう、連れだしてくれて。私が酒を勧められているのを、見かねたのだろう？　優しいな、隊長は……素敵だ……","en":"…Thank you for taking me out. You saw I was being offered alcohol, didn't you? How kind you are, Captain… so wonderful…"},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ん……なに、匂いで酔ったのか、だと？　酔ってなど、いらい……ひっく……うぃー……","en":"Hmm… what, you think I'm drunk from the smell? I'm not drunk… *hic*… whee…"},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"わらひは、こぇれも……隊長には、けーいを払っている……それをわかってるろかぁ！？　んぅっ、けしからぁん！","en":"I… even this… I'm paying respect to the captain… do you get that?! Nngh, how indecent!"},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"軍属にあるものならば、いかなる状況でも万全でいられるよう、アルコールは断っておくべきだ","en":"If it's something a soldier possesses, we should refuse alcohol so we can stay fully prepared in any situation."},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"んぁぁ、はふぅぅぅ……んぅ、酔っへにゃい……らって、おひゃけなんか、のんれないからなぁ……","en":"Nn… haaa… nngh, I won't get drunk… and besides, I can't drink anything while on duty…"},"clip":"Audio/Voice/uni00282_1/uni00282_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00282_1/uni00282_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0184_r18"]],"stills":[["chr_0184a_r18"]],"obtain":[{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】期間限定正月ガチャ"},"start":"2025-12-31","end":"2026-01-16"},{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":false,"art":{"graphicId":"uni_00282","graphicNum":2,"r18GraphicId":"uni_00282_r18","r18GraphicNum":2,"spineId":"Chr_0184"}}