0013",4],[35,"blo00007",4],[35,"blo00010",4],[35,"blo00013",4],[36,"evo00018",8],[36,"evo00023",32],[36,"evo01020",1],[37,"blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00018",8],[41,"evo00023",32],[41,"evo01020",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00018",8],[46,"evo00023",32],[46,"evo01020",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ガオォォォ！！！！　……あれ？　なんだ君かぁ。ぼく白熊タロー、仲良くしてね～","en":"Gao! ...... Hmm? You're the one, huh? I'm Shirokuma Taro, let's get along~"},"clip":"Audio/Voice/uni07020_1/uni07020_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"がおー、食べちゃうぞー！　なーんてね。うそうそ、ぼくはそんなことしないよ～","en":"Grrr, I'll eat you up! Just kidding, I wouldn't do that. Hehe, don't worry about it."},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ぼく、難しいことを考えるのは苦手なんだ～。でも、力仕事なら何でもまかせて","en":"I'm not good at thinking about complicated things, but if it's a physical task, I can handle anything."},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ｚｚＺ……ｚｚＺ……ふぁーあ、気持ちよくてつい寝ちゃってたよぉ～","en":"Zzz... I dozed off, it was so comfortable..."},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ぼくの毛皮を触りたい？　いいよぉ、ふかふかで自慢の毛並みなんだ。夏はちょっと暑いんだけどね……","en":"Want to touch my fur? It's okay, I'm proud of my soft and fluffy coat. It's just a bit hot in the summer, though..."},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ここのみんなは優しくて、居心地がいいねえ。あとは、お酒が飲めれば最高なんだけどなあ","en":"Everyone here is so nice, and it feels really comfortable. If only I could drink some booze, it'd be perfect..."},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"獣王会はね、トラちゃんも一郎太のアニキも、みーんな強くてすごいんだよ～","en":"The Shirokuma group is amazing - Torachan, Ichirota's big brother, everyone's so strong and awesome!"},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"最近ちょっと太っちゃって、鎧のお腹まわりがきついんだ。でも、おいしいご飯とお酒はやめられないよね","en":"I've put on a bit of weight lately, and my armor's getting a bit tight around the stomach. But I just can't resist delicious food and booze, you know?"},"clip":"Audio/Voice/uni07020_1/uni07020_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07020_1/uni07020_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"bas