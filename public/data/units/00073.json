",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「ラスタだ。この力を、利用してくれて構わない……私には、それくらいしかないからな」","en":"I'm Luster. You can use this power however you like… that's all I've got."},"clip":"Audio/Voice/uni00073_1/uni00073_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の身体には、魔族の細胞が埋め込まれている……半人半魔の存在、という事だ","en":"My body has demon cells implanted… I'm a half-human, half-demon."},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"人体実験の、唯一の生き残り……忌ま忌ましい力を手にして、私は生き残った……","en":"I'm the only survivor of those human experiments… I survived by wielding this abhorrent power…"},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"この腕輪を外したら？　これは言わば制御装置……私の中の破壊衝動を抑えるための……","en":"What if I take off this bracelet? It's basically a control device… to keep my destructive urges in check…"},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"戦う時は、この魔族の力を使っている。空中に刃を作る事ができるんだ","en":"When I fight, I use this demon power. I can forge blades in midair."},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私は魔族を許せない。同じように、それが中に入っているという事実すらも……","en":"I can't forgive demons. And I can't even accept that it's inside me…"},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"くっ、腕輪をつけても、既に溢れ出した破壊衝動が残っているのか……","en":"Damn, even with the bracelet on, the destructive urge that's already spilled out is still there…"},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"破壊衝動が抑えられない時……別の強い衝動で発散する事ができる……だからその時は……","en":"When I can't suppress the destructive urge… I can release it with another strong impulse… so then…"},"clip":"Audio/Voice/uni00073_1/uni00073_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00073_1/uni00073_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":n