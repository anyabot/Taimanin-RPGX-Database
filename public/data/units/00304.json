00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00304",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00304",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00304",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00304",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"今日は私のために来てくれて、ありがとー！　さぁ、井河さくらのベースに、酔いしれるがいい～♪","en":"Thanks for coming for me today! Now, get drunk on Igawa Sakura's bass~!"},"clip":"Audio/Voice/uni00304_1/uni00304_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"えっへへ～、どうだ！　様になってきたでしょー？　時子さんにゲーム取り上げられて始めたベース、すっかりハマっちゃったよ♪","en":"Hehe~ how's that! Getting the hang of it, right? I started the bass after Tokiko took the game away, and I'm totally hooked♪"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"う～ん、ベースもいいけど、またゲームやりたいねぇ……ゲームやりすぎの件、そろそろ許してくれないかなぁ、時子さん……","en":"Hmm, the bass is great but I want to play games again… Could you finally forgive me for playing too much, Tokiko…"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"今日は音のノリがいいねぇ、絶好調♪　いよぉ～し、このまま武道館目指しちゃおっかな～？","en":"The vibe's perfect today, I'm on fire♪ Alright, shall I aim for the Budokan like this~?"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"いつかお姉ちゃんとかムッちゃんと、バンド組みたいな～……あ！　そのときは、キミも一緒に来てよねっ？　二人にも紹介するからさっ♪","en":"Someday I want to form a band with my big sis and Mucchan… Ah! Then you have to come too, okay? I'll introduce you to the two of them♪"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ふぅ～、今日もいい汗かいたぜ……ねっ、ちょっと散歩行こうよ♪　ベース始めてから、あんまり構ってあげられなかったからね～♪","en":"Phew~ sweated a lot today… Hey, let's take a little walk♪ Since I started the bass I haven't been able to give you much attention~"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この低音がさぁ、聞いてると身体に響くんだよねぇ……揺さぶられるっていうかさぁ……なんつって♪","en":"This low end, when you hear it it resonates in your body… it's like being shaken… just kidding♪"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ね、ねぇ、その……よかったらキミも、やってみない？　ほら、ギターもドラムも空いてるしさぁ、いまのとこ","en":"Um, um… if you want, why don't you try it too? Look, there's a guitar and drums free right now"},"clip":"Audio/Voice/uni00304_1/uni00304_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00304_1/uni00304_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00304_1/uni00304_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00304_1/uni00304_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00304_1/uni00304_1_dmg_1.ogg"},{"type":"dmg","labe