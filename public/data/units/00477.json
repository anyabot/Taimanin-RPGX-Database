,3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"海辺のつよつよヤタガラス、ハツカゼ参上！　ほらほらどうよどうよ？　私の大人水着でふうまなんてイチコロなのさー、むふー！","en":"I'm Hatsukaze, the strongest Yatagarasu by the sea! How's this, how's this? My adult swimsuit is the best, and I'm not just saying that because I'm a Fuuma - muhu!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"水着の霊鳥ハツカゼとは私のことだ！　どんな勝負でも受けて立つぞー！","en":"I'm Hatsukaze, the spirit bird in a swimsuit! I'll take on any challenge you've got!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"私の大人水着にメロメロになったでしょ？　さあさあ見物料を払ってもらおうじゃないか！","en":"You're drooling over my adult swimsuit, aren't you? Well, pay up if you want to keep looking!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふっふっふーっ！　私と勝負なんていい度胸だね！　大人になったつよつよヤタガラスの力を思い知らせてやるー！","en":"Huh-huh-huh, you've got some nerve challenging me! I'll show you the power of a grown-up Yatagarasu!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"このカラス浮き輪がある限り私は溺れない！　海辺でも最強なんだー！　むふーッ！","en":"As long as I've got this crow floatie, I won't drown! I'm the strongest, even by the sea - muhu!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"海と言ったら遊びもいいけどバーベキューもねっ！　焼肉！　ソーセージ！　ハンバーグ！　焼き鳥ー！　共食いも上等だーい！","en":"The beach is great for playing, but it's also perfect for a barbecue! Grilled meat, sausages, hamburgers, and skewers - I'll take them all!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"海だー！　泳ご泳ごッ！　えっ？　烏の行水って何？　新作の和菓子か何か？　奢って奢ってー！　私にお菓子を貢ぐといいことあるよー！","en":"It's the beach! Let's swim! What's \"crow's water\"? Is it a new Japanese snack? Treat me to some, and I might just reward you!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ビーチフラッグにビーチバレー、ビーチパラソルでもなんでもかかってきんしゃい！　カモーン！　よゆーで私が全勝利だからなー！","en":"Bring it on - beach flags, beach volleyball, or beach parasols! I'll take them all on and win, of course!"},"clip":"Audio/Voice/uni00477_1/uni00477_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"「ふふんっ、な、何されても感じないってば……！　ひひゃあッ！？　オマンコはダメっ、んんあっ、そこは感じるとこひイイイっ！？」","en":"\"Huh, I won't feel a thing...! Hiyah! Oh no, my pussy's sensitive...! Ahhh, it feels so good!\""},"clip":"Audio/Voice_r18/uni00477_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"「わっ、私の勝ちだね……！　そんな必死に腰動かして……私にメロメロになって……んいいいっ、イクイクイクぅうッ！！」","en":"\"I win, of course...! You're moving your hips so desperately... and you're so obsessed with me...! Ahhh, I'm cumming, cumming, cumming!\""},"clip":"Audio/Voice_r18/uni00477_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00477_1/uni00477_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"tex