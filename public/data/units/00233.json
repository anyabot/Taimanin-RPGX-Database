,5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふふっ……私の調教が忘れられなかったのねぇ、ボウヤ？　それなら、もっともっと深い刻印を、お腹の中に仕込んであげるわ♪","en":"Hehe… you still can't forget my training, can you, boy? Then I'll carve an even deeper mark into your belly♪"},"clip":"Audio/Voice/uni00233_1/uni00233_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"あら、おはよう……昨夜はよく眠れたかしら？　ふ・う・子・ちゃん♪　あははははっ！","en":"Ah, good morning… did you sleep well last night? Fu-u-ko-chan♪ Ahahaha!"},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"なぁに、その反抗的な目つきは……ふふっ、まだ鞭が足りなかったかしらねぇ？　それとも『棒』のほうがいいかしら♪","en":"What's with that defiant stare… heh, maybe the whip wasn't enough? Or would you rather a \"rod\"?"},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふっ、そうそう……飼い主には従順でいなさい。そうすれば餌もあげるし、気持ちのいいご褒美もあげるわよ","en":"Hehe, that's right… be obedient to your master. Then I'll give you food, and a nice reward."},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"そろそろ、お前にお客を取らせるのも悪くないわね……『穴』と『竿』、どっちを使える客がいい？　選ばせてあげるわ","en":"It might not be bad to have you take a client… which would you rather, a \"hole\" or a \"shaft\"? I'll let you decide."},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"いまのお前を見たら、アサギのやつはなんて思うかしら？　同じ境遇に貶めてやれば、仲睦まじい夫婦になれるかもしれないわよ、あははははっ♪","en":"Seeing you like this, I wonder what Asagi would think… If I drag her down to the same fate, maybe we could become a cozy couple, ahahaha!"},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"アサギのお気に入りの小僧が、私の奴隷になってくれるなんて♪　ほら、誓いのキスをなさい……足の裏にねぇ、あはははは！","en":"Asagi's favorite brat becoming my slave… Come on, give me a pledge kiss… on the sole of my foot, ahahaha!"},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"随分と感度が上がってきたようね……あら、いつものおねだりはどうしたの？　早く惨めに啼いて、無様に媚びなさい！","en":"Your sensitivity's really spiking… oh, where's your usual pleading? Cry pitifully fast, and beg clumsily!"},"clip":"Audio/Voice/uni00233_1/uni00233_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00233_1/uni00233_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","