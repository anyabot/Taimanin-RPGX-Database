0011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"今日は店が休みだからデートをするぞふうま！　互いの事をよく知るためには必要な事だからな！","en":"Today's my day off, so let's go on a date, Fuuma! It's necessary for us to get to know each other better."},"clip":"Audio/Voice/uni00493_1/uni00493_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ふふ、この服中々可愛いだろ。ポイントはこのパンダポシェットだ！　中身は秘密だけどな♪","en":"Hehe, don't you think this outfit is cute? The highlight is this panda pouch! But what's inside is a secret, okay?"},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ん？　腹が減ったのか？　よし、何か作ってやる……と思ったが、この服のままじゃ汚れてしまうか","en":"Hmm, are you hungry? I was thinking of making something... but I don't want to get this outfit dirty."},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"さっきからこっちをチラチラ見てどうしたんだ？　お前はあたしの婿になるんだもっと堂々と見ていいんだぞ","en":"What's with the sneaky glances? You're going to be my husband, so feel free to look at me straight on."},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"お前とのデートは想像以上に楽しかったからまた行こう！　次は『おうちデート』とやらがしてみたい","en":"I had more fun on our date than I expected, so let's do it again! Next time, I want to try a \"home date\"."},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お前はどんな服が好みだ？　次のデートはそれを……いつもの服がいいのか？　ふふふ、そうかそうか♪","en":"What kind of clothes do you like? Do you want me to wear something special for our next date, or my usual outfit? Hehe, okay, got it."},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お前とは店でばかり会っていたからな、私服を見せるのは新鮮だ……どうだ？　そそるか？","en":"Since we always meet at the restaurant, it's nice to see me in casual clothes... what do you think? Does it turn you on?"},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"親父にふうまとデートだと言ったら軍資金を沢山もらったぞ。これだけあればホテルでのディナーも余裕だな","en":"When I told my dad we were going on a date, he gave us a lot of money. With this, we can even have a hotel dinner."},"clip":"Audio/Voice/uni00493_1/uni00493_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あぁ……これがふうまのザーメン……♪　あたしを孕ませる男の子種か……♪","en":"Ah... this is Fuuma's semen... I can feel it... the sperm that will make me pregnant..."},"clip":"Audio/Voice_r18/uni00493_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"こんなに濃い精液を出してくれるなんて……さ、次はあたしの膣内に注ぎ込んでくれ♪","en":"You're producing such thick semen... now, pour it inside me..."},"clip":"Audio/Voice_r18/uni00493_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"んぢゅるっ、ちゅぷっ、くちゅくちゅ……けぷ♪　ふふ、もっともっと出して、あたしに味わわせてくれ……♪","en":"Njuju, chupu, kuchukuchu... kep! Hehe, more, more, give me more..."},"clip":"Audio/Voice_r18/uni00493_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00493_1/uni00493_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00493_1/uni00493_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"t