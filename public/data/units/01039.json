nstant"},{"text":"Power +30% against targets with Confusion","tag":"modifier"}]}},"leader":{"name":{"ja":"宇宙連邦軍の少佐"},"detail":{"ja":"戦闘開始時、監獄戦艦特性の会心率を中アップ+部隊全体のATKを中アップ"},"effects":[{"text":"Prison Battleship allies: crit rate +15%","icon":"crt_up","tag":"passive"},{"text":"All allies: ATK +15%","icon":"atk_up","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ご丁寧にどうも。私はジャサント号艦長のドニ・ボーカンです。――ああ、そうか。なら自分を偽る必要はないな。よろしく","en":"Thanks for the courtesy. I'm the captain of the Jasant, Doni Bogan. — Ah, I see. Then there's no need to pretend. Nice to meet you."},"clip":"Audio/Voice/uni01039_1/uni01039_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"俺はあんたの信条についてどうこう言うつもりはない。その分、こちらの方も尊重してもらわないとな。お互い平和でいたいだろう？","en":"I'm not going to tell you what to think about your creed. In return, you'll have to respect mine. We both want to keep the peace, right?"},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"大それた野望なんぞ持ってない。若い頃からただがむしゃらに生きていただけだ。今は……そう、復讐のためだけに生きているのさ","en":"I don't have any grand ambitions. I've just been charging head-first since I was young. Now… yeah, I live only for revenge."},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"なんだ。洗脳ラボに興味があるのか？　あんたも案外……おっと、冗談さ。あんたが興味あるのは仕組みの方だけ、だろ？　分かってるよ","en":"What, you're interested in the brain-washing lab? You're actually… hey, just kidding. You're only interested in the mechanism, aren't you? I know."},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"俺が大人しいのがそんなに意外か？　俺は自分の欲望に正直なだけの、どこにでもいる普通の男さ。まあ、今は復讐の事しか考えていないがな","en":"Is it so surprising that I'm calm? I'm just a regular guy who's honest about his desires. Well, right now all I can think about is revenge."},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"復讐さえできるならここに骨を埋めたって構わない。だが、ジャサント号のラボの奴ら以外を信用するつもりはないぞ","en":"If I can get my revenge, I don't mind burying my bones here. But I won't trust anyone besides the guys in the Jasant's lab."},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"つれないな。同じ『頭脳派』同士、バカ強い女をどうやって扱うのか。共有できる情報もあると思うがね","en":"Don't be cold. We're both \"brains\" types—how do you handle a ridiculously strong woman? I think there's info we could share."},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ふっ……若いのに部下を率いる術をよく心得ているな。俺は死ぬ思いをしながらようやく手に入れたというのに……","en":"Huh… you're young yet you've got a good grasp on leading subordinates. I only just earned this through near-death experiences…"},"clip":"Audio/Voice/uni01039_1/uni01039_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"このスーツがこの時代の流行りなのか？　機能性は悪くはないようだが……見た目にはもう少し気をつかってもらいたかったな","en":"Is this suit the fashion of the era? Functionally it's not bad, but I wish the appearance had a bit more care."},"clip":"Audio/Voice_r18/uni01039_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"まさか俺は洗脳を受けているのか？　こんな派手なスーツを着るなんて、いつもならば有り得ないぞ","en":"Could it be that I'm being brain-washed? Wearing such a flashy suit would never happen under normal circumstances."},"clip":"Audio/Voice_r18/uni01039_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"正義のヒーローと言えば聞こえはいいが、流石にこの格好は……機能性に問題はないし、一旦保留しておくか","en":"Calling yourself a righteous hero sounds nice, but this outfit… Functionally it's fine, so I'll put it on hold for now."},"clip":"Audio/Voice_r18/uni01039_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni01039_1/uni01039_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_1039_1_r18","chr_1039_3_r18"],["chr_1039_2_r18"]],"stills":[["chr_1039_1a_r18"],["chr_1039_2a_r18"]],"obtain":[],"standardPool":false,"art":{"graphicId":"uni_01039","graphicNum":2,"r18GraphicId":"uni_01039_r18","r18GraphicNum":2,"spineId":"Chr_1039"}}