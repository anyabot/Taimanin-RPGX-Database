00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00001",320],[26,"blo00004",1],[27,"blo00007",5],[27,"blo00010",5],[27,"blo00013",5],[28,"blo00007",5],[28,"blo00010",5],[28,"blo00013",5],[29,"blo00007",5],[29,"blo00010",5],[29,"blo00013",5],[30,"blo00007",5],[30,"blo00010",5],[30,"blo00013",5],[31,"blo00001",320],[31,"blo00004",2],[32,"blo00007",5],[32,"blo00010",5],[32,"blo00013",5],[33,"blo00007",5],[33,"blo00010",5],[33,"blo00013",5],[34,"blo00007",5],[34,"blo00010",5],[34,"blo00013",5],[35,"blo00007",5],[35,"blo00010",5],[35,"blo00013",5],[36,"blo00001",320],[36,"blo00004",2],[37,"blo00007",5],[37,"blo00010",5],[37,"blo00013",5],[38,"blo00007",5],[38,"blo00010",5],[38,"blo00013",5],[39,"blo00007",5],[39,"blo00010",5],[39,"blo00013",5],[40,"blo00007",5],[40,"blo00010",5],[40,"blo00013",5],[41,"blo00001",640],[41,"blo00004",2],[42,"blo00007",5],[42,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"エレ・アンスタン。本能のままに放浪している者だけど、この荒野で出会ったのも何かの縁、君のために少しは役立とう","en":"\"I'm Errer Instinct. I wander wherever my instincts lead, but meeting you out here must be fate. I'll try to be of some help.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私は何かの実験体……だと思うんだけど、実は自分のことはよくわからないの。まあ、気長に探していくわ","en":"\"I think I'm some kind of test subject… but honestly, I don't really understand myself. Well, I'll take my time and figure it out.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"荒野を彷徨っているのは仲間と……いえ、誰かと出会うため。現に君と出会ったでしょう？","en":"\"I'm roaming the wasteland to meet comrades… no, to meet someone. After all, I've already met you, haven't I?\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"できれば戦いたくないんだけど……敵であるなら容赦はしない！　全力で叩き潰すのみよ！","en":"\"I'd rather not fight… but if you're an enemy, I won't show mercy! I'll crush you with everything I've got!\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"人は簡単に死ぬ。息をするくらい当たり前に、理不尽にね。でも私の手の届く範囲でなら、簡単に奪われてしまう命を救いたい","en":"\"People die easily. Breathing is as natural as it is absurdly fragile. If it's within my reach, I want to save those lives that would otherwise be snatched away so easily.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"斧とマチェット、ショットガン、残弾は……ん？　ああ、装備の確認はいつも欠かさないの。これをしてると落ち着くから","en":"\"Axes, machetes, shotguns, leftover ammo… huh? Ah, I never skip checking my gear. It calms me down when I do it.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"これでも少しは修羅場を経験している、甘言など通じない。痛い目を見ないうちに失せることね","en":"\"Even though I've seen a bit of hell, sweet talk won't work on me. It's better to disappear before you get a painful lesson.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この荒野で仲間を捜している。生存している可能性はごく僅かだけど、ゼロでないのなら私は進む","en":"\"I'm searching for comrades in this wasteland. The chance they're still alive is slim, but as long as it's not zero, I'll keep moving forward.\""},"clip":"Audio/Voice/uni00620_1/uni00620_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ぐンン！？　これっ、媚薬なの……ッ！？　くっ、こんな触手にいいようにされるなんてっ、ああっ、身体っ、勝手に気持ちよくならないで……！","en":"\"Grrr!? This… it's an aphrodisiac…! Damn, being toyed with by these tentacles… ah, my body… don't… get turned on on its own…!\""},"clip":"Audio/Voice_r18/uni00620_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"マンコに入って！？　イイイっ！？　私を苗床にするつもりっ？　あぐあっ、奥まで引っ掻き回されるぅ！？","en":"\"Inside my…? Yes! You think you'll use me as a breeding ground? Ah, you're tearing me deep inside!?\""},"clip":"Audio/Voice_r18/uni00620_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"この世界には秩序はないっ、だから雄は雌に種付けをして、んひっ、雌は孕んでアクメをし子を産むんだ！　んぉおぉっ！","en":"\"There's no order in this world, so the male impregnates the female, and then the female… reaches climax and gives birth! Ah-oo-oo!\""},"clip":"Audio/Voice_r18/uni00620_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00620_1/uni00620_1_wav_1.ogg"}],"trust":[50],"scenes":[["chr_0468_r18"]],"stills":[["chr_0468a_r18"]],"obtain":[{"kind":"spark","title":null,"need":30,"start":"2022-09-16","end":"2022-09-30"},{"kind":"spark","title":null,"need":30,"start":"2023-09-01","end":"2023-09-30"},{"kind":"spark","title":null,"need":30,"start":"2024-04-01","end":"2024-04-30"},{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【魔性】"},"start":"2025-05-01","end":"2025-05-31"}],"standardPool":true,"art":{"graphicId":"uni_00620","graphicNum":2,"r18GraphicId":"uni_00620_r18","r18GraphicNum":2,"spineId":"Chr_0468"}}