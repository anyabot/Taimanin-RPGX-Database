1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"い、いきなり呼び出してんじゃねーよ！　こっちにも色々準備とかあんだよ！　あ、こら！　写真撮るな！","en":"Hey, don't just summon me out of nowhere! I got my own prep to do! Hey, don't take pictures!"},"clip":"Audio/Voice/uni00239_1/uni00239_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"誰も見てないよな……？　へへ、我ながらけっこう似合ってるよな……うん、いい感じじゃん","en":"Nobody's watching, right…? Heh, I gotta say it actually looks kinda good… yeah, not bad at all."},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"最近雨ばっかりで嫌になるな……でもお洒落は我慢だしなー……","en":"All this rain's getting on my nerves… but I gotta tough it out for fashion's sake…"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"な、なにジロジロ見てやがんだ！　消し炭にしてやろうか！？","en":"W-what the hell are you staring at! Want me to turn you into charcoal!?"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"俺がこんな服着ていたなんて、絶対他の奴に言うんじゃねえぞ！？　おい、聞いてんのか！","en":"Don't go tell anyone I wore this, got it!? Hey, you listening!?"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"か、可愛いとか、俺の事舐めてんのか！？　ぶ、ぶっとばすぞ……","en":"Cute? You think you're playing with me!? I'm gonna blow you away…"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"このコーデならやっぱりアクセはあんまない方がいいよなあ……でも、この前買ったシュシュ可愛いんだよなあ……","en":"With this outfit, less accessories is probably better… but that scrunchie I got the other day is so cute…"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"な、なんでこっそり遊びに来た先にお前がいるんだよ！？　ほ、他には誰もいねえだろうな？","en":"W-why the heck are you here when I snuck out? N-no one's else around, right?"},"clip":"Audio/Voice/uni00239_1/uni00239_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00239_1/uni00239_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voi