e":{"ja":"魔狼"},"detail":{"ja":"超人属性ユニットの使用スキルによるHP回復効果が中アップ"},"effects":[{"text":"Superhuman allies: skill HP healing +8%"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"evo00018",16],[1,"evo00023",32],[1,"evo01009",4],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"evo00018",32],[12,"evo00023",64],[12,"evo01009",8],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00008",10],[23,"blo00009",15],[24,"blo00011",10],[24,"blo00012",15],[25,"blo00014",10],[25,"blo00015",15],[26,"evo00018",8],[26,"evo00023",32],[26,"evo01009",1],[27,"blo00007",4],[27,"blo00010",4],[27,"blo00013",4],[28,"blo00007",4],[28,"blo00010",4],[28,"blo00013",4],[29,"blo00007",4],[29,"blo00010",4],[29,"blo00013",4],[30,"blo00007",4],[30,"blo00010",4],[30,"blo00013",4],[31,"evo00018",8],[31,"evo00023",32],[31,"evo01009",1],[32,"blo00007",4],[32,"blo00010",4],[32,"blo00013",4],[33,"blo00007",4],[33,"blo00010",4],[33,"blo00013",4],[34,"blo00007",4],[34,"blo00010",4],[34,"blo00013",4],[35,"blo00007",4],[35,"blo00010",4],[35,"blo00013",4],[36,"evo00018",8],[36,"evo00023",32],[36,"evo01009",1],[37,"blo00007",4],[37,"blo00010",4],[37,"blo00013",4],[38,"blo00007",4],[38,"blo00010",4],[38,"blo00013",4],[39,"blo00007",4],[39,"blo00010",4],[39,"blo00013",4],[40,"blo00007",4],[40,"blo00010",4],[40,"blo00013",4],[41,"evo00018",8],[41,"evo00023",32],[41,"evo01009",1],[42,"blo00007",9],[42,"blo00010",9],[42,"blo00013",9],[43,"blo00007",9],[43,"blo00010",9],[43,"blo00013",9],[44,"blo00007",9],[44,"blo00010",9],[44,"blo00013",9],[45,"blo00007",9],[45,"blo00010",9],[45,"blo00013",9],[46,"evo00018",8],[46,"evo00023",32],[46,"evo01009",1],[47,"blo00007",14],[47,"blo00010",14],[47,"blo00013",14],[48,"blo00007",14],[48,"blo00010",14],[48,"blo00013",14],[49,"blo00007",14],[49,"blo00010",14],[49,"blo00013",14],[50,"blo00007",14],[50,"blo00010",14],[50,"blo00013",14]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"おう邪魔するぜ。で、今回はどんな仕事だ？　……はっ、俺が対魔忍とこんな話をするなんてな。分からねぇもんだ","en":"Oh, I'm getting in the way, huh? So, what's the job this time? ... Ha, who would've thought I'd be having a conversation like this with a Taimanin? It's all pretty weird."},"clip":"Audio/Voice/uni07010_1/uni07010_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"こんな風に俺と親しくしていていいのか？　対魔忍さんよ……ま、あんたには無用な気遣いだったな","en":"Is it okay for me to be this close to you, Taimanin? ... Ah, I guess I was just being considerate for nothing."},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"へっ、おべっかなんて使っても無駄だぜ。俺は適当に褒め殺してアゴで使おうとする奴が嫌い……おい、尻尾を覗き込むんじゃない！","en":"Hey, don't bother with the flattery, it won't work on me. I hate it when people try to butter me up just to use me. And stop staring at my tail!"},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おい、違ったら悪いが、『トラ』の奴もこの部隊にいるって噂は本当か？　いや、もし本当なら上手くやれてるか心配でよ","en":"Hey, is it true that \"Tora\" is also in this unit? I've heard the rumors, but if it's true, I'm a bit worried that things might get out of hand."},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"どうだ、自慢のフサフサの白毛。触ってもいいんだぜ？　え？　いらない？　そうか……まあ、別にいいんだけどよ……","en":"So, what do you think of my proud, fluffy white fur? You can touch it if you want. Huh? You're not interested? Oh, well, it's no big deal, I guess."},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"人間の姿に戻らないのかって？　へっ、よく言うぜ。さっきから任務だ討伐だと引っ張り回しやがって。おちおち戻ってもいられねぇよ","en":"You're wondering why I won't change back into my human form? Ha! You're one to talk, always dragging me around on missions and hunts. I don't have time to change back right now."},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"な、なあ、今日は蛇子さん来ねぇのか？　あーいや！　呼び出すほどの用事じゃねぇんだ。……よ、呼んで欲しくないとも言ってないだろう！？","en":"Hey, isn't Aishu Hebiko coming today? Ah, no need to get her involved, it's not that important. ... But that doesn't mean I don't want her to come!"},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"トラのやつ相変わらず訳の分からん言いがかりばかりつけてきて困るぜ。メールばかりするな！　とか、かと思えばオレにはメールしろ！　とか","en":"That \"Tora\" guy is still being a pain, always making unreasonable demands. Stop sending me emails! ... Or, wait, he says I should be the one sending him emails!"},"clip":"Audio/Voice/uni07010_1/uni07010_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni07010_1/uni07010_1_wav_1.ogg"}],"trust":[],"scenes":[],"obtain":[{"kind":"event","type":"Kessen","title":{"ja":"결전 퀘스트 #9","en":"Kessen quest"}},{"kind":"mission","title":null}],"standardPool":false,"art":{"graphicId":"uni_07010","graphicNum":2,"r18GraphicId":"uni_07010","r18GraphicNum":0,"spineId":"Chr_7010"}}