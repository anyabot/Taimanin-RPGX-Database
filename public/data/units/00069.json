uni00069_1/uni00069_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふうま。ちょっと私の腕見てくれる？　……なんて、冗談よ","en":"Fuuma. Can you take a look at my arm? …Just kidding."},"clip":"Audio/Voice/uni00069_1/uni00069_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"さてと、そろそろ任務の時間かな？　面倒くさいけど、頑張りますか","en":"Well then, looks like it's mission time soon. It's a hassle, but shall we push through?"},"clip":"Audio/Voice/uni00069_1/uni00069_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ねぇちょっと。ふうま、聞いてるの？　もう、何よ、さっきから無視して","en":"Hey, listen. Fuuma, are you listening? Ugh, what's up, ignoring me since earlier?"},"clip":"Audio/Voice/uni00069_1/uni00069_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"闇の勢力につくようなやつは、誰であろうと許さないわっ！　私の力で、根絶やしにしてやるから","en":"Anyone who sides with the darkness, whoever they are, I won't forgive them! I'll eradicate them with my power."},"clip":"Audio/Voice/uni00069_1/uni00069_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この対魔ブレードに、切れないものはない！　私の前に立ちはだかる敵は、皆この対魔ブレードの錆にしてやるわ！","en":"There's nothing this Taimanin blade can't cut! Any enemy that stands before me will end up as rust on this blade!"},"clip":"Audio/Voice/uni00069_1/uni00069_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00069_1/uni00069_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00069_1/uni00069_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00069_1/uni00069_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00069_1/uni00069_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00069_1/uni00069_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","varian