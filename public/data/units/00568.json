310,"detail":{"ja":"敵１体にランダムな威力(最大は極特大威力)で攻撃する"}},{"level":5,"sp":310,"detail":{"ja":"敵１体にランダムな威力(最大は極特大威力)で攻撃する"}}],"effects":[{"text":"One of these at random:"},{"text":"1 enemy: 1150% Superhuman damage","when":"25% chance"},{"text":"1 enemy: 1250% Superhuman damage","when":"25% chance"},{"text":"1 enemy: 1350% Superhuman damage","when":"25% chance"},{"text":"1 enemy: 1450% Superhuman damage","when":"25% chance"}]}},"leader":{"name":{"ja":"剛拳の対魔忍"},"detail":{"ja":"部隊全体のATKを中アップ+DEFを極小アップ"},"effects":[{"text":"All allies: ATK +15%","icon":"atk_up"},{"text":"All allies: DEF +5%","icon":"def_up"}]},"abilities":[],"bloom":{"points":1,"gold":2,"status":1,"bonus":1,"items":[[1,"blo00003",40],[1,"ubl00568",50],[2,"blo00007",10],[2,"blo00008",10],[3,"blo00010",10],[3,"blo00011",10],[4,"blo00013",10],[4,"blo00014",10],[5,"blo00007",10],[5,"blo00008",10],[6,"blo00010",10],[6,"blo00011",10],[7,"blo00013",10],[7,"blo00014",10],[8,"blo00007",10],[8,"blo00008",10],[9,"blo00010",5],[9,"blo00011",15],[9,"blo00012",5],[10,"blo00007",5],[10,"blo00008",15],[10,"blo00009",5],[11,"blo00013",5],[11,"blo00014",15],[11,"blo00015",5],[12,"blo00003",80],[12,"ubl00568",100],[13,"blo00007",5],[13,"blo00008",15],[13,"blo00009",5],[14,"blo00010",5],[14,"blo00011",15],[14,"blo00012",5],[15,"blo00013",5],[15,"blo00014",15],[15,"blo00015",5],[16,"blo00007",5],[16,"blo00008",15],[16,"blo00009",5],[17,"blo00010",5],[17,"blo00011",15],[17,"blo00012",5],[18,"blo00013",5],[18,"blo00014",15],[18,"blo00015",5],[19,"blo00007",5],[19,"blo00008",15],[19,"blo00009",5],[20,"blo00011",10],[20,"blo00012",15],[21,"blo00008",10],[21,"blo00009",15],[22,"blo00014",10],[22,"blo00015",15],[23,"blo00011",10],[23,"blo00012",15],[24,"blo00008",10],[24,"blo00009",15],[25,"blo00014",10],[25,"blo00015",15],[26,"blo00003",30],[26,"ubl00568",50],[27,"blo00009",5],[27,"blo00012",5],[27,"blo00015",5],[28,"blo00009",5],[28,"blo00012",5],[28,"blo00015",5],[29,"blo00009",5],[29,"blo00012",5],[29,"blo00015",5],[30,"blo00009",5],[30,"blo00012",5],[30,"blo00015",5],[31,"blo00003",25],[31,"ubl00568",100],[32,"blo00009",5],[32,"blo00012",5],[32,"blo00015",5],[33,"blo00009",5],[33,"blo00012",5],[33,"blo00015",5],[34,"blo00009",5],[34,"blo00012",5],[34,"blo00015",5],[35,"blo00009",5],[35,"blo00012",5],[35,"blo00015",5],[36,"blo00003",50],[36,"ubl00568",50],[37,"blo00009",5],[37,"blo00012",5],[37,"blo00015",5],[38,"blo00009",5],[38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00568",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00568",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"貴方も“Ｂａｎｄｉｔ”に協力してくれるの？　大歓迎です！お礼に私も力を貸しましょう！","en":"Will you cooperate with \"Bandit\" too? You're more than welcome! As a token of gratitude, I'll lend you my power as well!"},"clip":"Audio/Voice/uni00568_1/uni00568_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"さぁ、今日も訓練はじめましょ！　日々の蓄積は重要よ","en":"Alright, let's start today's training! Daily accumulation is crucial, you know."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ふふふ……、心配しなくても大丈夫だよ。失敗は誰にでもあるんだから。実は私も沢山躓いてきたのよ","en":"Don't worry, it's okay... everyone fails sometimes. Actually, I've stumbled many times myself."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"和菓子、好き？　お一つどうぞ。任務を頑張ったご褒美です、ふふっ","en":"Do you like Japanese sweets? Help yourself. It's a reward for a job well done, hehe."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"次の任務、私も一緒に連れていってくださいね。皆さんのフォローは首領としての使命ですから","en":"For the next mission, please take me with you. As the leader, it's my duty to provide support."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あまり気を張りすぎちゃ駄目よ。緊張は失敗のもとだから……。大丈夫、私がついてます！","en":"Don't be too tense, or you'll end up failing... Relax, I've got your back."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"学園時代が懐かしいですね。あの頃の思い出が私に力を与えてくれます","en":"The academy days are nostalgic, aren't they? Those memories give me the strength I need."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"委員長、ですか。ふふっ、あの頃のようなドジはもう踏みませんよ。","en":"The student council president, huh? Hehe, I won't make the same mistakes I did back then."},"clip":"Audio/Voice/uni00568_1/uni00568_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ふふ……っ、じゃあ二人っきりで、訓練はじめましょうかぁ……？","en":"Hehe... shall we start our private training session, just the two of us?"},"clip":"Audio/Voice_r18/uni00568_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"あぁっ、身体が熱いです……っ。ねぇ、お願い……。私を慰めて……？","en":"Ah, my body is burning up... Please, I need you to comfort me...?"},"clip":"Audio/Voice_r18/uni00568_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00568_1/uni00568_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00568_1/uni00568_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00568_1/uni00568_1_atk_3.ogg"},{"t