ariant":"base","index":4,"text":{"ja":"ふふ、似合ってると言われるのは意外と嬉しいものだな","en":"Hehe, being told I look good is surprisingly pleasant."},"clip":"Audio/Voice/uni00238_1/uni00238_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"こ、コラ。余りつつくな。服が伸びるじゃないかっ！","en":"Hey, stop pulling! It'll stretch the clothes!"},"clip":"Audio/Voice/uni00238_1/uni00238_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私服のセンスか……あまり自信はないな。ゆきかぜの様に流行りや着こなしを追うのは苦手なんだ","en":"My sense of civilian fashion... I'm not very confident. I'm not good at keeping up with trends like Yukikaze."},"clip":"Audio/Voice/uni00238_1/uni00238_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"デートだと？　ああ、そんなに言うのなら……まあ少しくらい……別に","en":"A date? Ah, if you say so... well, a little... it's fine."},"clip":"Audio/Voice/uni00238_1/uni00238_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00238_1/uni00238_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00238