29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"ふうま宗家お庭番・壱番隊筆頭、石川あむです。夜会の会場での任務もどうぞお任せください、お館様！","en":"I'm Ishikawa Amu, the leader of the Fuuma family's elite guard. Please leave the mission at the night party to me, Master."},"clip":"Audio/Voice/uni00665_1/uni00665_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"夜会の最中でも、いつでも私はお館様の側にいますので安心してください","en":"Even during the night party, I'm always by Master's side, so please don't worry."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"うふふ～、これこそが本当の壁の華……あれ？　ただの路傍の石でした～？","en":"Hehehe, this is the true flower of the wall... Wait, I'm just a roadside stone?"},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"酔っ払ったお館様を～、介護するように見せかけて～……んふふふ～","en":"Taking care of Master when they're drunk... Hehehe."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"このドレス、似合うでしょうか？　隠れるので、見ることが出来るのはお館様だけですけどね","en":"Does this dress suit me? Only Master can see me, though."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お館様～、あぁ、夜会のために着飾った姿も素敵です～、えへへ～","en":"Master~, ah, you look great dressed up for the night party, hehe."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"この身は常にお館様と共に。どこまでも一緒ですよ","en":"This body is always with Master, together forever."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"１度で良いので、このドレスでお館様と踊って……あっ、い、いいえ～何でもないですっ","en":"I just want to dance with Master in this dress once... Ah, no, it's nothing."},"clip":"Audio/Voice/uni00665_1/uni00665_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"はぁ、はぁ、お～や～か～た～さまぁ～、しゅきしゅき～。んはぁぁあ……！","en":"Haa, haa, oh Master~, I love you. Nnhaaa..."},"clip":"Audio/Voice_r18/uni00665_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"あぁん、お館様を想うだけで、ドレスにシミがついちゃうんですぅぅ","en":"Just thinking about Master makes me get stains on the dress..."},"clip":"Audio/Voice_r18/uni00665_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"誰にも見られてないとはいえ、こんな場所でオナニーなんて……んはぁっ、クセになっちゃいそうかもぉ……！","en":"Even if no one's watching, doing this in a place like this... Ahh, I might just get used to it..."},"clip":"Audio/Voice_r18/uni00665_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00665_1/uni00665_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0513_1_r18"],["chr_0513_2_r18"]],"stills":[["chr_0513_1a_r18"],["chr_0513_2a_r18"]],"obtain":[{