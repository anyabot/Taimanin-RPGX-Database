41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"お呼びと聞き馳せ参じました。どうぞ、私の力をお使いください、若様！","en":"I heard your summons and came running. Please, use my power, Young Master!"},"clip":"Audio/Voice/uni00661_1/uni00661_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"まだまだ私は未熟者ですが、精一杯頑張らせていただきますね","en":"I'm still a novice, but I'll give it my all."},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"若様、私に何か御用ですか？　何かあれば遠慮なくおっしゃってくださいっ","en":"Young Master, do you need anything from me? If there's anything, don't hesitate to tell me!"},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"鎖遁の術……まだ使いこなせているとは言えません。特訓にお付き合いいただけませんか？","en":"The Chain Escape Technique… I can't say I've mastered it yet. Would you train with me?"},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"父とは折り合いが悪いんです。鉄華院家と敵対することになっても問題はありません","en":"I don't get along with my father. I don't mind if it means opposing the Tekkain family."},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"あ、あの、そんなに見つめられると恥ずかしいのですが……","en":"Ah, um, being stared at like that makes me embarrassed..."},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私はまだまだ修行中の身。若様、どうか私をお導きくださいね","en":"I'm still in training. Young Master, please guide me."},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"若様とこうしてともに戦える……。それだけで心が沸き立つ思いです","en":"Fighting alongside you, Young Master… just that makes my heart race."},"clip":"Audio/Voice/uni00661_1/uni00661_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"この若い肉体をお好きにしていいんですよ、若様？　さあ、どうしたいですか……？","en":"You can do whatever you want with this young body, Young Master? Come on, what will you do...?"},"clip":"Audio/Voice_r18/uni00661_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"あぁ、若様にこのように拘束されるなんて。どのように犯されてしまうのでしょうか……","en":"Ah, to be"},"clip":"Audio/Voice_r18/uni00661_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"んはぁっ、気持ち良いです、若様ぁ。もっと私を縛りつけてくださいっ、もっとぉ……！","en":"\"Mmm, that feels good, Young Master. Please bind me tighter, more...!\""},"clip":"Audio/Voice_r18/uni00661_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00661_1/uni00661_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00661_1/uni00661_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00661_1/uni00661_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00661_1/uni00661_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00661_1/uni00661_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","ind