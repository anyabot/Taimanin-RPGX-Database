2,"blo00010",5],[42,"blo00013",5],[43,"blo00007",5],[43,"blo00010",5],[43,"blo00013",5],[44,"blo00007",5],[44,"blo00010",5],[44,"blo00013",5],[45,"blo00007",5],[45,"blo00010",5],[45,"blo00013",5],[46,"blo00001",640],[46,"blo00004",2],[47,"blo00007",5],[47,"blo00009",1],[47,"blo00010",5],[47,"blo00012",1],[47,"blo00013",5],[47,"blo00015",1],[48,"blo00007",5],[48,"blo00009",1],[48,"blo00010",5],[48,"blo00012",1],[48,"blo00013",5],[48,"blo00015",1],[49,"blo00007",5],[49,"blo00009",1],[49,"blo00010",5],[49,"blo00012",1],[49,"blo00013",5],[49,"blo00015",1],[50,"blo00007",5],[50,"blo00009",1],[50,"blo00010",5],[50,"blo00012",1],[50,"blo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"にゃああんっ。メルシーだにゃあ、メルと気持ちいいことするにゃあっ","en":"Nyaa~. It's Merci, and I'm gonna do something pleasurable with you, nya~"},"clip":"Audio/Voice/uni00189_1/uni00189_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"にゃっ。メルと気持ちいいことするにゃあ。……それともお金くれる？","en":"Nya. Do something pleasurable with me, nya... or will you just give me money?"},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"にゃあん？　メルは猫にゃっ。こんにゃに愛らしい人間はいにゃいにゃっ。いっしょにするにゃよっ","en":"Nyaa? I'm a cat, nya. There's no cute human around, nya. Let's do it together, nya."},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おかねは大事だにゃあ。おかねがないと悲しいことがいっぱい起こるにゃあ。だからメルにお金をよこすにゃ","en":"Money's important, nya. Without money sad things happen a lot, nya. So give me some money, nya."},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"そこにじっとしてるにゃ。メルがいまきもちよーくしてやるにゃあ。動いたらつい襲いかかってしまうにゃよ？","en":"Just stay still, nya. I'll make you feel really good now, nya. If you move, I'll just end up attacking, nya?"},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"メルはメルシーっていうにゃ。メルシーはメルの名前にゃ。猫のときには猫って呼ばれていたのにゃ","en":"I'm called Merci. Merci is my name. I used to be called just \"cat\" back when I was a cat, nya."},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"メルは猫にゃ。メルシーっていうのにゃ。お金をくれれば気持ちよくしてやるのにゃ。お金がなくても気持ちよくしてやるのにゃ！","en":"I'm a cat. My name is Merci. If you give me money I'll make you feel good. Even without money I'll still make you feel good!"},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"メルはいま眠いのにゃ。名前？　だからメル……メルシーにゃ。お金をくれないならもう寝るにゃ、気持ちいいことでもいいにゃよ？","en":"I'm sleepy now, nya. Name? So it's... Merci, nya. If you don't give me money I'll just go to sleep, okay? Or maybe do something nice instead?"},"clip":"Audio/Voice/uni00189_1/uni00189_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00189_1/uni00189_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":nu