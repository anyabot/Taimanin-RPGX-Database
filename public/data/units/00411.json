3",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"アタシはアンリード・ボニー、賞金稼ぎ……だけど今夜はクリスマス・ハンターさ。メリー、クリスマス","en":"I'm Annreed Bonnie, a bounty hunter… but tonight I'm a Christmas Hunter. Merry Christmas."},"clip":"Audio/Voice/uni00411_1/uni00411_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"アタシはクリスマス・ハンター。狙った獲物は逃さない。ちゃんと袋も用意しているし、宿もあらかじめ取ってある。完璧だろう？","en":"I'm a Christmas Hunter. I never let my target get away. I've got the bag ready and even booked a place to stay. Perfect, right?"},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"クリスマス……人間界にこんないい日があったとはね。だって今日はやり放題の日なんだろう？　何をって？　決まっているじゃないか","en":"Christmas… I never thought the Human Realm had such a great day. Because today is a free-for-all, right? What? Of course."},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"メリークリスマス。それじゃあ行こうか。何？　今のは合意の合図だろう？　違う？　……なら、なぜ皆はわざわざこんなやり取りを？","en":"Merry Christmas. Then shall we go? What? That was a sign of consent, right? Wrong? …Then why does everyone go through all this talk?"},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"普段は金を出す奴の味方だけど、今夜だけはいい子の味方さ。悪い子は？　……それはここでは言えないね","en":"I usually side with whoever pays, but tonight I'm on the good kids' side. Bad kids? …I can't say that here."},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"この袋が気になる？　ふふっ、いい子にしてたら入れてあげるよ……ん？　何かおかしなことを言ったかな？","en":"Curious about this bag? Heh, if you behave, I'll let you in… huh? Did I say something weird?"},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"人間界の……特にこの国の人々は禁欲的だと思っていたが……なるほど、この日のために備えていたという事か","en":"I thought people of the Human Realm—especially this country—were ascetic… I see, they were preparing for this day."},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"誰彼かまわないわけじゃないよ。何しろアタシはクリスマス・ハンター。アタシが見初めた獲物を狩るのさ","en":"It's not that I don't care who it is. After all, I'm a Christmas Hunter. I hunt the prey I set my sights on."},"clip":"Audio/Voice/uni00411_1/uni00411_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"あっ、んっ……くぅ、すっかり上手くなって……んんっ、そんなに心配しなくても、今のアタシはとっくにあんた専用さ","en":"Ah, mmm… *groan* I'm getting so good… mmm, you don't have to worry so much, I'm already all yours."},"clip":"Audio/Voice_r18/uni00411_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ふふ、クリスマス・ハンターの方が狩られちゃ、世話がないな。だけど不思議だ。今の方が、ずっと心穏やかだよ","en":"Heh, being hunted by a Christmas Hunter is no hassle. But it's strange. I feel a lot more at peace now."},"clip":"Audio/Voice_r18/uni00411_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"め、メリー……そ、その、そっちから言ってくれないか。なんだか今は、あんたから言われたい気分だ……","en":"M-Merry… uh, could you say it first? I kinda want to hear it from you right now…"},"clip":"Audio/Voice_r18/uni00411_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00411_1/uni00411_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0285_r18"]],"stills":[["chr_0285a_r18"]],"obtain":[{"kind":"gacha","type":"Limited","title":{"ja":"【復刻】期間限定クリスマスガチャ"},"start":"2025-12-07","end":"2025-12-25","pull":["Pick-up select"]},{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":false,"origin":"Christmas","art":{"graphicId":"uni_00411","graphicNum":2,"r18GraphicId":"uni_00411_r18","r18GraphicNum":2,"spineId":"Chr_0285"}}