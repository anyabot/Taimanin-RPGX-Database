,80],[1,"blo00005",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あたしは陳春桃だ、よろしくな。これはお近づきの印、うちの店の料理さ。冷めないうちに、食べてみてくれよ","en":"I'm Chen Shuntao, nice to meet you. Consider this a welcome gift - our restaurant's specialty dish. Try it while it's still hot."},"clip":"Audio/Voice/uni00320_1/uni00320_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"いらっしゃい。いまは空いてる時間なんだ、ツイてたな。空いてる席、どこでも自由に座ってくれよ","en":"Welcome! I've got some free time now, perfect timing. Feel free to take any empty seat."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ほい、お待たせ。しかしお前は、いつも同じものを頼むな……たまにはランチ以外も頼めよ、ほかも絶品なんだぞ","en":"Here you go, sorry to keep you waiting. But you always order the same thing... can't you try something else for a change? We've got other great dishes too, you know."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"よし、仕込み終わり――さ、行くぞ。どこにって、お前の修行に決まってるだろ。子作りの前に、少しでもお前に強くなってもらいたいしな","en":"Alright, prep work's done - let's go! Where to? Obviously, it's for your training. I want you to get stronger, even if it's just a bit, before we start a family."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"今夜は宴会の予約が入ってるんだ、お前にも手伝ってもらうからな。親父たちも、お前が来ると嬉しそうだし……ほら、いいから来い","en":"We've got a banquet reservation tonight, and I need your help. The old folks are looking forward to seeing you, so... come on, let's go."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"お疲れさん。夕飯はあたしが作ってやるよ……なに？　失礼だな……これでも跡取り娘だぞ、料理の修行もやってるっての","en":"You must be tired. I'll make dinner for you... what's with the surprise? I'm the heir to this restaurant, and I've been training in cooking too, you know."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お前は弱いけど、見所があるからな――お前と子供を作れば、強い子が生まれそうだ。よろしく頼むぞ、旦那さま","en":"You may be weak, but you've got potential. I think we could have a strong kid if we had one together. I'm counting on you, husband."},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ほらほら、どうした！　これくらいでヘバってちゃ、あたしとの子作りは当分お預けだぞ！","en":"Hey, hey, what's wrong! If you're going to get tired that easily, we'll have to put off having kids for a while!"},"clip":"Audio/Voice/uni00320_1/uni00320_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00320_1/uni00320_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0215_r18"]],"stills":[["chr_0215a_r18"]],"obtain":[{"kind":"gacha","type":"Kessen","title":{"ja":"決戦ピックアップガチャ【超人】"},"start":"2025-04-01","end":"2025-04-30"},{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":true,"origin":"Permanent","art":{"graphicId":"uni_00320","graphicNum":2,"r18GraphicId":"uni_00320_r18","r18GraphicNum":2,"spineId":"Chr_0215"}}