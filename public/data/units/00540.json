lo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"めりーくりすます、だよ～♪　セシリアと一緒に、おいしいケーキとお料理で、パーティしようね～♪","en":"Merry Christmas~♪ Let's have a party with delicious cake and food together with me~♪"},"clip":"Audio/Voice/uni00540_1/uni00540_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"えっへへ～、パーティ、パーティ～♪　いろんな人が集まるから、ちゃんとおめかししておかないとだよね、ヨシ！","en":"Ehehe~ Party, party~♪ Lots of people gather, so I have to dress up properly, right, yay!"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"どうかな、この服……サンタさんらしくって言われて、用意してもらったんだぁ、えへへ♪","en":"How's this outfit… they said it's Santa-like, so they prepared it for me, eheh♪"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふぅ、ちょっと暑くなってきちゃった……んっ、しょっ……じゃ～ん、下は水着なんだよ♪　お部屋が暑くなっても、これで安心だねっ","en":"Phew, it's getting a bit warm… nngh, shh… ta-da, I'm wearing a swimsuit underneath♪ Even if the room gets hot, I'll be fine now."},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ふあぁぁ～～～～、おいしい、クリスマスケーキぃ……ほらぁ、君も食べてみてよ……ねっ、おいしいでしょっ？","en":"Faaaar~… this delicious Christmas cake… here, you try it too… see, it's yummy, right?♪"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"チョコレートに、クリームに、フルーツにぃ……ふあぁ、まだまだた～っくさん、ケーキがあるよぉ……セシリア、すっごく幸せぇ……","en":"Chocolate, cream, fruit… faa, there's still sooo many cakes… I'm super happy…"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"お菓子はいつでもおいしいけど、みんなで食べると、も～っとおいしいよねっ","en":"Snacks are always tasty, but they're even more delicious when we share them together, right?"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"はい、あ～ん……えへへ～♪　セシリアも手伝ったんだよ、このケーキ作るの。おいしいかなぁ？","en":"Here, ahh… eheh~♪ I helped make this cake too, Cecilia. I wonder if it's tasty?"},"clip":"Audio/Voice/uni00540_1/uni00540_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"ふふっ、真っ白になっちゃったねぇ……え～？　雪じゃないよぉ……君のザーメンで、お顔もおっぱいも、真っ白になっちゃった♪","en":"Hehe, it turned all pure white… huh? It's not snow… your… semen turned both your face and breasts completely white♪"},"clip":"Audio/Voice_r18/uni00540_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"チンポにぃ、ホワイトチョコをつけてぇ……れろっ、べろぉ……んふっ、おいひぃ……た～っくさん、クリームだしてねぇ……れろっ♪","en":"Put white chocolate on the dick… le—lick, slurp… nfh, so tasty… so much cream coming out… le—♪"},"clip":"Audio/Voice_r18/uni00540_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00540_1/uni00540_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":nul