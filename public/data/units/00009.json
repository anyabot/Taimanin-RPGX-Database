38,"blo00012",5],[38,"blo00015",5],[39,"blo00009",5],[39,"blo00012",5],[39,"blo00015",5],[40,"blo00009",5],[40,"blo00012",5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00009",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00009",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「若、あなたの執事となるべくふうま天音参上いたしました。どうぞなんなりとお申し付け下さい」","en":"\"Young master, I, Fuuma Amane, have arrived to become your butler. Please feel free to command me at will.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"若、なにか御用などございませんか　このふうま天音になんなりとお申し付け下さい","en":"\"Young master, do you have any business? This Fuuma Amane is at your service—just tell me whatever you need.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"若、なぜ時子などをそばに置いているのですか、私の方が優秀です","en":"\"Young master, why do you keep Tokiko by your side? I'm far more capable.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"おや、若の方からお声がけいただくとは、執事として重用いただけるということですね？","en":"\"Oh? To hear you address me, young master, means you'll be putting me to good use as your butler, right?\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"当主としてはご立派ですがあまり根を詰めるのも良くありません、さ、後は執事の私に任せて","en":"\"As the head of the house you're splendid, but overworking yourself isn't wise. Now leave the rest to your butler.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"おのれ時子め……また邪魔を……！","en":"\"Damned Tokiko... always getting in the way...!\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"若、ふうまの一族に仕える執事として、全力でお助けいたします。時子などよりも","en":"\"Young master, as a butler serving the Fuuma clan, I will aid you with all my might—far beyond Tokiko.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"このふうま天音、若の執事として時子以上の働きをして見せましょう。","en":"\"I, Fuuma Amane, will prove I can work harder than Tokiko as your butler.\""},"clip":"Audio/Voice/uni00009_1/uni00009_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00009_1/uni00009_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni