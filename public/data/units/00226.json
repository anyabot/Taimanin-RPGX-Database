5],[40,"blo00015",5],[41,"blo00003",25],[41,"ubl00226",100],[42,"blo00009",5],[42,"blo00012",5],[42,"blo00015",5],[43,"blo00009",5],[43,"blo00012",5],[43,"blo00015",5],[44,"blo00009",5],[44,"blo00012",5],[44,"blo00015",5],[45,"blo00009",5],[45,"blo00012",5],[45,"blo00015",5],[46,"blo00003",50],[46,"ubl00226",50],[47,"blo00009",5],[47,"blo00012",5],[47,"blo00015",5],[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"アタシはアンリード・ボニー、賞金稼ぎさ。ま、一つよろしく","en":"I'm Annreed Bonnie, a bounty hunter. Well, nice to meet you."},"clip":"Audio/Voice/uni00226_1/uni00226_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"善悪とか仲間意識とかじゃない。アタシは金を出す奴の味方、覚えておきな","en":"It's not about good or evil or camaraderie. I side with whoever pays, remember that."},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"ジェットリボルバーに興味があるって？　残念だけど触らせるわけにはいかないね","en":"You're interested in the Jet Revolver? Sorry, but I can't let you touch it."},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"すまないね、アタシみたいな美人で賞金稼ぎなんてやってると、簡単に他人を信じる訳にはいかないのさ","en":"Sorry, but when a beautiful bounty hunter like me does this job, I can't easily trust others."},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"賞金稼ぎに興味を持つなんて、酔狂なことだ。それとも、興味があるのはアタシの美貌の方かな？","en":"Being interested in bounty hunting is a reckless thing. Or are you more interested in my looks?"},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"もしあんたの首に賞金をかけるやつがいたらすぐにその頭にデカい風穴を開けてやるよ。フフ、冗談さ","en":"If someone puts a bounty on your head, I'll blast a big hole right through it. Heh, just kidding."},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"“死神のアンリード”その名前に聞き覚えはないかい？","en":"\"Reaper of Annreed\"—does that name ring a bell?"},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"アタシの魔繍を見たいなら戦って見せてやろう。まあ、命の保障はしないけど","en":"If you want to see my ma-shuu, I'll show you in a fight. Though I can't guarantee you'll live."},"clip":"Audio/Voice/uni00226_1/uni00226_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00226_1/uni00226_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base",