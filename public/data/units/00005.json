[48,"blo00009",5],[48,"blo00012",5],[48,"blo00015",5],[49,"blo00009",5],[49,"blo00012",5],[49,"blo00015",5],[50,"blo00009",5],[50,"blo00012",5],[50,"blo00015",5]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「対魔忍、水城不知火、ゆきかぜの母よ。娘がいつもお世話になってるわね」","en":"Taimanin, I'm Mizuki Shiranui, Yukikaze's mother. My daughter always looks after me, doesn't she?"},"clip":"Audio/Voice/uni00005_1/uni00005_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"何か御用かしら？　ふふふ、なんでも言って頂戴ね♪","en":"Is there something you need? Hehe, just tell me anything♪"},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"あら、あまり女性をからかう物じゃないわよ？","en":"Oh my, that's not really something to tease a woman about, you know?"},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"ふふ、私は対魔忍の先輩だけれど、同級生の母親なんだから、そんなに緊張しないでもいいのよ","en":"Hehe, I'm a senior Taimanin, but I'm also a classmate's mother, so you don't have to be so nervous."},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"ゆきかぜはちゃんとやれているかしら……学校ではちゃんとしている？","en":"I wonder if Yukikaze is doing okay… Is she behaving properly at school?"},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"そう？　私自身はわりとゆきかぜとは似てると思うのだけれど……","en":"Really? I think I actually resemble Yukikaze quite a bit myself…"},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"あら、ゆきかぜのクラスメイトなの？　母の不知火よ。娘ともども、よろしくお願いするわ♪","en":"Oh, you're a classmate of Yukikaze? I'm Mother Shiranui. Please take care of both me and my daughter♪"},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私は水城不知火、水遁の術は変幻自在、何者も捕らえられないの","en":"I'm Mizuki Shiranui. My water techniques are ever-changing; nothing can catch me."},"clip":"Audio/Voice/uni00005_1/uni00005_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00005_1/uni00005_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice