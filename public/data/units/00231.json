[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"対魔忍総隊長、井河アサギ。これよりあなたの指揮下に入るわ。存分に使いこなしてみせなさい","en":"Taimanin commander, Igawa Asagi. From now on I'm under your orders. Put me to good use."},"clip":"Audio/Voice/uni00231_1/uni00231_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"準備万端。いつでも出撃できるわ。さあ指示を出してちょうだい","en":"Everything's ready. I can launch at a moment's notice. Give me your commands."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"後方で椅子をあたためるのは趣味じゃないわ。私はいつだって第一線よ","en":"Warming chairs in the rear isn't my thing. I'm always on the front lines."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"だらしない体にならないように鍛錬は欠かさないわ。見てみる？　ふふっ、冗談よ","en":"I never skip training so I don't get a sloppy body. Want a look? Heh, just kidding."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"部隊の皆とちゃんとお話してる？　コミュニケーションは大事よ。もちろん私ともね","en":"Do you actually talk with the squad? Communication's important. Including with me, of course."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"同じ『隊長』として協力できる事はたくさんあるわ。何でも言ってね","en":"As fellow captains, there's plenty we can collaborate on. Just tell me what you need."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"やっぱり戦場の空気が私には似合っているみたいね","en":"Looks like the battlefield atmosphere really suits me."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"現場復帰なんて言わないで。対魔忍として生涯現役のつもりなんだから","en":"Don't talk about me returning to the field. I plan to stay active as a Taimanin for life."},"clip":"Audio/Voice/uni00231_1/uni00231_1_hom_7.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00231_1/uni00231_1_wav_1.ogg"}],"trust":[50],"scenes":[["ex_0002_r18"]],"obtain":[],"standardPool":false,"art":{"graphicId":"uni_00231","graphicNum":3,"r18GraphicId":"uni_00231_r18","r18GraphicNum":3,"spineId":"Chr_0016"}}