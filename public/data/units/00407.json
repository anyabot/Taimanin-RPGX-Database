07",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00005",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00005",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00005",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00005",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00005",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00005",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"あら、久しぶりね……忘れたのかしら、三年の清水神流よ。そう、三年よ。背が低いからって、後輩と間違えないでもらいたいわね","en":"Ah, it's been a while… Did you forget, third-year Shimizu Kanna? That's right, third year. Just because I'm short doesn't mean you should mistake me for a junior."},"clip":"Audio/Voice/uni00407_1/uni00407_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"本当に同じ学校だったのね。あまり見ないから、嘘かと思ってたわ。まさか、普段はサボってたりしないでしょうね","en":"So we really did go to the same school. I hadn't seen you around, thought it was a joke. You aren't just goofing off, are you?"},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"……呆れた。本来なら授業中のはずよ、どうしてこんなところで読書しているのかしら。私は自習中よ、一緒にしないでもらいたいわね","en":"…How disappointing. You should be in class; why are you reading here? I'm doing self-study, so stay out of my way."},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"あ――こら！　目を逸らさないで、助けていきなさい！　あなたの同級生たちでしょ、さっきから私の頭を撫で回してきてる失礼な連中は！","en":"Ah—hey! Don't look away, go help them! They're your classmates, the rude ones who've been patting my head!"},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"まったく、私の実力を知らない連中は、ああやってぶしつけに、可愛いかわいいって……その点で言えば、あなたの礼儀正しさは褒められるべきね","en":"Honestly, those who haven't seen my skill act all cute and adorable… In that regard, your politeness deserves praise."},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"水城ゆきかぜなんかも、慕ってくれてはいるけど……たまに視線が怖いのよね、あの子。私、なにかしたかしら","en":"Even Mizuki Yukikaze looks up to me, but sometimes her stare is intimidating… Did I do something wrong?"},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"そうね、七瀬舞ともよく話すわ。あの子はゆきかぜと違って、視線も穏やかだし……ほかの後輩にも見習わせたいくらい、礼儀正しいわ","en":"Sure, I talk a lot with Nanase Mai. Unlike Yukikaze, her stare is gentle… I'd love for other juniors to follow her example of politeness."},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"私のことより――あなたは、ちゃんと友達がいるんでしょうね。もしいるなら、その子たちまでサボりに巻き込まないようになさい","en":"More than me—you must have friends, right? If so, don't let them get pulled into slacking either."},"clip":"Audio/Voice/uni00407_1/uni00407_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"こ、こんなの、クセになっちゃう……ぅっ、くぅぅっ……あぁっ、だめ、だめぇ……誰かに、見られちゃう……見られちゃう、のにぃっ……","en":"This… it's becoming a habit… ugh… no, no… someone's watching… even though they're watching…"},"clip":"Audio/Voice_r18/uni00407_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"はぁっ、はぁっ、んっっ……最低っ、こんなっ……教室で、一人でするのっ……いけないのに、これぇ……気持ち、よすぎるっ……あんっっ！","en":"Haa, haa, n… this is the worst… doing it alone in the classroom… I know I shouldn't, but it feels so good… ah!"},"clip":"Audio/Voice_r18/uni00407_1_hom_r18_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00407_1/uni00407_1_wav_1.ogg"}],"trust":[100],"scenes":[["chr_0281_r18"]],"stills":[["chr_0281a_r18"]],"obtain":[{"kind":"spark","title":null,"need":100,"start":"2023-06-01","end":"2023-06-30"},{"kind":"spark","title":null,"need":100,"start":null,"end":null}],"standardPool":true,"origin":"Permanent","art":{"graphicId":"uni_00407","graphicNum":2,"r18GraphicId":"uni_00407_r18","r18GraphicNum":2,"spineId":"Chr_0281"}}