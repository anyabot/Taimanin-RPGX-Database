lo00013",5],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"「私は訳あってオレンジインダストリーに協力している者だ。そうだな、スカイエッジと呼んでくれ」","en":"I have my reasons for cooperating with Orange Industry. Call me Skyedge."},"clip":"Audio/Voice/uni00050_1/uni00050_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"私の準備は万端だ。お前も今のうちにやれることはやっておけ","en":"I'm fully prepared. You should also get your tasks done while you can."},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"こ、こら！　物珍しいのかも知れないがあまり装備をいじるな！","en":"Hey! It might be a rare thing, but don't fiddle with the equipment too much!"},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"普段の装備じゃないから少し違和感があるんだが……そうか、似合ってるか","en":"It's not my usual gear, so it feels a bit off... Hmm, does it suit me?"},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"この装備は優秀なんだが、逸刀流や胡蝶乱舞が使えないのが不便なんだ……","en":"This equipment is excellent, but it's inconvenient that I can't use Itsutō-ryū or Butterfly Dance."},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"そう言えば最近ゆきかぜ達とあまり話が出来ていないんだよ","en":"Speaking of which, I haven't been able to talk much with Yukikaze and the others lately."},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"私のコードネームはスカイエッジ。秋山凜子……誰のことかな？","en":"My codename is Skyedge. Akiyama Rinko... who are you thinking of?"},"clip":"Audio/Voice/uni00050_1/uni00050_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"米連というのは面白い装備を考える……が、機械に頼りすぎるのはよくないな","en":"The US comes up with interesting gear... but relying too much on machines isn't good."},"clip":"Audio/Voice/uni00050_1/uni00050_1_