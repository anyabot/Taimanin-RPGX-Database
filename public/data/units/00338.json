:[{"text":"All enemies: 390% Science damage","tag":"instant"},{"text":"All allies: take 15% of max HP as damage","tag":"instant"}]},{"level":2,"sp":280,"detail":{"ja":"敵全体に大威力で攻撃、味方全体に小威力のダメージ"},"effects":[{"text":"All enemies: 392% Science damage","tag":"instant"},{"text":"All allies: take 15% of max HP as damage","tag":"instant"}]},{"level":3,"sp":280,"detail":{"ja":"敵全体に大威力で攻撃、味方全体に小威力のダメージ"},"effects":[{"text":"All enemies: 394% Science damage","tag":"instant"},{"text":"All allies: take 15% of max HP as damage","tag":"instant"}]},{"level":4,"sp":280,"detail":{"ja":"敵全体に大威力で攻撃、味方全体に小威力のダメージ"},"effects":[{"text":"All enemies: 396% Science damage","tag":"instant"},{"text":"All allies: take 15% of max HP as damage","tag":"instant"}]},{"level":5,"sp":280,"detail":{"ja":"敵全体に大威力で攻撃、味方全体に小威力のダメージ"}}],"effects":[{"text":"All enemies: 398% Science damage","tag":"instant"},{"text":"All allies: take 15% of max HP as damage","tag":"instant"}]}},"leader":{"name":{"ja":"お色直し"},"detail":{"ja":"科学属性ユニットのSPをターン終了時に小回復する"},"effects":[{"text":"Science allies: restore 20% SP at end of turn","icon":"Healing_sp","tag":"passive"}]},"abilities":[],"bloom":{"points":1,"gold":1,"status":1,"bonus":1,"items":[[1,"blo00002",80],[1,"blo00006",1],[2,"blo00007",15],[3,"blo00010",15],[4,"blo00013",15],[5,"blo00007",15],[6,"blo00010",15],[7,"blo00013",15],[8,"blo00007",15],[9,"blo00010",10],[9,"blo00011",10],[10,"blo00007",10],[10,"blo00008",10],[11,"blo00013",10],[11,"blo00014",10],[12,"blo00002",160],[12,"blo00006",2],[13,"blo00007",10],[13,"blo00008",10],[14,"blo00010",10],[14,"blo00011",10],[15,"blo00013",10],[15,"blo00014",10],[16,"blo00007",10],[16,"blo00008",10],[17,"blo00010",10],[17,"blo00011",10],[18,"blo00013",10],[18,"blo00014",10],[19,"blo00007",10],[19,"blo00008",10],[20,"blo00010",5],[20,"blo00011",15],[20,"blo00012",5],[21,"blo00007",5],[21,"blo00008",15],[21,"blo00009",5],[22,"blo00013",5],[22,"blo00014",15],[22,"blo00015",5],[23,"blo00010",5],[23,"blo00011",15],[23,"blo00012",5],[24,"blo00007",5],[24,"blo00008",15],[24,"blo00009",5],[25,"blo00013",5],[25,"blo00014",15],[25,"blo00015",5],[26,"blo00002",80],[26,"blo00006",1],[27,"blo00008",3],[27,"blo00011",3],[27,"blo00014",3],[28,"blo00008",3],[28,"blo00011",3],[28,"blo00014",3],[29,"blo00008",3],[29,"blo00011",3],[29,"blo00014",3],[30,"blo00008",3],[30,"blo00011",3],[30,"blo00014",3],[31,"blo00002",160],[31,"blo00006",2],[32,"blo00008",3],[32,"blo00011",3],[32,"blo00014",3],[33,"blo00008",3],[33,"blo00011",3],[33,"blo00014",3],[34,"blo00008",3],[34,"blo00011",3],[34,"blo00014",3],[35,"blo00008",3],[35,"blo00011",3],[35,"blo00014",3],[36,"blo00002",160],[36,"blo00006",2],[37,"blo00008",3],[37,"blo00011",3],[37,"blo00014",3],[38,"blo00008",3],[38,"blo00011",3],[38,"blo00014",3],[39,"blo00008",3],[39,"blo00011",3],[39,"blo00014",3],[40,"blo00008",3],[40,"blo00011",3],[40,"blo00014",3],[41,"blo00002",160],[41,"blo00006",2],[42,"blo00008",3],[42,"blo00011",3],[42,"blo00014",3],[43,"blo00008",3],[43,"blo00011",3],[43,"blo00014",3],[44,"blo00008",3],[44,"blo00011",3],[44,"blo00014",3],[45,"blo00008",3],[45,"blo00011",3],[45,"blo00014",3],[46,"blo00002",160],[46,"blo00006",2],[47,"blo00008",3],[47,"blo00009",1],[47,"blo00011",3],[47,"blo00012",1],[47,"blo00014",3],[47,"blo00015",1],[48,"blo00008",3],[48,"blo00009",1],[48,"blo00011",3],[48,"blo00012",1],[48,"blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"じゃじゃん……お色直し、完了。どうだ、似合ってるか？　可愛いか？","en":"Ta-da… outfit change complete. How does it look? Does it suit me? Cute?"},"clip":"Audio/Voice/uni00338_1/uni00338_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"ドレスをいっぱい着替えるのは、楽しいな……旦那さまが喜んでくれると、なおいい……お前のことだぞ、旦那さま？","en":"I love changing dresses a lot… It's even better when Master likes it… I'm talking about you, Master?"},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"これはむしろ、お嫁さんというよりお姫さま……つまり、旦那さまじゃなく――王子さま？","en":"This is more of a princess than a bride… so not Master—maybe a prince?"},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"このあとは、ケーキをぶった切る予定……任せて、この触手で一刀両断……え？　二人で、一緒に？　にゅうとう？　乳頭？","en":"After this, I'm going to slice the cake… leave it to me, I'll cut it clean with these tentacles… huh? Together, the two of us? Nyūtō? Nipple?"},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"はい、あーん。たんとおあがり……ふふっ、これがファーストバイトだ。愛情の大きさだけ、ケーキを食べさせる……らしい","en":"Here, say \"ahh\". Take a big bite… hehe, that's the first bite. I guess I feed you cake matching how much I care."},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"ふぅ……いっぱいドレス着られて、満足……あ、こら。脱ぐのは部屋に戻ってからだぞ、まったく……","en":"Phew… I'm satisfied after trying on so many dresses… Hey, stop. We'll change back in the room, seriously…"},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"前より、お嫁さんに興味出てきた……いつか、なりたい……ふうまのお嫁さんに、なりたいぞ……","en":"I'm more interested in being a bride than before… I want to become one someday… I want to be Fuuma's bride…"},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"この格好、ちゃんと可愛いか？　そうか、ならいい……うん、信じる。ふうまが褒めてくれるなら、信用できる","en":"Is this outfit actually cute? If so, great… yeah, I believe it. If Fuuma compliments me, I can trust it."},"clip":"Audio/Voice/uni00338_1/uni00338_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"結婚したらするの、新婚初夜……ちゃんと出来るから、ふうまのお嫁さんにして……？","en":"If we get married, the wedding night… I can handle it properly, so will you be my bride, Fuuma…?"},"clip":"Audio/Voice_r18/uni00338_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"ドレス姿をずっとチラチラ見られてお股がムズムズしてきた……このまましよ？","en":"Being stared at in my dress is making my… well, itchy… should we just keep it up?"},"clip":"Audio/Voice_r18/uni00338_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"折角のウェディングドレスが汚れちゃうぞ？　で、でも私ももう我慢出来ない……！","en":"My wedding dress will get dirty, you know? But I can't hold back any longer…!"},"clip":"Audio/Voice_r18/uni00338_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni00338_1/uni00338_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["chr_0227_1_r18"],["chr_0227_2_r18"]],"stills":[["chr_0227_1a_r18"],["chr_0227_2a_r18"]],"obtain":[{"kind":"event","type":"Story event","title":{"ja":"Story event #14","en":"Story event #14"},"archive":true},{"kind":"mission","title":null}],"standardPool":false,"origin":"Event","art":{"graphicId":"uni_00338","graphicNum":3,"r18GraphicId":"uni_00338_r18","r18GraphicNum":2,"spineId":"Chr_0227"}}