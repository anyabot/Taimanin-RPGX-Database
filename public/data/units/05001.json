blo00014",3],[48,"blo00015",1],[49,"blo00008",3],[49,"blo00009",1],[49,"blo00011",3],[49,"blo00012",1],[49,"blo00014",3],[49,"blo00015",1],[50,"blo00008",3],[50,"blo00009",1],[50,"blo00011",3],[50,"blo00012",1],[50,"blo00014",3],[50,"blo00015",1]]},"voices":[{"type":"new","label":"Acquired","variant":"base","index":1,"text":{"ja":"私をゲット、おめでたいまに～ん！　い～っぱいお祝いしていくんだから！","en":"Get me, celebratory Taimanin! I'll celebrate you to the max!"},"clip":"Audio/Voice/uni05001_1/uni05001_1_new_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":1,"text":{"ja":"おめでたいまにん！　水城ゆきかぜよ！　おめでたいことないかしらね～。私が祝ってあげるんだから！","en":"Celebratory Taimanin! Mizuki Yukikaze here! Anything worth celebrating? I'll celebrate it for you!"},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_1.ogg"},{"type":"hom","label":"Home","variant":"base","index":2,"text":{"ja":"おめでたいことがあれば駆けつける！　『祝いのおめでたいまにん』とは私のことよ","en":"If there's something to celebrate, I'll rush right in! The \"Celebratory Taimanin\" is me."},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_2.ogg"},{"type":"hom","label":"Home","variant":"base","index":3,"text":{"ja":"私がいれば、いつでも、どこでも、おめでたいまにん♪　君の勝利をお祝いして、あ・げ・る","en":"Whenever I'm around, anywhere, it's celebratory Taimanin time♪ I'll celebrate your victory, just for you."},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_3.ogg"},{"type":"hom","label":"Home","variant":"base","index":4,"text":{"ja":"おめでたいまに～ん！　私と入れば、毎日がおめでたいまにん！　どう？　ハッピーになれたでしょ","en":"Celebratory Taimanin! With me, every day's a celebration! How's that? You're happy now, right?"},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_4.ogg"},{"type":"hom","label":"Home","variant":"base","index":5,"text":{"ja":"私を手に入れてくれてありがたいまにん♪　私と一緒にいれば、毎日がおめでたいまにん♪","en":"Thanks for snagging me, lucky charm♪ As long as you're with me, every day feels like a celebration, lucky charm♪"},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_5.ogg"},{"type":"hom","label":"Home","variant":"base","index":6,"text":{"ja":"任務お疲れ様！　どう？　おめでたいまにんな私の言葉でハッピーになれたでしょ？　あはは","en":"Great work on the mission! So, my celebratory words made you happy, huh? Ahaha"},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_6.ogg"},{"type":"hom","label":"Home","variant":"base","index":7,"text":{"ja":"ちょっと！！　いつもと少し違うからってジロジロ見ないでよ！　恥ずかしいでしょ！","en":"Hey!! Just because it's a bit different than usual, don't stare at me! It's embarrassing!"},"clip":"Audio/Voice/uni05001_1/uni05001_1_hom_7.ogg"},{"type":"hom","label":"Home","variant":"r18","index":1,"text":{"ja":"お、おめでたいまにん…あんっ、私がお祝いのご褒美のはずなのにぃぃ～ご褒美もらっちゃってるよぉ","en":"Um, celebratory lucky charm… ahh, I was supposed to be the prize, but I'm getting the reward too~"},"clip":"Audio/Voice_r18/uni05001_1_hom_r18_1.ogg"},{"type":"hom","label":"Home","variant":"r18","index":2,"text":{"ja":"こ、こんな格好でお祝いなんてできないよぉ…言いましゅ！言いましゅう！　おめでたいまにん～","en":"I- I can't celebrate like this in this outfit… I gotta say it! I gotta say it! celebratory lucky charm～"},"clip":"Audio/Voice_r18/uni05001_1_hom_r18_2.ogg"},{"type":"hom","label":"Home","variant":"r18","index":3,"text":{"ja":"はうっ！どんだけ出すのよぉ！あんたの精子で子宮渋滞じゃない！　わ、わたしがおめでたいまにんになっちゃうわよ…","en":"Hau! How much are you dumping! It's not a uterine traffic jam from your sperm! I- I'm turning into a celebratory lucky charm…"},"clip":"Audio/Voice_r18/uni05001_1_hom_r18_3.ogg"},{"type":"atk","label":"Attack","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_atk_1.ogg"},{"type":"atk","label":"Attack","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_atk_2.ogg"},{"type":"atk","label":"Attack","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_atk_3.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_dmg_1.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_dmg_2.ogg"},{"type":"dmg","label":"Damaged","variant":"base","index":3,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_dmg_3.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_evo_1.ogg"},{"type":"evo","label":"Awakening","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_evo_2.ogg"},{"type":"lup","label":"Level Up","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_lup_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_msr_1.ogg"},{"type":"msr","label":"Mission","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_msr_2.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_rdy_1.ogg"},{"type":"rdy","label":"Battle Start","variant":"base","index":2,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_rdy_2.ogg"},{"type":"res","label":"Result","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_res_1.ogg"},{"type":"wav","label":"Wave","variant":"base","index":1,"text":null,"clip":"Audio/Voice/uni05001_1/uni05001_1_wav_1.ogg"}],"trust":[100,200],"scenes":[["ex_0005_1_r18"],["ex_0005_2_r18"]],"stills":[["ex_0005_1a_r18"],["ex_0005_2a_r18"]],"obtain":[],"standardPool":false,"art":{"graphicId":"uni_05001","graphicNum":2,"r18GraphicId":"uni_05001_r18","r18GraphicNum":2,"spineId":"Chr_5001"}}