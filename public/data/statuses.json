ltimate"],["00830","skill1"],["01027","skill2"],["01042","skill1"],["01048","skill2"],["01075","skill1"],["04004","ultimate"],["04014","skill1"]]},{"key":"mk:3","name":"Hellfire","ja":"獄炎","icon":"marker_hellfire","definition":["Hellfire (up to 8): when hit by a Burn skill, 40% chance (less the target's status ailment resistance) of 3000 extra damage, +25% per stack; Burn damage +13% per stack (rest of the battle)"],"help":null,"units":[["00662","ultimate"],["00725","skill1"],["00725","skill2"],["00779","skill2"],["00779","ultimate"],["00863","ultimate"],["00868","ultimate"],["00875","skill1"],["00875","skill2"],["00903","skill1"],["01022","skill2"]]},{"key":"mk:4","name":"Revy Erosion","ja":"侵食","icon":"marker_revy_erosion","definition":["Revy Erosion (up to 4): status ailment resistance -3 at each turn end; each status ailment inflicted adds 1; after 10 turns it ends with 70000 damage, +75% per stack"],"help":null,"units":[["00674","ultimate"]]},{"key":"mk:8","name":"Bunny","ja":"バニーマーカー","icon":"marker_bunny","definition":["Bunny (up to 20): ATK +1% per stack, DEF +1% per stack"],"help":null,"units":[["00710","ultimate"],["00815","skill2"],["01070","ultimate"],["01071","skill2"],["01071","ultimate"],["01097","ultimate"]]},{"key":"mk:9","name":"Roaring Thunder","ja":"轟雷","icon":"marker_roaringthunder","definition":["Roaring Thunder (up to 8): when hit by a Paralysis skill, 40% chance (less the target's status ailment resistance) of 2500 extra damage, +25% per stack; at turn end DEF -3% and SPD -3%, up to 5 times (rest of the battle)","While electrified, attacks apply Roaring Thunder (up to 8): when hit by a Paralysis skill, 40% chance (less the target's status ailment resistance) of 2500 extra damage, +25% per stack; at turn end DEF -3% and SPD -3%, up to 5 times","While electrified, attacks apply Roaring Thunder (up to 8): when hit by a Paralysis skill, 40% chance (less the target's status ailment resistance) of 2500 extra damage, +25% per stack; at turn end DEF -5% and SPD -3%, up to 5 times"],"help":null,"units":[["00737","skill1"],["00737","skill2"],["00834","skill1"],["00834","skill2"],["00884","skill2"],["00890","skill2"],["00895","ultimate"],["00902","skill1"],["00902","ultimate"],["00953","skill1"],["00953","skill2"],["01096","skill1"],["01096","ultimate"],["01100","skill1"],["01100","ultimate"],["05005","skill1"],["05007","skill1"],["05007","ultimate"]]},{"key":"mk:11","name":"Hojin","ja":"紙方陣","icon":null,"definition":["Hojin: DEF +60, easier for enemies to target (+300%), and when hit all allies restore 5 SP (rest of the battle)"],"help":"【紙方陣】は選択したスキルに関わらず発動するスキル効果です。\nリーダースキルやサポートスキルとして発動する他、通常攻撃などバトルの最初の行動開始時に自動的に発動します。\n【紙方陣】が発動すると、自身に以下3点の効果を付与します。\n・DEFを60アップする\n・敵から狙われやすくなる\n・敵からのダメージを受けたとき、味方全体のSPを極小回復する\n\n▼仕様詳細\n・【紙方陣】の効果は重複しません。\n・「ランダムな敵に」攻撃するスキルを受ける場合、受けた攻撃回数分のSP回復が行われます。\n　※「敵１体に」複数回攻撃するスキルは１回分のSP回復となります。\n・混乱した味方からダメージを受けた場合もSPは回復します。\n・毒や火傷等によるダメージではSPは回復しません。\n・【紙方陣】を発動しているユニットがダメージを受けて死亡したターンでもSP回復を行います。\n・【紙方陣】は死亡および石化すると解除されます。バトルに復帰した際は、次の行動開始時に【紙方陣】が再発動します。","units":[["00744","attack"],["00744","skill1"],["00744","skill2"],["00744","ultimate"]]},{"key":"mk:12","name":"Inspire","ja":"奮起","icon":"marker_inspire","definition":["Inspire: when Immortal triggers, own attack damage +50% for 2 turns, then Immortal and Inspire end","Inspire: when Immortal triggers, own attack damage +20% for 2 turns, then Immortal and Inspire end"],"help":null,"units":[["00741","ultimate"],["00807","ultimate"],["01013","skill1"],["01059","skill1"]]},{"key":"mk:13","name":"Frozen Bomb","ja":"氷爆","icon":"marker_frozenbomb","definition":["Frozen Bomb (up to 5): +1 stack per own crit; after each action, a follow-up attack on random enemies that grows in power and hits with stacks"],"help":"『氷爆』が付与されたユニットは、行動する度に追加でランダムな敵に『追撃』としてダメージを与えます。\n『追撃』の威力と回数は、『氷爆』マーカーの累積数に応じてアップします。\nまた『氷爆』の累積数は、対象ユニットの攻撃に会心が発生する度に加算されます。\n攻撃が1回増える『双撃』装備の4set効果で『追撃』の機会を増やしたり、会心率を上げる『天賦』装備の4set効果で『氷爆』マーカーを溜めやすくしたりすることで、より強力なものとなります。\n\n▼仕様詳細\n・最大5まで累積可能です。\n・追撃により会心が発生した際も累積されます。\n・以下の場合により発生する通常攻撃には『追撃』が発生しません。\n　・反撃\n　・状態異常「混乱」「封印」\n　・通常攻撃以外使用不可のステージ\n・『追撃』は暗闇の状態異常の影響を受けます。\n・『追撃』は攻撃スキルに状態異常付与効果を付与する特殊効果（『火傷付与効果』など）の対象となります。\n・累積したマーカーは個別に管理され、それぞれ4ターン後に消失します。継続中のマーカーが残っている限り、『氷爆』の効果は継続します。","units":[["00745","skill1"],["01036","skill1"]]},{"key":"mk:15","name":"Gold Aegis","ja":"ゴールドイージス","icon":"marker_goldaegis","definition":["Gold Aegis (up to 5): after each action, a follow-up attack (5 random hits) that also gives self a 500 shield"],"help":null,"units":[["07022","skill2"],["07022","ultimate"]]},{"key":"mk:16","name":"SCL","ja":"一重紅蓮","icon":"marker_scl","definition":[],"help":null,"units":[["04002","skill1"],["04002","skill2"],["04002","ultimate"]]},{"key":"mk:17","name":"Onikoroshi","ja":"鬼ころし","icon":"marker_onikoroshi","definition":["Onikoroshi: own crit rate -20%"],"help":null,"units":[["04001","skill1"],["04001","ultimate"]]},{"key":"mk:18","name":"Divine Eye","ja":"神眼","icon":"marker_shingan","definition":[],"help":null,"units":[["01095","ultimate"],["01099","ultimate"],["05006","ultimate"]]},{"key":"mk:19","name":"Deadly Poison","ja":"猛毒","icon":null,"definition":["Deadly Poison (up to 10): Poison skills have a 25% chance (less the target's status ailment resistance) to add a stack; while poisoned, damage taken +1% per stack; at each turn end, by stacks: DEF -1% each (max 20%), HP and SP recovery -0.75% each (max 15%), poison damage from 3000, +390 each (max 10000)"],"help":"『猛毒』が付与された対象は以下の効果を受けます。\n・猛毒ダメージが発生（最大10000）\n・被回復効果がダウン(最大15%)\n・DEFがダウン(最大20%)\n\n上記の効果は『猛毒』マーカーの累積数に応じて、ターン終了時に効果値が上昇いたします。\n\nさらに、『猛毒』マーカーは状態異常『毒』と組み合わせることによって、より強力な効果を発揮することが出来ます。\n対象に『猛毒』マーカーと状態異常『毒』の両方が付与されている場合、対象の受けるダメージが『猛毒』マーカーの累積数に応じて上昇し、最大で10%アップする状態になります。\n※上記の対象となるのは直接ダメージを与える攻撃によるダメージとなります。\n\n▼仕様詳細\n・『猛毒』マーカーは最大10まで累積可能です。\n・『猛毒』マーカーは「毒状態にする」スキルを発動する毎に確率で「1」ずつ加算されます。\n　※状態異常『毒』を付与する確率と『猛毒』マーカーを付与する確率はそれぞれ異なります。\n　※既に『猛毒』マーカーが付与されている対象に対して、同マーカーを付与するスキルを使用しても、\n　　マーカーの累積が行われませんのでご注意ください。\n・『猛毒』の効果によって発生する猛毒ダメージによってHPが0になることはありません。\n・『猛毒』マーカーはターン経過により消失しません。死亡および石化した場合のみ、消失します。","units":[["00789","ultimate"],["00831","skill2"],["00873","skill2"],["00922","skill2"],["01012","skill1"],["01047","skill1"],["04005","skill1"]]},{"key":"mk:20","name":"Pledge","ja":"誓約","icon":"marker_pledge","definition":["Pledge (up to 20): DEF -1% per stack, SPD -1% per stack"],"help":null,"units":[["00793","ultimate"]]},{"key":"mk:21","name":"Bouquet","ja":"ブーケ","icon":"marker_bouquet","definition":[],"help":null,"units":[["00799","skill1"],["00799","skill2"],["00799","ultimate"]]},{"key":"mk:22","name":"Taima Particle","ja":"対魔粒子","icon":"marker_taimaparticle","definition":[],"help":null,"units":[["00803","skill1"],["00803","skill2"],["00803","ultimate"],["00917","skill1"],["00917","skill2"],["00917","ultimate"]]},{"key":"mk:23","name":"Crimson Darkness","ja":"紅き闇","icon":"marker_crimsondarkness","definition":["Crimson Darkness (up to 7): acts first of all units; +1 stack at each turn end; per stack Max HP -15%, ATK +15%, easier to target +50%; all removed when Immortal triggers"],"help":null,"units":[["00807","ultimate"]]},{"key":"mk:25","name":"Ice Wall","ja":"氷壁","icon":null,"definition":["Ice Wall: after each action, all allies get a 250 shield for 2 turns"],"help":null,"units":[["00832","skill1"]]},{"key":"mk:26","name":"Voltage [HP]","ja":"ボルテージ【HP】","icon":null,"definition":["Voltage [HP] (up to 10): Max HP +500 per stack, +1 stack at each turn end (rest of the battle)"],"help":null,"units":[["01049","skill1"],["04007","skill1"]]},{"key":"mk:28","name":"Voltage [ATK]","ja":"ボルテージ【ATK】","icon":null,"definition":["Voltage [ATK] (up to 10): ATK +15 per stack, +1 stack at each turn end (rest of the battle)"],"help":null,"units":[["00913","skill1"],["04010","skill1"]]},{"key":"mk:29","name":"Voltage [DEF]","ja":"ボルテージ【DEF】","icon":null,"definition":["Voltage [DEF] (up to 10): DEF +50 per stack, +1 stack at each turn end (rest of the battle)"],"help":null,"units":[["00852","skill1"],["00886","skill1"],["00930","skill1"],["00944","skill1"],["01041","skill1"]]},{"key":"mk:30","name":"Voltage [SPD]","ja":"ボルテージ【SPD】","icon":null,"definition":["Voltage [SPD] (up to 10): SPD +3 per stack, +1 stack at each turn end (rest of the battle)"],"help":null,"units":[["00856","skill1"],["01048","skill1"],["04009","skill1"]]},{"key":"mk:31","name":"Voltage [CRT]","ja":"ボルテージ【CRT】","icon":null,"definition":["Voltage [CRT] (up to 10): crit rate +5% per stack, +1 stack at each turn end (rest of the battle)","Voltage [CRT] (up to 10): crit rate +5% per stack, +1 stack at each turn end"],"help":null,"units":[["00949","skill1"],["00949","skill2"],["01075","skill1"]]},{"key":"mk:32","name":"Bad Omen","ja":"凶兆","icon":"marker_badomen","definition":["Bad Omen (up to 10): counts as every status ailment when targeted; 1 removed each time the holder lands a crit"],"help":null,"units":[["00860","skill1"],["00934","skill1"],["01035","ultimate"],["04011","ultimate"]]},{"key":"mk:33","name":"Dark Contamination","ja":"闇の蝕み","icon":null,"definition":[],"help":null,"units":[["00863","skill1"],["00863","skill2"],["00863","ultimate"]]},{"key":"mk:34","name":"Fire Soul","ja":"炎魂","icon":"marker_firesoul","definition":["Fire Soul (up to 5): Max HP -15%; per stack ATK +15%, crit damage +10%"],"help":null,"units":[["00872","ultimate"],["01045","skill2"],["01071","ultimate"]]},{"key":"mk:electrification","name":"Electrification","ja":"帯電","icon":null,"definition":["While electrified, attacks apply Roaring Thunder (up to 8): when hit by a Paralysis skill, 40% chance (less the target's status ailment resistance) of 2500 extra damage, +25% per stack; at turn end DEF -5% and SPD -3%, up to 5 times"],"help":null,"units":[["01096","ultimate"],["01100","ultimate"],["05007","ultimate"]]}]}